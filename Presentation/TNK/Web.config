  <!-- Cau hinh log4net-->
  <log4net debug="true">
    <appender name="DailyLog" type="log4net.Appender.RollingFileAppender">
      <file value="log/"/>
      <appendToFile value="true"/>
      <rollingStyle value="Date"/>
      <staticLogFileName value="false"/>
      <datePattern value="yyyy-MM-dd.lo\g"/>
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date %-5level %logger - %message%newline"/>
      </layout>
    </appender>
    <root>
      <level value="ALL"/>
      <appender-ref ref="DailyLog"/>
    </root>
  </log4net>
  <system.web>
    <globalization fileEncoding="UTF-8" requestEncoding="UTF-8" responseEncoding="UTF-8" culture="vi-VN" uiCulture="vi-VN" />
    <authentication mode="Forms">
      <forms name="TNK.AUTH" loginUrl="/User/Login" protection="All" timeout="120" requireSSL="false" slidingExpiration="true"></forms>
    </authentication>
    <compilation debug="true" targetFramework="4.5" />
    <httpRuntime targetFramework="4.5" maxRequestLength="1048576"/>
  </system.web>
