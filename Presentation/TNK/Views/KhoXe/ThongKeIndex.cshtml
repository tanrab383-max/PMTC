@model List<TNK.Core.Domain.View.ViewThongKeKho>
@{
    ViewBag.Title = "Thống kê kho xe";
    int i = 1;
    double SoLuong = 0, TongTien = 0;
}
<div class="page-title">
    <div class="title_left">
        <h3>@ViewBag.Title</h3>
    </div>
</div>
<div class="clearfix"></div>
<div class="row">
    <div class="col-md-12">
        <div class="tabbable-line boxless tabbable-reversed">

            <div class="tab-content">
                <div class="tab-pane active" id="tab_0">
                    <div class="x_panel">
                        <div class="x_content">
                            <form method="get" class="row">
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <label>Từ ngày nhập</label>
                                        <input type="text" class="form-control input-sm date" value="@ViewBag.From" name="from" />
                                    </div>
                                </div>
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <label>Đến ngày nhập</label>
                                        <input type="text" class="form-control input-sm date" value="@ViewBag.To" name="to" />
                                    </div>
                                </div>
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <br />
                                        <input type="submit" value="Tìm kiếm" class="btn btn-success" />
                                    </div>
                                </div>
                            </form>
                            <div class="table-responsive" style="overflow:auto">
                                <table class="table" style="width:100%;">
                                    <thead>
                                        <tr class="success">
                                            <th>STT</th>
                                            <th>Mã Loại Xe</th>
                                            <th>Loại Xe</th>
                                            <th>Giá Vốn</th>
                                            <th>Số Lượng Xe</th>
                                            <th>Số Tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            SoLuong += item.SoLuong.Value;
                                            TongTien += item.SoTien;
                                        <tr>
                                            <td>@i</td>
                                            <td>@item.MaLoaiXe</td>
                                            <td>@item.TenLoai</td>
                                            <td class="number2">@TNK.Core.Common.ToCurrencyString(item.GiaVon)</td>
                                            <td>@item.SoLuong</td>
                                            <td class="number2">@TNK.Core.Common.ToCurrencyString(item.SoTien)</td>
                                        </tr>
                                            i++;
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td colspan="4"><b style="text-align:center">TỔNG CỘNG</b></td>
                                            <td><span style="color:red"><b>@SoLuong</b></span></td>
                                            <td><span style="color:red"><b>@TNK.Core.Common.ToCurrencyString(TongTien)</b></span></td>
                                        </tr>
                                    </tfoot>
                                </table>
                                <div class="right">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-md-12 col-sm-12 col-xs-12">
    </div>
    <div class="clearfix"></div>
</div>
