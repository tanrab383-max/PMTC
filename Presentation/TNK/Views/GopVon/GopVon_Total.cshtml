@section scripts
{
    <script src="~/Scripts/IndexCommon.js"></script>
    <script>
        $(document).ready(function () {
            @*if(@str != "")
            {
                alert(@str);
            }*@
        });
        var p = 1;
        $("#searchDSDotGopVon").click(function () {
            debugger;
            var $this = $(this);
            $this.button('loading');
            setTimeout(function () {
                $this.button('reset');
            }, 300);
            Search(this);
        })
        $("#searchDSDotRutVon").click(function () {
            debugger;
            var $this = $(this);
            $this.button('loading');
            setTimeout(function () {
                $this.button('reset');
            }, 300);
            Search_RutVon(this);
        })
        $("#searchThuGopVon").click(function () {
            debugger;
            var $this = $(this);
            $this.button('loading');
            setTimeout(function () {
                $this.button('reset');
            }, 300);
            SearchTGV(this);
        })
        $("#searchRutVon").click(function () {
            debugger;
            var $this = $(this);
            $this.button('loading');
            setTimeout(function () {
                $this.button('reset');
            }, 300);
            SearchRutVon(this);
        })
        function change() {
            p = 1;
        }
        function DanhSach() {
            debugger;
            var from = $("#ngayFrom").val();
            var to = $("#ngayTo").val();
            $.ajax({
                url: "/GopVon/HistoryGV",
                type: "POST",
                dataType: "json",
                data: { From: from, To: to },
                success: function (result) {
                    var html = "";
                    if(result != null)
                    {
                        $("#DSDotGopVon").empty();
                        for(var i = 0; i < result.length;i++)
                        {
                            var j = i + 1;
                            html +="<tr>";
                            html += "<td>" + j + "</td>";
                            html += "<td>" + result[i].NgayGopVon + "</td>";
                            html += "<td>" + result[i].MaKhoiTao + "</td>";
                            html += "<td>" + result[i].TenKhoiTao + "</td>";                                                  
                            
                            html += "<td><a href='/GopVon/XemCTGV/" + result[i].MaKhoiTao + "'><i class='fa fa-eye'></i></a> ";
                            html += "<a href='#' onclick=DeleteChiTietDotGopVon('" + result[i].MaKhoiTao + "');><i class='fa fa-remove'></i></a>";
                            html += "</td> ";
                            //html +="<td><a href='#' onclick=Delete('" +result[i.MaKhoiTao +"');><i class='fa fa-remove'></i></a></td>";
                            html += "</tr>";
                        }
                        $("#DSDotGopVon").append(html);
                    }
                }
            });
        }
        function DanhSach_RutVon() {
            debugger;
            var from = $("#ngayFrom_RutVon").val();
            var to = $("#ngayTo_RutVon").val();
            $.ajax({
                url: "/GopVon/HistoryRutVon",
                type: "POST",
                dataType: "json",
                data: { From: from, To: to },
                success: function (result) {
                    var html = "";
                    if (result != null) {
                        $("#DSDotRutVon").empty();
                        for (var i = 0; i < result.length; i++) {
                            var j = i + 1;
                            html += "<tr>";
                            html += "<td>" + j + "</td>";
                            html += "<td>" + result[i].NgayGopVon + "</td>";
                            html += "<td>" + result[i].TenKhoiTao + "</td>";
                            html += "<td><a href='/GopVon/XemCTGV/" + result[i].MaKhoiTao + "'><i class='fa fa-eye'></i></a>";
                            html += "<a href='#' onclick=DeleteChiTietDotGopVon('" + result[i].MaKhoiTao + "');><i class='fa fa-remove'></i></a>";
                            html += "</td>"
                            html += "</tr>";
                        }
                        $("#DSDotRutVon").append(html);
                    }
                }
            });
        }
        function DanhSachTGV() {
            debugger;
            var from = $("#TGV_from").val();
            var to = $("#TGV_to").val();
            var doitac = $("#doiTac").val();
            var query = $("#query").val();
            $.ajax({
                url: "/GopVon/DSThuGV",
                type: "POST",
                dataType: "json",
                data: { From: from, To: to,DoiTac : doitac,Query : query },
                success: function (result) {
                        var html = "";
                        if (result != null) {
                        $("#DSThuGopVon").empty();
                        for (var i = 0; i < result.length; i++) {
                            debugger;
                            var j = i + 1;
                            html += "<tr>";
                            html += "<td>"+j+"</td>";
                            html += "<td>" +result[i].SoChungTu +"</td>";
                            html += "<td>" +result[i].NgayThu+"</td>";
                            html += "<td>" + result[i].TongCong+ "</td>";
                            html += "<td>" +result[i].TenDoiTac+"</td>";
                            html += "<td>" +result[i].GhiChu+"</td>";
                            html += "<td><a href='' onclick="+"DeletePTGopVon('"+result[i].MaPhieuThu+"')"+"><i class='fa fa-remove'></i></a></td>";
                            html += "</tr>";
                        }
                        $("#DSThuGopVon").append(html);
                                    }
                                }
                            });
        }
        function DanhSachDSRutVon() {
            debugger;
            var from = $("#from_DSRV").val();
            var to = $("#to_DSRV").val();
            var doitac = $("#doiTac_DSRV").val();
            var query = $("#query_DSRV").val();
            $.ajax({
                url: "/GopVon/DSRutVon",
                type: "POST",
                dataType: "json",
                data: { From: from, To: to, DoiTac: doitac, Query: query },
                success: function (result) {
                    var html = "";
                    if (result != null) {
                        $("#DSRutVon").empty();
                        for (var i = 0; i < result.length; i++) {
                            debugger;
                            var j = i + 1;
                            html += "<tr>";
                            html += "<td>" + j + "</td>";
                            html += "<td>" + result[i].SoChungTu + "</td>";
                            html += "<td>" + result[i].NgayThu + "</td>";
                            html += "<td>" + result[i].TongCong + "</td>";
                            html += "<td>" + result[i].TenDoiTac + "</td>";
                            html += "<td>" + result[i].GhiChu + "</td>";
                            html += "<td><a href='' onclick=" + "DeletePCRutVon('" + result[i].MaPhieuChi + "')" + "><i class='fa fa-remove'></i></a></td>";
                            html += "</tr>";
                        }
                        $("#DSRutVon").append(html);
                    }
                }
            });
        }
        function Search(obj) {
            debugger;
            DanhSach();
        $(obj).val("Tìm kiếm");
        $(obj).prop('disabled', false);

        }
        function Search_RutVon(obj) {
            debugger;
            DanhSach_RutVon();
            $(obj).val("Tìm kiếm");
            $(obj).prop('disabled', false);

        }
        function SearchTGV(obj) {
            debugger;
            DanhSachTGV();
        $(obj).val("Tìm kiếm");
        $(obj).prop('disabled', false);

        }
        function SearchRutVon(obj) {
            debugger;
            DanhSachDSRutVon();
            $(obj).val("Tìm kiếm");
            $(obj).prop('disabled', false);

        }
                        //$.get("/GopVon/HistoryGV?from=" + from + "&to=" + to).success(function (response) {
                        //    $("#DSDotGopVon").html(response);
                        //    $(obj).val("Tìm kiếm");
                        //    $(obj).prop('disabled', false);
                        //})
