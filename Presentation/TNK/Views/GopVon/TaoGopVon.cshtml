@model TNK.Model.ChiTietGopVonModel
@{
    var DGV1 = Model.DGV;
    //var CTGV2 = ViewBag.CTGV;
    var DT2 = ViewBag.DT;
    var listDGV = Model.LstDGV;
}
<div class="page-title">
    <div class="title_left">
        <h3>@ViewBag.Title</h3>
    </div>
</div>
<div class="clearfix"></div>

<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_panel">
            <div class="x_title">
                <h2>Chi tiết khởi tạo</h2>
                <ul class="nav navbar-right panel_toolbox">
                    <li>
                        <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                    </li>
                </ul>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">
                <form id="form-data" method="post" action="@Url.Action("TaoGopVon", "GopVon")" class="form-horizontal form-label-left">
                    <div class="row">
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Ngày khởi tạo</label>
                                @Html.EditorFor(x => DGV1.NgayGopVon, new { htmlAttributes = new { @class = "form-control input-sm date", @Value = @ViewBag.Date } })
                            </div>
                        </div>
                        @*<div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Đợt góp vốn</label>
                                @Html.EditorFor(x => DGV1.MaKhoiTao, new { htmlAttributes = new { @class = "form-control input-sm" } })
                                @Html.DropDownListFor(x => DGV1.MaKhoiTao, Model.LstDGV.Select(x => new SelectListItem { Text = x.MaKhoiTao + " " + x.TenKhoiTao, Value = x.MaKhoiTao.ToString() }), "Chọn", new { @class = "select2 fullwidth" })
                            </div>
                        </div>*@
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Tên đợt góp vốn (*)</label>
                                @Html.EditorFor(x => DGV1.TenKhoiTao, new { htmlAttributes = new { @class = "form-control input-sm tenkhoitao" } })
                            </div>
                        </div>
                        <div class="col-md-12 col-sm-12 col-xs-12">

                            <div class="form-group  table-responsive">
                                <label>Danh sách góp vốn</label>
                                <table id="ThanhToan" class="table table-striped jambo_table bulk_action">
                                    <thead>
                                        <tr>
                                            <th style="width:30%">Nhà đầu tư</th>
                                            <th style="width:20%">Số tiền</th>
                                            <th style="width:15%">Tỷ lệ(%)</th>
                                            <th style="width:20%">Tổng cộng tiền</th>
                                            <th style="width:15%">Tỷ lệ đợt góp vốn trước(%)</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbody">
                                        @for (int j = 0; j < ViewBag.ListTongHop.Rows.Count; j++)
                                        {
                                            <tr id="tr" class="animated fadeIn">
                                                <td>
                                                    <select class="select2 fullwidth MaDoiTac" name="CTGV1[@j].MaDoiTac">
                                                            <option value="@ViewBag.ListTongHop.Rows[j]["MaDoiTac"]" selected>
                                                                @ViewBag.ListTongHop.Rows[j]["TenDoiTac"]
                                                            </option>
                                                    </select>
                                                </td>
                                                <td><input type="text" min="0" name="CTGV1[@j].SoTien"  class="form-control input-sm number" maxlength="15" /></td>
                                                <td><input type="text" min="0" name="CTGV1[@j].TyLe" class="form-control input-sm" maxlength="4" /></td>
                                                <td><input class="form-control input-sm number" value="@TNK.Core.Common.ToCurrencyString(ViewBag.ListTongHop.Rows[j]["SoTienGop"])"/></td>
                                                <td><input class="form-control input-sm" value="@ViewBag.ListTongHop.Rows[j]["TyLe"]" /></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="form-group center">
                        <div class="col-md-6 col-sm-6 col-xs-12 col-md-offset-3">
                            <input type="submit" name="submit" value="Lưu" class="btn btn-success" />
                            @*<input type="submit" value="Lưu" onclick="SetSubmitType('Save');" class="btn btn-success Save" />*@
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <a href="/GopVon/GopVon_Total">Quay lại</a>
</div>
@section scripts
{
    <script src="~/Scripts/IndexCommon.js"></script>
    <script src="~/Scripts/ThuGopVon.js"></script>
    <script type="text/javascript">
        var i = '@Model.CTGV.Count';
        $(".addHTTT").click(function () {
            var html = tr.split("CTGV1[0]").join("CTGV1[" + i + "]");
            @if (Model.CTGV.Count > 0)
            {
             @*@Html.Raw("html=html.replace('" + Model.CTGV[0].Id + "','');")*@
             @Html.Raw("html=html.replace('" + Model.CTGV[0].SoTien + "','');")
             @Html.Raw("html=html.replace('" + Model.CTGV[0].SoTienThucTe + "','');")
             @Html.Raw("html=html.replace('selected','');")
                ////@Html.Raw("html=html.replace('" + Model.CTPT[0].SoThamChieu + "','');")
            }
            $("#tbody").append("<tr>" + html + "</tr>");
            i++;
            setTimeout(function () {
                $('.select2').select2({
                    placeholder: "Select an option",
                    allowClear: true
                });
                removeSelect();
            }, 200);
        })
        function Remove(a) {
            var tr = $(a.closest("tr"));
            tr.find(".IsDeleted").val("true");
            tr.html(tr.html().split("required").join(""));
            tr.hide();
        }
        $("#form-data").submit(function () {
            debugger;
            let flag = true;
            $("#tbody").find("tr").map(function (key, val) {
                if ($(val).is(":visible")) {
                    var tuitien = $(val).find(".Temp").select2('val');
                    var sotien = $(val).find(".number").val().split(",").join("");
                    tuitien = tuitien == "Chọn" ? "" : tuitien;
                    sotien = sotien == "" ? 0 : parseInt(sotien);
                    //if (tuitien != "" && sotien === 0) {
                    //    toastWarning("Vui lòng nhập số tiền.");
                    //    $(val).find(".number").focus();
                    //    flag = false;
                    //    return;
                    //}
                    //if (tuitien == "" && sotien != 0) {
                    //    toastWarning("Vui lòng nhập tên đối tác.");
                    //    $(val).find(".Temp").focus();
                    //    flag = false;
                    //    return;
                    //}
                }
            })
            if ($(".tenkhoitao").val() == "") {
                toastWarning("Vui lòng nhập tên khởi tạo.");
                return false;
            }
            if (!flag) {
                return false;
            }
            var lst = $(".number");
            lst.map(function (key, val) {
                $(val).val($(val).val().split(",").join(""));
            });
        });

        $("#txtSoPhieu").focusout(function () {
            GetInfoTicket();
        })

        function KeyEnter(e) {
            if (e.keyCode == 13) {
                GetInfoTicket();
            }
        }
        $(".number").map(function (key, val) {
            var val = $(this).val();
            if (val != "") {
                val = val.split(",").join("");
                val = parseInt(val);
                if (isNaN(val))
                    val = 0;
                $(this).val(val.toLocaleString('en-us'));
            }
        })
        $(document).on("keypress", ".date", function () {
            return false;
        });
        $(document).on("change", ".number", function () {
            var val = $(this).val();
            val = val.split(",").join("");
            val = parseInt(val);
            if (isNaN(val))
                val = 0;
            $(this).val(val.toLocaleString('en-us'));
        });
    </script>

}
