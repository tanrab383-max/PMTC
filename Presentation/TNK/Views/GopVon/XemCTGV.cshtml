@model TNK.Model.ChiTietGopVonModel
@{
    var DGV1 = Model.DGV;
    var CTGV2 = Model.CTGV;
    var DT2 = Model.DT;
}
<div class="page-title">
    <div class="title_left">
        <h3>@ViewBag.Title</h3>
    </div>
</div>
<div class="clearfix"></div>

<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_panel">
            <div class="x_title">
                <h2>Chi tiết khởi tạo</h2>
                <ul class="nav navbar-right panel_toolbox">
                    <li>
                        <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                    </li>
                </ul>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">
                <form id="form-data" method="post" action="@Url.Action("TaoGopVon", "GopVon")" class="form-horizontal form-label-left">
                    <div class="row">
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Ngày khởi tạo</label>
                                @*<input type="text" class="form-control input-sm date" name="DGV.NgayGopVon" value="@ViewBag.Date"  />*@
                                @Html.EditorFor(x => DGV1.NgayGopVon, new { htmlAttributes = new { @class = "form-control input-sm date", @Value = @ViewBag.Date } })
                            </div>
                        </div>
                        @*<div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Tên khởi tạo</label>
                                @*<input type="text" class="form-control input-sm tenkhoitao" name="DGV.TenKhoiTao" />
                                Html.EditorFor(x => DGV1.TenKhoiTao, new { htmlAttributes = new { class = "form-control input-sm tenkhoitao" } })
                            </div>
                        </div>*@
                        <div class="col-md-12 col-sm-12 col-xs-12">

                            <div class="form-group  table-responsive">
                                <label>Danh sách góp vốn</label>
                                <table id="ThanhToan" class="table table-striped jambo_table bulk_action">
                                    <thead>
                                        <tr>
                                            <th style="width:30%">Nhà đầu tư</th>
                                            <th style="width:20%">Số tiền</th>
                                            <th style="width:15%">Tỷ lệ</th>
                                            <th style="width:20%">Số tiền trước đây</th>
                                            <th style="width:15%">Tỷ lệ trước đây</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbody">
                                        @{
                                            var count = CTGV2.Count;
                                        }
                                        @for (int j = 0; j < count; j++)
                                        {
                                            <tr id="tr" class="animated fadeIn">
                                                <td>
                                                    @*<input type="hidden" name="CTGV1[@j].ID" value="@CTGV2[j].MaChiTiet" />*@
                                                    <select class="select2 fullwidth MaDoiTac" name="CTGV1[@j].MaDoiTac">
                                                        <option value="">Chọn</option>
                                                        @foreach (var i in DT2)
                                                        {
                                                            <option value="@i.madoitac" @(CTGV2[j].MaDoiTac == i.madoitac ? "selected" : "")>@i.TenDoiTac</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td><input type="text" name="CTGV1[@j].SoTien" value="@CTGV2[@j].SoTien" class="form-control input-sm number" maxlength="15" /></td>
                                                <td><input value="@CTGV2[@j].TyLe" name="CTGV1[@j].TyLe" class="form-control input-sm" maxlength="4" /></td>
                                                @if (CTGV2[@j].SoTienDotTruoc == 0)
                                                {
                                                    <td><input type="text" value="@CTGV2[@j].SoTienDotTruoc" name="CTGV1[@j].SoTienDotTruoc" class="form-control input-sm number" maxlength="15" /></td>
                                                }
                                                else
                                                {
                                                    <td><input type="text" value="@CTGV2[@j].SoTienDotTruoc" name="CTGV1[@j].SoTienDotTruoc" class="form-control input-sm number" maxlength="15" /></td>
                                                }
                                                <td><input value="@CTGV2[@j].TyLeDotTruoc" class="form-control input-sm number" maxlength="4" /></td>
                                                <td>
                                                    <input type="hidden" class="IsDeleted" name="CTGV1[@j].IsDeleted" value="false" />
                                                </td>
                                                @*<td class="right"><a href="/GopVon/PhieuThuGopVonCreate/@CTGV2[j].Id"><input class="btn btn-success" type="button" value="Thu" /></a></td>*@
                                                @*<td><i class="fa fa-remove" onclick="Remove(this)" style="cursor:pointer"></i></td>*@
                                            </tr>
                                        }
                                    </tbody>
                                    @*<tfoot>
                                        <tr>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td class="right"><i class="fa fa-plus addHTTT" style="cursor:pointer"></i></td>
                                        </tr>
                                    </tfoot>*@
                                </table>
                            </div>
                        </div>
                    </div>
                    @*<div class="form-group center">
                        <div class="col-md-6 col-sm-6 col-xs-12 col-md-offset-3">
                            <input type="submit" name="submit" value="Lưu" class="btn btn-success" />
                            <input type="submit" value="Lưu" onclick="SetSubmitType('Save');" class="btn btn-success Save" />
                        </div>
                    </div>*@
                </form>
            </div>
        </div>
    </div>
<a class="Back" href="/GopVon/GopVon_Total">Quay lại</a>
</div>
@section scripts
{
    <link href="~/assests/plugins/select2/select2.css" rel="stylesheet" />
    <link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <script src="~/Scripts/jquery-ui.js"></script>
    <script src="~/assests/plugins/select2/select2.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/ThuGopVon.js"></script>
    <script type="text/javascript">
        var i = '@CTGV2.Count';
        $(".addHTTT").click(function () {
            var html = tr.split("httt[0]").join("httt[" + i + "]");
            @if (CTGV2.Count > 0)
            {
             @*@Html.Raw("html=html.replace('" + ViewBag.CTGV[0].MaChiTiet + "','');")*@
             @Html.Raw("html=html.replace('" + CTGV2[0].SoTien + "','');")
             @Html.Raw("html=html.replace('" + CTGV2[0].SoTienThucTe + "','');")
             @Html.Raw("html=html.replace('selected','');")
                ////@Html.Raw("html=html.replace('" + Model.CTPT[0].SoThamChieu + "','');")
            }
            $("#tbody").append("<tr>" + html + "</tr>");
            i++;
            setTimeout(function () {
                $('.select2').select2({
                    placeholder: "Select an option",
                    allowClear: true
                });
                removeSelect();
            }, 200);
        })

        function SetSubmitType(value) {
            debugger;
            $("#submitType").val(value);
        }
        function Remove(a) {
            var tr = $(a.closest("tr"));
            tr.find(".IsDeleted").val("true");
            tr.html(tr.html().split("required").join(""));
            tr.hide();
        }
        function CalCoc(a) {
            setTimeout(function () {
                var stsd = $(a).val();
                stsd = stsd.split(",").join("");
                var stctsd = $(a).closest("tr").find(".SoTienCoTheSuDung").val().split(",").join("");
                if (stctsd - stsd < 0) {
                    toastError("Số tiền sử dụng cọc không được lớn hơn số tiền có thể sử dụng.Vui lòng nhập lại.");
                    $(a).focus();
                    $(a).val(0);
                    $(a).closest("tr").find(".ConLai").val(stctsd);
                }
                else
                    $(a).closest("tr").find(".ConLai").val((stctsd - stsd).toLocaleString('en-us'));
            }, 100);
            Cal();
        }
        function Cal() {
            setTimeout(function () {
                debugger;
                var result = total;
                $(".SoTienThanhToan").map(function (key, val) {
                    if ($(val).is(":visible")) {
                        var num = $(val).val().split(",").join("");
                        result = result - num;
                    }
                });
                var tienThanhToan = 0;
                $("#tbody").find("tr").map(function (key, val) {
                    if ($(val).is(":visible")) {
                        var isDeleted = $(val).find(".IsDeleted").val();
                        if (isDeleted != "true") {
                            var sotien = parseInt($(val).find(".number").val().split(",").join(""));
                            if (isNaN(sotien))
                                sotien = 0;
                            tienThanhToan += sotien;
                        }
                    }
                });
                $(".Total").html(tienThanhToan.toLocaleString('en-us'));
                $("#NPT_SoTienNo").val(result);
            }, 100);
        }
        //bắt validate


        $("#form-data").submit(function () {
            debugger;
            let flag = true;
            $("#tbody").find("tr").map(function (key, val) {
                if ($(val).is(":visible")) {
                    var tuitien = $(val).find(".Temp").select2('val');
                    var sotien = $(val).find(".number").val().split(",").join("");
                    tuitien = tuitien == "Chọn" ? "" : tuitien;
                    sotien = sotien == "" ? 0 : parseInt(sotien);
                    if (tuitien != "" && sotien === 0) {
                        toastWarning("Vui lòng nhập số tiền.");
                        $(val).find(".number").focus();
                        flag = false;
                        return;
                    }
                    if (tuitien == "" && sotien != 0) {
                        toastWarning("Vui lòng nhập tên đối tác.");
                        $(val).find(".Temp").focus();
                        flag = false;
                        return;
                    }
                }
            })
            if ($(".tenkhoitao").val() == "") {
                toastWarning("Vui lòng nhập tên khởi tạo.");
                return false;
            }
            if (!flag) {
                return false;
            }
            //if (CheckValidatePhieuBanXe() == false)
            //    return false;
            //if (CheckValidateThongTinNguoiThanhToan_PhieuThu() == false)
            //    return false;
            var lst = $(".number");
            lst.map(function (key, val) {
                $(val).val($(val).val().split(",").join(""));
            });
        });

        $("#txtSoPhieu").focusout(function () {
            GetInfoTicket();
        })

        function KeyEnter(e) {
            if (e.keyCode == 13) {
                GetInfoTicket();
            }
        }
        $(".number").map(function (key, val) {
            var val = $(this).val();
            if (val != "") {
                val = val.split(",").join("");
                val = parseInt(val);
                if (isNaN(val))
                    val = 0;
                $(this).val(val.toLocaleString('en-us'));
            }
        })
        $(document).on("keypress", ".date", function () {
            return false;
        });
        $(document).on("change", ".number", function () {
            var val = $(this).val();
            val = val.split(",").join("");
            val = parseInt(val);
            if (isNaN(val))
                val = 0;
            // val = val * 1000;
            $(this).val(val.toLocaleString('en-us'));
        });
        $(document).on("keypress", ".number", function ($event) {
            return ($event.charCode >= 48 && $event.charCode <= 57) || $event.charCode == 0;
        });
        $(document).on("focus", ".number", function () {
            var tr = $(this).closest("tr");
            var temp = tr.find(".Temp").val();
        });
    </script>

}
