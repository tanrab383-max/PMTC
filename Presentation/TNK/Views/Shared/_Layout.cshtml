    @if (ViewBag.Warning != null && ViewBag.Warning != "")
    {
        <script>

            toastWarning('@ViewBag.Warning');
        </script>
    }
    @if (ViewBag.Alert != null && ViewBag.Alert != "")
    {
        <script>

            toastWarning('@ViewBag.Alert');
        </script>
    }
    else if (TempData["Alert"] != null && TempData["Alert"].ToString() != "")
    {
        <script>

            toastError('@TempData["Alert"]');
        </script>
    }

    @if (ViewBag.Error != null && ViewBag.Error != "")
    {
        <script>

            toastError('@ViewBag.Error');
        </script>
    }
    else if (TempData["Error"] != null && TempData["Error"].ToString() != "")
    {
        <script>

            toastError('@TempData["Error"]');
        </script>
    }
    @if (ViewBag.Info != null && ViewBag.Info != "")
