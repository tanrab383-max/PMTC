    @RenderSection("scripts", false)
    <script>
        $("form").submit(function () {
            $("input[type=submit]").hide();
            setTimeout(function () {
                $("input[type=submit]").show();
            }, 3000);
            //$(".nav side-menu").hide();
        })
        $(window).keydown(function (e) {
            //Xu ly control_s: submit form
            //N:78
            //F:70
            if (e.ctrlKey && e.keyCode === 66) {//ctrl+b back về
                document.location = $(".Back").attr("href");
            }
            // e.preventDefault();
            if (e.ctrlKey && e.keyCode === 83) {
                //   alert("CTL_S"); save lại
                $("#form-data").submit();
                return false;
            }
            //CTRL_F
            if (e.ctrlKey && e.keyCode === 70) {
                // alert("CTL_F"); tìm kiếm
                $("#formSearch").submit();
                return false;
            }
            //CTRL_N
            if (e.ctrlKey && e.keyCode === 65) {
                //  alert("CTL_N"); tạo mới
                e.preventDefault();
                $(".addNew").click();

                return false;
            }
            return true;

        })
    </script>
