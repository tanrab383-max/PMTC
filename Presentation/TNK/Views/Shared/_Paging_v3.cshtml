<script src="~/Scripts/jquery-1.10.2.js"></script>
<script>
    functionNames = [];
    $(document).ready(function () {
        idTab = "";
        var total = '@(ViewBag.Total)';
        var pageSizes = document.getElementById('@("pageSize"+ Controller)');
        var tabsActive = $('.nav-tabs .active');
        if (tabsActive.length>0)
            idTab = tabsActive[0].querySelectorAll("a")[0].hash;
        if (total == 0 && (idTab === '#tab_0' || idTab == ""))
            pageSizes.disabled = true;
        for (var obj in window) {
            if (!/webkitStorageInfo|webkitIndexedDB/.test(obj) && window.hasOwnProperty(obj) && typeof window[obj] === 'function')
                functionNames.push(obj)
        };
        functionNames = functionNames.filter(s => s.includes("Search"));
    });
    function changeFunc() {
        idTab = "";
        var pageSizes = document.getElementById('@("pageSize"+ Controller)');
        var tabs = $('.nav-tabs .active');
        if (tabs.length > 0)
            idTab = $('.nav-tabs .active')[0].querySelectorAll("a")[0].hash;
        debugger
        if (idTab === '#tab_0' || idTab == "") {
            var href = $('.pagination span.redColor')[0].querySelector("a").href;
            var href_sub = href.substring(0, href.indexOf("&pageSize"));
            var link = href_sub + '&pageSize=' + pageSizes.value;
            pageSizes.value = '@(ViewBag.PageSize)';
            var linkC = link.replace(/&amp;/g, '&');
            window.location.href = linkC;
        }
        else if (idTab === '#tab_1') {
            Search();
            @*pageSizes.value = '@(ViewBag.PageSize)';*@
        }
        else {
            window[functionNames[2]]();
            pageSizes.value = '@(ViewBag.PageSize)';
        }
    }
    function GetData(pageIndex, pageSize) {
        debugger
        var url = '@ViewBag.Url' + pageIndex + "&pageSize=" + pageSize;
        var pageSizes = document.getElementById('@("pageSize"+ Controller)');
        // Tìm tbody gần nhất dựa trên pageSizes
        var tbody = $(pageSizes).closest('.table-responsive').find('table tbody').prevObject;

        url = url.replaceAll('amp;', '');
        $.get(url).success(function (response) {
            if (tbody.length > 0) {
                tbody.html(response);

                tbody.find(".number2").map(function () {
                    var val = $(this).html();
                    if (val !== "") {
                        val = val.split(",").join("");
                        val = parseInt(val);
                        $(this).html(val.toLocaleString());
                    }
                });
            }
            else {
                $("#tbody").html(response);
                $("#tbody").find(".number2").map(function (key, val) {
                    var val = $(this).html();
                    if (val != "") {
                        val = val.split(",").join("");
                        val = parseInt(val);
                        $(this).html(val.toLocaleString());
                    }
                })
            }
           
            $(obj).val("Tìm kiếm");
            $(obj).prop('disabled', false);

        })
    }
</script>