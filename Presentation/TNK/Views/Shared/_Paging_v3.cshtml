@{
    int pageCount = (int)Math.Ceiling(Convert.ToDouble(ViewBag.Total) / Convert.ToDouble(ViewBag.PageSize));
    string LinkText = ViewBag.Url;
    string Controller = @HttpContext.Current.Request.RequestContext.RouteData.Values["action"].ToString();
    int PageSize = ViewBag.PageSize;
    int CurrentPageNumber = ViewBag.PageIndex;
}
@if (LinkText.ToLower().Contains("thunocomplete") || LinkText.ToLower().Contains("temp"))
{

    <ul class="pagination">
        <li>
            <span class="redColor">
                <a href="@(LinkText + 1 + "&pageSize=" + PageSize)"></a>
                <select id="@("pageSize" + Controller)" onchange="changeFunc()">
                    <option value="30" @(PageSize == 30 ? "selected" : "")>30 dòng</option>
                    <option value="50" @(PageSize == 50 ? "selected" : "")>50 dòng</option>
                    <option value="100" @(PageSize == 100 ? "selected" : "")>100 dòng</option>
                    <option value="200" @(PageSize == 200 ? "selected" : "")>200 dòng</option>
                    <option value="1000000000" @(PageSize == 1000000000 ? "selected" : "")>Tất cả</option>
                </select>
            </span>
        </li>
        <li><span class="redColor">Tìm thấy <b>@ViewBag.Total</b> dòng</span></li>
    </ul>
    if (pageCount > 1)
    {
        <ul class="pagination">

            @if (CurrentPageNumber > 1 && !Request.Browser.IsMobileDevice)
            {
                <li><a class="redColor" onclick="GetData( 1, @PageSize)" title="Trang 1"><i class="glyphicon glyphicon-backward red"></i></a></li>
                <li><a class="redColor" onclick="GetData( (@CurrentPageNumber - 1), @PageSize)"><i class="glyphicon glyphicon-step-backward red"></i></a></li>
            }
            @if (!Request.Browser.IsMobileDevice)
            {
                <li><span>Trang</span></li>
            }
            @if (CurrentPageNumber <= 4)
            {
                for (int i = 1; i <= 7 && i <= pageCount; i++)
                {
                    if (i == CurrentPageNumber)
                    {
                        <li class="active"><a class="redColor" onclick="GetData(@i, @PageSize)"><span>@i</span></a></li>
                    }
                    else
                    {
                        <li><a class="redColor" onclick="GetData(@i, @PageSize)"><span>@i</span></a></li>
                    }
                }
            }
            else if (CurrentPageNumber >= pageCount - 3)
            {
                for (int i = pageCount > 6 ? pageCount - 6 : 1; i <= pageCount; i++)
                {
                    if (i == CurrentPageNumber)
                    {
                        <li class="active"><a class="redColor" onclick="GetData(@i, @PageSize)"><span>@i</span></a></li>
                    }
                    else
                    {
                        <li><a class="redColor" onclick="GetData(@i, @PageSize)"><span>@i</span></a></li>
                    }
                }
            }
            else
            {
                for (int i = CurrentPageNumber - 3; i <= CurrentPageNumber + 3; i++)
                {
                    if (i == CurrentPageNumber)
                    {
                        <li class="active"><a class="redColor" onclick="GetData(@i, @PageSize)"><span>@i</span></a></li>
                    }
                    else
                    {
                        <li><a class="redColor" onclick="GetData(@i, @PageSize)"><span>@i</span></a></li>
                    }
                }
            }

            @if (CurrentPageNumber < pageCount - 4)
            {
                <li><span>....</span></li>
                <li><a class="redColor" onclick="GetData(@pageCount, @PageSize)"><span>@pageCount</span></a></li>
            }
            @if (CurrentPageNumber < pageCount && !Request.Browser.IsMobileDevice)
            {
                <li><a class="redColor" onclick="GetData((@CurrentPageNumber + 1), @PageSize)" href="@(LinkText + (CurrentPageNumber + 1) + "&pageSize=" + PageSize)"><i class="glyphicon glyphicon-step-forward red"></i></a></li>
                <li><a class="redColor" onclick="GetData(@pageCount, @PageSize)" title="Trang cuối"><i class="glyphicon glyphicon-forward red"></i></a></li>
            }
        </ul>
    }
}
