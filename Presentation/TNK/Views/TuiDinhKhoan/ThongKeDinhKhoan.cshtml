@model List<TNK.Core.Domain.TuiDinhKhoan>
@{
    ViewBag.Title = "Thống kê định khoản";
    var item = Model;
    var Total1234 = ViewBag.Total1 - ViewBag.Total2;
    //double Tien = 0, Vay = 0, TaiSan = 0, NguonVon = 0;
}
