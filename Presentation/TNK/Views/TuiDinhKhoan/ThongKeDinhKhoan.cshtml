<div class="page-title" >
    <div class="title" style="float:left">
        <h3>@ViewBag.Title </h3>
    </div>
</div>
<br />
<br />
<div class="clearfix">
    <div>
        <label style="color:dimgray;font-size:20px;margin-left:-6%">(1) + (2) = @TNK.Core.Common.ToCurrencyString(ViewBag.Total1)</label>
        @if (Total1234 < 1000)
        {
            <label style="color:blue;font-size:20px;margin-left:15%">@TNK.Core.Common.ToCurrencyString(Total1234)</label>
        }
        else
        {
            <label style="color:red;font-size:20px;margin-left:15%">@TNK.Core.Common.ToCurrencyString(Total1234)</label>
        }
        <label style="color:dimgray;font-size:20px;margin-left:15%">(3) + (4) = @TNK.Core.Common.ToCurrencyString(ViewBag.Total2)</label>
    </div>
</div>
<div class="col-md-3 col-sm-3 col-xs-12">
        <div class="x_panel">
            <div class="x_title">
                        <h4 style="text-align:center">
                            @ViewBag.TitleTien <br />
                            (@TNK.Core.Common.ToCurrencyString(ViewBag.Tien))
                        </h4>
                        <ul class="nav navbar-right panel_toolbox">
                            <li>
                                <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                            </li>
                        </ul>
                        <div class="clearfix"></div>
                </div>
                <div class="x_content">
                    <div class="table-responsive">
                        <div class="tree_tien jstree_tien jstree-1 jstree-default" role="tree" aria-activedescendant="node_1016">
                        </div>
                    </div>
            </div>
            </div>
    </div>

<div class="col-md-3 col-sm-3 col-xs-12">
    <div class="x_panel">
        <div class="x_title">
            <h4 style="text-align:center">@ViewBag.TitleTAISAN <br />
            (@TNK.Core.Common.ToCurrencyString(ViewBag.Taisan))</h4>
            <ul class="nav navbar-right panel_toolbox">
                <li>
                    <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                </li>
            </ul>
            <div class="clearfix"></div>
        </div>
        <div class="x_content">
            <div class="table-responsive">
                <div class="tree_taisan tree_taisan jstree-1 jstree-default" role="tree">
                </div>
            </div>
        </div>
    </div>
</div>

<div class="col-md-3 col-sm-3 col-xs-12">
    <div class="x_panel">
        <div class="x_title">
            <h4 style="text-align:center">
                @ViewBag.TitleVAY <br />
            (@TNK.Core.Common.ToCurrencyString(ViewBag.Vay))
        </h4>
        <ul class="nav navbar-right panel_toolbox">
            <li>
                <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
            </li>
        </ul>
        <div class="clearfix"></div>
    </div>
    <div class="x_content">
        <div class="table-responsive">
            <div class="tree_vay jstree_vay jstree-1 jstree-default" role="tree">
            </div>
        </div>
    </div>
</div>
</div>

<div class="col-md-3 col-sm-3 col-xs-12">
    <div class="x_panel">
        <div class="x_title">
            <h4 style="text-align:center">@ViewBag.TitleNV <br />
            (@TNK.Core.Common.ToCurrencyString(ViewBag.Nguonvon))</h4>
            <ul class="nav navbar-right panel_toolbox">
                <li>
                    <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                </li>
            </ul>
            <div class="clearfix"></div>
        </div>
        <div class="x_content">
            <div class="table-responsive">
                <div class="tree_nguonvon tree_nguonvon jstree-1 jstree-default" role="tree">
                </div>
            </div>
        </div>
    </div>
</div>





