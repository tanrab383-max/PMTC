                                    <td class="number">@row["SoLuongTonKhoCuoiKy"].ToString().Replace(",", ".")</td>
                                    <td class="number">@Math.Round(Convert.ToDouble(row["TongTienTonKhoCuoiKy"])).ToString().Replace(",", ".")</td>
                                </tr>
                            }
                        }
                    }
