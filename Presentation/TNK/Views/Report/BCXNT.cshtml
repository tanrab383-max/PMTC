                                    </tr>

                                }

                            }
                            else
                            {
                                <tr class="even pointer" >
                                    <td group="@row["MaModel"]">@row["TenModel"]</td>
                                    <td group="@row["MaModel"]">@row["MaModel"]</td>
                                    <td group="@row["MaModel"]@row["MaMau"]">@row["TenMau"]</td>
                                    <td group="@row["MaModel"]@row["MaMau"]">@row["MaMau"]</td>
                                    <td group="@row["MaModel"]@row["MaMau"]">@row["XuatXu"]</td>
                                    <td class="number" group ="@row["MaModel"]@row["MaMau"]@row["GiaVon"]">@row["GiaVon"].ToString().Replace(",", ".")</td>
                                    <td class="number">@row["SoLuongTonKhoDauKy"].ToString().Replace(",", ".")</td>
                                    <td class="number">@row["TongTienTonKhoDauKy"].ToString().Replace(",", ".")</td>
