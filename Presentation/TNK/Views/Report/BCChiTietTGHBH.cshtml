
@using System.Data;
<div class="x_content">
    <div id="BCChiTietTGHBH" class="table-responsive">
        <table class="table table-striped table-bordered table-condensed">
            <thead>
                <tr class="headings">
                    <th colspan='17' class="tile">BÁO CÁO CHI TIẾT THU GIA HẠN BẢO HÀNH  @ViewBag.ShowRoom</th>
                </tr>
                <tr>
                    <th colspan='17' class="tile">@ViewBag.TuNgayDenNgay</th>
                </tr>
                <tr class="headings">
                    <th rowspan="2" class="column-title">STT</th>
                    <th rowspan="2" class="column-title">Ngày Thu</th>
                    <th rowspan="2" class="column-title">Mã Phiếu Thu</th>
                    <th rowspan="2" class="column-title">Công Ty Thu Hộ</th>
                    <th rowspan="2" class="column-title">Tên Khách Hàng</th>
                    <th rowspan="2" class="column-title">Số Hợp Đồng</th>
                    <th rowspan="2" class="column-title">Số Khung</th>
                    <th rowspan="2" class="column-title">Biển Số Xe</th>
                    <th rowspan="2" class="column-title">Giá Bán</th>
                    <th rowspan="2" class="column-title">Giảm Giá</th>
                    <th rowspan="2" class="column-title">Thực bán</th>
                    <th rowspan="2" class="column-title">Tiền Mặt</th>
                    <th colspan="2" class="column-title">Chuyển Khoản</th>
                    <th colspan="2" class="column-title">Cà Thẻ</th>
                    <th rowspan="2" class="column-title">Cọc sử dụng</th>
                </tr>
                <tr>
                    <th class="column-title">Số Tiền</th>
                    <th class="column-title">Ngân hàng</th>
                    <th class="column-title">Số Tiền</th>
                    <th class="column-title">Ngân hàng</th>
                </tr>
            </thead>
            <tbody>
                @{
                    double TongGiaBan = 0,
                        TongThucThu = 0,
                        TongGiamGia = 0,
                        TongTienMat = 0,
                        TongNH_CK = 0,
                        TongNH_CT = 0,
                        TongCoc = 0;
                }
                @if (Model != null)
                {

                    int intCount = 0;
                    foreach (DataRow row in (Model as DataTable).Rows)
                    {
                        TongGiaBan += row["GiaVon"].ToString() == "" ? 0 : Convert.ToDouble(row["GiaVon"]);
                        TongGiamGia += row["GiamGia"].ToString() == "" ? 0 : Convert.ToDouble(row["GiamGia"]);
                        TongThucThu += row["TongCong"].ToString() == "" ? 0 : Convert.ToDouble(row["TongCong"]);
                        TongTienMat += row["TienMat"].ToString() == "" ? 0 : Convert.ToDouble(row["TienMat"]);
                        TongNH_CK += row["NH_ChuyenKhoan"].ToString() == "" ? 0 : Convert.ToDouble(row["NH_ChuyenKhoan"]);
                        TongNH_CT += row["NH_CaThe"].ToString() == "" ? 0 : Convert.ToDouble(row["NH_CaThe"]);
                        TongCoc += row["COC_SuDungCoc"].ToString() == "" ? 0 : Convert.ToDouble(row["COC_SuDungCoc"]);
                        <tr class="even pointer">
                            <td>@(++intCount)</td>
                            <td>@row["NgayThu"]</td>
                            <td>@row["MaPhieuThu"].ToString()</td>
                            <td>@row["TenDoiTac"].ToString()</td>
                            <td>@row["Hoten"].ToString()</td>
                            <td style="text-align:left">@row["SoHopDong"].ToString()</td>
                            <td>@row["SoKhung"].ToString()</td>
                            <td>@row["BienSo"].ToString()</td>
                            <td class="number">@row["GiaVon"].ToString().Replace(",", ".")</td>
                            <td class="number">@row["GiamGia"].ToString().Replace(",", ".")</td>
                            <td class="number">@row["TongCong"].ToString()</td>
                            <td class="number">@row["TienMat"].ToString()</td>
                            <td class="number">@row["NH_ChuyenKhoan"].ToString()</td>
                            <td>@row["NH_TenNHChuyenKhoan"].ToString()</td>
                            <td class="number">@row["NH_CaThe"].ToString()</td>
                            <td>@row["NH_TenNHCaThe"].ToString()</td>
                            <td class="number">@row["COC_SuDungCoc"].ToString()</td>
                        </tr>
                    }
                    <tr class="even pointer" style="background-color:lightblue;font-weight:bold">
                        <td colspan="8"><b>TỔNG CỘNG :</b></td>
                        <td class="number">@TongGiaBan.ToString().Replace(",", ".")</td>
                        <td class="number">@TongGiamGia.ToString().Replace(",", ".")</td>
                        <td class="number">@TongThucThu.ToString().Replace(",", ".")</td>
                        <td class="number">@TongTienMat.ToString().Replace(",", ".")</td>
                        <td class="number">@TongNH_CK.ToString().Replace(",", ".")</td>
                        <td></td>
                        <td class="number">@TongNH_CT.ToString().Replace(",", ".")</td>
                        <td></td>
                        <td class="number">@TongCoc.ToString().Replace(",", ".")</td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $("td.number").map(function (key, val) {
        var val = $(this).html();
        //val = val.replace(",", ".");
        val = val.split(",").join("");
        val = parseFloat(val);
        $(this).html(val.toLocaleString('en-us'));
    })
    $("td.numberRE").map(function (key, val) {
        var val = $(this).html();
        val = val.replace(",", ".");
        val = val.split(",").join("");
        val = parseFloat(val);
        $(this).html(val.toLocaleString('en-us'));
    })
</script>


