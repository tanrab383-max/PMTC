                    TotalGiaVonPTTT = TotalGiaVonPT + TotalGiaVonPTPK + TotalGiaVonPTTC;
                    TotalGCNTT = TotalGCN + TotalGCNPK + TotalGCNTC;
                    TotalHoaHongTaiXe_SoTienTT = TotalHoaHongTaiXe_SoTien + TotalHoaHongTaiXe_SoTienPK + TotalHoaHongTaiXe_SoTienTC;
                    TotalLoiNhuanTT = TotalLoiNhuan + TotalLoiNhuanPK + TotalLoiNhuanTC;
                }
            <tr class="even pointer" style="background-color:lightblue;font-weight:bold">
                <td colspan="6"><b>TỔNG</b></td>
                <td class="number">@TotalTongThuTT.ToString().Replace(",", ".")</td>
                <td class="number">@TotalTienMattt.ToString().Replace(",", ".")</td>
                <td class="number">@TotalNH_ChuyenKhoanTT.ToString().Replace(",", ".")</td>
                <td></td>
                <td class="number">@TotalNH_CaTheTT.ToString().Replace(",", ".")</td>
                <td></td>
                <td class="number">@TotalCOC_SuDungCocTT.ToString().Replace(",", ".")</td>
                <td class="number">@TotalCanTruCongNoTT.ToString().Replace(",", ".")</td>
                <td class="number">@TotalBaoHiem_SoTienTT.ToString().Replace(",", ".")</td>
                <td></td>
                <td></td>
                <td class="number">@TotalNo_SoTienTT.ToString().Replace(",", ".")</td>
                <td></td>
                <td class="number">@TotalGiaVonPTTT.ToString().Replace(",", ".")</td>
                <td class="number">@TotalCongLapPK.ToString().Replace(",", ".")</td>
                <td class="number">@TotalGCNTT.ToString().Replace(",", ".")</td>
                <td class="number">@TotalHoaHongTaiXe_SoTienTT.ToString().Replace(",", ".")</td>
                <td></td>
                <td class="number">@TotalLoiNhuanTT.ToString().Replace(",", ".")</td>
            </tr>
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $("td.number").map(function (key, val) {
        var val = $(this).html();
        //val = val.replace(",", ".");
        val = val.split(",").join("");
        val = parseFloat(val);
        $(this).html(val.toLocaleString('en-us'));
    })
</script>