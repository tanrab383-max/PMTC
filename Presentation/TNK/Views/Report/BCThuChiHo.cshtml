@using System.Data;
@*@if (Model != null)
{
    DataTableCollection ViewTongHop = (Model as DataTableCollection);
}*@
    <div class="x_content">
        <div id="BCThuChiHo" class="table-responsive">
            <table class="table table-striped table-bordered table-condensed">
                <thead>
                    <tr class="headings">
                        <th colspan='10' class="tile">BÁO CÁO CHI HỘ @ViewBag.ShowRoom</th>
                    </tr>
                    <tr>
                        <th colspan='10' class="tile">@ViewBag.TuNgayDenNgay</th>
                    </tr>
                    <tr class="headings">
                        <th class="column-title">STT</th>
                        <th class="column-title">NGÀY NỢ</th>
                        <th class="column-title">MÃ PHIẾU NỢ</th>
                        <th class="column-title">ĐỐI TÁC NỢ</th>
                        <th class="column-title">THÔNG TIN KHÁC</th>
                        <th class="column-title">SỐ TIỀN NỢ</th>
                        <th class="column-title">ĐÃ THANH TOÁN</th>
                        <th class="column-title">CÒN NỢ</th>
                        <th class="column-title">NGÀY THANH TOÁN</th>
                        <th class="column-title">LÝ DO CHI HỘ</th>
                        <th class="column-title">SỐ KHUNG</th>
                    </tr>

                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        DataView ViewTongHop = (Model[0] as DataTable).DefaultView;
                        foreach (DataRow row in ViewTongHop.ToTable().Rows)
                        {
                    <tr class="even pointer">
                        @if (@row["MaPhieuNo"].ToString().ToUpper() == "TỔNG CỘNG")
                        {
                            <td group="@row["MaPhieuNo"]" colspan="5" style="background-color:lightblue; color:red"><b>@row["MaPhieuNo"]</b></td>
                            <td class="number" style="background-color:lightblue; color:red">@row["SoTienNo"].ToString().Replace(",", ".")</td>
                            <td class="number" style="background-color:lightblue; color:red">@row["DaThanhToan"].ToString().Replace(",", ".")</td>
                            <td class="number" style="background-color:lightblue; color:red">@row["ConNo"].ToString().Replace(",", ".")</td>
                            <td style="background-color:lightblue; color:red"></td>
                            <td style="background-color:lightblue; color:red"></td>
                            <td style="background-color:lightblue; color:red"></td>
                        }
                        else
                        {
                            <td>@row["STT"]</td>
                            <td>@row["NgayNo"]</td>
                            <td>@row["MaPhieuNo"]</td>
                            <td>@row["TenDoiTac"]</td>
                            <td>@row["NoiDung"]</td>
                            <td class="number">@row["SoTienNo"].ToString().Replace(",", ".")</td>
                            <td class="number">@row["DaThanhToan"].ToString().Replace(",", ".")</td>
                            <td class="number">@row["ConNo"].ToString().Replace(",", ".")</td>
                            <td>@row["NgayThanhToan"]</td>
                            <td>@row["LyDoChi"]</td>
                            <td>@row["SoKhung"]</td>
                        }
                    </tr>
                        }
                    }
                </tbody>
            </table>
            <br />
            <table class="table table-striped table-bordered table-condensed">
                <thead>
                    <tr class="headings">
                        <th class="column-title"></th>
                        <th class="column-title">ĐẦU KỲ</th>
                        <th class="column-title">PHÁT SINH CHI HỘ</th>
                        <th class="column-title">THU HỘ</th>
                        <th class="column-title">CUỐI KỲ</th>
                    </tr>

                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        DataView ViewTongHop = (Model[1] as DataTable).DefaultView;
                        foreach (DataRow row in ViewTongHop.ToTable().Rows)
                        {
                            <tr class="even pointer">
                                @if (@row["LyDoChi"].ToString().ToUpper() == "TỔNG")
                                {
                                    <td group="@row["LyDoChi"]" colspan="1" style="background-color:lightblue; color:red"><b>@row["LyDoChi"]</b></td>
                                    <td class="number" style="background-color:lightblue; color:red">@row["DauKy"].ToString().Replace(",", ".")</td>
                                    <td class="number" style="background-color:lightblue; color:red">@row["PhatSinhChiHo"].ToString().Replace(",", ".")</td>
                                    <td class="number" style="background-color:lightblue; color:red">@row["ThuNo"].ToString().Replace(",", ".")</td>
                                    <td class="number" style="background-color:lightblue; color:red">@row["CuoiKy"].ToString().Replace(",", ".")</td>
                                    <td style="background-color:lightblue; color:red"></td>
                                }
                                else
                                {
                                    <td>@row["LyDoChi"]</td>
                                    <td class="number">@row["DauKy"].ToString().Replace(",", ".")</td>
                                    <td class="number">@row["PhatSinhChiHo"].ToString().Replace(",", ".")</td>
                                    <td class="number">@row["ThuNo"].ToString().Replace(",", ".")</td>
                                    <td class="number">@row["CuoiKy"].ToString().Replace(",", ".")</td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <script type="text/javascript">
        $("td.number").map(function (key, val) {
            var val = $(this).html();
            //val = val.replace(",", ".");
            val = val.split(",").join("");
            val = parseFloat(val);
            $(this).html(val.toLocaleString('en-us'));
        })
    </script>


