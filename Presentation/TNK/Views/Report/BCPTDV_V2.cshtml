                                <td class="number">@row["PhuKien_GiamGia"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["PhuKien_ThucThu"].ToString().Replace(",", ".")</td>

                                <td class="number">@row["DS_GiaBan"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["DS_GiaVon"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["DS_KhuyenMai"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["DS_GiamGia"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["DS_ThucThu"].ToString().Replace(",", ".")</td>

                                <td class="number">@row["QuaTang_GiaBan"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["QuaTang_GiaVon"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["QuaTang_KhuyenMai"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["QuaTang_GiamGia"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["QuaTang_ThucThu"].ToString().Replace(",", ".")</td>

                                <td class="number">@row["TongGiaBan"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["TongGiaVon"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["TongKhuyenMai"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["TongGiamGia"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["TongThucThu"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["GCN_ChiGCN"].ToString().Replace(",", ".")</td>
                                <td>@row["TramDV"].ToString()</td>
                            </tr>
                        }
                        else if (@row["NgayThu"].ToString().Contains("TỔNG"))
                        {
                            <tr style="background-color: lightblue;color:black; font-weight: bold">
                                <td colspan="5">@row["NgayThu"]</td>
                                <td class="number">@row["SC_GiaBan"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["SC_GiamGia"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["SC_ThucThu"].ToString().Replace(",", ".")</td>

                                <td class="number">@row["PTT_GiaBan"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["PTT_GiaVon"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["PTT_KhuyenMai"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["PTT_GiamGia"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["PTT_ThucThu"].ToString().Replace(",", ".")</td>

                                <td class="number">@row["PhuKien_GiaBan"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["PhuKien_GiaVon"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["PhuKien_KhuyenMai"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["PhuKien_GiamGia"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["PhuKien_ThucThu"].ToString().Replace(",", ".")</td>

                                <td class="number">@row["DS_GiaBan"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["DS_GiaVon"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["DS_KhuyenMai"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["DS_GiamGia"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["DS_ThucThu"].ToString().Replace(",", ".")</td>

                                <td class="number">@row["QuaTang_GiaBan"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["QuaTang_GiaVon"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["QuaTang_KhuyenMai"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["QuaTang_GiamGia"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["QuaTang_ThucThu"].ToString().Replace(",", ".")</td>

                                <td class="number">@row["TongGiaBan"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["TongGiaVon"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["TongKhuyenMai"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["TongGiamGia"].ToString().Replace(",", ".")</td>
