                                <td><b>Nợ lẻ CK</b></td>
                                <td class="number"> @ViewBag.NoLeCK.ToString().Replace(",", ".")</td>
                                <td><b>Nợ CK hãng</b></td>
                                <td class="number"> @ViewBag.NoLeCK_Hang.ToString().Replace(",", ".")</td>
                            </tr>
                            <tr>
                                <td><b>Chuyển cọc PT-PK</b></td>
                                <td class="number">@ViewBag.ChuyenCocTPHKI.ToString().Replace(",", ".") </td>
                            </tr>
                            <tr>
                                <td><b>Chuyển cọc BHTH</b></td>
                                <td class="number">@ViewBag.ChuyenCocBHTH.ToString().Replace(",", ".") </td>
                            </tr>
