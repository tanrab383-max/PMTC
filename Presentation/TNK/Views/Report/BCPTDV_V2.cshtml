                                <td class="number">@row["GCN_ChiGCN"].ToString().Replace(",", ".")</td>
                                <td>@row["TramDV"].ToString()</td>
                            </tr>
                        }
                        else
                        {
                            <tr style="background-color:orange;color:black;font-weight:bold">

                                <td colspan="45"><b> @row["NgayThu"] </b></td>

                            </tr>
                        }

                    }
                }
            </tbody>
        </table>
        <br />
