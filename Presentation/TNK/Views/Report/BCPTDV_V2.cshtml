                    <td colspan="45"><b>A - PHIẾU DỊCH VỤ</b></td>
                </tr>
                @if (ViewBag.dtbResult != null)
                {
                    foreach (DataRow row in (ViewBag.dtbResult as DataTable).Rows)
                    {
                        if (@row["NgayThu"].ToString().Contains('/'))
                        {
                            <tr class="even pointer">
                                <td>@row["Row#"]</td>
                                <td>@row["NgayThu"]</td>
                                <td>@row["SoHopDong"]</td>
                                <td>@row["BienSo"]</td>
                                <td>@row["Hoten"]</td>
