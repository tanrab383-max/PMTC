                    <th class="column-title" colspan="3">CÔNG DV</th>
                    <th class="column-title" colspan="5">PHỤ TÙNG</th>
                    <th class="column-title" colspan="5">PHỤ KIỆN</th>
                    <th class="column-title" colspan="5">VẬT TƯ SƠN</th>
                    <th class="column-title" colspan="5">QUÀ TẶNG</th>

