                                <td class="number">@ViewBag.dtTHLoiNhuanKho.Rows[3]["LoiNhuan"].ToString().Replace(",", ".")</td>
                            </tr>
                        }
                        if (ViewBag.dtTHLoiNhuanKho.Rows.Count >= 5)
                        {
                            <tr>
                                <td></td>
                                <td rowspan="2">@ViewBag.dtTHLoiNhuanKho.Rows[4]["STT"]</td>
                                <td rowspan="2">@ViewBag.dtTHLoiNhuanKho.Rows[4]["TenKho"]</td>
                                <td>DOANH THU</td>
