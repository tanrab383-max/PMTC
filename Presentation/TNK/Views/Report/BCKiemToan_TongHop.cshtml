                                <td rowspan="2">@ViewBag.dtTHLoiNhuanKho.Rows[2]["STT"]</td>
                                <td rowspan="2">@ViewBag.dtTHLoiNhuanKho.Rows[2]["TenKho"]</td>
                                <td>DOANH THU</td>
                                <td>GIÁ VỐN</td>
                                <td>LỢI NHUẬN</td>
                            </tr>
                            <tr>
                                <td></td>
                                <td class="number">@ViewBag.dtTHLoiNhuanKho.Rows[2]["DoanhThu"].ToString().Replace(",", ".")</td>
                                <td class="number">@ViewBag.dtTHLoiNhuanKho.Rows[2]["GiaVon"].ToString().Replace(",", ".")</td>
                                <td class="number">@ViewBag.dtTHLoiNhuanKho.Rows[2]["LoiNhuan"].ToString().Replace(",", ".")</td>
                            </tr>
                        }
                        if (ViewBag.dtTHLoiNhuanKho.Rows.Count >= 4)
                        {
                            <tr>
                                <td></td>
                                <td rowspan="2">@ViewBag.dtTHLoiNhuanKho.Rows[3]["STT"]</td>
                                <td rowspan="2">@ViewBag.dtTHLoiNhuanKho.Rows[3]["TenKho"]</td>
                                <td>DOANH THU</td>
                                <td>GIÁ VỐN</td>
                                <td>LỢI NHUẬN</td>
                            </tr>
                            <tr>
                                <td></td>
