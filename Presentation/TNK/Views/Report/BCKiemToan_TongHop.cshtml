                            }
                            @if (ViewBag.dtTHXuatBanXe.Rows[0]["SoLuongXeGop"].ToString() == "")
                            {
                                <td style="text-align: right;">0</td>
                            }
                            else
                            {
                                <td style="text-align: right;">@Convert.ToDouble(ViewBag.dtTHXuatBanXe.Rows[0]["SoLuongXeGop"])</td>
                            }
                            @if (ViewBag.dtTHXuatBanXe.Rows[0]["SoLuongXeTraoDoi"].ToString() == "")
                            {
                                <td style="text-align: right;">0</td>
                            }
                            else
                            {
                                <td style="text-align: right;">@Convert.ToDouble(ViewBag.dtTHXuatBanXe.Rows[0]["SoLuongXeTraoDoi"])</td>
                            }
                            <td style="text-align: right;">@Convert.ToDouble(ViewBag.dtTHXuatBanXe.Rows[0]["TongSoLuongXe"])</td>
                            <td></td>
                        </tr>
                        <tr>
                            <td hidden></td>
                            <td>GIÁ BÁN</td>
                            <td>TIỀN MẶT + NH</td>
                            <td>CHI CỌC</td>
                            <td>NỢ GÓP</td>
                            <td>NỢ</td>
                        </tr>
                        <tr>
                            <td hidden></td>
                            <td class="number">@ViewBag.dtTHXuatBanXe.Rows[0]["TongGiaBan"].ToString().Replace(",", ".")</td>
                            <td class="number">@ViewBag.dtTHXuatBanXe.Rows[0]["TongThanhToanTM_NH"].ToString().Replace(",", ".")</td>
                            <td class="number">@ViewBag.dtTHXuatBanXe.Rows[0]["TongChiCoc"].ToString().Replace(",", ".")</td>
                            <td class="number">@ViewBag.dtTHXuatBanXe.Rows[0]["NoGop"].ToString().Replace(",", ".")</td>
                            <td class="number">@ViewBag.dtTHXuatBanXe.Rows[0]["NoLe"].ToString().Replace(",", ".")</td>
                        </tr>
                        <tr>
                            <td hidden></td>
                            <td>THU CỌC</td>
                            <td>THU NỢ</td>
                            <td>GIẢI NGÂN</td>
                            <td>GIÁ VỐN</td>
                            <td>LỢI NHUẬN</td>
                        </tr>
                        <tr>
                            <td hidden></td>
                            <td class="number">@ViewBag.dtTHXuatBanXe.Rows[0]["ThuCoc"].ToString().Replace(",", ".")</td>
                            <td class="number">@ViewBag.dtTHXuatBanXe.Rows[0]["ThuNO"].ToString().Replace(",", ".")</td>
                            <td class="number">@ViewBag.dtTHXuatBanXe.Rows[0]["GiaiNgan"].ToString().Replace(",", ".")</td>
                            <td class="number">@ViewBag.dtTHXuatBanXe.Rows[0]["GiaVon"].ToString().Replace(",", ".")</td>
                            <td class="number">@ViewBag.dtTHXuatBanXe.Rows[0]["LoiNhuan"].ToString().Replace(",", ".")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <table  class="table table-striped table-bordered table-condensed">
                <tbody>
                    @if (ViewBag.dtTHLoiNhuanKho.Rows.Count > 0)
                    {
                        if (ViewBag.dtTHLoiNhuanKho.Rows.Count >= 1)
                        {
                            <tr>
                                <td></td>
                                <td rowspan="2">@ViewBag.dtTHLoiNhuanKho.Rows[0]["STT"]</td>
                                <td rowspan="2">@ViewBag.dtTHLoiNhuanKho.Rows[0]["TenKho"]</td>
                                <td>DOANH THU</td>
                                <td>GIÁ VỐN</td>
                                <td>LỢI NHUẬN</td>
                            </tr>
                            <tr>
                                <td></td>
                                <td class="number">@ViewBag.dtTHLoiNhuanKho.Rows[0]["DoanhThu"].ToString().Replace(",", ".")</td>
                                <td class="number">@ViewBag.dtTHLoiNhuanKho.Rows[0]["GiaVon"].ToString().Replace(",", ".")</td>
                                <td class="number">@ViewBag.dtTHLoiNhuanKho.Rows[0]["LoiNhuan"].ToString().Replace(",", ".")</td>
                            </tr>
                        }

                        if (ViewBag.dtTHLoiNhuanKho.Rows.Count >= 2)
                        {
                            <tr>
                                <td></td>
                                <td rowspan="2">@ViewBag.dtTHLoiNhuanKho.Rows[1]["STT"]</td>
                                <td rowspan="2">@ViewBag.dtTHLoiNhuanKho.Rows[1]["TenKho"]</td>
                                <td>DOANH THU</td>
                                <td>GIÁ VỐN</td>
                                <td>LỢI NHUẬN</td>
                            </tr>
                            <tr>
                                <td></td>
                                <td class="number">@ViewBag.dtTHLoiNhuanKho.Rows[1]["DoanhThu"].ToString().Replace(",", ".")</td>
                                <td class="number">@ViewBag.dtTHLoiNhuanKho.Rows[1]["GiaVon"].ToString().Replace(",", ".")</td>
                                <td class="number">@ViewBag.dtTHLoiNhuanKho.Rows[1]["LoiNhuan"].ToString().Replace(",", ".")</td>
                            </tr>
