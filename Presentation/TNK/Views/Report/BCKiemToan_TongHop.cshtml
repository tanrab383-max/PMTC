                    @if (ViewBag.dtTHTheChuVao.Rows.Count > 0)
                    {
                        <tr>
                            <td></td>
                            <td>13</td>
                            <td>THẺ CHƯA VÀO</td>
                            <td class="number">@ViewBag.dtTHTheChuVao.Rows[0]["NGANHANG_TREO"].ToString().Replace(",", ".")</td>
