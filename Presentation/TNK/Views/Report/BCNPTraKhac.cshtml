@using System.Data;
<div class="x_content">
    <div id="BCNPTraKhac" class="table-responsive">
        <table class="table table-striped table-bordered table-condensed">
            <thead>
                <tr class="headings">
                    <th colspan='8' class="tile">DANH SÁCH CHI TIẾT CÔNG NỢ PHẢI TRẢ KHÁC @ViewBag.ShowRoom</th>
                </tr>
                <tr>
                    <th colspan='8' class="tile">@ViewBag.TuNgayDenNgay</th>
                </tr>
                <tr class="headings">
                    <th class="column-title">STT</th>
                    <th class="column-title">Ngày nợ</th>
                    <th class="column-title">Khách hàng</th>
                    <th class="column-title">Nội dung</th>
                    <th class="column-title">Số tiền nợ</th>
                    <th class="column-title">Đã thanh toán</th>
                    <th class="column-title">Còn nợ</th>
                    <th class="column-title">Ngày thanh toán</th>
                    <th class="column-title">Hạn sử dụng</th>
                    <th class="column-title">Lý do chi</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    int dem = 0;
                    DataView ViewTongHop = (Model as DataTable).DefaultView;
                    foreach (DataRow row in ViewTongHop.ToTable().Rows)
                    {
                        <tr class="even pointer">
                            @if (@row["TenDoiTac"].ToString().ToUpper() == "TỔNG CỘNG")
                            {
                                <td group="@row["TenDoiTac"]" colspan="4" style="background-color:lightblue; color:red"><b>@row["DienGiai"]</b></td>
                                <td class="number" style="background-color:lightblue; color:red">@row["SoTienNo"].ToString().Replace(",", ".")</td>
                                <td class="number" style="background-color:lightblue; color:red">@row["SoTienDaTra"].ToString().Replace(",", ".")</td>
                                <td class="number" style="background-color:lightblue; color:red">@row["SoTienConLai"].ToString().Replace(",", ".")</td>
                                <td style="background-color:lightblue; color:red"></td>
								<td style="background-color:lightblue; color:red"></td>
                                <td></td>
                            }
                            else
                            {
                                <td>@(++dem)</td>
                                <td>@row["NgayNo"]</td>
                                <td>@row["TenDoiTac"]</td>
                                <td>@row["GhiChu"]</td>
                                <td class="number">@row["SoTienNo"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["SoTienDaTra"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["SoTienConLai"].ToString().Replace(",", ".")</td>
                                <td>@row["NgayThanhToan"]</td>
								<td>@row["HanSuDung"]</td>
                                <td>@row["LyDoChi"]</td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $("td.number").map(function (key, val) {
        var val = $(this).html();
        //val = val.replace(",", ".");
        val = val.split(",").join("");
        val = parseFloat(val);
        $(this).html(val.toLocaleString('en-us'));
    })
</script>


