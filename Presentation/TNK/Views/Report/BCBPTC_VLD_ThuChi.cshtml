@using System.Data;

@{
    DataTable dtbThu = ViewBag.dtbThu;
    DataTable dtbChi = ViewBag.dtbChi;

}

<div id="BCBPTC_THCTBX" class="x_content">
    <div class="row col-sm-12" style="float:left">
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-condensed">
                <thead>
                    <tr class="headings">
                        <th class="column-title" colspan="24">BÁO CÁO THU</th>
                    </tr>
                    <tr class="headings">
                        <th class="column-title" rowspan="2">TT</th>
                        <th class="column-title" rowspan="2">DANH MỤC ĐẠI LÝ</th>
                        <th class="column-title" colspan="10">HOẠT ĐỘNG KINH DOANH</th>
                        <th class="column-title" rowspan="2">THU VAY NGÂN HÀNG</th>
                        <th class="column-title" colspan="9">KHÁC</th>
                        <th class="column-title" rowspan="2">TỔNG CỘNG THU</th>
                    </tr>
                    <tr class="headings">
                        <th class="column-title">THU BÁN XE</th>
                        <th class="column-title">THU NỢ BÁN XE</th>
                        <th class="column-title">THU GIẢI NGÂN XE KHÁCH NỢ NH</th>
                        <th class="column-title">THU CỌC XE</th>
                        <th class="column-title">THU CỌC DV</th>
                        <th class="column-title">THU DỊCH VỤ / PHỤ TÙNG</th>
                        <th class="column-title">THU BÁN PHỤ KIỆN</th>
                        <th class="column-title">THU HOA HỒNG BÁN BH / GIẢI NGÂN NH</th>
                        <th class="column-title">THU NỢ DỊCH VỤ</th>
                        <th class="column-title">THU NỢ HVN/TMV/MMV</th>
                        <th class="column-title">THU KHÁC TỪ HĐKD</th>
                        <th class="column-title">TỔNG THU TỪ HĐKD</th>
                        <th class="column-title">THU BẢO HIỂM / GHBH THU HỘ</th>
                        <th class="column-title">THU GTX</th>
                        <th class="column-title">THU HOÀN ỨNG</th>
                        <th class="column-title">THU VAY MƯỢN NỘI BỘ (VAY TRUNG GIAN QUA PT)</th>
                        <th class="column-title">THU NHẬN GÓP VỐN, ĐẦU TƯ, VAY MƯỢN NỘI BỘ KHÁC</th>
                        <th class="column-title">THU BÁN TÀI SẢN</th>
                        <th class="column-title">THU KHÁC</th>
                        <th class="column-title">TỔNG THU KHÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        for (int i = 0; i < dtbThu.Rows.Count; i++)
                        {

                            <tr class="even pointer">
                                @for (int j = 0; j < dtbThu.Columns.Count; j++)
                                {
                                    if (dtbThu.Columns[j].ColumnName != "TT" && dtbThu.Columns[j].ColumnName != "DaiLy")
                                    {
                                        <td class="number">@dtbThu.Rows[i][j].ToString()</td>
                                    }
                                    else
                                    {
                                        <td>@dtbThu.Rows[i][j]</td>
                                    }
                                }

                            </tr>
                        }
                    }
                    <tr>
                        <td>TỔNG CỘNG</td>
                        <td></td>
                        @if (dtbThu.Rows.Count > 0)
                        {
                            for (int j = 2; j < dtbThu.Columns.Count; j++)
                            {
                                if (dtbThu.Columns[j].ColumnName != "TT" && dtbThu.Columns[j].ColumnName != "DaiLy")
                                {
                                    <td class="number">@dtbThu.Rows[0][j].ToString()</td>
                                }
                                else
                                {
                                    <td>@dtbThu.Rows[0][j]</td>
                                }
                            }
                        }
                        else
                        {
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                        }
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="row col-sm-12" style="float:left">
            <div class="table-responsive">
                <table class="table table-striped table-bordered table-condensed">
                    <thead
                         <tr class="headings">
                            <th class="column-title" colspan="24">BÁO CÁO CHI</th>
                         </tr>
                        <tr>
                            <th rowspan="2">TT</th>
                            <th rowspan="2">DANH MỤC ĐẠI LÝ</th>
                            <th colspan="10">HOẠT ĐỘNG KINH DOANH</th>
                            <th rowspan="2">CHI TRẢ VAY NGÂN HÀNG</th>
                            <th colspan="9">KHÁC</th>
                            <th rowspan="2">TỔNG CỘNG CHI</th>
                        </tr>
                        <tr>
                            <th class="column-title">CHI LƯƠNG THƯỞNG/BHXH</th>
                            <th class="column-title">CHI NỘP THUẾ/PHẠT THUẾ</th>
                            <th class="column-title">CHI LÃI VAY</th>
                            <th class="column-title">CHI PHÍ</th>
                            <th class="column-title">CHI THANH TOÁN NHÀ CUNG CẤP</th>
                            <th class="column-title">CHI THANH TOÁN XE TMV/HVN</th>
                            <th class="column-title">CHI MUA/TRẢ TIỀN XE NGOÀI</th>
                            <th class="column-title">CHI THANH TOÁN PHỤ TÙNG HVN/TMV</th>
                            <th class="column-title">CHI TRẢ CỌC/ TIỀN THỪA</th>
                            <th class="column-title">CHI ĐẶT CỌC</th>
                            <th class="column-title">CHI KHÁC CHO HĐKD</th>
                            <th class="column-title">TỔNG CHI CHO HĐKD</th>
                            <th class="column-title">CHI TRẢ BH/GHBH THU HỘ</th>
                            <th class="column-title">CHI GTX</th>
                            <th class="column-title">CHI TẠM ỨNG</th>
                            <th class="column-title">CHI TRẢ VAY MƯỢN NỘI BỘ (VAY TRUNG GIAN QUA PT)</th>
                            <th class="column-title">CHI GÓP VỐN, ĐẦU TƯ, TRẢ VAY MƯỢN NỘI BỘ KHÁC</th>
                            <th class="column-title">CHI MUA TÀI SẢN</th>
                            <th class="column-title">CHI KHÁC</th>
                            <th class="column-title">TỔNG CHI KHÁC</th>
                        </tr>
                    </thead>
                    @{
                        for (int i = 0; i < dtbChi.Rows.Count; i++)
                        {
                            <tr class="even pointer">
                                @for (int j = 0; j < dtbChi.Columns.Count; j++)
                                {
                                    if (dtbChi.Columns[j].ColumnName != "TT" && dtbChi.Columns[j].ColumnName != "DaiLy")
                                    {
                                        <td class="number">@dtbChi.Rows[i][j].ToString()</td>
                                    }
                                    else
                                    {
                                        <td>@dtbChi.Rows[i][j]</td>
                                    }
                                }

                            </tr>
                        }
                    }
                    <tr>
                        <td>TỔNG CỘNG</td>
                        <td></td>
                        @if (dtbChi.Rows.Count > 0)
                        {
                            for (int j = 2; j < dtbChi.Columns.Count; j++)
                            {
                                if (dtbChi.Columns[j].ColumnName != "TT" && dtbChi.Columns[j].ColumnName != "DaiLy")
                                {
                                    <td class="number">@dtbChi.Rows[0][j].ToString()</td>
                                }
                                else
                                {
                                    <td>@dtbChi.Rows[0][j]</td>
                                }
                            }
                        }
                        else
                        {
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                        }
                    </tr>
                </table>
                </div>
            </div>
            </div>
        </div>


        <script type="text/javascript">
            $("td.number").map(function (key, val) {
                var val = $(this).html();
                //val = val.replace(",", ".");
                val = val.split(",").join("");
                val = parseFloat(val);
                $(this).html(val.toLocaleString('en-us'));
            })
        </script>

