@using System.Data 
<div id="tab_MMTB_CCDC">
    <div class="x_content">
        <div id="BCKiemToan_MMTB_CCDC_div" class="table-responsive">
            <table class="table table-striped table-bordered table-condensed">
                <thead>
                    <tr class="headings">
                        <th colspan='9' class="tile">DANH SÁCH CHI THIẾT BỊ MÁY MÓC VÀ CÔNG DỤ DỤNG CỤ</th>
                    </tr>
                    <tr>
                        <th colspan='9' class="tile">@ViewBag.TuNgayDenNgay</th>
                    </tr>
                    <tr class="headings">
                        <th rowspan="2" class="column-title">STT</th>
                        <th rowspan="2" class="column-title">Ngày phát sinh</th>
                        <th rowspan="2" class="column-title">Tên tài sản</th>
                        <th colspan="2" class="column-title">Nguyên giá</th>
                        <th rowspan="2" class="column-title">Thời gian khấu hao</th>
                        <th  rowspan="2" class="column-title">Giá trị khấu hao</th>
                        <th colspan="2" class="column-title">Giá trị Còn lại</th>
                    </tr>
                    <tr class="headings">
                        <th class="column-title">MMTB Xưởng</th>
                        <th class="column-title">CCDC Quản lý</th>
                        <th class="column-title">MMTB Xưởng</th>
                        <th class="column-title">CCDC Quản lý</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        double TongNguyenGiaMMTB = 0, TongNguyenGiaCCDC = 0, TongConLaiMMTB = 0, TongConLaiCCDC =0
                            , TongCongNguyenGiaTBMM = 0 , TongCongNguyenGiaCCDC = 0, TongCongConLaiTBMM = 0, TongCongConLaiCCDC = 0;
                        int intCount = 0;
                        DateTime datevalue = (Convert.ToDateTime(Model.Rows[0]["NgayChi"].ToString()));
                        String yy = datevalue.Year.ToString();
                        int k = int.Parse(yy);

                        foreach (DataRow row in (Model as DataTable).Rows)
                        {

                            datevalue = (Convert.ToDateTime(row["NgayChi"].ToString()));
                            yy = datevalue.Year.ToString();
                            int kt = int.Parse(yy);
                            if (kt == k)
                            {
                                TongNguyenGiaMMTB += row["NguyenGiaMMTB"].ToString() == "" ? 0 : Convert.ToDouble(row["NguyenGiaMMTB"]);
                                TongNguyenGiaCCDC += row["NguyenGiaCCDC"].ToString() == "" ? 0 : Convert.ToDouble(row["NguyenGiaCCDC"]);
                                TongConLaiMMTB += row["GiaTriConLaiMMTB"].ToString() == "" ? 0 : Convert.ToDouble(row["GiaTriConLaiMMTB"]);
                                TongConLaiCCDC += row["GiaTriConLaiCCDC"].ToString() == "" ? 0 : Convert.ToDouble(row["GiaTriConLaiCCDC"]);

                                 <tr class="even pointer">
                                    <td>@(++intCount)</td>
                                    <td>@row["NgayChi"].ToString()</td>
                                     @if (@row["NguyenGiaMMTB"].ToString() == "0")
                                     {
                                        <td width="400px">@row["TenTaiSan"].ToString()</td>
                                        <td ></td>
                                        <td class="number">@row["NguyenGiaCCDC"].ToString()</td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td class="number">@row["GiaTriConLaiCCDC"].ToString()</td>
                                     }
                                     else
                                     {
                                        <td width="400px">@row["TenTaiSan"].ToString()</td>
                                        <td class="number">@row["NguyenGiaMMTB"].ToString() </td>
                                        <td ></td>
                                        <td></td>
                                        <td></td>
                                        <td class="number">@row["GiaTriConLaiMMTB"].ToString()</td>
                                        <td></td>
                                     }
                                     </tr>
                            }
                            else
                            {
                                <tr class="even pointer" style="background-color:darkgray;font-weight:bold">
                                    <td colspan="3">@k</td>
                                    <td class="number">@TongNguyenGiaMMTB</td>
                                    <td class="number">@TongNguyenGiaCCDC</td>
                                    <td></td>
                                    <td></td>
                                    <td class="number">@TongConLaiMMTB</td>
                                    <td class="number">@TongConLaiCCDC</td>
                                </tr>
                                TongCongNguyenGiaTBMM += TongNguyenGiaMMTB;
                                TongCongNguyenGiaCCDC += TongNguyenGiaCCDC;
                                TongCongConLaiTBMM += TongConLaiMMTB;
                                TongCongConLaiCCDC += TongConLaiCCDC;
                                TongNguyenGiaMMTB = 0; TongNguyenGiaCCDC = 0; TongConLaiMMTB = 0; TongConLaiCCDC = 0;


                                TongNguyenGiaMMTB += row["NguyenGiaMMTB"].ToString() == "" ? 0 : Convert.ToDouble(row["NguyenGiaMMTB"]);
                                TongNguyenGiaCCDC += row["NguyenGiaCCDC"].ToString() == "" ? 0 : Convert.ToDouble(row["NguyenGiaCCDC"]);
                                TongConLaiMMTB += row["GiaTriConLaiMMTB"].ToString() == "" ? 0 : Convert.ToDouble(row["GiaTriConLaiMMTB"]);
                                TongConLaiCCDC += row["GiaTriConLaiCCDC"].ToString() == "" ? 0 : Convert.ToDouble(row["GiaTriConLaiCCDC"]);
                                <tr class="even pointer">
                                    <td>@(++intCount)</td>
                                    <td>@row["NgayChi"].ToString()</td>
                                    <td width="400px">@row["TenTaiSan"].ToString()</td>
                                    <td class="number">@row["NguyenGiaMMTB"].ToString()</td>
                                    <td class="number">@row["NguyenGiaCCDC"].ToString()</td>
                                    <td></td>
                                    <td></td>
                                    <td class="number">@row["GiaTriConLaiMMTB"].ToString()</td>
                                    <td class="number">@row["GiaTriConLaiCCDC"].ToString()</td>
                                </tr>
                                k = kt;
                            }

                        }
                        
                            TongCongNguyenGiaTBMM += TongNguyenGiaMMTB;
                            TongCongNguyenGiaCCDC += TongNguyenGiaCCDC;
                            TongCongConLaiTBMM += TongConLaiMMTB;
                            TongCongConLaiCCDC += TongConLaiCCDC;
                        
                        <tr class="even pointer" style="background-color:darkgray;font-weight:bold">
                            <td colspan="3">@k</td>
                            <td class="number">@TongNguyenGiaMMTB</td>
                            <td class="number">@TongNguyenGiaCCDC</td>
                            <td></td>
                            <td></td>
                            <td class="number">@TongConLaiMMTB</td>
                            <td class="number">@TongConLaiCCDC</td>
                        </tr>
                        <tr class="even pointer" style="background-color:lightblue;font-weight:bold">
                            <td colspan="3">TỔNG</td>
                            <td class="number">@TongCongNguyenGiaTBMM</td>
                            <td class="number">@TongCongNguyenGiaCCDC</td>
                            <td></td>
                            <td></td>
                            <td class="number">@TongCongConLaiTBMM</td>
                            <td class="number">@TongCongConLaiCCDC</td>
                        </tr>
                            TongCongNguyenGiaTBMM += TongCongNguyenGiaCCDC;
                            TongCongConLaiTBMM += TongCongConLaiCCDC;
                        <tr class="even pointer" style="background-color:lightblue;font-weight:bold">
                            <td colspan="3">TỔNG CỘNG</td>
                            <td colspan="2" class="number">@TongCongNguyenGiaTBMM </td>
                            <td></td>
                            <td></td>
                            <td colspan="2" class="number">@TongCongConLaiTBMM</td>
                        </tr>
                        @*<tr class="even pointer" style="background-color:lightblue;font-weight:bold">
                            <td colspan="4"><b>TỔNG CỘNG :</b></td>
                            <td class="number">@TongSoTien.ToString().Replace(",", ".")</td>
                            <td colspan="3"></td>
                        </tr>*@
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script type="text/javascript">
    $("td.number").map(function (key, val) {
        var val = $(this).html();
        //val = val.replace(",", ".");
        val = val.split(",").join("");
        val = parseFloat(val);
        $(this).html(val.toLocaleString('en-us'));
    })
    $("td.numberRE").map(function (key, val) {
        var val = $(this).html();
        val = val.replace(",", ".");
        val = val.split(",").join("");
        val = parseFloat(val);
        $(this).html(val.toLocaleString('en-us'));
    })
</script>


