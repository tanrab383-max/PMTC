@using System.Data;
<style>
    table :last-child > :last-child > td {
        background-color: lightblue;
        font-weight: bold;
    }
</style>
<div class="x_content">
    <div id="BCHHKMGHBH" class="table-responsive">
        <table class="table table-striped table-bordered table-condensed">
            <thead>
                <tr class="headings">
                    <th colspan='10' class="tile">DANH SÁCH HOA HỒNG KHUYẾN MÃI GIA HẠN BẢO HÀNH @ViewBag.ShowRoom</th>
                </tr>
                <tr>
                    <th colspan='10' class="tile">@ViewBag.ToDate</th>
                </tr>
                <tr class="headings">
                    <th class="column-title">STT</th>
                    <th class="column-title">NGÀY NỢ</th>
                    <th class="column-title">MÃ PHIẾU</th>
                    <th class="column-title">TÊN ĐƠN VỊ</th>
                    <th class="column-title">KHÁCH HÀNG</th>
                    <th class="column-title">DT GHBH KM</th>
                    <th class="column-title">ĐÃ TT GHBH KM</th>
                    <th class="column-title">NGÀY TT GHBH KM</th>
                    <th class="column-title">CÒN NỢ GHBH KM</th>
                    <th class="column-title">HOA HỒNG GHBH KM</th>
                    <th class="column-title">ĐÃ THU HH GHBH KM</th>
                    <th class="column-title">NGÀY THU HH GHBH KM</th>
                    <th class="column-title">CÒN NỢ HH GHBH KM</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (DataRow row in (ViewBag.Data as DataTable).Rows)
                    {
                        <tr class="even pointer">
                            <td>@row["STT"]</td>
                            <td>@row["NgayThu"]</td>
                            <td>@row["MaPhieuThu"]</td>
                            <td>@row["TenDoiTac"].ToString()</td>
                            <td>@row["HoTen"].ToString()</td>
                            <td class="number">@row["ThuHo_SoTienNo"].ToString().Replace(",", ".")</td>
                            <td class="number">@row["ThuHo_DaTra"].ToString().Replace(",", ".")</td>
                            <td>@row["NgayTTBHTH"].ToString()</td>
                            <td class="number">@row["ThuHo_ConLai"].ToString().Replace(",", ".")</td>
                            <td class="number">@row["ThuHH_SoTienNo"].ToString().Replace(",", ".")</td>
                            <td class="number">@row["ThuHH_DaTra"].ToString().Replace(",", ".")</td>
                            <td>@row["NgayTTHHBH"].ToString()</td>
                            <td class="number">@row["ThuHH_ConLai"].ToString().Replace(",", ".")</td>
                        </tr>
                    }

                }
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $("td.number").map(function (key, val) {
        var val = $(this).html();
        //val = val.replace(",", ".");
        val = val.split(",").join("");
        val = parseFloat(val);
        $(this).html(val.toLocaleString('en-us'));
    })
    $("td.numberRE").map(function (key, val) {
        var val = $(this).html();
        val = val.replace(",", ".");
        val = val.split(",").join("");
        val = parseFloat(val);
        $(this).html(val.toLocaleString('en-us'));
    })
</script>




