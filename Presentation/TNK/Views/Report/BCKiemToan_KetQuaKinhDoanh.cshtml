        $(this).html(val.toLocaleString('en-us'));
    })
    $("td.number2").map(function (key, val) {
        var val = $(this).html();
        val = val.replace(",", ".");
        val = val.split(",").join("");
        val = Math.round(val * 100) / 100;
        val = parseFloat(val);
        $(this).html(val.toLocaleString('en-us'));
    })
</script>


