                                                <td style="background-color:#ceefef;font-weight:bold"></td>
                                                <td class="number" style="background-color:#ceefef;font-weight:bold">@row["SoLuongTonKhoDauKy"].ToString().Replace(",", ".")</td>
                                                <td class="number" style="background-color:#ceefef;font-weight:bold">@row["TongTienTonKhoDauKy"].ToString().Replace(",", ".")</td>
