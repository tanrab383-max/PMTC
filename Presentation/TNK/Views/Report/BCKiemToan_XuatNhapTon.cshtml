@using System.Data;
@*(ViewBag.ListCarOutside as DataTable).Rows*@
<div id="tab_XNT">
    <div class="x_content">
        <div  id="BCKiemToan_XuatNhapTon_div">
            <div class="table-responsive">
                <table id="XXNT" class="table table-striped table-bordered table-condensed">
                    <thead>
                        <tr class="headings">
                            <th colspan='14' class="tile">NHẬP XUẤT TỒN XE</th>
                        </tr>
                        <tr>
                            <th colspan='14' class="tile">@ViewBag.TuNgayDenNgay</th>
                        </tr>
                        <tr></tr>
                        <tr class="headings">
                            <th class="column-title" rowspan="2">XUẤT XỨ</th>
                            <th class="column-title" rowspan="2">LOẠI XE</th>
                            <th class="column-title" rowspan="2">MÃ</th>
                            <th class="column-title" rowspan="2">MÀU</th>
                            <th class="column-title" rowspan="2">MÃ MÀU</th>
                            <th class="column-title" rowspan="2">GIÁ VỐN (VAT)</th>
                            <th class="column-title" colspan="2">TỒN ĐK</th>
                            <th class="column-title" colspan="2">NHẬP</th>
                            <th class="column-title" colspan="2">XUẤT BÁN</th>
                            <th class="column-title" colspan="2">TỒN CK</th>
                        </tr>
                        <tr class="headings">
                            <th class="column-title">SL</th>
                            <th class="column-title">TT</th>
                            <th class="column-title">SL</th>
                            <th class="column-title">TT</th>
                            <th class="column-title">SL</th>
                            <th class="column-title">TT</th>
                            <th class="column-title">SL</th>
                            <th class="column-title">TT</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            if (Model != null)
                            {

                                string maXeCheck = ViewBag.str;
                                foreach (DataRow row in (Model as DataTable).Rows)
                                {
                                    if (@row["MaModel"].ToString() == "" || @row["MaModel"].ToString() == "0")
                                    {
                                        if (@row["MaModel"].ToString() == "0")
                                        {
                                            <tr class="even pointer" style="background-color:lightblue;font-weight:bold">
                                                @*<td group="@row["XuatXu"]">@row["XuatXu"]</td>*@
                                                <td group="@row["MaModel"]">@row["TenModel"]</td>
                                                <td group="@row["MaModel"] + @row["MaMau"]"></td>
                                                <td group="@row["MaModel"] + @row["MaMau"]"></td>
                                                <td group="@row["MaModel"] + @row["MaMau"] "></td>
                                                <td group="@row["MaModel"] + @row["MaMau"] "></td>
                                                <td group="@row["MaModel"] + @row["MaMau"]@row["GiaVon"]"></td>
                                                <td class="number">@row["SoLuongTonKhoDauKy"].ToString().Replace(",", ".")</td>
                                                <td class="number">@row["TongTienTonKhoDauKy"].ToString().Replace(",", ".")</td>
                                                <td class="number">@row["SoLuongNhap"].ToString().Replace(",", ".")</td>
                                                <td class="number">@row["TongTienNhap"].ToString().Replace(",", ".")</td>
                                                <td class="number">@row["SoLuongXuat"].ToString().Replace(",", ".")</td>
                                                <td class="number">@row["TongTienXuat"].ToString().Replace(",", ".")</td>
                                                <td class="number">@row["SoLuongTonKhoCuoiKy"].ToString().Replace(",", ".")</td>
                                                <td class="number">@row["TongTienTonKhoCuoiKy"].ToString().Replace(",", ".")</td>
                                            </tr>
                                        }
                                        else
                                        {
                                            <tr class="even pointer" style="background-color:#ceefef;font-weight:bold">
                                                <td group="@row["XuatXu"]">@row["XuatXu"]</td>
                                                <td group="@row["MaModel"]">@row["TenModel"]</td>
                                                <td group="@row["MaModel"]@row["MaMau"] "></td>
                                                <td group="@row["MaModel"]@row["MaMau"] "></td>
                                                <td group="@row["MaModel"]@row["MaMau"] "></td>
                                                <td group="@row["MaModel"]@row["MaMau"]@row["GiaVon"]"></td>
                                                <td class="number">@row["SoLuongTonKhoDauKy"].ToString().Replace(",", ".")</td>
                                                <td class="number">@row["TongTienTonKhoDauKy"].ToString().Replace(",", ".")</td>
                                                <td class="number">@row["SoLuongNhap"].ToString().Replace(",", ".")</td>
                                                <td class="number">@row["TongTienNhap"].ToString().Replace(",", ".")</td>
                                                <td class="number">@row["SoLuongXuat"].ToString().Replace(",", ".")</td>
                                                <td class="number">@row["TongTienXuat"].ToString().Replace(",", ".")</td>
                                                <td class="number">@row["SoLuongTonKhoCuoiKy"].ToString().Replace(",", ".")</td>
                                                <td class="number">@row["TongTienTonKhoCuoiKy"].ToString().Replace(",", ".")</td>
                                            </tr>

                                        }

                                    }
                                    else
                                    {
                                        <tr class="even pointer">
                                            <td group="@row["XuatXu"]">@row["XuatXu"]</td>
                                            <td group="@row["MaModel"]">@row["TenModel"]</td>
                                            <td group="@row["MaModel"]">@row["MaModel"]</td>
                                            <td group="@row["MaModel"]+ @row["TenMau"]">@row["TenMau"]</td>
                                            <td group="@row["MaModel"]+ @row["TenMau"]">@row["MaMau"]</td>
                                            <td class="number">@row["GiaVon"]</td>
                                            <td class="number">@row["SoLuongTonKhoDauKy"].ToString().Replace(",", ".")</td>
                                            <td class="number">@row["TongTienTonKhoDauKy"].ToString().Replace(",", ".")</td>
                                            <td class="number">@row["SoLuongNhap"].ToString().Replace(",", ".")</td>
                                            <td class="number">@row["TongTienNhap"].ToString().Replace(",", ".")</td>
                                            <td class="number">@row["SoLuongXuat"].ToString().Replace(",", ".")</td>
                                            <td class="number">@row["TongTienXuat"].ToString().Replace(",", ".")</td>
                                            <td class="number">@row["SoLuongTonKhoCuoiKy"].ToString().Replace(",", ".")</td>
                                            <td class="number">@row["TongTienTonKhoCuoiKy"].ToString().Replace(",", ".")</td>
                                        </tr>
                                    }
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        
            <div class="table-responsive">
                <table id="XN" class="table table-striped table-bordered table-condensed">
                    <thead>
