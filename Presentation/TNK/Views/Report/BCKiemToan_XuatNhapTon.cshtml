                            <th class="column-title" colspan="2">TỒN ĐK</th>
                            <th class="column-title" colspan="2">NHẬP</th>
                            <th class="column-title" colspan="2">XUẤT BÁN</th>
                            <th class="column-title" colspan="2">TỒN CK</th>
                        </tr>
                        <tr class="headings">
                            <th class="column-title">SL</th>
                            <th class="column-title">TT</th>
                            <th class="column-title">SL</th>
                            <th class="column-title">TT</th>
                            <th class="column-title">SL</th>
                            <th class="column-title">TT</th>
                            <th class="column-title">SL</th>
                            <th class="column-title">TT</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            if (Model != null)
                            {
                                int i = 0;
                                string maXeCheck = ViewBag.str;
                                foreach (DataRow row in (ViewBag.ListCarOutside as DataTable).Rows)
                                {
                                    if (@row["MaModel"].ToString() == "" || @row["MaModel"].ToString() == "0")
                                    {
                                        if (@row["MaModel"].ToString() == "0")
                                        {
