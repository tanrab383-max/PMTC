                                                <td class="number" style="background-color:#ceefef;font-weight:bold">@row["SoLuongXuat"].ToString().Replace(",", ".")</td>
                                                <td class="number" style="background-color:#ceefef;font-weight:bold">@row["TongTienXuat"].ToString().Replace(",", ".")</td>
                                                <td class="number" style="background-color:#ceefef;font-weight:bold">@row["SoLuongTonKhoCuoiKy"].ToString().Replace(",", ".")</td>
                                                <td class="number" style="background-color:#ceefef;font-weight:bold">@row["TongTienTonKhoCuoiKy"].ToString().Replace(",", ".")</td>
                                            </tr>

                                        }

                                    }
                                    else
                                    {
                                        <tr class="even pointer">
                                            <td group="@(++i)">@row["XuatXu"]</td>
                                            <td group="@(++i)">@row["TenModel"]</td>
                                            <td group="@(++i)">@row["MaModel"]</td>
                                            <td group="@(++i)">@row["TenMau"]</td>
                                            <td group="@(++i)">@row["MaMau"]</td>
                                            <td class="number">@row["GiaVon"]</td>
                                            <td class="number">@row["SoLuongTonKhoDauKy"].ToString().Replace(",", ".")</td>
                                            <td class="number">@row["TongTienTonKhoDauKy"].ToString().Replace(",", ".")</td>
                                            <td class="number">@row["SoLuongNhap"].ToString().Replace(",", ".")</td>
                                            <td class="number">@row["TongTienNhap"].ToString().Replace(",", ".")</td>
                                            <td class="number">@row["SoLuongXuat"].ToString().Replace(",", ".")</td>
                                            <td class="number">@row["TongTienXuat"].ToString().Replace(",", ".")</td>
                                            <td class="number">@row["SoLuongTonKhoCuoiKy"].ToString().Replace(",", ".")</td>
                                            <td class="number">@row["TongTienTonKhoCuoiKy"].ToString().Replace(",", ".")</td>
                                        </tr>
                                    }
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $("td.number").map(function (key, val) {
        var val = $(this).html();
        //val = val.replace(",", ".");
        val = val.split(",").join("");
        val = parseFloat(val);
        $(this).html(val.toLocaleString('en-us'));
    })
</script>
