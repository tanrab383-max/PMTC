                                                @*<td group="@row["MaModel"]">@row["XuatXu"]</td>*@
                                                <td group="">@row["TenModel"]</td>
                                                <td group=""></td>
                                                <td group=""></td>
                                                <td group=""></td>
                                                <td group=""></td>
                                                <td></td>
