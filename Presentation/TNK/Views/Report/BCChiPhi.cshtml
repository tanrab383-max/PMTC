                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-condensed">
                        <thead>
                            <tr class="headings">
                                <th colspan='5' class="tile">CÁC KHOẢN TẠM ỨNG</th>
                            </tr>
                            <tr class="headings">
                                <th class="column-title">DIỄN GIẢI</th>
                                <th class="column-title">THU</th>
                                <th class="column-title">CHI</th>
                                <th class="column-title">KÝ DUYỆT</th>
                                <th class="column-title">GHI CHÚ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.ListAdvance != null)
                            {
                                TotalThu = 0; TotalChi = 0;
                                foreach (DataRow row in (ViewBag.ListAdvance as DataTable).Rows)
                                {
                                    TotalThu += row["Thu"].ToString() == "" ? 0 : Convert.ToDouble(row["Thu"]);
                                    TotalChi += row["Chi"].ToString() == "" ? 0 : Convert.ToDouble(row["Chi"]);
                                <tr class="even pointer">
                                    <td>@row["DienGiai"]</td>
                                    <td class="number">@row["Thu"]</td>
                                    <td class="number">@row["Chi"]</td>
                                    <td>@row["NguoiPheDuyet"]</td>
                                    <td>@row["GhiChu"]</td>
                                </tr>
                                }
                            }
                            <tr class="even pointer">
                                <td>TỔNG CHI</td>
                                <td class="number">@TotalThu</td>
                                <td class="number">@TotalChi</td>
                                <td></td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>*@


<script type="text/javascript">
    $("td.number").map(function (key, val) {
        var val = $(this).html();
        //val = val.replace(",", ".");
        val = val.split(",").join("");
        val = parseFloat(val);
        $(this).html(val.toLocaleString('en-us'));
    })
</script>