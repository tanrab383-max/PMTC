@using System.Data;

@{ 
    double TotalThu = 0;
    double TotalChi = 0;
    double TotalGiam = 0;
    double TotalTongGiam = 0;
}

<div id="BCChiPhi" class="x_content">
    <div class="row col-sm-6" style="float:left">
        <div class="col-sm-12">
            <div class="table-responsive">
                <table class="table table-striped table-bordered table-condensed">
                    <thead>
                        <tr class="headings">
                            <th colspan='6' class="tile">BẢNG PHÂN TÍCH CHI PHÍ TIỀN MẶT(Q.CHÍNH) @ViewBag.ShowRoom</th>
                        </tr>
                        <tr>
                            <th colspan='6' class="tile">@ViewBag.TuNgayDenNgay</th>
                        </tr>
                        <tr class="headings">
                            <th class="column-title">DIỄN GIẢI</th>
                            <th class="column-title">THU</th>
                            <th class="column-title">CHI</th>
                            <th class="column-title">BỘ PHẬN</th>
                            <th class="column-title">KÝ DUYỆT</th>
                            <th class="column-title">GHI CHÚ</th>
                            @*<th class="column-title">HHXE</th>
                            <th class="column-title">HHPT</th>*@
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (DataRow row in (Model as DataTable).Rows)
                            {
                                TotalThu += row["Thu"].ToString() == "" ? 0 : Convert.ToDouble(row["Thu"]);
                                TotalChi += row["Chi"].ToString() == "" ? 0 : Convert.ToDouble(row["Chi"]);
                                <tr class="even pointer">
                                    <td>@row["DienGiai"]</td>
                                    <td class="number">@row["Thu"].ToString().Replace(",", ".")</td>
                                    <td class="number">@row["Chi"].ToString().Replace(",", ".")</td>
                                    <td>@row["BoPhan"]</td>
                                    <td>@row["NguoiDuyet"]</td>
                                    <td>@row["GhiChu"]</td>
                                    @*<td>@row["HHXE"]</td>
                                    <td>@row["HHPT"]</td>*@
                                </tr>
                            }
                        }
                        <tr class="even pointer" style="background-color:lightblue;font-weight:bold">
                            <td>TỔNG CHI PHÍ</td>
                            <td class="number">@TotalThu.ToString().Replace(",", ".")</td>
                            <td class="number">@TotalChi.ToString().Replace(",", ".")</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            @*<td></td>
                            <td></td>*@
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col-sm-12">
