@using System.Data;

<div class="x_content">
    <div id="BCCNPTKhac_NoTTBH" class="table-responsive">
        <table class="table table-striped table-bordered table-condensed">
            <thead>
                <tr class="headings">
                    <th colspan='14' class="tile">DANH SÁCH CHI TIẾT CÔNG NỢ PHẢI THU THƯỞNG THÀNH TÍCH BÁN HÀNG @ViewBag.ShowRoom</th>
                </tr>
                <tr>
                    <th colspan='14' class="tile">@ViewBag.TuNgayDenNgay</th>
                </tr>
                <tr class="headings">
                    <th class="column-title">STT</th>
                    <th class="column-title">NGÀY NỢ</th>
                    <th class="column-title">MÃ PHIẾU</th>
                    <th class="column-title">SỐ KHUNG</th>
                    <th class="column-title">KHÁCH HÀNG</th>
                    <th class="column-title">NỘI DUNG</th>
                    <th class="column-title">SỐ TIỀN NỢ</th>
                    <th class="column-title">ĐÃ THANH TOÁN</th>
                    <th class="column-title">CÒN NỢ</th>
                    <th class="column-title">NGÀY THANH TOÁN</th>
                    <th class="column-title">PHÂN BỔ THEO HÀNG XUẤT</th>
                    <th class="column-title">CÒN LẠI CHỜ PHÂN BỔ</th>
                    <th class="column-title">NGÀY XUẤT XE</th>
                </tr>

            </thead>
            <tbody>
                @if (Model != null)
                {
                    DataView ViewTongHop = (Model as DataTable).DefaultView;
                    foreach (DataRow row in ViewTongHop.ToTable().Rows)
                    {
                        <tr class="even pointer">
                            @if (@row["NgayNo"].ToString().ToUpper() == "TỔNG CỘNG")
                            {
                                <td group="@row["NgayNo"]" colspan="6" style="background-color:lightblue; color:red"><b>@row["NgayNo"]</b></td>
                                <td class="number" style="background-color:lightblue; color:red">@row["SoTienNo"].ToString().Replace(",", ".")</td>
                                <td class="number" style="background-color:lightblue; color:red">@row["SoTienDaTra"].ToString().Replace(",", ".")</td>
                                <td class="number" style="background-color:lightblue; color:red">@row["SoTienConLai"].ToString().Replace(",", ".")</td>
                                <td style="background-color:lightblue; color:red"></td>
                                <td class="number" style="background-color:lightblue; color:red">@row["PhanBoHangXuat"].ToString().Replace(",", ".")</td>
                                <td class="number" style="background-color:lightblue; color:red">@row["ConLaiChoPhanBo"].ToString().Replace(",", ".")</td>
                                <td style="background-color:lightblue; color:red"></td>
                            }
                            else
                            {
                                <td>@row["Row#"]</td>
                                <td>@row["NgayNo"]</td>
                                <td>@row["MaPhieuNo"]</td>
                                <td>@row["SoKhung"]</td>
                                <td>@row["TenDoiTac"]</td>
                                <td>@row["NoiDung"]</td>
                                <td class="number">@row["SoTienNo"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["SoTienDaTra"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["SoTienConLai"].ToString().Replace(",", ".")</td>
                                <td>@row["NgayThanhToan"]</td>
                                <td>@row["PhanBoHangXuat"]</td>
                                <td>@row["ConLaiChoPhanBo"]</td>
                                <td>@row["NgayBanXe"]</td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $("td.number").map(function (key, val) {
        var val = $(this).html();
        //val = val.replace(",", ".");
        val = val.split(",").join("");
        val = parseFloat(val);
        $(this).html(val.toLocaleString('en-us'));
    })
</script>


