
@{
    ViewBag.Title = "PTS";
}
<div class="">
    <div class="page-title">
        <div class="title_left">
            <h3>BÁO CÁO SỐ LIỆU CỬA HÀNG</h3>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_panel">
            <div class="x_content">
                <br />
                <form id="demo-form2" data-parsley-validate class="form-horizontal form-label-left">

                    <div class="form-group">
                        <label class="control-label col-md-3 col-sm-3 col-xs-12" for="first-name">Ngày gọi </label>
                        <div class="col-sm-3">
                            <input type="text" id="FromDate" required="required" class="date form-control" placeholder="Từ ngày">
                        </div>
                        <div class="col-sm-3">
                            <input type="text" id="ToDate" required="required" class="date form-control" placeholder="Đến ngày">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-md-3 col-sm-3 col-xs-12" for="first-name">Tên báo cáo </label>
                        <div class="col-sm-3">
                            <select id="Status" required="required" multiple="true" class="multiselect form-control">
                                <option value="BC1">BC 1</option>
                                <option value="BC2">BC 2</option>
                                <option value="BC3">BC 3</option>
                            </select>
                        </div>
                        <label class="control-label col-sm-1">Cửa hàng </label>
                        <div class="col-sm-3">
                            <select id="Store" multiple="true" class="multiselect form-control">
                                <option value="PT1">PT 1</option>
                                <option value="PT2">PT 2</option>
                                <option value="PT3">PT 3</option>
                                <option value="PT4">PT 4</option>
                                <option value="PT5">PT 5</option>
                                <option value="PT6">PT 6</option>
                                <option value="Wing1">Wing 1</option>
                                <option value="Wing2">Wing 2</option>
                                <option value="Wing3">Wing 3</option>
                                <option value="Wing4">Wing 4</option>
                                <option value="Wing5">Wing 5</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-6 col-sm-6 col-xs-12 col-md-offset-3">
                            <button type="submit" class="btn btn-primary"><i class="fa fa-file-excel-o"></i> Xuất excel</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script>
        $(document).ready(function () {
            $("select.multiselect").multiselect({
                noneSelectedText: '-- Tất cả --',
                multiple: true,
            }).multiselectfilter();
        });
    </script>
}