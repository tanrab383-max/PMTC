@using System.Data;
<div class="x_content">
    <div id="BCXeTon" class="table-responsive">
        <table class="table table-striped table-bordered table-condensed">
            <thead>
                <tr class="headings">
                    <th colspan='9' class="tile">DANH SÁCH XE TỒN @ViewBag.ShowRoom</th>
                </tr>
                <tr>
                    <th colspan='9' class="tile">@ViewBag.ToDate đang tồn @ViewBag.Total xe</th>
                </tr>
                <tr class="headings">
                    <th class="column-title">STT</th>
                    <th class="column-title">Tên loại xe</th>
                    <th class="column-title">Tên màu</th>
                    <th class="column-title">Số khung</th>
                    <th class="column-title">Xuất xứ</th>
                    <th class="column-title">Giá vốn </th>
                    <th class="column-title">Giá niêm yết </th>
                    <th class="column-title">Ngày nhập kho</th>
                    <th class="column-title">Tình Trạng</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                  
                    int intCount = 0;
                    foreach (DataRow row in (Model as DataTable).Rows)
                    {
                        
                        <tr class="even pointer">
                            <td>@(++intCount)</td>
                            <td>@row["TenModel"]</td>
                            <td>@row["TenMau"].ToString()</td>
                            <td>@row["SoKhung"].ToString()</td>
                            <td>@row["XuatXu"].ToString()</td>
                            <td class="number">@row["GiaVon"].ToString().Replace(",", ".")</td>
                            <td class="number">@row["GiaNiemYet"].ToString().Replace(",", ".")</td>
                            <td>@row["NgayNhapKho"].ToString()</td>
                            @if(@row["TinhTrang"].ToString() == "TC")
                            {
                            <td>Đang Thế Chấp</td>
                            }
                            else if(@row["TinhTrang"].ToString() == "N")
                            {
                            <td>Trong kho</td>
                            }
                            else if (@row["TinhTrang"].ToString() == "X")
                            {
                                <td>Xuất bán</td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $("td.number").map(function (key, val) {
        var val = $(this).html();
        //val = val.replace(",", ".");
        val = val.split(",").join("");
        val = parseFloat(val);
        $(this).html(val.toLocaleString('en-us'));
    })
    $("td.numberRE").map(function (key, val) {
        var val = $(this).html();
        val = val.replace(",", ".");
        val = val.split(",").join("");
        val = parseFloat(val);
        $(this).html(val.toLocaleString('en-us'));
    })
</script>
