@section scripts
{
    <script src="~/Scripts/jquery.fileDownload.js"></script>
    @*<script src="~/Scripts/jquery-ui-1.10.4.custom.min.js"></script>*@
    @*<script src="~/Scripts/jquery-ui.js"></script>*@
    <link href="~/Content/jquery-ui.css" rel="stylesheet" />
    <script>

        $('.date').datepicker({
            orientation: "left",
            autoclose: true
        });

        $("td.number").map(function (key, val) {
            var val = $(this).html();
            val = val.replace(",", ".");
            val = val.split(",").join("");
            val = parseInt(val);
            $(this).html(val.toLocaleString('en-us'));
        })
        $("#myTab li").on("click", function () {
            debugger;
            $("#FromDate").prop("disabled", false);
            GetReportInfo();
        });


        function GetReportInfo() {
            var expirDate = $($("#myTab li.active")[0]).attr("data-expirDate");
            var url = $($("#myTab li.active")[0]).attr("data-url");
            //if (url == '/Report/BCPTDV' || url == '/Report/BCKhoPhuTungNgayV2') {
            var fromDate = $("#FromDate").val(); // Lấy giá trị ngày từ input
            var parsedFromDate = moment(fromDate, "DD/MM/YYYY"); // Chuyển đổi sang đối tượng moment

            if (parsedFromDate.isSameOrAfter(moment(expirDate, "DD/MM/YYYY")) ) {
                alert("Báo cáo chỉ được xuất từ " + expirDate + " trở về trước!");
                return false;
            }


            //}
            if (checkInvalidDate() == false)
                return false;
            //alert(url);
            var viewbox = $($($("#myTab li.active a")[0]).attr("href"));
            viewbox.html('<p align="center"><img src="/assests/images/loading.gif"/></p>');
            viewbox.show();
            $("#report_1").text("Đang xuất");
            $("#report_1").prop('disabled', true);
            $.ajax({
                url: url,
                type: "POST",
                data: { "FromDate": $("#FromDate").val(), "ToDate": $("#ToDate").val() },
                success: function (result) {
                    viewbox.html(result);
                    //alert(result);
                    //debugger;
                    if (viewbox.selector == "#tab_XNT") {
                        var tablenxtx = viewbox.find($("table#nxtx tbody"));
                        MergeRow(tablenxtx);
                        var tablexn = viewbox.find($("table#xn tbody"));
                        MergeRow(tablexn);
                    } else if (viewbox.selector == "#tab_XNTTong") {
                        var table = viewbox.find($("table tbody"));
                        MergeRow(table);
                    }

                        $(viewbox).removeAttr("style");
                    },
                    error: function (result) {
                        viewbox.html('<p align="center">Không thể hiển thị danh sách</p>');
                        alert("Lỗi: Không thể tải danh sách");
                    }
            });
            $("#report_1").text("Xem báo cáo");
            $("#report_1").prop('disabled', false);
        };

        $("#btnExportExcel").click(function () {
            debugger;
            if (checkInvalidDate() == false)
                return false;
            else{
            if ($($("#myTab li.active")[0]).attr("data-url") != "/Report/CongNo") {
                var dt = new Date();
                var day = dt.getDate();
                var month = dt.getMonth() + 1;
                var year = dt.getFullYear();
                var hour = dt.getHours();
                var mins = dt.getMinutes();
