@using System.Data;

<div class="x_content">
    <div id="BCXNTTong" class="table-responsive">
        <table class="table table-striped table-bordered table-condensed">
            <thead>
                <tr class="headings">
                    <th colspan='15' class="tile">NHẬP XUẤT TỒN XE TỔNG @ViewBag.ShowRoom</th>
                </tr>
                <tr>
                    <th colspan='15'>Từ 15h ngày @DateTime.Now.AddDays(-7).ToString("dd/MM/yyyy") đến 15h ngày @DateTime.Now.ToString("dd/MM/yyyy")</th>
                </tr>
                <tr></tr>
                <tr class="headings">
                    @*<th class="column-title" rowspan="2">STT</th>*@
                    <th class="column-title" rowspan="2">LOẠI XE</th>
                    <th class="column-title" rowspan="2">MÃ XE</th>
                    <th class="column-title" rowspan="2">ĐƠN GIÁ</th>
                    <th class="column-title" rowspan="2">XUẤT XỨ</th>
                    <th class="column-title" colspan="2">TỒN ĐK</th>
                    <th class="column-title" colspan="2">NHẬP</th>
                    <th class="column-title" colspan="2">XUẤT BÁN</th>
                    <th class="column-title" colspan="2">TỒN CK</th>
                    <th class="column-title" colspan="2">THẾ CHẤP NGÂN HÀNG</th>
                    <th class="column-title" rowspan="2">LOẠI XE</th>
                </tr>
                <tr class="headings">
                    @*<th class="column-title">SL</th>*@
                    <th class="column-title">SL</th>
                    <th class="column-title">TT</th>
                    <th class="column-title">SL</th>
                    <th class="column-title">TT</th>
                    <th class="column-title">SL</th>
                    <th class="column-title">TT</th>
                    <th class="column-title">SL</th>
                    <th class="column-title">TT</th>
                    <th class="column-title">SL</th>
                    <th class="column-title">TT</th>
                </tr>
            </thead>
            <tbody>
                @{
                    if (Model != null)
                    {
                        int intCount = 1;
                        foreach (DataRow row in (ViewBag.dtbCarInOutCKD as DataTable).Rows)
                        {
                            double ThanhTienTheChap = row["ThanhTienTheChap"].ToString() == "" ? 0 : Convert.ToDouble(row["ThanhTienTheChap"]);
                            if (@row["MaModel"].ToString() == "" || @row["MaModel"].ToString() == "0" || @row["MaModel"].ToString() == "1")
                            {
                                if (@row["MaModel"].ToString() == "1")
                                {
                                    <tr class="even pointer" style="background-color:lightblue;font-weight:bold">
                                        @*<td group="@row["MaModel"]">@intCount++</td>*@
                                        <td group="@row["MaModel"]" colspan="1">@row["TenModel"]</td>
                                        <td group="@row["MaModel"]"></td>
                                        <td group="@row["MaModel"]"></td>
                                        <td group="@row["MaModel"]@row["GiaVon"].ToString().Replace(",", ".")">@row["XuatXu"]</td>
                                        <td class="number">@row["SoLuongTonKhoDauKy"].ToString().Replace(",", ".")</td>
                                        <td class="number">@row["TongTienTonKhoDauKy"].ToString().Replace(",", ".")</td>
                                        <td class="number">@row["SoLuongNhap"].ToString().Replace(",", ".")</td>
                                        <td class="number">@row["TongTienNhap"].ToString().Replace(",", ".")</td>
                                        <td class="number">@row["SoLuongXuat"].ToString().Replace(",", ".")</td>
                                        <td class="number">@row["TongTienXuat"].ToString().Replace(",", ".")</td>
                                        <td class="number">@row["SoLuongTonKhoCuoiKy"].ToString().Replace(",", ".")</td>
                                        <td class="number">@row["TongTienTonKhoCuoiKy"].ToString().Replace(",", ".")</td>
                                        <td class="number">@row["SoLuongTheChap"].ToString().Replace(",", ".")</td>
                                        <td class="number">@ThanhTienTheChap.ToString().Replace(",", ".")</td>
                                        <td></td>
                                    </tr>
                                }
                                else
                                {
                                    <tr class="even pointer" style="background-color:#ceefef;font-weight:bold">
                                        @*<td group="@row["MaModel"]">@intCount++</td>*@
                                        <td group="@row["MaModel"]" colspan="1">@row["TenModel"]</td>
                                        <td group="@row["MaModel"]"></td>
                                        <td group="@row["MaModel"]"></td>
                                        <td group="@row["MaModel"]@row["GiaVon"].ToString().Replace(",", ".")">@row["XuatXu"]</td>
                                        <td class="number">@row["SoLuongTonKhoDauKy"].ToString().Replace(",", ".")</td>
                                        <td class="number">@row["TongTienTonKhoDauKy"].ToString().Replace(",", ".")</td>
                                        <td class="number">@row["SoLuongNhap"].ToString().Replace(",", ".")</td>
                                        <td class="number">@row["TongTienNhap"].ToString().Replace(",", ".")</td>
                                        <td class="number">@row["SoLuongXuat"].ToString().Replace(",", ".")</td>
                                        <td class="number">@row["TongTienXuat"].ToString().Replace(",", ".")</td>
                                        <td class="number">@row["SoLuongTonKhoCuoiKy"].ToString().Replace(",", ".")</td>
                                        <td class="number">@row["TongTienTonKhoCuoiKy"].ToString().Replace(",", ".")</td>
                                        <td class="number">@row["SoLuongTheChap"].ToString().Replace(",", ".")</td>
                                        <td class="number">@ThanhTienTheChap.ToString().Replace(",", ".")</td>
                                        <td></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                 <tr class="even pointer">
                                @*<td group="@row["MaModel"]">@intCount++</td>*@
                                <td group="@row["MaModel"]">@row["TenModel"]</td>
                                <td group="@row["MaModel"]">@row["MaModel"]</td>
                                <td class="number" group="@row["MaModel"]@row["GiaVon"]">@row["GiaVon"].ToString().Replace(",", ".")</td>
                                <td  group="@row["MaModel"]@row["GiaVon"]">@row["XuatXu"]</td>
                                <td class="number">@row["SoLuongTonKhoDauKy"].ToString().Replace(",", ".")</td>
                                <td class="number" >@row["TongTienTonKhoDauKy"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["SoLuongNhap"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["TongTienNhap"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["SoLuongXuat"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["TongTienXuat"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["SoLuongTonKhoCuoiKy"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["TongTienTonKhoCuoiKy"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["SoLuongTheChap"].ToString().Replace(",", ".")</td>
                                <td class="number">@ThanhTienTheChap.ToString().Replace(",", ".")</td>
                                <td>@row["TenModel"]</td>
                            </tr>
                            }
                        }
                    }
                   }
            </tbody> 
        </table>

        <br />
        <table class="table table-striped table-bordered table-condensed">
            <thead>
                <tr class="headings">
                    <th colspan='5' class="tile">HÀNG TRÊN ĐƯỜNG @ViewBag.ShowRoom</th>
                </tr>
                <tr>
                    <th colspan='5'>Đến ngày @ViewBag.ToDate.ToString("dd/MM/yyyy")</th>
                </tr>
                <tr></tr>
                <tr class="headings">
                    <th rowspan="2">Nhà cung cấp</th>
                    <th rowspan="2">Đầu kỳ</th>
                    <th colspan="2">Phát sinh trong kỳ</th>
                    <th rowspan="2">Cuối kỳ</th>
                </tr>
                <tr class="headings">
                    <th>P/S Nợ</th>
                    <th>Nhập kho xe</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.HTD.Rows.Count > 0)
                {
                    foreach (DataRow row in (ViewBag.HTD as DataTable).Rows)
                    {
                        <tr>
                            <td>@row["NhaCungCap"]</td>
                            <td class="number">@row["TongDauKy"].ToString().Replace(",", ".")</td>
                            <td class="number">@row["PhatSinhNo"].ToString().Replace(",", ".")</td>
                            <td class="number">@row["TongNhapKho"].ToString().Replace(",", ".")</td>
                            <td class="number">@row["TongCuoiKy"].ToString().Replace(",", ".")</td>
                        </tr>
                    }
                }

            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $("td.number").map(function (key, val) {
        var val = $(this).html();
        //val = val.replace(",", ".");
        val = val.split(",").join("");
        val = parseFloat(val);
        $(this).html(val.toLocaleString('en-us'));
    })
</script>