@using System.Data;

@{ 
   
    double TotalChi = 0;
    int i = 1;

}

<div id="BCTongChiPhi" class="x_content">
    <div class="row col-sm-12" style="float:left">
        <div class="col-sm-12">
            <div class="table-responsive">
                <table class="table table-striped table-bordered table-condensed">
                    <thead>
                        <tr class="headings">
                            <th colspan='4' class="tile">TỔNG CHI PHÍ @ViewBag.ShowRoom</th>
                        </tr>
                        <tr class="headings">
                            <th colspan='4' class="tile">Từ ngày @ViewBag.FromDate đến @ViewBag.ToDate</th>
                        </tr>
                        <tr class="headings">
                            <th class="column-title">STT</th>
                            <th class="column-title">NỘI DUNG</th>
                            <th class="column-title">SỐ TIỀN</th>
                            <th class="column-title">GHI CHÚ</th>                           
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (DataRow row in (Model as DataTable).Rows)
                            {
                                TotalChi += row["SoTien"].ToString() == "" ? 0 : Convert.ToDouble(row["SoTien"]);
                              
                                <tr class="even pointer">
                                    <td>@(i++)</td>
                                    <td>@row["NoiDung"]</td>
                                    <td class="number">@row["SoTien"].ToString().Replace(",", ".")</td>   
                                    <td></td>                               
                                </tr>
                            }
                        }
                        <tr class="even pointer" style="background-color:lightblue;font-weight:bold">
                            <td></td>
                            <td>TỔNG CHI PHÍ</td>
                            <td class="number">@TotalChi.ToString().Replace(",", ".")</td>                           
                            <td></td>
                            @*<td></td>
                                <td></td>*@
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>



<script type="text/javascript">
    $("td.number").map(function (key, val) {
        var val = $(this).html();
        //val = val.replace(",", ".");
        val = val.split(",").join("");
        val = parseFloat(val);
        $(this).html(val.toLocaleString('en-us'));
    })
</script>