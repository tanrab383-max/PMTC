@using System.Data;
<div class="x_content">
    <div id="BCChiTamUng" class="table-responsive">
        <table class="table table-striped table-bordered table-condensed">
            <thead>
                <tr class="headings">
                    <th colspan='11' class="tile">DANH SÁCH CHI TIẾT CÁC KHOẢN TẠM ỨNG @ViewBag.ShowRoom</th>
                </tr>
                <tr>
                    <th colspan='11' class="tile">@ViewBag.TuNgayDenNgay</th>
                </tr>
                <tr class="headings">
                    <th class="column-title">STT</th>
                    <th class="column-title">Mã phiếu chi</th>
                    <th class="column-title">Ngày Chi</th>
                    <th class="column-title">Nội Dung</th>
                    <th class="column-title">Số chứng từ</th>
                    <th class="column-title">Người ứng</th>
                    <th class="column-title">Điện thoại</th>
                    <th class="column-title">Số tiền</th>
                    <th class="column-title">Thanh toán</th>
                    <th class="column-title">Còn lại</th>
                    <th class="column-title">Ngày hoàn ứng</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    double TongSoTien = 0, TongThanhToan = 0, TongConLai = 0;
                    int intCount = 0;
                    foreach (DataRow row in (Model as DataTable).Rows)
                    {
                        TongSoTien += row["TongCong"].ToString() == "" ? 0 : Convert.ToDouble(row["TongCong"]);
                        TongThanhToan += row["SoTienDaTra"].ToString() == "" ? 0 : Convert.ToDouble(row["SoTienDaTra"]);
                        TongConLai += row["SoTienConLai"].ToString() == "" ? 0 : Convert.ToDouble(row["SoTienConLai"]);
                        <tr class="even pointer">
                            <td>@(++intCount)</td>
                            <td>@row["MaPhieuChi"]</td>
                            <td>@row["NgayChi"].ToString()</td>
                            <td>@row["NoiDung"].ToString()</td>
                            <td style="text-align:left">@row["SoChungTu"].ToString()</td>
                            <td>@row["Hoten"].ToString()</td>
                            <td>@row["DienThoai"]</td>
                            <td class="number">@row["TongCong"].ToString().Replace(",", ".")</td>
                            <td class="number">@row["SoTienDaTra"].ToString().Replace(",", ".")</td>
                            <td class="number">@row["SoTienConLai"].ToString().Replace(",", ".")</td>
                            <td>@row["NgayHoanUng"].ToString()</td>
                        </tr>
                    }
                    <tr class="even pointer" style="background-color:lightblue;font-weight:bold">
                        <td colspan="7"><b>TỔNG CỘNG :</b></td>
                        <td class="number">@TongSoTien.ToString().Replace(",", ".")</td>
                        <td class="number">@TongThanhToan.ToString().Replace(",", ".")</td>
                        <td class="number">@TongConLai.ToString().Replace(",", ".")</td>
                        <td></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $("td.number").map(function (key, val) {
        var val = $(this).html();
        //val = val.replace(",", ".");
        val = val.split(",").join("");
        val = parseFloat(val);
        $(this).html(val.toLocaleString('en-us'));
    })
    $("td.numberRE").map(function (key, val) {
        var val = $(this).html();
        val = val.replace(",", ".");
        val = val.split(",").join("");
        val = parseFloat(val);
        $(this).html(val.toLocaleString('en-us'));
    })
</script>


