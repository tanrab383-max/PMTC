@using System.Data;
<div class="x_content">
    <div id="BCNoMuaPTPK" class="table-responsive">
        <table class="table table-striped table-bordered table-condensed">
            <thead>
                <tr class="headings">
                    <th colspan='10' class="tile">CÔNG NỢ MUA PHỤ TÙNG - PHỤ KIỆN @ViewBag.ShowRoom</th>
                </tr>
                <tr>
                    <th colspan='10' class="tile">@ViewBag.TuNgayDenNgay</th>
                </tr>
                <tr class="headings">
                    <th class="column-title">STT</th>
                    <th class="column-title">Ngày nợ</th>
                    <th class="column-title">Mã phiếu nợ</th>
                    <th class="column-title">Khách hàng</th>
                    <th class="column-title">Nội dung</th>
                    <th class="column-title">kho nhập</th>
                    <th class="column-title">Số tiền nợ</th>
                    <th class="column-title">Đã thanh toán</th>
                    <th class="column-title">Còn nợ</th>
                    <th class="column-title">Ngày thanh toán</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    double TongSoTien = 0, TongThanhToan = 0, TongConLai = 0;
                    int intCount = 0;
                    foreach (DataRow row in (Model as DataTable).Rows)
                    {
                        TongSoTien += row["SoTienNo"].ToString() == "" ? 0 : Convert.ToDouble(row["SoTienNo"]);
                        TongThanhToan += row["SoTienDaTra"].ToString() == "" ? 0 : Convert.ToDouble(row["SoTienDaTra"]);
                        TongConLai += row["SoTienConLai"].ToString() == "" ? 0 : Convert.ToDouble(row["SoTienConLai"]);
                        <tr class="even pointer">
                            @if (@row["DonViNo"].ToString().ToUpper().Contains("TỔNG CỘNG") == true)
                            {
                                if (@row["Hoten"].ToString() == "Tổng Cộng Tất Cả")
                                {
                                    <td group="@row["DonViNo"]" colspan="6" style="background-color:darkorange; color:blue"><b>@row["DonViNo"]</b></td>
                                    <td class="number" style="background-color:darkorange; color:blue">@row["SoTienNo"].ToString().Replace(",", ".")</td>
                                    <td class="number" style="background-color:darkorange; color:blue">@row["SoTienDaTra"].ToString().Replace(",", ".")</td>
                                    <td class="number" style="background-color:darkorange; color:blue">@row["SoTienConLai"].ToString().Replace(",", ".")</td>
                                    <td style="background-color:darkorange;"></td>
                                }
                                else
                                {
                                    <td group="@row["DonViNo"]" colspan="6" style="background-color:lightblue; color:red"><b>@row["DonViNo"]</b></td>
                                    <td class="number" style="background-color:lightblue; color:red">@row["SoTienNo"].ToString().Replace(",", ".")</td>
                                    <td class="number" style="background-color:lightblue; color:red">@row["SoTienDaTra"].ToString().Replace(",", ".")</td>
                                    <td class="number" style="background-color:lightblue; color:red">@row["SoTienConLai"].ToString().Replace(",", ".")</td>
                                    <td style="background-color:lightblue;"></td>
                                }


                            }
                            @*else if (@row["DonViNo"].ToString().ToUpper().Contains("TỔNG CỘNG THU HỘ XĂNG") == true)
                            {
                                <td group="@row["DonViNo"]" colspan="4" style="background-color:lightblue; color:red"><b>@row["DonViNo"]</b></td>
                                <td class="number" style="background-color:lightblue; color:red">@row["SoTienNo"].ToString().Replace(",", ".")</td>
                                <td class="number" style="background-color:lightblue; color:red">@row["SoTienDaTra"].ToString().Replace(",", ".")</td>
                                <td class="number" style="background-color:lightblue; color:red">@row["SoTienConLai"].ToString().Replace(",", ".")</td>
                                <td style="background-color:lightblue;"></td>

                            }*@
                            else
                            {
                                <td>@(++intCount)</td>
                                <td>@row["NgayNo"]</td>
                                <td>@row["MaPhieuNo"]</td>
                                <td>@row["TenDoiTac"].ToString()</td>
                                <td>@row["NoiDung"].ToString()</td>
                                <td>@row["TenTui"].ToString()</td>
                                <td class="number">@row["SoTienNo"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["SoTienDaTra"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["SoTienConLai"].ToString().Replace(",", ".")</td>
                                <td>@row["NgayHoanUng"].ToString()</td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $("td.number").map(function (key, val) {
        var val = $(this).html();
        //val = val.replace(",", ".");
        val = val.split(",").join("");
        val = parseFloat(val);
        $(this).html(val.toLocaleString('en-us'));
    })
    $("td.numberRE").map(function (key, val) {
        var val = $(this).html();
        val = val.replace(",", ".");
        val = val.split(",").join("");
        val = parseFloat(val);
        $(this).html(val.toLocaleString('en-us'));
    })
</script>


