@using System.Data;
@{
    double TongDauKyTotal = 0, TongCuoiKyTotal = 0, TangGiamTotal = 0, TongTangGiamTotal = 0;
    double TONGCONG = 0;
}
<div id="tab_CT">
    <div class="x_content">
        <div class="table-responsive" id="BCKiemToan_ChiTiet_div">
                <table class="table table-striped table-bordered table-condensed">
                    <thead>
                        <tr class="headings">
                            <th colspan='8' class="tile">BẢNG SO SÁNH TÀI SẢN</th>
                        </tr>
                        <tr></tr>
                        <tr class="headings">
                            <th class="column-title">DIỄN GIẢI</th>
                            <th class="column-title" colspan="3">BẢNG SO SÁNH</th>
                            <th class="column-title">CHI TIẾT</th>
                            <th class="column-title">@ViewBag.From</th>
                            <th class="column-title">@ViewBag.To</th>
                            <th class="column-title">TĂNG/GIẢM</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            double TongDauKy = 0, TongCuoiKy = 0, TangGiam = 0, TongTangGiam = 0;
                            string dau = "", cuoi = "";
                            DataView ViewTongHop = (Model as DataTable).DefaultView;
                            foreach (DataRow row in ViewTongHop.ToTable().Rows)
                            {
                                dau = @row["Nhom"].ToString();
                                TongDauKy += double.Parse(string.IsNullOrEmpty(@row["DauKy"].ToString()) ? "0" : (@row["DauKy"].ToString()));
                                TongCuoiKy += double.Parse(string.IsNullOrEmpty(@row["CuoiKy"].ToString()) ? "0" : (@row["CuoiKy"].ToString()));
                                TangGiam = double.Parse(string.IsNullOrEmpty(@row["DauKy"].ToString()) ? "0" : (@row["DauKy"].ToString())) - double.Parse(string.IsNullOrEmpty(@row["CuoiKy"].ToString()) ? "0" : (@row["CuoiKy"].ToString()));
                                TongTangGiam += TangGiam;
                                <tr class="even pointer">
                                    <td group="@row["Nhom"]">@row["Nhom"]</td>
                                    @if (@row["ID"].ToString().ToUpper() == "TỔNG CỘNG")
                                    {
                                        TongDauKyTotal += double.Parse(string.IsNullOrEmpty(@row["DauKy"].ToString()) ? "0" : (@row["DauKy"].ToString()));
                                        TongCuoiKyTotal += double.Parse(string.IsNullOrEmpty(@row["CuoiKy"].ToString()) ? "0" : (@row["CuoiKy"].ToString()));
                                        TangGiamTotal = double.Parse(string.IsNullOrEmpty(@row["CuoiKy"].ToString()) ? "0" : (@row["CuoiKy"].ToString())) - double.Parse(string.IsNullOrEmpty(@row["DauKy"].ToString()) ? "0" : (@row["DauKy"].ToString()));
                                        TongTangGiamTotal += TangGiamTotal;

                                        <td group="@row["ID"]" colspan="3" style="background-color:lightblue; color:red"><b>@row["ID"]</b></td>
                                        <td style="background-color:lightblue"></td>
                                        <td class="number" style="background-color:lightblue; color:red">@row["DauKy"].ToString().Replace(",", ".")</td>
                                        <td class="number" style="background-color:lightblue; color:red">@row["CuoiKy"].ToString().Replace(",", ".")</td>
                                        <td class="number" style="background-color:lightblue; color:red">@TangGiam.ToString().Replace(",", ".")</td>

                                    }
                                    else
                                    {
                                        <td colspan="3" group="@row["ID"]">@row["ID"]</td>
                                        <td>@row["ChiTiet"]</td>
                                        <td class="number">@row["DauKy"].ToString().Replace(",", ".")</td>
                                        <td class="number">@row["CuoiKy"].ToString().Replace(",", ".")</td>
                                        <td class="number">@TangGiam.ToString().Replace(",", ".")</td>
                                    }
                                </tr>
                                TangGiam = 0; TongDauKy = 0; TongCuoiKy = 0; TongTangGiam = 0;
                            }
                        }
                        <tr>
                            <td colspan="5" style="background-color:lightblue; color:red"><b>Tổng Cộng</b></td>
                            <td class="number" style="background-color:lightblue; color:red">@TongDauKyTotal.ToString().Replace(",", ".")</td>
                            <td class="number" style="background-color:lightblue; color:red">@TongCuoiKyTotal.ToString().Replace(",", ".")</td>
                            <td class="number" style="background-color:lightblue; color:red">@TongTangGiamTotal.ToString().Replace(",", ".")</td>
                        </tr>
                    </tbody>
                </table>
            <br />
                <table class="table table-striped table-bordered table-condensed">
                    <thead>
                        <tr class="headings">
                            <th colspan='5' class="tile">CÂN ĐỐI KQKD</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.CanDoiKQKDTang.Rows.Count > 0)
                        {
                            <tr class="headings">
                                <th colspan='5' style="text-align:center">PHÁT SINH TĂNG</th>
                            </tr>
                            double KQKDTang = 0, SoTienTotalTang = 0;
                            string dau = "";
                            foreach (DataRow row in ViewBag.CanDoiKQKDTang.Rows)
                            {
                                dau = @row["Nhom"].ToString();
                                KQKDTang += double.Parse(string.IsNullOrEmpty(@row["SoTien"].ToString()) ? "0" : (@row["SoTien"].ToString()));
                                TONGCONG += KQKDTang;
                                <tr class="even pointer">
                                    <td group="@row["Nhom"]">@row["Nhom"]</td>
                                    <td></td>
                                    @if (@row["HangMuc"].ToString().ToUpper() == "CỘNG")
                                    {
                                        SoTienTotalTang += double.Parse(string.IsNullOrEmpty(@row["SoTien"].ToString()) ? "0" : (@row["SoTien"].ToString()));

                                        <td colspan="3" style="background-color:lightblue; color:red"><b>@row["HangMuc"]</b></td>
                                        <td class="number" style="background-color:lightblue; color:red">@SoTienTotalTang.ToString().Replace(",", ".")</td>
                                    }
                                    else
                                    {
                                        <td colspan="3">@row["HangMuc"]</td>
                                        <td class="number">@row["SoTien"].ToString().Replace(",", ".")</td>
                                    }
                                </tr>
                                KQKDTang = 0; SoTienTotalTang = 0;
                            }
                        }

                        @if (ViewBag.CanDoiKQKDGiam.Rows.Count > 0)
                        {
                            <tr class="headings">
                                <th colspan='5' style="text-align:center">PHÁT SINH GIẢM</th>
                            </tr>
                            double KQKDGiam = 0, SoTienGiamTotal = 0;
                            string dau = "";
                            foreach (DataRow row in ViewBag.CanDoiKQKDGiam.Rows)
                            {
                                dau = @row["Nhom"].ToString();
                                KQKDGiam += double.Parse(string.IsNullOrEmpty(@row["SoTien"].ToString()) ? "0" : (@row["SoTien"].ToString()));
                                TONGCONG += KQKDGiam;
                                <tr class="even pointer">
                                    <td group="@row["Nhom"]">@row["Nhom"]</td>
                                    <td></td>
                                    @if (@row["HangMuc"].ToString().ToUpper() == "CỘNG")
                                    {
                                        SoTienGiamTotal += double.Parse(string.IsNullOrEmpty(@row["SoTien"].ToString()) ? "0" : (@row["SoTien"].ToString()));

                                        <td colspan="3" style="background-color:lightblue; color:red"><b>@row["HangMuc"]</b></td>
                                        <td class="number" style="background-color:lightblue; color:red">@SoTienGiamTotal.ToString().Replace(",", ".")</td>
                                    }
                                    else
                                    {
                                        <td colspan="3">@row["HangMuc"]</td>
                                        <td class="number">@row["SoTien"].ToString().Replace(",", ".")</td>
                                    }
                                </tr>
                                KQKDGiam = 0; SoTienGiamTotal = 0;
                            }
                        }
                        <tr style="background-color:lightblue; color:red">
                            <td colspan="4"><b>KQKD</b></td>
                            <td></td>
                            <td class="number" rowspan="4">@TONGCONG.ToString().Replace(",", ".")</td>
                        </tr>
                    </tbody>
                </table>
            <br />
            <table class="table table-striped table-bordered table-condensed">
                <thead>
                    <tr>
                        <th>BẢNG GÓP VỐN</th>
                        <th>SỐ TIỀN GÓP</th>
                        <th>SỐ TIỀN THỰC GÓP</th>
                        <th>TỶ LỆ</th>
                    </tr>
                </thead>
                <tbody>
                    
                    @if (ViewBag.dtBangGopVon.Rows.Count > 0)
                    {
                        double soTienGop = 0, thuGop = 0, tyLe = 0;
                        foreach (DataRow row in ViewBag.dtBangGopVon.Rows)
                        {
                            soTienGop += double.Parse(string.IsNullOrEmpty(row["SoTienGop"].ToString()) ? "0" : (row["SoTienGop"].ToString()));
                            thuGop += double.Parse(string.IsNullOrEmpty(row["ThucGop"].ToString()) ? "0" : (row["ThucGop"].ToString()));
                            tyLe += double.Parse(string.IsNullOrEmpty(row["TyLe"].ToString()) ? "0" : (row["TyLe"].ToString()));
                            <tr>
                                <td></td>
                                <td></td>
                                <td>@row["TenDoiTac"]</td>
                                <td class="number">@row["SoTienGop"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["ThucGop"].ToString().Replace(",", ".")</td>
                                <td style="text-align: right;">@row["TyLe"]%</td>
                            </tr>
                        }
                        <tr>
                            <td></td>
                            <td></td>
                            <td><b>TỔNG</b></td>
                            <td class="number">@soTienGop.ToString().Replace(",", ".")</td>
                            <td class="number">@thuGop.ToString().Replace(",", ".")</td>
                            <td style="text-align: right;">@tyLe%</td>
                        </tr>
                    }
                    
                </tbody>
            </table>
        </div>

    </div>
    <br />
</div>

<script type="text/javascript">
    $("td.number").map(function (key, val) {
        var val = $(this).html();
        val = val.split(",").join("");
        val = parseFloat(val);
        $(this).html(val.toLocaleString('en-us'));
    })
</script>