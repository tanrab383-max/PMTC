@using System.Data;

<div class="x_content">
    <div id="BC_CNO" class="table-responsive">
        <table class="table table-striped table-bordered table-condensed">
            <thead>
                <tr class="headings">
                    <th colspan='6' class="tile">DANH SÁCH NỢ BẢO HIỂM DỊCH VỤ CHỜ PHÂN BỔ @ViewBag.ShowRoom</th>
                </tr>
                <tr>
                    <th colspan='6' class="tile">@ViewBag.TuNgayDenNgay</th>
                </tr>
                <tr class="headings">
                    <th class="column-title" rowspan="2">STT</th>
                    <th class="column-title" rowspan="2">TÊN ĐƠN VỊ</th>
                    <th class="column-title" rowspan="2">NỢ ĐẦU <br /> @(ViewBag.FromDate.ToString("dd/MM"))</th>
                    <th class="column-title" colspan="2">ĐÃ THU CHỜ PB</th>
                    <th class="column-title" rowspan="2">NỢ CUỐI <br /> @(ViewBag.ToDate.ToString("dd/MM"))</th>
                </tr>
                <tr>
                    <th class="column-title">PHÁT SINH</th>
                    <th class="column-title">PHÂN BỔ</th>
                </tr>

            </thead>
            <tbody>
                @if (Model != null)
                {
                    DataView ViewTongHop = (Model as DataTable).DefaultView;
                    foreach (DataRow row in ViewTongHop.ToTable().Rows)
                    {
                        <tr class="even pointer">
                            @if (@row["DonViNo"].ToString().ToUpper() == "TỔNG CỘNG")
                            {
                                <td group="@row["DonViNo"]" colspan="2" style="background-color:lightblue; color:red"><b>@row["DonViNo"]</b></td>
                                <td class="number" style="background-color:lightblue; color:red">@row["NoDauKy"].ToString().Replace(",", ".")</td>
                                <td class="number" style="background-color:lightblue; color:red">@row["PhatSinhNo"].ToString().Replace(",", ".")</td>
                                <td class="number" style="background-color:lightblue; color:red">@row["PhanBo"].ToString().Replace(",", ".")</td>
                                <td class="number" style="background-color:lightblue; color:red">@row["NoCuoiKy"].ToString().Replace(",", ".")</td>
                            }
                            else
                            {
                                <td>@row["Row#"]</td>
                                <td>@row["DonViNo"]</td>
                                <td class="number">@row["NoDauKy"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["PhatSinhNo"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["PhanBo"].ToString().Replace(",", ".")</td>
                                <td class="number">@row["NoCuoiKy"].ToString().Replace(",", ".")</td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $("td.number").map(function (key, val) {
        var val = $(this).html();
        //val = val.replace(",", ".");
        val = val.split(",").join("");
        val = parseFloat(val);
        $(this).html(val.toLocaleString('en-us'));
    })
</script>


