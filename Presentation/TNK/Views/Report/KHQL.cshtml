
@{
    ViewBag.Title = "KHQL";
}
<div class="">
    <div class="page-title">
        <div class="title_left">
            <h3>BÁO CÁO KHÁCH HÀNG QUAY LẠI</h3>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 col-sm-12 col-xs-12">
            <div class="x_panel">
                <div class="x_content">
                    <br />
                    <form id="demo-form2" data-parsley-validate class="form-horizontal form-label-left">
                        <div class="row">
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label>Từ ngày</label>
                                    <input type="text" id="FromDate" required="required" class="form-control date" />
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label>Đến ngày</label>
                                    <input type="text" id="ToDate" required="required" class="form-control date" />
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label>Chu kỳ</label>
                                    <div class="row">
                                        <div class="col-sm-4">
                                            <input type="text" id="Cycle" required="required" class="form-control" />
                                        </div>
                                        <div class="col-sm-8">
                                            <input type="text" id="Cycle1" required="required" class="form-control" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label>Cửa hàng</label>
                                    <select id="Store" multiple="true" class="multiselect form-control">
                                        <option value="PT1Wing1">PT 1 & Wing 1</option>
                                        <option value="PT2">PT 2</option>
                                        <option value="PT3">PT 3</option>
                                        <option value="PT4">PT 4</option>
                                        <option value="PT5Wing5">PT 5 & Wing 5</option>
                                        <option value="PT6">PT 6</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="form-group">
                                <div class="col-md-6 col-sm-6 col-xs-12 col-md-offset-3">
                                    <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> Báo cáo tổng</button>
                                    <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> Báo cáo so sánh</button>
                                    <button type="submit" class="btn btn-primary"><i class="fa fa-file-excel-o"></i> Xuất excel</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="x_content">
                    <div class="table-responsive">
                        <table class="table table-striped jambo_table bulk_action">
                            <thead>
                                <tr class="headings">
                                    <th class="column-title">Lượt</th>
                                    <th class="column-title">Biển số xe </th>
                                    <th class="column-title">Số lượng KQL </th>
                                    <th class="column-title">Tỷ lệ KQL </th>
                                    <th class="column-title">SL quay lại </th>
                                    <th class="column-title">TL quay lại </th>
                                    <th class="column-title">SL quay lại sớm </th>
                                    <th class="column-title">TL quay lại sớm </th>
                                    <th class="column-title">SL quay lại đúng chu kỳ </th>
                                    <th class="column-title">TL quay lại đúng chu kỳ </th>
                                    <th class="column-title">SL quay lại gia hạn </th>
                                    <th class="column-title">TL quay lại gia hạn </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="even pointer">
                                    <td class=" ">124</td>
                                    <td class=" ">122</td>
                                    <td class=" ">118</td>
                                    <td class=" ">96.72</td>
                                    <td class=" ">4</td>
                                    <td class=" ">3.28%</td>
                                    <td class=" ">4</td>
                                    <td class=" ">3.28%</td>
                                    <td class=" ">0</td>
                                    <td class=" ">0.00%</td>
                                    <td class=" ">0</td>
                                    <td class=" ">0.00%</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="row"><div class="col-sm-5"><div class="dataTables_info" id="datatable-keytable_info" role="status" aria-live="polite">Hiển thị 1 - 2 / 40 dòng dữ liệu</div></div><div class="col-sm-7"><div class="dataTables_paginate paging_simple_numbers" id="datatable-keytable_paginate"><ul class="pagination" style="margin:0; "><li class="paginate_button previous disabled" id="datatable-keytable_previous"><a href="#" aria-controls="datatable-keytable" data-dt-idx="0" tabindex="0">Trở về</a></li><li class="paginate_button active"><a href="#" aria-controls="datatable-keytable" data-dt-idx="1" tabindex="0">1</a></li><li class="paginate_button "><a href="#" aria-controls="datatable-keytable" data-dt-idx="2" tabindex="0">2</a></li><li class="paginate_button "><a href="#" aria-controls="datatable-keytable" data-dt-idx="3" tabindex="0">3</a></li><li class="paginate_button "><a href="#" aria-controls="datatable-keytable" data-dt-idx="4" tabindex="0">4</a></li><li class="paginate_button "><a href="#" aria-controls="datatable-keytable" data-dt-idx="5" tabindex="0">5</a></li><li class="paginate_button "><a href="#" aria-controls="datatable-keytable" data-dt-idx="6" tabindex="0">6</a></li><li class="paginate_button next" id="datatable-keytable_next"><a href="#" aria-controls="datatable-keytable" data-dt-idx="7" tabindex="0">Tiếp theo</a></li></ul></div></div></div>
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts
{
    <script>
        $(document).ready(function () {
            $('.date').daterangepicker({
                singleDatePicker: true,
                calender_style: "picker_2"
            }, function (start, end, label) {
                console.log(start.toISOString(), end.toISOString(), label);
            });

            $("select.multiselect").multiselect({
                noneSelectedText: '-- Tất cả --',
                multiple: true,
            }).multiselectfilter();
        });
    </script>

}