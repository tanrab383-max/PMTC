@using System.Data;

@{
    DateTime ToDate = ViewBag.ToDate;
    DateTime FromDate = ViewBag.FromDate;
    double TotalThuCoc = 0, TotalChiCoc = 0, TotalTonDauKy = 0, TotalCuoiKy = 0;
}

<div class="x_content">
    <div id="BCCocPT" class="table-responsive">
        <table class="table table-striped table-bordered table-condensed">
            <thead>
                <tr class="headings">
                    <th colspan='9' class="tile">BẢNG KÊ THU - CHI CỌC DỊCH VỤ @ViewBag.ShowRoom</th>
                </tr>
                <tr>
                    <th colspan='9' class="tile">@ViewBag.TuNgayDenNgay</th>
                </tr>
                <tr class="headings">
                    <th colspan='9' class="tile">Đến ngày @ToDate.Day tháng @ToDate.Month năm @ToDate.Year</th>
                </tr>
                <tr></tr>
                <tr class="headings">
                    <th class="column-title">STT</th>
                    <th class="column-title">NGÀY</th>
                    <th class="column-title">SỐ XE</th>
                    <th class="column-title">TÊN ĐƠN VỊ</th>
                    <th class="column-title">ĐẦU KỲ <br />(@ToDate.ToString("1/1/yyyy"))</th>
                    <th class="column-title">THU CỌC</th>
                    <th class="column-title">NGÀY CHI CỌC</th>
                    <th class="column-title">CHI CỌC</th>
                    <th class="column-title">CUỐI KỲ <br />(@ToDate.ToString("dd/MM/yyyy"))</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    int intCount = 0;
                    foreach (DataRow row in (Model as DataTable).Rows)
                    {
                        TotalThuCoc += row["ThuCoc"].ToString() == "" ? 0 : Convert.ToDouble(row["ThuCoc"]);
                        TotalChiCoc += row["ChiCoc"].ToString() == "" ? 0 : Convert.ToDouble(row["ChiCoc"]);
                        TotalTonDauKy += row["TonDauKy"].ToString() == "" ? 0 : Convert.ToDouble(row["TonDauKy"]);
                        TotalCuoiKy += row["CuoiKy"].ToString() == "" ? 0 : Convert.ToDouble(row["CuoiKy"]);

                    <tr class="even pointer">
                        <td>@(++intCount)</td>
                        <td>@row["NgayThu"]</td>
                        <td>@row["BienSo"]</td>
                        <td>@row["DonVi"]</td>
                        <td class="number">@row["TonDauKy"].ToString().Replace(",", ".")</td>
                        <td class="number">@row["ThuCoc"].ToString().Replace(",", ".")</td>
                        <td>@row["NgayChiCoc"]</td>
                        <td class="number">@row["ChiCoc"].ToString().Replace(",", ".")</td>
                        <td class="number">@row["CuoiKy"].ToString().Replace(",", ".")</td>
                    </tr>
                    }
                }
                <tr class="even pointer" style="background-color:lightblue;font-weight:bold">
                    <td colspan="4">TỔNG</td>
                    <td class="number">@TotalTonDauKy.ToString().Replace(",", ".")</td>
                    <td class="number">@TotalThuCoc.ToString().Replace(",", ".")</td>
                    <td></td>
                    <td class="number">@TotalChiCoc.ToString().Replace(",", ".")</td>
                    <td class="number">@TotalCuoiKy.ToString().Replace(",", ".")</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $("td.number").map(function (key, val) {
        var val = $(this).html();
        //val = val.replace(",", ".");
        val = val.split(",").join("");
        val = parseFloat(val);
        $(this).html(val.toLocaleString('en-us'));
    })
</script>