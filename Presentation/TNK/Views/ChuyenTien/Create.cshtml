@model TNK.Model.PhieuChuyenTienModel
@{
    var item = Model.Item;
    var CTPT = Model.CTPT;
    var HTTT = Model.HTTT;
    var VTKTNH = Model.VTKTNH;
    double tongcong = 0;
}


<div class="page-title">
    <div class="title_left">
        <h3>@ViewBag.Title</h3>
    </div>
</div>
<div class="clearfix"></div>
<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_panel">
            <div class="x_title">
                <h2><b>Thông tin</b></h2>
                <ul class="nav navbar-right panel_toolbox">
                    <li>
                        <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                    </li>
                </ul>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">
                <form id="form-data" method="post" class="form-horizontal form-label-left">
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(x => item.MaPhieu)
                    @Html.HiddenFor(x => item.MaLoaiPhieu)
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="row">
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Số chứng từ (*)</label>
                                @Html.EditorFor(x => item.SoChungTu, new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "10", @required = "" } })
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Ngày chuyển</label>
                                <input type="text" class="form-control input-sm date " name="item.NgayChuyen" value="@item.NgayChuyen.ToString(ViewBag.DateFormat)" required />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label>Nội dung</label>
                                @Html.TextAreaFor(x => item.NoiDung, new { @class = "form-control input-sm" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label>Thanh toán</label>
                                <table id="ThanhToan" class="table table-striped jambo_table bulk_action">
                                    <thead>
                                        <tr>
                                            <th style="width:20%">Tài khoản chi</th>
                                            <th style="width:30%">Số tiền</th>
                                            <th style="width:20%">Tài khoản thu</th>
                                            <th style="width:30%">Số tham chiếu</th>
                                            <th>Treo</th>
                                            @*<th></th>*@
                                        </tr>
                                    </thead>
                                    <tbody id="tbody">
                                        @for (int j = 0; j < CTPT.Count; j++)
                                        {
                                            tongcong += CTPT[j].SoTienThanhToan;
                                            <tr id="tr" class="animated fadeIn">
                                                <td>
                                                    <input type="hidden" name="httt[@j].Id" class="CTPTId" value="@CTPT[j].Id" />
                                                    <select  class="select2 fullwidth Temp" name="httt[@j].TaiKhoanNguon">
                                                        <option value="">Chọn</option>
                                                        @foreach (var i in HTTT)
                                                        {
                                                            <option value="@i.GiaTri" @((CTPT[j].TaiKhoanNguon + "-" + CTPT[j].HinhThucThanhToan) == i.GiaTri ? "selected" : "")>@i.HienThi</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td><input  type="text" name="httt[@j].SoTienThanhToan" onchange="CalThanhToan(this)" value="@CTPT[j].SoTienThanhToan" class="form-control input-sm number" /></td>
                                                <td>
                                                    <select  class="select2 fullwidth TempThu" name="httt[@j].TaiKhoanDich">
                                                        <option value="">Chọn</option>
                                                        @foreach (var i in VTKTNH)
                                                        {
                                                            <option value="@i.MaNganHang" @(CTPT[j].TaiKhoanDich == i.MaNganHang ? "selected" : "")>@i.MaNganHang</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td><input name="httt[@j].SoThamChieu" value="@CTPT[j].SoThamChieu" class="form-control input-sm SoThamChieu" /></td>
                                                <td>
                                                    <input type="checkbox" class="chkTinhTrang" @(CTPT[j].TinhTrang ? "checked" : "") />
                                                    <input type="hidden" class="TinhTrang" name="httt[@j].TinhTrang" value="@CTPT[j].TinhTrang" />
                                                    <input type="hidden" class="IsDeleted" name="httt[@j].IsDeleted" value="false" />
                                                </td>
                                                @*<td><i class="fa fa-remove" onclick="Remove(this)" style="cursor:pointer"></i></td>*@
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td>Tổng cộng: </td>
                                            <td class="Total">@tongcong</td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            @*<td class="right"><i class="fa fa-plus addHTTT" style="cursor:pointer"></i></td>*@
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label>Ghi chú</label>
                                @Html.TextAreaFor(x => item.GhiChu, new { @class = "form-control input-sm" })
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12">
                            <div class="form-group">
                                <label>Kế toán trưởng</label>
                                @Html.DropDownList("item.KeToanTruong", Model.Users.Select(x => new SelectListItem { Text = x.UserName, Value = x.UserId.ToString() }), "Chọn", new { @class = "select2 fullwidth"})
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12">
                            <div class="form-group">
                                <label>Người lập phiếu</label>
                                @Html.DropDownList("item.NguoiLapPhieu", Model.Users.Select(x => new SelectListItem { Text = x.UserName, Value = x.UserId.ToString() }), "Chọn", new { @class = "select2 fullwidth" })
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12">
                            <div class="form-group">
                                <label>Người nộp tiền</label>
                                @Html.DropDownList("item.NguoiNopTien", Model.Users.Select(x => new SelectListItem { Text = x.UserName, Value = x.UserId.ToString() }), "Chọn", new { @class = "select2 fullwidth" })
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12">
                            <div class="form-group">
                                <label>Người thu tiền (*)</label>
                                @Html.DropDownList("item.NguoiThuTien", Model.Users.Select(x => new SelectListItem { Text = x.UserName, Value = x.UserId.ToString() }), "Chọn", new { @class = "select2 fullwidth"})
                            </div>
                        </div>
                    </div>
                    <div class="ln_solid"></div>
                    <div class="form-group center">
                        <div class="col-md-6 col-sm-6 col-xs-12 col-md-offset-3">
                            @if (ViewBag.Action == "Create")
                            {
                            <input type="submit" name="submit" id="Create" value="Lưu" class="btn btn-success" />
                            }
                            @*<input type="submit" name="submit" id="New" value="Lưu và thêm mới" class="btn btn-success" />*@
                        </div>
                    </div>
                    <div class="ln_solid"></div>
                </form>
            </div>
        </div>
    </div>
</div>
<a href="/ChuyenTien/Index">Quay lại</a>

@section scripts
{
    <link href="~/assests/plugins/select2/select2.css" rel="stylesheet" />
    <script src="~/assests/plugins/select2/select2.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/SoThuCommon.js"></script>
    <script>
        i = '@Model.CTPT.Count';
        $(".addHTTT").click(function () {
            var html = tr.split("httt[0]").join("httt[" + i + "]");
            @if(Model.CTPT.Count>0)
            {
             @Html.Raw("html=html.replace('" + Model.CTPT[0].Id+"','');")
             @Html.Raw("html=html.replace('" + Model.CTPT[0].SoTienThanhToan+"','');")
             @Html.Raw("html=html.replace('selected','');")
             @Html.Raw("html=html.replace('" + Model.CTPT[0].SoThamChieu + "','');")
            }
            $("#tbody").append("<tr>" + html + "</tr>");
            i++;
            setTimeout(function () {
                $('.select2').select2({
                    placeholder: "Select an option",
                    allowClear: true
                });
                removeSelect();
            }, 200);
        })
        $(document).on("change", ".number", function () {
            var val = $(this).val();
            if (val != "") {
                val = val.split(",").join("");
                val = parseInt(val);
               // val = val * 1000;
                $(this).val(val.toLocaleString('en-us'));
            }
            else {
                $(this).val(0);
            }
            let total = 0;
        });
        $("#form-data").submit(function () {
            let flag = true;
            $("#tbody").find("tr").map(function (key, val) {
                var tuitien = $(val).find(".Temp").select2('val');
                var sotien = $(val).find(".number").val().split(",").join("");
                var taikhoanthu = $(val).find(".TempThu").select2('val');
                tuitien = tuitien == "Chọn" ? "" : tuitien;
                sotien = sotien == "" ? 0 : parseInt(sotien);
                if ((tuitien != "" || taikhoanthu!="") && sotien === 0) {
                    toastWarning("Vui lòng nhập số tiền");
                    $(val).find(".number").focus();
                    flag = false;
                    return;
                }
                if ((tuitien == "" || taikhoanthu == "") && sotien != 0) {
                    toastWarning("Vui lòng nhập tài khoản");
                    $(val).find(".Temp").focus();
                    flag = false;
                    return;
                }
            })
            if (!flag) {
                return false;
            }
            var lst = $(".number");
            lst.map(function (key, val) {
                $(val).val($(val).val().split(",").join(""));
            });
        })
    </script>
}