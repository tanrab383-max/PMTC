@model List<TNK.Core.Domain.View.ViewNoDaTra>
@{
    Layout = null;
    int i = 1;
}

<table class="table">
    <thead>
        <tr class="success">
            <th>STT</th>
            <th>Ma phiếu chi</th>
            <th>Mã phiếu nợ</th>
            <th>Ngày chi</th>
            <th>Chứng từ chi</th>
            <th>Khách hàng</th>
            <th>Số tiền nợ</th>
            <th>Số tiền thanh toán</th>
            <th>Số tiền còn lại</th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@(ViewBag.PageSize * (ViewBag.PageIndex - 1) + i)</td>
                <td>@item.MaPhieuChi</td>
                <td>@Html.Raw(HttpUtility.HtmlDecode(item.SoPhieuQuyetToan))</td>
                <td>@item.NgayChi.ToString("dd/MM/yyyy")</td>
                <td>@item.ChungTuThu</td>
                <td>@item.Hoten</td>
                <td>@TNK.Core.Common.ToCurrencyString(item.SoTienNo)</td>
                <td>@TNK.Core.Common.ToCurrencyString(item.SoTienThanhToan)</td>
                <td style="width:5%" class="center">
                    <a href="/SoChi/PhieuChiHoEdit/@item.SoPhieuQuyetToan?type=@ViewBag.Type"><i title="View" class="fa fa-eye"></i></a>
                </td>
                <td style="width:5%" class="center">
                    <a href="javascript:;" onclick="DeletePhieuChi(this,'@item.MaPhieuChi')"><i title="Delete" class="fa fa-close"></i></a>
                </td>
            </tr>
            i++;
        }
    </tbody>
</table>
<div class="right">
    @Html.Partial("~/Views/Shared/_Paging_v2.cshtml")
</div>



