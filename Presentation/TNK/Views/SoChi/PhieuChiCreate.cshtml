@model TNK.Model.SoChiModel
@{
    var item = Model.VNPT;
    if (item.LoaiPhieuNo == "N2GTX")
    {
        item.KhachHang = item.ThongTinKhac;
    }
    string[] list = { "NTHPK", "CTHBH", "NBHBX", "NPTPK", "NTHBH", "NGCNG","NKHAC" };
    var flag = list.Contains((string)ViewBag.Type);
    string ids = ViewBag.Id;
    item.SoTienConLai = Math.Ceiling(item.SoTienConLai);
    if (ViewBag.Type == "NMPTU" && ViewBag.SoTienChi != null)
    {
        item.SoTienConLai = item.SoTienConLai - ViewBag.SoTienChi;
    }
    if (ViewBag.Type == "N2THK" && ViewBag.SoTienChi != null)
    {
        item.SoTienConLai = item.SoTienConLai - ViewBag.SoTienChi;
    }
    if ((ViewBag.Type == "NGCNG" || ViewBag.Type == "HHTXE") && ViewBag.SoTienChi != null)
    {
        item.SoTienConLai = item.SoTienConLai - ViewBag.SoTienChi;
    }
    if ((ViewBag.Type == "N2GTX"  || ViewBag.Type == "NKHAC") && ViewBag.SoTienChi != null)
    {
        item.SoTienConLai = item.SoTienConLai - ViewBag.SoTienChi;
    }
}

<div class="page-title">
    <div class="title_left">
        <h3>@ViewBag.Title</h3>
    </div>
</div>
<div class="clearfix"></div>
<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_panel">
            <div class="x_title">
                <h2><b>Thông tin</b></h2>
                <ul class="nav navbar-right panel_toolbox">
                    <li>
                        <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                    </li>
                </ul>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">
                <form method="post" id="form-data" class="form-horizontal form-label-left FormPhieuChi">
                    <input type="hidden" name="item.HoTen" value="@item.KhachHang" />
                    <input type="hidden" name="item.MaLoaiPhieu" value="@item.LoaiPhieuNo" />
                    <input type="hidden" name="item.MaPhieuLienQuan" value="@item.MaPhieuNo" />
                    <input type="hidden" id="type" value="@item.LoaiPhieuNo" />
                    <input type="hidden" name="ChuoiUpdatedDate" value="@ViewBag.ChuoiUpdatedDate" />
                    @Html.HiddenFor(x => item.DiaChi)
                    @Html.HiddenFor(x => item.SoHopDong)
                    @Html.HiddenFor(x => item.BienSo)
                    @Html.Hidden("item.DoiTac", item.DonViNo)
                    @Html.Hidden("Ids", ids)
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12">
                            <div class="form-group">
                                <label>Số chứng từ (*)</label>
                                @Html.Editor("item.SoChungTu", new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "10", @value = item.ChungTuThu } })
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12">
                            <div class="form-group">
                                <label>Ngày chi</label>
                                <input type="text" class="form-control input-sm date1 " name="item.NgayChi" value="@DateTime.Now.ToString("dd/MM/yyyy")" />
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12">
                            <div class="form-group">
                                <label>Ngày hoạch toán</label>
                                <input type="text" class="form-control input-sm date1 " name="item.NgayHachToan" value="@DateTime.Now.ToString("dd/MM/yyyy")" />
                            </div>
                        </div>
                        @if(ViewBag.Type == "NTOHO")
                        {
                        <div class="col-md-3 col-sm-3 col-xs-12">
                            <div class="form-group">
                                <label>Lý Do Chi (*)</label>
                                <input type="text" class="form-control input-sm " disabled name="item.LyDoChi" value="@item.LyDoChi" />
                            </div>
                        </div>
                        }
                        @if (ViewBag.Type == "NGCNG")
                        {
                            
                            <div class="col-md-3 col-sm-3 col-xs-12">
                                <div class="form-group">
                                    <label>Nhà cung cấp (*)</label>
                                    @Html.DropDownList("item.NhaCungCap", Model.DoiTac.Select(x => new SelectListItem { Text = x.TenDoiTac, Value = x.MaDoiTac }), "Chọn", new { @class = "select2 fullwidth", @id = "NCC", @onchange = "DanhSachCoc(this)" })
                                </div>
                            </div>
                        }
                        @*@if (ViewBag.Type == "NGCNG")
                        {
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Nhà cung cấp (*)</label>
                                    Html.DropDownListFor(x => item.DoiTac, Model.DoiTac.Select(x => new SelectListItem { Text = x.TenDoiTac, Value = x.MaDoiTac }), "Chọn", new { @class = "select2 fullwidth", @id = "NCC", @onchange = "DanhSachCoc(this)" })
                                    <select name="item.DoiTac" id="NCC" onchange="DanhSachCoc(this)" class="select2 fullwidth">
                                        <option>Chọn</option>
                                        @foreach(var NCC in Model.DoiTac)
                                        {
                                            <option value="@NCC.MaDoiTac">@NCC.TenDoiTac</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        }*@
                    </div>
                    
                    <div class="row">
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label>Thông tin KH</label>
                                <textarea class="form-control input-sm" rows="3" readonly>@Html.Raw(item.KhachHang)</textarea>
                            </div>
                        </div>
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label>Nội dung (*)</label>
                                @Html.TextArea("item.NoiDung", new { @class = "form-control input-sm" })
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Số tiền nợ</label>
                                <input type="text" class="form-control input-sm SoTienNo" id="SoTienNo" readonly value="@(TNK.Core.Common.ToCurrencyString(item.SoTienNo))" />
                            </div>
                        </div>
                        @if (ViewBag.Type == "NBHBX" || ViewBag.Type == "NTHBH")
                        {
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Hoa hồng</label>
                                    @if (item.HoaHong != null)
                                    {
                                        <input type="text" name="item.HoaHong" class="form-control input-sm number" readonly value="@(TNK.Core.Common.ToCurrencyString(item.HoaHong.Value))" />
                                    }
                                    else
                                    {
                                        <input type="text" name="item.HoaHong" class="form-control input-sm number" readonly value="0" />
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    @if (ViewBag.Type == "NGCNG")
                    {
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group table-responsive">
                                <label>Cọc: </label>
                                <table class="table table-striped jambo_table bulk_action" id="Coc">
                                    <thead>
                                        <tr>
                                            <th>Mã Phiếu Cọc</th>
                                            <th>Số tiền có thể sử dụng</th>
                                            <th>Số tiền sử dụng</th>
                                            <th>Còn lại</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody id="DS_ChiCoc"></tbody>
                                    <tfoot>
                                        <tr>
                                            <td>Tổng cộng: </td>
                                            <td class="number" id="TongCongThanhToanCoc"></td>
                                            <td class="number" name="CTPC.SoTienThanhToan" id="TongSoTienChi">0</td>
                                            <td></td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    }
                    @if (flag || ViewBag.Type == "NMPTU" || ViewBag.Type == "N2THK" || ViewBag.Type == "N2GTX")
                    {
                        <div class="row" style="display:none">
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Còn nợ</label>
                                    @if (ViewBag.Type == "NMPTU" || ViewBag.Type == "N2THK" || ViewBag.Type == "N2GTX")
                                    {
                                        <input type="text" id="SoTienConNo" class="form-control input-sm" readonly value="@(Math.Round(item.SoTienConLai))" />
                                    }
                                    else
                                    {
                                        <input type="text" id="SoTienConNo" class="form-control input-sm" readonly value="@(Math.Round(item.SoTienConLai))" />
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    @if (!flag || ViewBag.Type != "NMPTU" || ViewBag.Type == "N2THK" || ViewBag.Type == "N2GTX")
                    {
                        <div class="row">
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Còn nợ</label>
                                    <input type="text" class="form-control input-sm number" readonly value="@item.SoTienConLai" />
                                </div>
                            </div>
                        </div>
                    }
                    <div class="row">
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            @Html.Partial("~/Views/Shared/_ThanhToanChi.cshtml", null, new ViewDataDictionary { { "CTPT", Model.CTPT }, { "HTTT", Model.HTTT } })
                        </div>
                    </div>
                    @if (flag)
                    {
                        <div class="row" style="display:none">
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Còn lại</label>
                                    <input type="text" class="form-control input-sm number" readonly value="@item.SoTienConLai" id="ConLai" />
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row">
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Còn lại</label>
                                    <input type="text" class="form-control input-sm number" readonly value="@item.SoTienConLai" id="ConLai" />
                                </div>
                            </div>
                        </div>
                    }
                    <div class="row">
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label>Ghi chú</label>
                                @Html.TextAreaFor(x => item.GhiChu, new { @class = "form-control input-sm" })
                            </div>
                        </div>
                        @Html.Partial("~/Views/Common/UserComfirm.cshtml", null, new ViewDataDictionary { { "User", Model.Users } })
                    </div>
                    <div class="ln_solid"></div>
                    <div class="form-group center">
                        <div class="col-md-6 col-sm-6 col-xs-12 col-md-offset-3">
                            <input type="submit" name="submit" id="Create" value="Lưu" class="btn btn-success" />
                        </div>
                    </div>
                    <div class="ln_solid"></div>
                </form>
            </div>
        </div>
    </div>
</div>
<a href="@ViewBag.LinkIndex" class="Back">Quay lại</a>
@section scripts
{
    <script src="~/Scripts/IndexCommon.js"></script>
    <link href="~/assests/plugins/select2/select2.css" rel="stylesheet" />
    <link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <script src="~/assests/plugins/select2/select2.min.js"></script>
    <script src="~/Scripts/jquery-ui.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/SoThuCommon.js?@DateTime.Now"></script>

    <script>
        i = '@Model.CTPT.Count';
        var type = '@list.Contains((string) ViewBag.Type)';
        if ("@ViewBag.Type" == "NMPTU" || "@ViewBag.Type" == "N2THK" || "@ViewBag.Type" == "NGCNG" || "@ViewBag.Type" == "HHTXE" || "@ViewBag.Type" == "N2GTX") {
            var MPLQ = "@ViewBag.MPLQ";
        }
        @*$(".addHTTT").click(function () {
            var html = tr.split("httt[0]").join("httt[" + i + "]");
            @if(Model.CTPT.Count>0)
            {
             @Html.Raw("html=html.replace('" + Model.CTPT[0].Id+"','');")
             @Html.Raw("html=html.replace('" + Model.CTPT[0].SoTienThanhToan+"','');")
             @Html.Raw("html=html.replace('selected','');")
             @Html.Raw("html=html.replace('" + Model.CTPT[0].SoThamChieu + "','');")
            }
            $("#tbody").append("<tr>" + html + "</tr>");
            i++;
            setTimeout(function () {
                $('.select2').select2({
                    placeholder: "Select an option",
                    allowClear: true
                });
                removeSelect();
            }, 200);
        })*@
        $(".addHTTT").click(function () {
            debugger;

            // Tạo bản sao từ template mẫu `tr`
            // Biến `tr` nên lưu HTML gốc của dòng đầu tiên lúc load page
            var html = tr.split("httt[0]").join("httt[" + i + "]");
            @if (Model.CTPT.Count > 0)
            {
                 @Html.Raw("html=html.replace('" + Model.CTPT[0].Id + "','');")
            }
            // Bỏ disabled nếu có
            if (html.indexOf("disabled") > 0) {
                html = html.split("disabled").join("");
            }

            // Chuyển sang DOM để thao tác an toàn
            var $tempRow = $("<tr>" + html + "</tr>");

            // Reset các input text, number, textarea
            $tempRow.find("input[type='text'], input[type='number'], textarea").val("");

            // Reset các select (giữ nguyên option và value của option)
            $tempRow.find("select").each(function () {
                $(this).val("").trigger("change");
            });

            // Thêm dòng vào table
            $("#tbody").append($tempRow);

            i++;

            // Khởi tạo lại select2 cho select mới
            setTimeout(function () {
                $('.select2').select2({
                    placeholder: "Select an option",
                    allowClear: true
                });
                removeSelect(); // nếu hàm này bạn dùng để xử lý khác
            }, 200);
        });

        var sotienno = '@item.SoTienNo';
        var conno = '@item.SoTienConLai';
        function Cal() {
            setTimeout(function () {
                debugger;
                let total = 0;
                $("table").find(".number").map(function (key, val) {
                    let number = $(this).val();
                    if (number != "") {
                        number = number.split(",").join("");
                        number = parseInt(number);
                        total += number;
                        $(".Total").html(total.toLocaleString('en-us'));
                    }
                });
                $("#ConLai").val((conno - total).toLocaleString('en-us'));

            }, 0);
        }
        $("form").submit(function () {
            debugger;
            if ($("#type").val() != "NGCNG")
                Cal();
            if ($("#type").val() == "NGCNG"  ) {
                debugger;
                var SoTienNo = parseInt($("#SoTienNo").val().split(",").join(""));
                var TongSoTienChi = $("#TongSoTienChi").val();
                var TongCongThanhToan = $("#TongCongThanhToan").val();

                if (TongSoTienChi != "")
                    TongSoTienChi = parseInt($("#TongSoTienChi").val().split(",").join(""));
                else
                    TongSoTienChi = 0;
                if (TongCongThanhToan != "")
                    TongCongThanhToan = parseInt($("#TongCongThanhToan").val().split(",").join(""));
                else
                    TongCongThanhToan = 0;
                var TongCong = TongSoTienChi + TongCongThanhToan;
                if (SoTienNo != TongCong) {
                    toastWarning("Tổng cọc và thanh toán phải bằng số tiền nợ.");
                    return false;
                }
            }
            //if($("#type").val() == "NTOHO") {
            //    debugger;
            //    var SoTienNo = parseInt($("#SoTienNo").val().split(",").join(""));
            //    var TongCongThanhToan = $("#TongCongThanhToan").val();
            //    if (SoTienNo != TongCongThanhToan) {
            //        toastWarning("Bạn không thể vừa nhập thanh toán vừa treo nợ đối với chi phí. Vui lòng liên hệ phòng KTNB.");
            //        return false;
            //    }
            //}
            if (type == "True") {
                if ($("#type").val() != "NBHBX" && $("#type").val() != "NTHBH" && $("#type").val() != "HHTXE" && $("#type").val() != "NGCNG")
                {
                    let number = parseInt($("#ConLai").val().split(",").join(""));

                    var list = '@Model.VNPT.MaPhieuNo'.split(';');
                    if (number > 0 && ($("#type").val() != "NKHAC" || list.length > 1)) {
                        toastError("Vui lòng nhập số tiền thanh toán bằng đúng số tiền nợ");
                        return false;
                    }
                }
            }

            var a = $("#ConLai").length;
            var b = $("#ConLai").val();
            if (MPLQ != undefined)
            {
                if (MPLQ.length > 16) {
                    if ($("#ConLai").val()) {
                        if ($("#type").val() != "N2GTX") {
                            var STN = parseInt($("#SoTienNo").val().split(",").join(""));
                            STN = STN - '@ViewBag.SoTienChi' + 1;
                            var TCTT = parseInt($("#TongCongThanhToan").val().split(",").join(""));
                            //if ($("#type").val() != "HHTXE") {
                            //    if (!Number.isInteger(STN))
                            //        STN = STN + 1;
                            //}
                            if (Math.abs(TCTT - STN) > 1 && TCTT != 0) {
                                toastWarning("Vui lòng nhập số tiền thanh toán bằng đúng số tiền còn nợ");
                                return false;
                            }
                        }
                        else {
                            var STN = parseInt($("#ConLai").val().split(",").join(""));
                            if (STN != 0) {
                                toastWarning("Vui lòng nhập số tiền thanh toán bằng đúng số tiền còn nợ");
                                return false;
                            }

                        }
                    }
                }
                else if (MPLQ.length <= 16) {
                    if ($("#type").val() == "HHTXE") {
                        if ($("#SoTienNo").val()) {
                            var STN = parseInt($("#SoTienNo").val().split(",").join(""));
                            STN = STN + 1;
                            var TCTT = parseInt($("#TongCongThanhToan").val().split(",").join(""));
                            if ((TCTT - STN) >= 1 && TCTT != 0) {
                                toastWarning("Vui lòng nhập số tiền thanh toán không lớn hơn số tiền còn nợ");
                                return false;
                            }
                        }
                    }
                    else {
                        if ($("#SoTienConNo").val()) {
                            var STN = parseInt($("#SoTienConNo").val().split(",").join(""));
                            STN = STN + 1;
                            var TCTT = parseInt($("#TongCongThanhToan").val().split(",").join(""));
                            if ((TCTT - STN) >= 1 && TCTT != 0) {
                                toastWarning("Vui lòng nhập số tiền thanh toán bằng đúng số tiền còn nợ");
                                return false;
                            }
                        }
                    }
                }
            }
            else {
                if ($("#ConLai").length == 0) {
                    var STN = parseInt($("#SoTienNo").val().split(",").join(""));
                    var TCTT = parseInt($("#TongCongThanhToan").val().split(",").join(""));
                    if (STN != TCTT && TCTT != 0) {
                        toastWarning("Vui lòng nhập số tiền thanh toán bằng đúng số tiền nợ");
                        return false;
                    }
                }
            }
            //if ($("#SoTienNo").val() != undefined && $("#type").val() != "NGCNG")
            //{
            //    if ($("#type").val() != "NKHAC")
            //    {
            //        var STN = parseInt($("#SoTienNo").val().split(",").join(""));//
            //        var TCTT = parseInt($("#TongCongThanhToan").val().split(",").join(""));
            //        if (STN != TCTT && TCTT != 0) {
            //            toastWarning("Vui lòng nhập số tiền thanh toán bằng đúng số tiền nợ");
            //            return false;
            //        }
            //    }
            //}


        });

        $(document).on("change", ".number", function () {
            //Cal();
            var val = $(this).val();
            if (val != "") {
                val = val.split(",").join("");
                val = parseInt(val);
              //  val = val * 1000;
                $(this).val(val.toLocaleString('en-us'));
            }
            else {
                $(this).val(0);
            }
            if ($("#type").val() != "NGCNG")
                Cal();
        });
        //auto_complete
        $(document).ready(function () {
            debugger
            var Mang = new Array();
            $(function () {
                $.ajax({
                    url: "/SoChi/AutoComplete",
                    type: "POST",
                    dataType: "json",
                    success: function (data) {
                        for (var i = 0; i < data.length; i++) {
                            Mang.push(data[i]);
                        }
                        return Mang;
                    }
                });

            });
            $("#auto_complete").autocomplete({
                source: Mang
            });
        });
        var dem = 0;
        function DanhSachCoc(ID_NCC) {
            debugger;
            ID_NCC = $("#NCC").val();
            $.ajax({
                data: { maPhieuChi: "", Id: ID_NCC },
                url: "/SoChi/DanhSachCocGCN",
                type: "POST",
                dataType: "json",
                success: function (result) {
                    if (result != null) {
                        dem = result.length;
                        var tongcong = 0, sotienchi = 0;
                        $("#DS_ChiCoc").empty();
                        var html = "";
                        for (var i = 0; i < result.length; i++) {
                            html += "<tr>";
                            html += "<td><input type='text'  class='form-control input-sm number' name='CTPC[" + i + "].SoThamChieu'  value='" + result[i].MaPhieuChi + "' readonly /></td>";
                            html += "<td><input type='text'  class='form-control input-sm SoTienCoTheSuDung number' value='" + result[i].ConLai.toLocaleString('en-us') + "' readonly /></td>";
                            html += "<td><input type='text' class='form-control input-sm number SoTienSuDung' id='CTPC[" + i + "]' name='CTPC[" + i + "].SoTienThanhToan' value='0' onchange='change(this)' maxlength='15'  /></td>";
                            html += "<td><input type='text' class='form-control input-sm SoTienConLai number' value='" + result[i].ConLai.toLocaleString('en-us') + "' readonly /></td>";
                            html += "<td></td>"
                            html += "</tr>";
                            tongcong += result[i].ConLai;
                            sotienchi += result[i].SoTienChi;
                        }
                        $("#DS_ChiCoc").append(html);
                        $("#TongCongThanhToanCoc").html(tongcong.toLocaleString("en-us"));
                        var a = 0;
                        $("#TongSoTienChi").html(a.toLocaleString("en-us"));
                        $("#TongSoTienChi").val(a.toLocaleString("en-us"));

                    }
                }
            });
            var a = 0;
            $("#TongSoTienChi").html(a.toLocaleString("en-us"));
            $("#TongSoTienChi").val(a.toLocaleString("en-us"));
            TinhConLai_New();
        }
        function change(a) {
            debugger;
            var TongTienDuocSuaDung = $("#TongSoTienChi").val() == "" ? 0 : parseInt($("#TongSoTienChi").val().split(",").join(""));
            var num = $(a).val().split(",").join("");
            var tot = $(a).closest("tr").find(".SoTienCoTheSuDung").val().split(",").join("");
            var soTienConLai = tot - num;
            if (soTienConLai < 0) {
                toastWarning("Vui lòng không nhập quá số tiền có thể sử dụng");
                $(a).html(tot.toLocaleString("en-us"));
                $(a).val(tot.toLocaleString("en-us"));
            }
            else {
                $(a).closest("tr").find(".SoTienConLai").val((tot - num).toLocaleString('en-us'));
            }
            var TongTienSuDung = 0;
            if (dem > 0) {
                for (var i = 0 ; i < dem; i++) {
                    var tong = $("#CTPC\\[" + i + "\\]").val().split(",").join("");
                    if (tong == "")
                        tong = 0;
                    TongTienSuDung += parseInt(tong);
                }
            }
            $("#TongSoTienChi").html(TongTienSuDung.toLocaleString("en-us"));
            $("#TongSoTienChi").val(TongTienSuDung.toLocaleString("en-us"));
            if ($("#type").val() != "NGCNG")
                TinhConLai();
        }
