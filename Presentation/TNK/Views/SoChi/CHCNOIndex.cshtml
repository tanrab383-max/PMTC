@model List<TNK.Core.Domain.View.ViewPhieuThuCNO>
@{
    int i = 1;
}
<div class="page-title">
    <div class="title_left">
        <h3>@ViewBag.Title</h3>
    </div>
    <div class="title_right" style="margin-left:88%">
        <a href="#" download><span style="font-style:italic;color:blue;font-size:15px" id="FileMau">Lấy file mẫu(*.xlxs)</span></a>
    </div>
</div>
<div class="clearfix"></div>
<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="tabbable-line boxless tabbable-reversed">
            <ul class="nav nav-tabs">
                <li class="active">
                    <a href="#tab_0" data-toggle="tab" aria-expanded="true">
                        Danh sách nợ
                    </a>
                </li>
                <li class="">
                    <a id="a_1" href="#tab_1" data-toggle="tab" aria-expanded="false">
                        Danh sách phiếu chi hoàn công nợ
                    </a>
                </li>
            </ul>
            <div class="tab-content">
                <div class="tab-pane active" id="tab_0">
                    <div class="x_panel">
                        <div class="x_content">
                            <form id="formSearch" method="get" class="row">
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <label>Từ ngày thu</label>
                                        <input type="text" class="form-control input-sm date" value="@ViewBag.From" name="from" />
                                    </div>
                                </div>
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <label>Đến ngày thu</label>
                                        <input type="text" class="form-control input-sm date" value="@ViewBag.To" name="to" />
                                    </div>
                                </div>
                                <div class="col-md-6 col-sm-6 col-xs-12">
                                    <div class="form-group">
                                        <label>Từ khóa</label>
                                        <input type="text" title="Mã phiếu thu,Biển số,Khách hàng,Điện thoại,Số chứng từ" placeholder="Mã phiếu thu,Biển số,Khách hàng,Điện thoại,Số chứng từ" class="form-control input-sm " value="@ViewBag.Query" name="query" />
                                    </div>
                                </div>
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <br />
                                        <input type="submit" value="Tìm kiếm" class="btn btn-success search" />
                                        <input type="button" value="Xuất excel" class="btn btn-info" id="exportExcel" />
                                        <input style="width:70%" onclick="ImportData()" title="Import phiếu chi" value="Import phiếu chi" class="btn btn-primary" />
                                    </div>
                                </div>
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                </div>
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                </div>
                                <div class="col-md-6 col-sm-6 col-xs-12">
                                    <div class="form-group">
                                        @Html.RadioButton("tinhtrang", "", true, new { id = "All" }) Tất Cả
                                        @* @Html.RadioButton("tinhtrang", "D", false, new { id = "D" }) Đang sử dụng*@
                                        @Html.RadioButton("tinhtrang", "H", false, new { id = "H" }) Hoàn tất
                                        @Html.RadioButton("tinhtrang", "C", false, new { id = "C" }) Chưa sử dụng
                                    </div>
                                </div>
                            </form>
                            <div class="table-responsive">
                                <table class="table" id="tbody">
                                    <thead>
                                        <tr class="success">
                                            <th>STT</th>
                                            <th>Ngày thu</th>
                                            <th>Mã phiếu thu</th>
                                            <th>Đối tác</th>
                                            <th>Số chứng từ</th>
                                            <th>Số tiền thu</th>
                                            <th>Số tiền đã phân bổ</th>
                                            <th>Số tiền hoàn</th>
                                            <th>Số tiền chưa phân bổ</th>
                                            <th>Ghi chú</th>
                                            <th></th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@(ViewBag.PageSize * (ViewBag.PageIndex - 1) + i)</td>
                                                <td>@item.NgayThu.ToString("dd/MM/yyyy")</td>
                                                <td>@item.MaPhieuThu</td>
                                                <td>@item.DoiTacPhieuThu</td>
                                                <td>@item.SoChungTu</td>
                                                <td>@TNK.Core.Common.ToCurrencyString(item.SoTienThu)</td>
                                                <td>@TNK.Core.Common.ToCurrencyString(item.SoTienDaSuDung)</td>
                                                <td>@TNK.Core.Common.ToCurrencyString(item.SoTienChiTra)</td>
                                                <td>@TNK.Core.Common.ToCurrencyString(item.ConLai)</td>
                                                <td>@item.GhiChu</td>
                                                <td style="width:5%" class="center">
                                                    <a href="/SoChi/CHCNOCreate/@item.MaPhieuThu"><i title="Edit" class="fa fa-plus"></i></a>
                                                </td>
                                            </tr>
                                            i++;
                                        }
                                    </tbody>
                                </table>
                                <div class="right">
                                    @Html.Partial("~/Views/Shared/_Paging_v2.cshtml")
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                <div class="tab-pane" id="tab_1">
                    <div class="x_panel">
                        <div class="x_content">
                            <div method="get" class="row">
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <label>Từ ngày</label>
                                        <input type="text" id="from" class="form-control input-sm date" value="@ViewBag.From" name="from" />
                                    </div>
                                </div>
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <label>Đến ngày </label>
                                        <input type="text" id="to" class="form-control input-sm date" value="@ViewBag.To" name="to" />
                                    </div>
                                </div>
                                <div class="col-md-6 col-sm-6 col-xs-12">
                                    <div class="form-group">
                                        <label>Từ khóa</label>
                                        <input type="text" id="query" title="Mã phiếu thu, Khách hàng, Điện thoại, Số chứng từ" placeholder="Mã phiếu thu, Khách hàng, Điện thoại, Số chứng từ" class="form-control input-sm " value="@ViewBag.Query" name="query" />
                                    </div>
                                </div>
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <br />
                                        <input type="submit" value="Tìm kiếm" id="Search" class="btn btn-success" />
                                    </div>
                                </div>
                            </div>
                            <div class="table-responsive" id="tbody2">

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
    <div class="clearfix"></div>
    <div style="display:none"><input type="file" id="txtUploadFile" /></div>
</div>
@section scripts
{
    <script src="~/Scripts/IndexCommon.js"></script>
    <script src="~/Scripts/jquery.fileDownload.js"></script>
    <script>
        var p = 1;
        $("#FileMau").click(function () {
            debugger;
            $.fileDownload("/SoChi/ExportFile_CHCNO", {
                httpMethod: "POST",
                data: {},
                failMessageHtml: "Có lỗi trong khi tải file excel."
            });
            return false;
        });
        $("#Search").click(function () {
            $(this).val("Loading...");
            $(this).prop('disabled', true);
            Search(this);
        })
        function change() {
            p = 1;
        }
        function Search(obj) {
            var from = $("#from").val();
            var to = $("#to").val();
            var query = $("#query").val();
            $.get("/SoChi/CHCNOComplete?query=" + query + "&from=" + from + "&to=" + to + "&p=" + p).success(function (response) {
                $("#tbody2").html(response);
                $(obj).val("Tìm kiếm");
                $(obj).prop('disabled', false);
            })
        }
        var a;
        $(document).on("click", "#tbody a", function () {
            a = $(this).attr("href");
            var b = a.split("&");
            p = b[3].split("=")[1];
            Search();
            return false;
        })
        function Delete(a, id) {
            if (confirm('Xác nhận')) {
                data = { id: id };
                $.post("/SoChi/DeletePhieuChi", data).success(function (response) {
                    if (response == "success") {
                        $(a).closest("tr").remove();
                        toastSuccess("Đã xóa thành công");
                    }
                    else
                        toastError(response);
                });
            }
        }
        $("#exportExcel").click(function () {
            debugger;
            if ($($("#tab_data li.unactive")[0]).attr("data-url") != "") {
                var dt = new Date();
                var day = dt.getDate();
                var month = dt.getMonth() + 1;
                var year = dt.getFullYear();
                var hour = dt.getHours();
                var mins = dt.getMinutes();
                var postfix = day + "." + month + "." + year + "_" + hour + "." + mins;
                //var idtable = $($("#tab_data li.unactive")).attr("data-url").replace("/SoChi/PhieuChi/", "#");
                //alert(idtable);
                var idtable = "#tbody";
                var result = $(idtable).html();
                result = result.replace('class="table"', 'class="table" border="1"');
                //alert(result)
                tableToExcel(result, 'SoThu' + '_@ViewBag.Type' + '_' + postfix + '.xls');
            }
            else {
                window.location = `/SoChi/CHCNOIndex?from=${$("#FromDate").val()}&to=${$("#ToDate").val()}&export=Excel`;
            }
            return false;
        })
        var tableToExcel = (function () {
            debugger;
            var uri = 'data:application/vnd.ms-excel;base64,'
                , template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>{table}</table></body></html>'
                , base64 = function (s) { return window.btoa(unescape(encodeURIComponent(s))) }
                , format = function (s, c) { return s.replace(/{(\w+)}/g, function (m, p) { return c[p]; }) }
            return function (table, name) {
                //if (!table.nodeType) table = document.getElementById(table)
                var ctx = { worksheet: name || 'Worksheet', table: table }
                var link = document.createElement("A");
                link.href = uri + base64(format(template, ctx));
                link.download = name || 'Baocao.xls';
                link.target = '_blank';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            }
        })()
        var datafile = new FormData();
        function ImportData() {
            $("#txtUploadFile").trigger('click');
        }
        $('#txtUploadFile').on('change', function (e) {
            //alert(("#txtUploadFile").val());
            if (document.getElementById("txtUploadFile").value != "") {
                var files = e.target.files;
                if (files.length > 0) {
                    if (window.FormData !== undefined) {
                        for (var x = 0; x < files.length; x++) {
                            datafile.append('file', files[x]);
                        }
                    }
                }

                $.ajax({
                    type: "POST",
                    url: "/SoChi/ImportData_CHCNO",
                    contentType: false,
                    processData: false,
                    data: datafile,
                    beforeSend: function () {
                        // Đang thực hiện ajax
                        //để Loading...
                    },
                    complete: function () {
                        // Hoàn tất ajax
                        document.getElementById("txtUploadFile").value = "";
                        datafile.delete('file');
                    },
                    success: function (result) {
                        if (result.IsError)
                            toastError(result.Message);
                        else {
                            toastSuccess("Import thành công");
                        }
                    },
                    error: function (xhr, status, p3, p4) {
                        toastError("Lỗi: Import file excel.");
                    }
                });
            }
        });
    </script>
}