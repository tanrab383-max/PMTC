@model TNK.Model.SoChiModel
@{
    var item = Model.Item;
    var STTT = ViewBag.SoTienThanhToan;
}
<div class="page-title">
    <div class="title_left">
        <h3>@ViewBag.Title</h3>
    </div>
</div>
<div class="clearfix"></div>
<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_panel">
            <div class="x_title">
                <h2><b>Thông tin</b></h2>
                <ul class="nav navbar-right panel_toolbox">
                    <li>
                        <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                    </li>
                </ul>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">
                <form method="post" id="form-data" class="form-horizontal form-label-left FormPhieuChi">
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    @Html.HiddenFor(x => item.MaPhieuChi)
                    <div class="row">
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Số chứng từ</label>
                                @Html.HiddenFor(x => item.MaLoaiPhieu, new { htmlAttributes = new { @class = "form-control input-sm maPhieuNo" }, @id = "maLoaiPhieu" })
                                @Html.EditorFor(x => item.SoChungTu, new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "10" } })
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Ngày chi</label>
                                @Html.EditorFor(x => item.NgayChi, new { htmlAttributes = new { @class = "form-control input-sm date1", @Value = item.NgayChi.ToString("dd/MM/yyyy") } })
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Ngày hạch toán</label>
                                @Html.EditorFor(x => item.NgayHachToan, new { htmlAttributes = new { @class = "form-control input-sm date1", @Value = item.NgayHachToan.Value.ToString("dd/MM/yyyy") } })
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Họ tên</label>
                                @Html.EditorFor(x => item.HoTen, new { htmlAttributes = new { @class = "form-control input-sm" } })
                            </div>
                        </div>

                        <div class="col-md-8 col-sm-8 col-xs-12">
                            <div class="form-group">
                                <label>Địa chỉ</label>
                                @Html.EditorFor(x => item.DiaChi, new { htmlAttributes = new { @class = "form-control input-sm" } })
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Điện thoại</label>
                                @Html.EditorFor(x => item.DienThoai, new { htmlAttributes = new { @class = "form-control input-sm" } })
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Lý do chi</label>
                                @Html.DropDownListFor(x => Model.Item.LyDoChi, Model.LyDoChi.Select(x => new SelectListItem { Text = x.Name, Value = x.Code }), "Chọn", new { @class = "select2 fullwidth", @id = "LDC", @onchange = "DanhSachCoc(this)" })
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Bộ phận(*)</label>
                                @Html.DropDownListFor(x => Model.Item.NguoiUngTien, Model.PhongBanChi.Select(x => new SelectListItem { Text = x.Name, Value = x.Code }), "Chọn", new { @class = "select2 fullwidth", @id = "BOPHAN" })
                            </div>
                        </div>
                        @*<div class="col-md-4 col-sm-4 col-xs-12">
            <div class="form-group">
                <label>Nhà cung cấp</label>
                @Html.DropDownListFor(x => Model.Item.DoiTac, Model.DoiTac.Select(x => new SelectListItem { Text = x.TenDoiTac, Value = x.MaDoiTac }), "Chọn", new { @class = "select2 fullwidth" })
            </div>
        </div>*@
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label>Nội dung(*)</label>
                                @Html.TextAreaFor(x => item.NoiDung, new { @class = "form-control input-sm" })
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Tổng tiền(*)</label>
                                @Html.EditorFor(x => item.TongCong, new { htmlAttributes = new { @class = "form-control input-sm number", @id = "TongTien", @onchange = "TinhConLai_v2()" } })
                            </div>
                        </div>
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group table-responsive">
                                <label>Cọc: </label>
                                <table class="table table-striped jambo_table bulk_action" id="Coc">
                                    <thead>
                                        <tr>
                                            <th>Mã Phiếu Cọc</th>
                                            <th>Số tiền có thể sử dụng</th>
                                            <th>Số tiền sử dụng</th>
                                            <th>Còn lại</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody id="DS_ChiCoc">
                                        @*phan append*@
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td>Tổng cộng: </td>
                                            <td class="number TotalCoc" id="TongCongThanhToanCoc"></td>
                                            <td class="number TotalCoc" name="CTPC.SoTienThanhToan" id="TongSoTienChi">0</td>
                                            <td></td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>

                        <div class="col-md-12 col-sm-12 col-xs-12">
                            @Html.Partial("~/Views/Shared/_ThanhToanChi.cshtml", null, new ViewDataDictionary { { "CTPT", Model.CTPT }, { "HTTT", Model.HTTT } })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12">
                            <div class="form-group">
                                <label>Còn Lại</label>
                                @Html.EditorFor(x => item.ConLai, new { htmlAttributes = new { @class = "form-control input-sm number", @readonly = "" } })
                                @*<input class="form-control input-sm number" value="@item.TongCong" id="idTongCong" readonly />*@
                            </div>
                        </div>
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label>Ghi chú</label>
                                @Html.TextAreaFor(x => item.GhiChu, new { @class = "form-control input-sm" })
                            </div>
                        </div>
                        @Html.Partial("~/Views/Common/UserComfirm.cshtml", null, new ViewDataDictionary { { "User", Model.Users }, { "Item", item } })
                    </div>
                    <div class="ln_solid"></div>
                    @if (ViewBag.a != "View")
                    {
                        <div class="form-group">
                            <div class="col-md-6 col-sm-6 col-xs-12 col-md-offset-3">
                                <input type="submit" value="Save" class="btn btn-success" />
                            </div>
                        </div>
                    }
                    else
                    {
                        <a href="/SoChi/Index" class="Back">Quay lại</a>
                    }
                    <div class="ln_solid"></div>
                </form>
            </div>
        </div>
    </div>
</div>

@*<a href="@ViewBag.LinkIndex" class="Back">Quay lại</a>*@
@section scripts
{
    <script src="~/Scripts/IndexCommon.js"></script>
    <link href="~/assests/plugins/select2/select2.css" rel="stylesheet" />
    <link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <script src="~/Scripts/jquery-ui.js"></script>
    <script src="~/assests/plugins/select2/select2.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/ChiTongHopCommon.js"></script>
    <script>
        $(document).ready(function () {
            DanhSachCoc($("#NCC").val);
            var Mang = new Array();
            $(function () {
                $.ajax({
                    url: "/SoChi/AutoComplete",
                    type: "POST",
                    dataType: "json",
                    success: function (data) {
                        for (var i = 0; i < data.length; i++) {
                            Mang.push(data[i]);
                        }
                        return Mang;
                    }
                });
                $("#auto_complete").autocomplete({
                    source: Mang
                });
            });
        });
        //$("#form-data").submit(function () {

        //    if ($("#item_KeToanTruong").val() == "") {
        //        toastWarning("Vui lòng chọn Kế toán trưởng.");
        //        return false;
        //    }
        //    if ($("#item_NguoiLapPhieu").val() == "") {
        //        toastWarning("Vui lòng chọn Người lập phiếu.");
        //        return false;
        //    }
        //    if ($("#item_NguoiNopTien").val() == "") {
        //        toastWarning("Vui lòng chọn Người nộp tiền.");
        //        return false;
        //    }
        //    if ($("#item_NguoiThuTien").val() == "") {
        //        toastWarning("Vui lòng chọn người thu tiền.");
        //        return false;
        //    }

        //    var lst = $(".number");
        //    lst.map(function (key, val) {
        //        $(val).val($(val).val().split(",").join(""));
        //    });
        //});

        i = '@Model.CTPT.Count';
        $(".addHTTT").click(function () {
            var html = tr.split("httt[0]").join("httt[" + i + "]");
            @if(Model.CTPT.Count>0)
            {
             @Html.Raw("html=html.replace('" + Model.CTPT[0].Id+"','');")
             @Html.Raw("html=html.replace('" + Model.CTPT[0].SoTienThanhToan+"','');")
             @Html.Raw("html=html.replace('selected','');")
             @Html.Raw("html=html.replace('" + Model.CTPT[0].SoThamChieu + "','');")
            }
            $("#tbody").append("<tr>" + html + "</tr>");
            i++;
            setTimeout(function () {
                $('.select2').select2({
                    placeholder: "Select an option",
                    allowClear: true
                });
                removeSelect();
            }, 200);
        })

        $(document).on("change", ".number", function () {
            var val = $(this).val();
            if (val != "") {
                val = val.split(",").join("");
                val = parseInt(val);
             //   val = val * 1000;
                $(this).val(val.toLocaleString('en-us'));
            }
            else {
                $(this).val(0);
            }
        });

        function CalThanhToan1(a) {
            debugger;
            setTimeout(function () {
                var total = 0;
                $("#DS_ChiCoc").find("tr").map(function (key, val) {
                    let i = parseInt($(val).find(".number1").val().split(",").join(""));
                    if (!isNaN(i))
                        total += i;
                });

                $("#Coc").find("#TongSoTienChi").html(total.toLocaleString('en-us'));
                //Cal();
            }, 100);
            TinhConLai_v2()
        }
        function TinhConLai() {
            debugger;
            var TongSoTienChi = $("#TongSoTienChi").val();
            var TongCongThanhToan = $("#TongCongThanhToan").val();

            if (TongSoTienChi != "")
                TongSoTienChi = parseInt($("#TongSoTienChi").val().split(",").join(""));
            else
                TongSoTienChi = 0;
            if (TongCongThanhToan != "")
                TongCongThanhToan = parseInt($("#TongCongThanhToan").val().split(",").join(""));
            else
                TongCongThanhToan = 0;
            var TongCong = TongSoTienChi + TongCongThanhToan;
            $("#idTongCong").val(TongCong.toLocaleString('en-us'));
            $("#idTongCong").html(TongCong.toLocaleString('en-us'));
        }
        var dem = 0;
        function DanhSachCoc(ID_NCC) {
            debugger;
            var tongcong = 0;
            var sotienchi = 0;
            ID_NCC = $("#LDC").val();
            $.ajax({
                data: {maPhieuChi: '@item.MaPhieuChi', Id: ID_NCC },
                url: "/SoChi/DanhSachCocTH",
                type: "POST",
                dataType: "json",
                success: function (result) {
                    if (result != null) {
                        dem = result.length;
                        $("#DS_ChiCoc").empty();
                        var html = "";
                        for (var i = 0; i < result.length; i++) {
                            //var ConLai = result[i].ConLai + result[i].SoTienChi;
                            html += "<tr>";
                            //html += "<td><label name='CTPC[" + i + "].Id'  value='CTPC[" + i + "].Id' hidden></label>";
                            html += "<td><input type='text'  class='form-control input-sm number' name='CTPC[" + i + "].SoThamChieu'  value='" + result[i].MaPhieuChi + "' readonly /></td>";
                            html += "<td><input type='text'  class='form-control input-sm SoTienCoTheSuDung number' value='" + result[i].TongCong.toLocaleString('en-us') + "' readonly /></td>";
                            html += "<td><input type='text' class='form-control input-sm number' name='CTPC[" + i + "].SoTienThanhToan' id='CTPC[" + i + "]' value='" + result[i].SoTienChi.toLocaleString('en-us') + "' maxlength='15' onchange='change(this)'  /></td>";
                            html += "<td><input type='text' class='form-control input-sm SoTienConLai number' value='" + result[i].ConLai.toLocaleString('en-us') + "' readonly /></td>";
                            html += "</tr>";
                            tongcong += result[i].TongCong;
                            sotienchi += result[i].SoTienChi;
                        }
                        $("#DS_ChiCoc").append(html);
                        $("#TongCongThanhToanCoc").html(tongcong.toLocaleString("en-us"));
                        $("#TongSoTienChi").html(sotienchi.toLocaleString("en-us"));
                        $("#TongSoTienChi").val(sotienchi.toLocaleString("en-us"));
                        TinhConLai();
                    }
                }
            });
            //var a = 0;
            //$("#TongSoTienChi").html(a.toLocaleString("en-us"));
            //$("#TongSoTienChi").val(a.toLocaleString("en-us"));
        }
        $(document).ready(function () {
            var STTT = @STTT;
            $("#TongCongThanhToan").val(STTT.toLocaleString("en-us"));
        });
        function change(a) {
            debugger;
            var TongTienDuocSuaDung = $("#TongSoTienChi").val() == "" ? 0 : parseInt($("#TongSoTienChi").val().split(",").join(""));
            var num = $(a).val().split(",").join("");
            var tot = $(a).closest("tr").find(".SoTienCoTheSuDung").val().split(",").join("");
            var soTienConLai = tot - num;
            if (soTienConLai < 0) {
                toastWarning("Vui lòng không nhập quá số tiền có thể sử dụng");
                $(a).html(tot.toLocaleString("en-us"));
                $(a).val(tot.toLocaleString("en-us"));
            }
            else {
                $(a).closest("tr").find(".SoTienConLai").val((tot - num).toLocaleString('en-us'));
            }
            var TongTienSuDung = 0;
            if (dem > 0) {
                for (var i = 0; i < dem; i++) {
                    var tong = $("#CTPC\\[" + i + "\\]").val().split(",").join("");
                    if (tong == "")
                        tong = 0;
                    TongTienSuDung += parseInt(tong);
                }
            }
            $("#TongSoTienChi").html(TongTienSuDung.toLocaleString("en-us"));
            $("#TongSoTienChi").val(TongTienSuDung.toLocaleString("en-us"));
            TinhConLai();
            TinhConLai_v2()
        }
        function TinhConLai_v2() {
            debugger
            var TongTien = $("#TongTien").val().split(",").join("");
            var s = $("#TongSoTienChi").val();
            var ss = $("#TongCongThanhToan").val();
            var TongChiCoc = $("#TongSoTienChi").val() == "" ? 0 : parseInt($("#TongSoTienChi").val().split(",").join(""));
            var TongThanhToan = $("#TongCongThanhToan").val() == "" ? 0 : parseInt($("#TongCongThanhToan").val().split(",").join(""));
            var TongThanhToan = TongChiCoc + TongThanhToan;
            var ConLai = TongTien - (TongThanhToan == "" ? 0 : parseInt(TongThanhToan));
            $("#item_ConLai").val(ConLai.toLocaleString("en-us"));
        }
        function Remove(a) {
            debugger;
            var tr = $(a.closest("tr"));
            tr.find(".IsDeleted").val("true");
            tr.hide();
            CalThanhToan(a);
            //var total = 0;

            //$("#tbody").find("tr").map(function (key, val) {
            //    if ($(val).is(":visible")) {
            //        var isDeleted = $(val).find(".IsDeleted").val();
            //        if (isDeleted != "true") {
            //            var sotien = parseInt($(val).find(".number").val().split(",").join(""));
            //            if (isNaN(sotien))
            //                sotien = 0;
            //            total += sotien;
            //        }
            //    }
            //});
            //if (isNaN(total))
            //    total = 0;
            //$("#TongCongThanhToan").html(total.toLocaleString("en-us"));
            //$("#TongCongThanhToan").val(total.toLocaleString("en-us"));
            TinhConLai();
        }
    </script>
}





