@model List<TNK.Core.Domain.View.ViewPhieuChi>
@{ 
    int i = 1;
}

<div class="page-title">
    <div class="title_left">
        <h3>@ViewBag.Title</h3>
    </div>
</div>
<div class="clearfix"></div>
<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_panel">
            <div class="x_title">
                <h2><b>Danh sách</b></h2>
                <ul class="nav navbar-right panel_toolbox">
                    <li>
                        <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                    </li>
                    <li>
                        <a href="@ViewBag.LinkCreate"><i class="fa fa-plus addNew"></i></a>
                    </li>
                </ul>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">
                <form id="formSearch" method="get" class="row">
                    <div class="col-md-2 col-sm-2 col-xs-12">
                        <div class="form-group">
                            <label>Từ ngày chi</label>
                            <input type="text" class="form-control input-sm date" value="@ViewBag.From" name="from" />
                        </div>
                    </div>
                    <div class="col-md-2 col-sm-2 col-xs-12">
                        <div class="form-group">
                            <label>Đến ngày chi</label>
                            <input type="text" class="form-control input-sm date" value="@ViewBag.To" name="to" />
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-6 col-xs-12">
                        <div class="form-group">
                            <label>Từ khóa</label>
                            <input type="text" title="Chứng từ chi, Người vay, Số điện thoại, Tình trạng" placeholder="Chứng từ chi, Người vay, Số điện thoại, Tình trạng" class="form-control input-sm " value="@ViewBag.Query" name="query" />
                        </div>
                    </div>
                    <div class="col-md-2 col-sm-2 col-xs-12">
                        <div class="form-group">
                            <br />
                            <input type="submit" value="Tìm kiếm" class="btn btn-success" />
                        </div>
                    </div>
                    <div class="col-md-2 col-sm-2 col-xs-12">
                    </div>
                    <div class="col-md-2 col-sm-2 col-xs-12">
                    </div>
                    <div class="col-md-6 col-sm-6 col-xs-12">
                        <div class="form-group">
                            @Html.RadioButton("tinhtrang", "", true, new { id = "All" }) Tất Cả
                            @Html.RadioButton("tinhtrang", "H", false, new { id = "H" }) Hoàn thành
                            @Html.RadioButton("tinhtrang", "C", false, new { id = "C" }) Còn nợ
                        </div>
                    </div>
                </form>
                <div class="x_content">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr class="success">
                                    <th>STT</th>
                                    <th>Mã phiếu chi</th>
                                    <th>Ngày chi</th>
                                    <th>Chứng từ chi</th>
                                    <th>Người vay</th>
                                    <th>Số điện thoại</th>
                                    <th>Số tiền</th>
                                    <th>Đã trả</th>
                                    <th>Còn nợ</th>
                                    <th>Tình trạng</th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@(ViewBag.PageSize * (ViewBag.PageIndex - 1) + i)</td>
                                        <td>@item.MaPhieuChi</td>
                                        <td>@item.NgayChi.ToString("dd/MM/yyyy")</td>
                                        <td>@item.SoChungTu</td>
                                        <td>@item.HoTen</td>
                                        <td>@item.DienThoai</td>
                                        <td>@TNK.Core.Common.ToCurrencyString(item.TongCong)</td>
                                        <td>@TNK.Core.Common.ToCurrencyString((item.TongCong - item.ConLaiPhaiThu))</td>
                                        @*<td>@TNK.Core.Common.ToCurrencyString(item.SoTienChi)</td>*@
                                        <td>@TNK.Core.Common.ToCurrencyString(item.ConLaiPhaiThu)</td>
                                       @if (item.ConLaiPhaiThu <= 0)
                                       {
                                            <td>Hoàn thành</td>
                                       }
                                       else
                                       {
                                            <td>Còn nợ</td>
                                       }
                                        <td style="width:5%" class="center">
                                            <a href="@ViewBag.LinkEdit/@item.MaPhieuChi"><i title="Edit" class="fa fa-edit"></i></a>
                                        </td>
                                        <td style="width:5%" class="center">
                                            <a href="javascript:;" onclick="Delete(this,'@item.MaPhieuChi')"><i title="Delete" class="fa fa-close"></i></a>
                                        </td>
                                    </tr>
                                    i++;
                                }
                            </tbody>
                        </table>
                        <div class="right">
                            @Html.Partial("~/Views/Shared/_Paging.cshtml")
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div class="clearfix"></div>
    </div>
</div>
@section scripts
{
<script src="~/Scripts/IndexCommon.js"></script>
    <script>

        $('.date').datepicker({
            orientation: "left",
            autoclose: true
        });

        function Delete(a, id) {
            if (confirm('Xác nhận')) {
                data = { id: id, type: 'DV' };
                $.post("/SoChi/DeletePhieuChi", data).success(function (response) {
                    if (response == "success") {
                        $(a).closest("tr").remove();
                        toastSuccess("Đã xóa thành công");
                    }
                    else
                        toastError(response);
                });
            }
        }
    </script>
}
