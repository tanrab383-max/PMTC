
@model List<TNK.Core.Domain.View.ViewListPhieuChi>
@{
    ViewBag.Title = "Danh Sách Phiếu Chi";
    var LoaiPhieuChi = new  List<TNK.Core.Domain.DanhMucDienGiai>();
    LoaiPhieuChi = ViewBag.LoaiPhieuChi;
    string[] list = { "NTHPK", "CTHBH", "NBHBX", "NPTPK", "NTHBH" };
}
<style>
    .overflow {
    width: 10em;
    white-space: nowrap;
    overflow: hidden;
}
.ellipsis { 
    text-overflow: "..."; 
}
</style>
<div class="page-title">
    <div class="title_left">
        <h3>@ViewBag.Title</h3>
    </div>
</div>
<div class="clearfix"></div>
<div class="row">
    <div class="col-md-12">
        <div class="tabbable-line boxless tabbable-reversed">
            <div class="tab-content">
                <div class="tab-pane active" id="tab_0">
                    <div class="x_panel">
                        <div class="x_content">
                            <form id="formSearch" method="get" class="row">
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <label>Từ ngày</label>
                                        <input type="text" class="form-control input-sm date" value="@ViewBag.From" name="from" id="FromDate" />
                                    </div>
                                </div>
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <label>Đến ngày</label>
                                        <input type="text" class="form-control input-sm date" value="@ViewBag.To" name="to" id="ToDate" />
                                    </div>
                                </div>
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <label>Loại phiếu chi</label>
                                        @Html.DropDownList("maLoaiPhieu", LoaiPhieuChi.Select(x => new SelectListItem  { Text = x.Ten.ToString(), Value = x.MaVietTat.ToString() }), "Tất cả", new { @class = "select2 fullwidth", @style = "height:29px",@id= "maLoaiPhieu" })
                                    </div>
                                </div>
                                <div class="col-md-3 col-sm-3 col-xs-12">
                                    <div class="form-group">
                                        <label>Từ khóa</label>
                                        <input type="text" title="Số chứng từ, Khách hàng, Mã phiếu chi" placeholder="Số chứng từ, Khách hàng, Mã phiếu chi" class="form-control input-sm " value="@ViewBag.Query" name="query" />
                                    </div>
                                </div>
                                <div class="col-md-3 col-sm-3 col-xs-12">
                                    <div class="form-group">
                                        <br />
                                        <input type="submit" value="Tìm kiếm" class="btn btn-success search" />
                                        <input id="btnExportExcel" type="button" value="Xuất Excel" class="btn btn-info export" />
                                    </div>
                                </div>
                                <div class="col-md-6 col-sm-6 col-xs-12">
                                    <div class="form-group">
                                        @Html.RadioButton("chonngay", "NC", true, new { id = "NC" }) Ngày chi
                                        @Html.RadioButton("chonngay", "NHT", false, new { id = "NHT" }) Ngày hoạch toán

                                    </div>
                                </div>
                        </form>
                            <div class="table-responsive">
                                <table class="table">
                                    <thead>
                                        <tr class="success">
                                            <th>STT</th>
                                            <th>Ngày chi</th>
                                            <th>Ngày hạch toán</th>
                                            <th>Mã Phiếu Chi</th>
                                            <th>Loại Phiếu Chi</th>
                                            <th>Số chứng từ</th>
                                            @*<th>Số hợp đồng</th>*@
                                            <th>Khách hàng</th>
                                            <th>Nội dung</th>
                                            <th>Tổng phải chi</th>
                                            <th>Ngân hàng</th>
                                            <th>Thanh toán ngân hàng</th>
                                            <th>Thanh toán tiền mặt</th>
                                            @if(ViewBag.maLoaiPhieu == "CMPTU")
                                            {
                                                <th>Kho</th>
                                            }
                                            <th>Tiền dụng cọc</th>
                                            <th>Còn lại</th>
                                            <th>Thao Tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int i = 1;
                                            foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td>@(ViewBag.PageSize * (ViewBag.PageIndex - 1) + i++)</td>
                                                    <td>@item.NgayChi.ToString("dd/MM/yyyy")</td>
                                                    <td>@item.NgayHachToan.ToString("dd/MM/yyyy")</td>
                                                    <td>@item.MaPhieuChi</td>
                                                    <td>@item.MaLoaiPhieu</td>
                                                    <td>@item.SoChungTu</td>
                                                    @*<td>@item.SoHopDong</td>*@
                                                    @if (item.MaLoaiPhieu == "CCOGC" || item.MaLoaiPhieu == "CDACO"
                                                        || item.MaLoaiPhieu == "CCOMX" || item.MaLoaiPhieu == "CMHTD"
                                                        || item.MaLoaiPhieu == "CMPTU" || item.MaLoaiPhieu == "CCOPT"
                                                        || item.MaLoaiPhieu == "CDATU"
                                                        || item.MaLoaiPhieu == "CMXTT" || item.MaLoaiPhieu == "CMUTS")
                                                    {
                                                        <td data-toggle="tooltip" title="@item.DoiTac" class="overflow ellipsis">@item.DoiTac</td>
                                                    }
                                                    else if (item.MaLoaiPhieu == "CHCPT" || item.MaLoaiPhieu == "CHCBX")
                                                    {
                                                        <td data-toggle="tooltip" title="@item.HoTenKH" class="overflow ellipsis">@item.HoTenKH</td>
                                                    }
                                                    else
                                                    {
                                                        <td data-toggle="tooltip" title="@item.Hoten" class="overflow ellipsis">@item.Hoten</td>
                                                    }
                                                    <td data-toggle="tooltip" title="@item.NoiDung" class="overflow ellipsis">@item.NoiDung</td>
                                                    <td class="number2">@item.TongCong.ToString().Replace(",", ".")</td>
                                                    <td data-toggle="tooltip" title="@item.HinhThucThanhToan" class="overflow ellipsis">@item.HinhThucThanhToan</td>
                                                    <td class="number2">@item.ThanhToanNganHang.ToString().Replace(",", ".")</td>
                                                    <td class="number2">@item.ThanhToanTienMat.ToString().Replace(",", ".")</td>
                                                    @if (ViewBag.maLoaiPhieu == "CMPTU")
                                                    {
                                                        <td>@item.TenTui</td>
                                                    }
                                                    <td class="number2">@item.ThanhToanDungCoc.ToString().Replace(",", ".")</td>
                                                    @{
                                                        double conlai = item.TongCong - item.ThanhToanNganHang.Value - item.ThanhToanTienMat.Value - item.ThanhToanDungCoc;

                                                    }
                                                    <td class="number2">@conlai.ToString().Replace(",", ".")</td>
                                                    <td style="width:5%" class="center">
                                                            @if (list.Contains(item.MaLoaiPhieu) == true)
                                                            {
                                                                <a href="/SoChi/PhieuChiEdit/@item.MaPhieuChi?type=@item.MaLoaiPhieu&action=View"><i title="Chi Tiết" class="fa fa-eye"></i></a>
                                                            }
                                                            else
                                                            {
                                                                @*<a href="/SoChi/@item.MaLoaiPhieu Edit/@item.MaPhieuChi?action=View"><i title="Chi Tiết" class="fa fa-edit"></i></a>*@
                                                                switch (item.MaLoaiPhieu)
                                                                {
                                                                    case "CCOGC":
                                                                            <a href="/SoChi/CocGCNEdit/@item.MaPhieuChi?a=View"><i title="Chi Tiết" class="fa fa-eye"></i></a>
                                                                            break;
                                                                    case "CCOMX":
                                                                        <a href="/SoChi/CocMuaXeEdit/@item.MaPhieuChi?a=View"><i title="Chi Tiết" class="fa fa-eye"></i></a>
                                                                            break;
                                                                    case "CCOPT":
                                                                        <a href="/SoChi/CocMuaPTEdit/@item.MaPhieuChi?a=View"><i title="Chi Tiết" class="fa fa-eye"></i></a>
                                                                        break;
                                                                    case "CCOTH":
                                                                        <a href="/SoChi/CocTHEdit/@item.MaPhieuChi?a=View"><i title="Chi Tiết" class="fa fa-eye"></i></a>
                                                                        break;
                                                                    case "CMUTS":
                                                                        <a href="/SoChi/CMUTSEdit/@item.MaPhieuChi?a=View"><i title="Chi Tiết" class="fa fa-eye"></i></a>
                                                                        break;
                                                                    case "CDATU":
                                                                        <a href="/SoChi/CDATUEdit/@item.MaPhieuChi?a=View"><i title="Chi Tiết" class="fa fa-eye"></i></a>
                                                                        break;
                                                                    case "CMPTU":
                                                                        <a href="/SoChi/CMPTUEdit/@item.MaPhieuChi?a=View"><i title="Chi Tiết" class="fa fa-eye"></i></a>
                                                                        break;
                                                                    case "CHCBX":
                                                                        <a href="/SoChi/CHCBXEdit/@item.MaPhieuChi?a=View"><i title="Chi Tiết" class="fa fa-eye"></i></a>
                                                                        break;
                                                                    case "CHCPT":
                                                                        <a href="/SoChi/CHCPTEdit/@item.MaPhieuChi?a=View"><i title="Chi Tiết" class="fa fa-eye"></i></a>
                                                                        break;
                                                                    case "CDACO":
                                                                        <a href="/SoChi/CDACOEdit/@item.MaPhieuChi?a=View"><i title="Chi Tiết" class="fa fa-eye"></i></a>
                                                                        break;
                                                                    case "CTAUN":
                                                                            <a href="/SoChi/CTAUNEdit/@item.MaPhieuChi?a=View"><i title="Chi Tiết" class="fa fa-eye"></i></a>
                                                                         break;
                                                                    case "CMHTD":
                                                                        <a href="/SoChi/CMHTDEdit/@item.MaPhieuChi?a=View"><i title="Chi Tiết" class="fa fa-eye"></i></a>
                                                                        break;
                                                                    case "CVAMU":
                                                                        <a href="/SoChi/CVAMUEdit/@item.MaPhieuChi?a=View"><i title="Chi Tiết" class="fa fa-eye"></i></a>
                                                                        break;
                                                                    case "NTHBH":
                                                                        <a href="/SoChi/PhieuChiEdit/@item.MaPhieuChi"><i title="Chi Tiết" class="fa fa-eye"></i></a>
                                                                        break;
                                                                    case "NMUTS":
                                                                        <a href="/SoChi/PhieuChiEdit/@item.MaPhieuChi"><i title="Chi Tiết" class="fa fa-eye"></i></a>
                                                                        break;
                                                                    case "HHTXE":
                                                                        <a href="/SoChi/PhieuChiEdit/@item.MaPhieuChi"><i title="Chi Tiết" class="fa fa-eye"></i></a>
                                                                        break;
                                                                    case "CHHBX":
                                                                        <a href="/SoChi/PhieuChiEdit/@item.MaPhieuChi"><i title="Chi Tiết" class="fa fa-eye"></i></a>
                                                                        break;
                                                                    case "NTHPK":
                                                                        <a href="/SoChi/PhieuChiEdit/@item.MaPhieuChi"><i title="Chi Tiết" class="fa fa-eye"></i></a>
                                                                        break;
                                                                    case "NMPTU":
                                                                        <a href="/SoChi/PhieuChiEdit/@item.MaPhieuChi"><i title="Chi Tiết" class="fa fa-eye"></i></a>
                                                                        break;
                                                                    case "NMXTT":
                                                                        <a href="/SoChi/PhieuChiEdit/@item.MaPhieuChi"><i title="Chi Tiết" class="fa fa-eye"></i></a>
                                                                        break;
                                                                    case "NTKHA":
                                                                        <a href="/SoChi/PhieuChiEdit/@item.MaPhieuChi"><i title="Chi Tiết" class="fa fa-eye"></i></a>
                                                                        break;
                                                                    case "NGCNG":
                                                                        <a href="/SoChi/PhieuChiEdit/@item.MaPhieuChi"><i title="Chi Tiết" class="fa fa-eye"></i></a>
                                                                        break;
                                                                    case "CTOHO":
                                                                        <a href="/SoChi/CTOHOEdit/@item.MaPhieuChi?a=View"><i title="Chi Tiết" class="fa fa-eye"></i></a>
                                                                        break;
                                                                    case "CMXTT":
                                                                        <a href="/SoChi/CMXTTEdit/@item.MaPhieuChi?a=View"><i title="Chi Tiết" class="fa fa-eye"></i></a>
                                                                        break;
                                                                }
                                                            }
                                                    </td>
                                                </tr>
                                            }
                                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="right">
                                @Html.Partial("~/Views/Shared/_Paging.cshtml")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-12 col-sm-12 col-xs-12">
    </div>
    <div class="clearfix"></div>
</div>

@section scripts
{
    <script src="~/Scripts/IndexCommon.js"></script>
    <script src="~/Scripts/jquery.fileDownload.js"></script>
    <script>
        $(document).ready(function () {
            $('[data-toggle="tooltip"]').tooltip();
            $(".ellipsis").text(function (index, currentText) {
                if(currentText.length > 20)
                {
                    return currentText.substr(0, 20) + "...";
                }
            });
        });
        var p = 1;
        $("#Search").click(function () {
            $(this).val("Loading...");
            $(this).prop('disabled', true);
                Search(this);
        })
        function change() {
            p = 1;
        }
        function Search(obj) {
            var from = $("#from").val();
            var to = $("#to").val();
            var query = $("#query").val();

            $.get("/SoThu/TBAXEComplete?query=" + query + "&from=" + from + "&to=" + to + "&p=" + p).success(function (response) {
                $("#tbody").html(response);
                $(obj).val("Tìm kiếm");
                $(obj).prop('disabled', false);
            })
        }
        var a;
        $(document).on("click", "#tbody a", function () {
            debugger;
            a = $(this).attr("href");
            var b = a.split("&");
            p = b[2].split("=")[1];
            console.log(p);
            Search();
            return false;
        })
        $('.date').datepicker({
            orientation: "left",
            autoclose: true
        });
        function Delete(a, id) {
            if (confirm('Xác nhận')) {
                data = { id: id, type: 'TBAXE' };
                $.post("/SoThu/DeletePhieuThu", data).success(function (response) {
                    if (response == "success") {
                        $(a).closest("tr").remove();
                        toastSuccess("Đã xóa thành công");
                    }
                    else
                        toastError(response);
                });
            }
        }
        //phan export excel
        $("#btnExportExcel").click(function () {

            $.fileDownload("/SoChi/Export_Excel", {
                httpMethod: "POST",
                data: {
                    FromDate: $("#FromDate").val(),
                    ToDate: $("#ToDate").val(),
                    MaLoaiPhieu : $("#maLoaiPhieu").val()
                },
                failMessageHtml: "Có lỗi trong khi tải file excel."
            });
           return false;
          });
    </script>
}