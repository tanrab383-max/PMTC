@model TNK.Model.SoChiModel
@{
    var item = Model.Item;
    double totalinput = 0;
}
<div class="page-title">
    <div class="title_left">
        <h3>@ViewBag.Title</h3>
    </div>
</div>
<div class="clearfix"></div>
<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_panel">
            <div class="x_title">
                <h2><b>Thông tin</b></h2>
                <ul class="nav navbar-right panel_toolbox">
                    <li>
                        <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                    </li>
                </ul>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">
                <form id="form-data" method="post" class="form-horizontal form-label-left FormPhieuChi">
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    @Html.HiddenFor(x => Model.Item.MaPhieuChi)
                    <div class="row">
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Số chứng từ (*)</label>
                                @Html.HiddenFor(x => item.MaLoaiPhieu, new { htmlAttributes = new { @class = "form-control input-sm maPhieuNo" }, @id = "maLoaiPhieu" })
                                @Html.EditorFor(x => Model.Item.SoChungTu, new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "10" } })
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Ngày chi</label>
                                @Html.EditorFor(x => Model.Item.NgayChi, new { htmlAttributes = new { @class = "form-control input-sm date1", @Value = item.NgayChi.ToString("dd/MM/yyyy") } })
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Ngày hạch toán</label>
                                @Html.EditorFor(x => Model.Item.NgayHachToan, new { htmlAttributes = new { @class = "form-control input-sm date1", @Value = item.NgayHachToan.Value.ToString("dd/MM/yyyy") } })
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Nhà cung cấp (*)</label>
                                @Html.DropDownListFor(x => item.DoiTac, Model.DoiTac.Select(x => new SelectListItem { Text = x.TenDoiTac, Value = x.MaDoiTac }), "Chọn", new { @class = "select2 fullwidth", @id = "NCC", @onchange = "DanhSachCoc(this)" })
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Loại Chi Phí(*)</label>
                                @Html.DropDownListFor(x => Model.Item.LyDoChi, Model.LyDoChi.Select(x => new SelectListItem { Text = x.Name, Value = x.Code }), "Chọn", new { @class = "select2 fullwidth", @id = "LDC", @onchange = "DanhSachCoc(this)" })
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Số Khung</label>
                                @Html.EditorFor(x => item.SoKhung, new { htmlAttributes = new { @class = "form-control input-sm" } })
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Tổng tiền (*)</label>
                                @Html.EditorFor(x => Model.Item.TongCong, new { htmlAttributes = new { @class = "form-control input-sm number", @onchange = "TinhConLai()" } })
                            </div>
                        </div>
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label>Nội dung (*)</label>
                                @Html.TextAreaFor(x => Model.Item.NoiDung, new { @class = "form-control input-sm", @id = "item_NoiDung" })
                            </div>
                        </div>
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            @Html.Partial("~/Views/Shared/_ThanhToanChi.cshtml", null, new ViewDataDictionary { { "CTPT", Model.CTPT }, { "HTTT", Model.HTTT } })
                        </div>
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label>Còn lại</label>
                                @Html.EditorFor(x => Model.Item.ConLai, new { htmlAttributes = new { @class = "number input-100 form-control input-sm", @readonly = "" } })
                            </div>
                        </div>
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label>Ghi chú</label>
                                @Html.TextAreaFor(x => item.GhiChu, new { @class = "form-control input-sm" })
                            </div>
                        </div>
                        @Html.Partial("~/Views/Common/UserComfirm.cshtml", null, new ViewDataDictionary { { "User", Model.Users }, { "Item", item } })
                    </div>
                    <div class="ln_solid"></div>
                    @if (ViewBag.a != "View")
                    {
                        <div class="form-group">
                            <div class="col-md-6 col-sm-6 col-xs-12 col-md-offset-3">
                                <input type="submit" value="Save" onclick="CalNhapKho()" class="btn btn-success" />
                            </div>
                        </div>
                    }
                    else
                    {
                        <a href="/SoChi/Index" class="Back">Quay lại</a>
                    }
                    <div class="ln_solid"></div>
                </form>
            </div>
        </div>
    </div>
</div>
@section scripts
{
    <script src="~/Scripts/IndexCommon.js"></script>
    <link href="~/assests/plugins/select2/select2.css" rel="stylesheet" />
    <link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <script src="~/Scripts/jquery-ui.js"></script>
    <script src="~/assests/plugins/select2/select2.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/CKhacCommon.js"></script>
    <script>
        $(document).ready(function () {
            var Mang = new Array();
            $(function () {
                $.ajax({
                    url: "/SoChi/AutoComplete",
                    type: "POST",
                    dataType: "json",
                    success: function (data) {
                        for (var i = 0; i < data.length; i++) {
                            Mang.push(data[i]);
                        }
                        return Mang;
                    }
                });
                $("#auto_complete").autocomplete({
                    source: Mang
                });
            });
        });
        $(document).on("change", ".number", function () {
            var val = $(this).val();
            
            if (val != "") {
                val = val.split(",").join("");
                val = parseFloat(val);
                $(this).val(val.toLocaleString('en-us'));
            }
            else {
                $(this).val(0);
            }
        });
        var trKM = $("#trKM").html();


        function TinhConLai() {
            debugger;
            var total = parseInt($("#Item_TongCong").val().split(",").join(""));
            //var price = $("#Item_TongCong").val() == "" ? 0 : parseInt($("#Item_TongCong").val().split(",").join(""));
            //TongSoTienChi
            var TongSoTienChi = $("#TongCongThanhToan").val() == "" ? 0 : parseInt($("#TongCongThanhToan").val().split(",").join(""));
            var rest = total - TongSoTienChi;
            $("#Item_ConLai").val(rest.toLocaleString('en-us'));
            $("#Item_ConLai").html(rest.toLocaleString('en-us'));
        }

        $(".TotalInput").html(parseInt($(".TotalInput").html()).toLocaleString('en-us'));

        i = '@Model.CTPT.Count';
        $(".addHTTT").click(function () {
            var html = tr.split("httt[0]").join("httt[" + i + "]");
            @if(Model.CTPT.Count>0)
            {
             @Html.Raw("html=html.replace('" + Model.CTPT[0].Id+"','');")
             @Html.Raw("html=html.replace('" + Model.CTPT[0].SoTienThanhToan+"','');")
             @Html.Raw("html=html.replace('selected','');")
             @Html.Raw("html=html.replace('" + Model.CTPT[0].SoThamChieu + "','');")
            }
            $("#tbody").append("<tr>" + html + "</tr>");
            i++;
            setTimeout(function () {
                $('.select2').select2({
                    placeholder: "Select an option",
                    allowClear: true
                });
                removeSelect();
            }, 200);
        })
        function Remove(a) {
            debugger;
            var tr = $(a.closest("tr"));
            tr.find(".IsDeleted").val("true");
            tr.hide();
            var total = 0;

            $("#tbody").find("tr").map(function (key, val) {
                if ($(val).is(":visible")) {
                    var isDeleted = $(val).find(".IsDeleted").val();
                    if (isDeleted != "true") {
                        var sotien = parseInt($(val).find(".number").val().split(",").join(""));
                        if (isNaN(sotien))
                            sotien = 0;
                        total += sotien;
                    }
                }
            });
            if (isNaN(total))
                total = 0;
            $("#TongCongThanhToan").html(total.toLocaleString("en-us"));
            $("#TongCongThanhToan").val(total.toLocaleString("en-us"));
            TinhConLai();
        }
        var a;
        $(document).on("click", ".chkTinhTrang", function () {
            a = this;
            $(this).closest("td").children(".TinhTrang").val($(this).is(":checked"));
        })
    </script>
}


