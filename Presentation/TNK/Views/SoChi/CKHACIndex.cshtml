@model List<TNK.Core.Domain.View.ViewPhieuChi>
@{
    int i = 1;
}

<div class="page-title">
    <div class="title_left">
        <h3>@ViewBag.Title</h3>
    </div>
</div>
<div class="clearfix"></div>
<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_panel">
            <div class="x_title">
                <h2><b>Danh sách</b></h2>
                <ul class="nav navbar-right panel_toolbox">
                    <li>
                        <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                    </li>
                    <li>
                        <a href="@ViewBag.LinkCreate"><i class="fa fa-plus addNew addNew"></i></a>
                    </li>
                </ul>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">
                <form id="formSearch" method="get" class="row">
                    <div class="col-md-2 col-sm-2 col-xs-12">
                        <div class="form-group">
                            <label>Từ ngày chi</label>
                            <input type="text" class="form-control input-sm date" value="@ViewBag.From" name="from" />
                        </div>
                    </div>
                    <div class="col-md-2 col-sm-2 col-xs-12">
                        <div class="form-group">
                            <label>Đến ngày chi</label>
                            <input type="text" class="form-control input-sm date" value="@ViewBag.To" name="to" />
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-6 col-xs-12">
                        <div class="form-group">
                            <label>Từ khóa</label>
                            <input type="text" title="Mã phiếu chi,Số chứng từ, Nhà cung cấp" placeholder="Mã phiếu chi, Số chứng từ, Nhà cung cấp" class="form-control input-sm " value="@ViewBag.Query" name="query" />
                        </div>
                    </div>
                    <div class="col-md-2 col-sm-2 col-xs-12">
                        <div class="form-group">
                            <br />
                            <input type="submit" value="Tìm kiếm" class="btn btn-success search" />
                        </div>
                    </div>
                </form>
                <div class="x_content">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr class="success">
                                    <th>STT</th>
                                    <th>Mã phiếu</th>
                                    <th>Ngày chi</th>
                                    <th>Chứng từ chi</th>
                                    <th>Nhà cung cấp</th>
                                    <th>Nội Dung</th>
                                    <th>Số tiền</th>
                                    <th>Thanh toán</th>
                                    <th>Còn lại</th>
                                    <th>Tình trạng</th>
                                    <th colspan="3">Thao Tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@(ViewBag.PageSize * (ViewBag.PageIndex - 1) + i)</td>
                                        <td>@item.MaPhieuChi</td>
                                        <td>@item.NgayChi.ToString("dd/MM/yyyy")</td>
                                        <td>@item.SoChungTu</td>
                                        <td>@item.TenDoiTac</td>
                                        <td>@item.NoiDung</td>
                                        <td>@TNK.Core.Common.ToCurrencyString(item.TongCong)</td>
                                        <td>@TNK.Core.Common.ToCurrencyString(item.SoTienChi)</td>
                                        <td>@TNK.Core.Common.ToCurrencyString(item.ConLaiPhaiTra)</td>
                                        @if (item.ConLaiPhaiTra <= 0)
                                        {
                                            <td>Hoàn thành</td>
                                        }
                                        else
                                        {
                                            <td>Còn nợ</td>
                                        }
                                        <td style="width:5%" class="center">
                                            <a href="@ViewBag.LinkEdit/@item.MaPhieuChi"><i title="Edit" class="fa fa-edit"></i></a>
                                        </td>
                                        <td style="width:5%" class="center">
                                            @*<a href="@ViewBag.LinkDelete/@item.MaPhieuChi"><i title="Delete" class="fa fa-close"></i></a>*@
                                            <a onclick="Delete('@item.MaPhieuChi')"><i title="Delete" class="fa fa-close"></i></a>
                                        </td>
                                    </tr>
                                    i++;
                                }
                            </tbody>
                        </table>
                        <div class="right">
                            @Html.Partial("~/Views/Shared/_Paging.cshtml")
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div class="clearfix"></div>
    </div>
</div>
@section scripts
{
<script src="~/Scripts/IndexCommon.js"></script>
<script>

        $('.date').datepicker({
            orientation: "left",
            autoclose: true
        });

        function Delete(maphieuchi) {
            if (confirm("Bạn có muốn xóa phiếu chi " + maphieuchi)) {
                window.location.href = "@ViewBag.LinkDelete/" + maphieuchi;
            }
        }
</script>
}
