@model TNK.Model.SoChiModel
@{
    var item = Model.Item;
}

<div class="page-title">
    <div class="title_left">
        <h3>Cập nhật @ViewBag.Title</h3>
    </div>
</div>
<div class="clearfix"></div>

<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_panel">
            <div class="x_title">
                <h2><b>Thông tin hóa đơn</b></h2>
                <ul class="nav navbar-right panel_toolbox">
                    <li>
                        <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                    </li>
                </ul>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">
                <form id="form-data" method="post" class="form-horizontal form-label-left FormPhieuChi">
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    @Html.HiddenFor(x => item.MaPhieuChi)
                    @Html.HiddenFor(x => item.MaLoaiPhieu)
                    @Html.HiddenFor(x => item.MaPhieuLienQuan)
                    <div class="row">
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Số chứng từ</label>
                                @Html.EditorFor(x => item.SoChungTu, new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "10", @required = "" } })
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Ngày chi</label>
                                <input type="text" class="form-control input-sm date1 " name="item.NgayChi" value="@item.NgayChi.ToString("dd/MM/yyyy")" required />
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Ngày HT</label>
                                <input type="text" class="form-control input-sm date1 " name="item.NgayHachToan" value="@item.NgayHachToan.Value.ToString("dd/MM/yyyy")" required />
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Họ tên</label>
                                <input type="text" value="@Model.TCODV.HoTen" class="form-control input-sm" readonly />
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Điện thoại</label>
                                <input type="text" value="@Model.TCODV.DienThoai" class="form-control input-sm" readonly />
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Địa chỉ</label>
                                <input type="text" value="@Model.TCODV.DiaChi" class="form-control input-sm" readonly />
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Biển số</label>
                                <input type="text" value="@Model.TCODV.BienSo" class="form-control input-sm" readonly />
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Mã xe</label>
                                @if (Model.MX != null)
                                {
                                    <input type="text" value="@Model.MX.Name" class="form-control input-sm" readonly />
                                }
                                else
                                {
                                    <input type="text" value="" class="form-control input-sm" readonly />
                                }
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Màu xe</label>
                                @if (Model.MAX != null)
                                {
                                    <input type="text" value="@Model.MAX.Name" class="form-control input-sm" readonly />
                                }
                                else
                                { <input type="text" value="" class="form-control input-sm" readonly />}
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Số tiền cọc</label>
                                <input type="text" value="@Model.TCODV.TongCong" class="form-control input-sm " readonly />
                            </div>
                        </div>
                        @*<div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Trả cọc</label>
                                <input type="text" class="form-control input-sm number2" name="item.SoTienChi" value="@Model.TCODV.SoTienChiTra" />
                            </div>
                        </div>*@
                        @*<div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Đã sử dụng</label>
                                @Html.EditorFor(x => item.SoTienChi, new { htmlAttributes = new { @class = "form-control input-sm number", @readonly = "" }  })
                            </div>
                        </div>*@
