            }
        }



        $('.date').datepicker({
            orientation: "left",
            autoclose: true
        });
        $("#FileMau").click(function () {
            debugger;
            $.fileDownload("/SoChi/ExportFile_CMPT", {
                httpMethod: "POST",
                data: {},
                failMessageHtml: "Có lỗi trong khi tải file excel."
            });
            return false;
        });
        var datafile = new FormData();
        function ImportData_PhuTung() {
            $("#txtUploadFile").trigger('click');
        }
        $('#txtUploadFile').on('change', function (e) {
            if (document.getElementById("txtUploadFile").value != "") {
                var files = e.target.files;
                if (files.length > 0) {
                    if (window.FormData !== undefined) {
                        for (var x = 0; x < files.length; x++) {
                            datafile.append('file', files[x]);
                        }
                    }
                }

                $.ajax({
                    type: "POST",
                    url: "/SoChi/ImportData_CMPT",
                    contentType: false,
                    processData: false,
                    data: datafile,
                    beforeSend: function () {
                        // Đang thực hiện ajax
                        //để Loading...
                    },
                    complete: function () {
                        // Hoàn tất ajax
                        document.getElementById("txtUploadFile").value = "";
                        datafile.delete('file');
                    },
                    success: function (result) {
                        if (result.IsError)
                            toastError(result.Message);
                        else {
                            toastSuccess("Import thành công");
                            //window.location.reload();
                        }
                    },
                    error: function (xhr, status, p3, p4) {
                        toastError("Lỗi: Import file excel.");
                        //window.location.reload();
                    }
                });
            }
        });

        function Delete(id) {
            if (confirm('Bạn có chắc chắn xóa')) {
                data = { id: id };
                $.post("/SoChi/CMPTUDelete", data).success(function (response) {
                    if (response == "success") {
                        $(a).closest("tr").remove();
                        toastSuccess("Đã xóa thành công");
                    }
                    else
                        toastError(response);
                });
            }
        }
        var p = 1;
        function change() {
            debugger;
            p = 1;
        }
        $("#btnSearchTemp").click(function () {
            $(this).val("Loading...");
            $(this).prop('disabled', true);
            Search(this);
        })
        function Search(obj) {
            var pageSizes = document.getElementById('pageSizeCMPTUTemp');
            var size = pageSizes != undefined ? pageSizes.value : '';
            var from = $("#from").val();
            var to = $("#to").val();
            var query = $("#query").val();
            $.get("/SoChi/CMPTUTemp?query=" + query + "&from=" + from + "&to=" + to + "&p=" + p + "&pageSize=" + size).success(function (response) {
                $("#tbody").html(response);
                //debugger;
