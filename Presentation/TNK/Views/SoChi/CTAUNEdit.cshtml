@model TNK.Model.SoChiModel
@{
    //var NhanVien = (List<TNK.Core.Domain.NhanVien>)ViewData["NhanVien"];

    var item = Model.Item;

}
<div class="page-title">
    <div class="title_left">
        <h3>@ViewBag.Title</h3>
    </div>
</div>
<div class="clearfix"></div>
<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_panel">
            <div class="x_title">
                <h2><b>Thông tin</b></h2>
                <ul class="nav navbar-right panel_toolbox">
                    <li>
                        <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                    </li>
                </ul>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">
                <form method="post" id="form-data" class="form-horizontal form-label-left FormPhieuChi">
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    @Html.HiddenFor(x => item.MaPhieuChi)
                    @Html.HiddenFor(x=> item.MaLoaiPhieu)
                    <div class="row">
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Số chứng từ (*)</label> <!-- (nhập BNTAY nếu là biên nhận tay)-->
                                @Html.EditorFor(x => item.SoChungTu, new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "10" } })
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Ngày chi</label>
                                @Html.EditorFor(x => item.NgayChi, new { htmlAttributes = new { @class = "form-control input-sm date1", @Value = item.NgayChi.ToString("dd/MM/yyyy") } })
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Ngày hạch toán</label>
                                @Html.EditorFor(x => item.NgayHachToan, new { htmlAttributes = new { @class = "form-control input-sm date1", @Value = item.NgayHachToan.Value.ToString("dd/MM/yyyy") } })
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Họ tên (*)</label>
                                @Html.EditorFor(x => item.HoTen, new { htmlAttributes = new { @class = "form-control input-sm", @id = "auto_complete" } })
                                @*@Html.DropDownListFor(x=>item.HoTen, Model.GetNhanVien.Select(x=> new SelectListItem { Text = x.HoTen, Value = x.HoTen.ToString() }),"Chọn", new { @class = "select2 fullwidth" })*@
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Điện thoại</label>
                                @Html.EditorFor(x => item.DienThoai, new { htmlAttributes = new { @class = "form-control input-sm" } })
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Địa chỉ</label>
                                @Html.EditorFor(x => item.DiaChi, new { htmlAttributes = new { @class = "form-control input-sm" } })
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Lý do chi</label>
                                <input type="hidden" class="CTPTId" value="" />
                               
                                <select class="select2 fullwidth" name="item.LyDoChi"  >
                                    @if (item.LyDoChi != "")
                                    {
                                        //<option value="@item.LyDoChi">@item.LyDoChi</option>
                                        <option value="">Chọn</option>
                                        <option value="CP" @(item.LyDoChi == "CP" ? "selected" : "")>Chi Phí</option>
                                        <option value="GCN" @(item.LyDoChi == "GCN" ? "selected" : "")>Gia Công Ngoài</option>
                                        <option value="VTX" @(item.LyDoChi == "VTX" ? "selected" : "")>Vật Tư Xưởng</option>
                                        <option value="GTX" @(item.LyDoChi == "GTX" ? "selected" : "")>Giấy Tờ Xe</option>
                                        <option value="KHAC" @(item.LyDoChi == "KHAC" ? "selected" : "")>Khác</option>
                                    }                                
                                             
                                </select>
                            </div>
                        </div>

                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label>Nội dung (*)</label>
                                @Html.TextAreaFor(x => item.NoiDung, new { @class = "form-control input-sm" })
                            </div>
                        </div>
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            @Html.Partial("~/Views/Shared/_ThanhToanChi.cshtml", null, new ViewDataDictionary { { "CTPT", Model.CTPT }, { "HTTT", Model.HTTT } })
                        </div>
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label>Ghi chú</label>
                                @Html.TextAreaFor(x => item.GhiChu, new { @class = "form-control input-sm" })
                            </div>
                        </div>
                        @Html.Partial("~/Views/Common/UserComfirm.cshtml", null, new ViewDataDictionary { { "User", Model.Users }, { "Item", item } })
                    </div>
                    <div class="ln_solid"></div>
                    <div class="form-group">
                        <div class="col-md-6 col-sm-6 col-xs-12 col-md-offset-3">
                            @if (item.ConLai == 0)
                            {
                                <input value="Save" class="btn btn-success" onclick="Back();" style="width:12%"  />
                            }
                            else
                            {
                                if (ViewBag.a != "View")
                                {
                                    <input type="submit" value="Save" class="btn btn-success" />
                                }
                                else
                                {
                                    <a href="/SoChi/Index" class="Back">Quay lại</a>
                                }
                            }
                            
                        </div>
                    </div>
                    <div class="ln_solid"></div>
                </form>
            </div>
        </div>
    </div>
</div>

@*<a href="@ViewBag.LinkIndex" class="Back">Quay lại</a>*@
@section scripts
{
    <script src="~/Scripts/IndexCommon.js"></script>
    <link href="~/assests/plugins/select2/select2.css" rel="stylesheet" />
    <link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <script src="~/assests/plugins/select2/select2.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery-ui.js"></script>
    <script src="~/Scripts/SoChiPhuTungCommon.js"></script>
    <script type="text/javascript">

        i = '@Model.CTPT.Count';
        $(".addHTTT").click(function () {
            var html = tr.split("httt[0]").join("httt[" + i + "]");
            @if(Model.CTPT.Count>0)
            {
             @Html.Raw("html=html.replace('" + Model.CTPT[0].Id+"','');")
             @Html.Raw("html=html.replace('" + Model.CTPT[0].SoTienThanhToan+"','');")
             @Html.Raw("html=html.replace('selected','');")
             @Html.Raw("html=html.replace('" + Model.CTPT[0].SoThamChieu + "','');")
            }
            $("#tbody").append("<tr>" + html + "</tr>");
            i++;
            setTimeout(function () {
                $('.select2').select2({
                    placeholder: "Select an option",
                    allowClear: true
                });
                removeSelect();
            }, 200);
        })

        $(document).on("change", ".number", function () {
            var val = $(this).val();
            if (val != "") {
                val = val.split(",").join("");
                val = parseInt(val);
               // val = val * 1000;
                $(this).val(val.toLocaleString('en-us'));
            }
            else {
                $(this).val(0);
            }
        });
        function Remove(a) {
            var tr = $(a.closest("tr"));
            tr.find(".IsDeleted").val("true");
            tr.hide();
            CalThanhToan(a);
        }
        $(document).ready(function () {
            var Mang = new Array();
            var ArrSoChungTu = new Array();
            ArrSoChungTu.push("BNTAY");
            $(function () {
                $.ajax({
                    url: "/SoChi/AutoComplete",
                    type: "POST",
                    dataType: "json",
                    success: function (data) {
                        for (var i = 0; i < data.length; i++) {
                            Mang.push(data[i]);
                        }
                        return Mang;
                    }
                });
                $("#auto_complete").autocomplete({
                    source: Mang
                });
                $("#item_SoChungTu").autocomplete({
                    source: ArrSoChungTu
                });
            });
        });
        var Back = function () {
            window.location.assign("/SoChi/CTAUNIndex")
        }
    </script>
}





