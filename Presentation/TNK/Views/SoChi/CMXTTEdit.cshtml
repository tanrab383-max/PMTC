@model TNK.Model.SoChiModel
@{
    var item = Model.Item;
    var noPhaiTra = Model.ItemNoPhaiTra;
}
<div class="">
    <div class="page-title">
        <div class="title_left">
            <h3>Cập nhật phiếu mua xe thực tế</h3>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="row">
        <div class="col-md-12 col-sm-12 col-xs-12">
            <div class="x_panel">
                <div class="x_title">
                    <h2><b>Thông tin hóa đơn</b></h2>
                    <ul class="nav navbar-right panel_toolbox">
                        <li>
                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                        </li>
                    </ul>
                    <div class="clearfix"></div>
                </div>
                <div class="x_content">
                    <form method="post" id="form-data" class="form-horizontal form-label-left FormPhieuChi">
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        @Html.HiddenFor(x => item.MaPhieuChi)
                        <input id="maLoaiPhieu" value="@item.MaLoaiPhieu" hidden /> 
                        <div class="row">
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Số chứng từ</label>
                                    @Html.HiddenFor(x => item.MaLoaiPhieu, new { htmlAttributes = new { @class = "form-control input-sm maPhieuNo" }, @id = "maLoaiPhieu" })
                                    @Html.EditorFor(x => item.SoChungTu, new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "10" } })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Ngày chi</label>
                                    @Html.EditorFor(x => item.NgayChi, new { htmlAttributes = new { @class = "form-control input-sm date1", @Value = item.NgayChi.ToString("dd/MM/yyyy") } })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Ngày hạch toán</label>
                                    @Html.EditorFor(x => item.NgayHachToan, new { htmlAttributes = new { @class = "form-control input-sm date1", @Value = item.NgayHachToan.Value.ToString("dd/MM/yyyy") } })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Nhà cung cấp</label>
                                    @Html.DropDownListFor(x => item.DoiTac, Model.DoiTac.Select(x => new SelectListItem { Text = x.TenDoiTac, Value = x.MaDoiTac }), "Chọn", new { @class = "select2 fullwidth", @id = "NCC", @onchange = "DanhSachCoc(this)" })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Về dự kiến</label>
                                    @Html.EditorFor(x => item.NgayVeDuKien, new { htmlAttributes = new { @class = "form-control input-sm date1", @Value = item.NgayVeDuKien.Value.ToString("dd/MM/yyyy") } })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Về thực tế</label>
                                    @Html.EditorFor(x => item.NgayVeThucTe, new { htmlAttributes = new { @class = "form-control input-sm date1", @Value = item.NgayVeThucTe.Value.ToString("dd/MM/yyyy") } })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Loại xe</label>
                                    @*@if (ViewBag.Flag == false)
                                    {
                                        <select class="select2 fullwidth" style="height:29px" name="item.MaXe">
                                            <option value="@item.MaXe">@item.MaXe</option>
                                        </select>
                                    }
                                    else
                                    {*@
                                        @Html.DropDownListFor(x => item.MaXe, Model.MaXe.Select(x => new SelectListItem { Text = x.MaLoaiXe, Value = x.MaLoaiXe.ToString() }), "Chọn", new { @class = "select2 fullwidth" })
                                    @*}*@
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Số khung</label>
                                    @Html.EditorFor(x => item.SoKhung, new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "20", @readonly =""} })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Số máy</label>
                                    @Html.EditorFor(x => item.SoMay, new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "20" } })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Giá mua</label>
                                    @Html.EditorFor(x => item.GiaVon, new { htmlAttributes = new { @class = "form-control input-sm number", @maxlength = "20", @onchange = " CalThanhToan(a)" } })
                                </div>
                            </div>

                            <div class="col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group table-responsive">
                                    <label>Cọc: </label>
                                    <table class="table table-striped jambo_table bulk_action" id="Coc">
                                        <thead>
                                            <tr>
                                                <th>Mã Phiếu Cọc</th>
                                                <th>Số tiền có thể sử dụng</th>
                                                <th>Số tiền sử dụng</th>
                                                <th>Còn lại</th>
                                            </tr>
                                        </thead>
                                        <tbody id="DS_ChiCoc">
                                            @*phan append*@
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td>Tổng cộng: </td>
                                                <td class="number TotalCoc" id="TongCongThanhToanCoc">0</td>
                                                <td class="number TotalCoc" name="CTPC.SoTienThanhToan" id="TongSoTienChi">0</td>
                                                <td></td>

                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>

                            <div class="col-md-12 col-sm-12 col-xs-12">
                                @Html.Partial("~/Views/Shared/_ThanhToanChi.cshtml", null, new ViewDataDictionary { { "CTPT", Model.CTPT }, { "HTTT", Model.HTTT } })
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Nợ</label>
                                    @Html.HiddenFor(x => noPhaiTra.MaPhieuNo, new { htmlAttributes = new { @class = "form-control input-sm maPhieuNo" }, @id = "maPhieuNo" })
                                    @Html.EditorFor(x => noPhaiTra.SoTienNo, new { htmlAttributes = new { @class = "form-control input-sm number",@readonly = "" } })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Đã trả</label>
                                    @Html.EditorFor(x => noPhaiTra.SoTienDaTra, new { htmlAttributes = new { @class = "form-control input-sm number", @readonly = "" } })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Còn lại</label>
                                    @Html.EditorFor(x => noPhaiTra.SoTienConLai, new { htmlAttributes = new { @class = "form-control input-sm number", @readonly = "" } })
                                </div>
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label>Ghi chú</label>
                                    @Html.TextAreaFor(x => item.GhiChu, new { @class = "form-control input-sm" })
                                </div>
                            </div>
                            @Html.Partial("~/Views/Common/UserComfirm.cshtml", null, new ViewDataDictionary { { "User", Model.Users }, { "Item", item } })
                        </div>
                        <div class="ln_solid"></div>
                        @if (ViewBag.a != "View")
                        {
                            <div class="form-group">
                                <div class="col-md-6 col-sm-6 col-xs-12 col-md-offset-3">
                                    <input type="submit" value="Save" class="btn btn-success" />
                                </div>
                            </div>
                        }
                        else
                        {
                            <a href="/SoChi/Index" class="Back">Quay lại</a>
                        }
                        <div class="ln_solid"></div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@*<a href="/SoThu/CMXTTIndex" class="Back">Quay lại</a>*@
