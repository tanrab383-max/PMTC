@model List<TNK.Core.Domain.View.ViewPhieuChi>
@{
    ViewBag.Title = "Mua xe thực tế";
    int i = 1;
}
<div class="page-title">
    <div class="title_left">
        <h3>@ViewBag.Title</h3>       

    </div>
</div>
<div class="clearfix"></div>
<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_panel">
            <div class="x_title">
                <h2><b></b></h2>
                <ul class="nav navbar-right panel_toolbox">
                    <li>
                        <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                    </li>
                    <li>
                        <a href="/SoChi/CMXTTCreate"><i class="fa fa-plus addNew addNew"></i></a>
                    </li>
                </ul>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">
                <form id="formSearch" method="get" class="row">
                    <div class="col-md-2 col-sm-2 col-xs-12">
                        <div class="form-group">
                            <label>Từ ngày chi</label>
                            <input type="text" class="form-control input-sm date" value="@ViewBag.From" name="from" />
                        </div>
                    </div>
                    <div class="col-md-2 col-sm-2 col-xs-12">
                        <div class="form-group">
                            <label>Đến ngày chi</label>
                            <input type="text" class="form-control input-sm date" value="@ViewBag.To" name="to" />
                        </div>
                    </div>
                    <div class="col-md-5 col-sm-5 col-xs-12">
                        <div class="form-group">
                            <label>Từ khóa</label>
                            <input type="text" title="Số chứng từ, Đối tác, Số khung, Số máy, Loại xe" placeholder="Số chứng từ, Đối tác, Số khung, Số máy, Loại xe" class="form-control input-sm " value="@ViewBag.Query" name="query" />
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12">
                        <div class="form-group">
                            <br />
                            <input type="submit" value="Tìm kiếm" class="btn btn-success search" />
                            <input id="btnExportExcel" style="width:40%" name="export" value="Xuất Excel" class="btn btn-info" />
                        </div>
                    </div>
                </form>
                <div class="x_content">
                    <div class="table-responsive" id="tbody">
                        <table class="table">
                            <thead>
                                <tr class="success">
                                    <th>STT</th>
                                    <th>Ngày chi</th>
                                    <th>Mã phiếu</th>
                                    <th>Chứng từ</th>
                                    <th>Đối tác</th>
                                    <th>Loại xe</th>
                                    <th>Số khung</th>
                                    <th>Số máy</th>
                                    <th>Giá mua</th>
                                    <th>Thanh toán</th>
                                    <th>Còn nợ</th>
                                    <th>Tình trạng</th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@(ViewBag.PageSize * (ViewBag.PageIndex - 1) + i)</td>
                                        <td>@item.NgayChi.ToString(ViewBag.DateFormat)</td>
                                        <td>@item.MaPhieuChi</td>
                                        <td>@item.SoChungTu</td>                                       
                                        <td>@item.TenDoiTac</td>
                                        <td>@item.MaXe</td>
                                        <td>@item.SoKhung</td>
                                        <td>@item.SoMay</td>
                                        <td>@TNK.Core.Common.ToCurrencyString(item.GiaVon)</td>
                                        <td>@TNK.Core.Common.ToCurrencyString(item.SoTienChi)</td>
                                        <td>@TNK.Core.Common.ToCurrencyString(item.ConLaiPhaiTra)</td>
                                        @if (item.ConLaiPhaiTra <= 0)
                                        {
                                            <td>Hoàn thành</td>
                                        }
                                        else
                                        {
                                            <td>Còn nợ</td>
                                        }
                                        <td style="width:5%" class="center">
                                            <a href="/SoChi/CMXTTEdit/@item.MaPhieuChi" ><i title="Edit" class="fa fa-edit"></i></a>
                                        </td>
                                        <td style="width:5%" class="center">
                                            <a href="/Sochi/CMXTTDelete/@item.MaPhieuChi" onclick="return confirm('Xác nhận xóa?');"><i title="Delete" class="fa fa-close"></i></a>
                                        </td>
                                    </tr>
                                    i++;
                                }
                            </tbody>
                        </table>
                        <div class="right">
                            @Html.Partial("~/Views/Shared/_Paging_v2.cshtml")
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div class="clearfix"></div>
    </div>
    </div>
    @section scripts
{
<script src="~/Scripts/IndexCommon.js"></script>
<script>

        $('.date').datepicker({
            orientation: "left",
            autoclose: true
        });
             $("#btnExportExcel").click(function () {
            if ($($("#tab_data li.unactive")[0]).attr("data-url") != "") {
                var dt = new Date();
                var day = dt.getDate();
                var month = dt.getMonth() + 1;
                var year = dt.getFullYear();
                var hour = dt.getHours();
                var mins = dt.getMinutes();
                var postfix = day + "." + month + "." + year + "_" + hour + "." + mins;
                //var idtable = $($("#tab_data li.unactive")).attr("data-url").replace("/SoChi/PhieuChi/", "#");
                //alert(idtable);
                var idtable = "#tbody";
                var result = $(idtable).html();
                result = result.replace('class="table"', 'class="table" border="1"');
                //alert(result)
                tableToExcel(result, 'CMXTT' + '_@ViewBag.Type' + '_' + postfix + '.xls');
            }
            else {
                window.location = `/SoThu/CMXTTIndex?from=${$("#FromDate").val()}&to=${$("#ToDate").val()}&export=Excel`;
            }
            return false;
        })

        var tableToExcel = (function () {
            var uri = 'data:application/vnd.ms-excel;base64,'
            , template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>{table}</table></body></html>'
            , base64 = function (s) { return window.btoa(unescape(encodeURIComponent(s))) }
            , format = function (s, c) { return s.replace(/{(\w+)}/g, function (m, p) { return c[p]; }) }
            return function (table, name) {
                //if (!table.nodeType) table = document.getElementById(table)
                var ctx = { worksheet: name || 'Worksheet', table: table }
                var link = document.createElement("A");
                link.href = uri + base64(format(template, ctx));
                link.download = name || 'Baocao.xls';
                link.target = '_blank';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            }
        })()
</script>
    }