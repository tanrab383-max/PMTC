@model List<TNK.Core.Domain.KhoPhuTung>
@{
    double tongtien = 0;

}
<div class="page-title">
    <div class="title_left">
        <h3>@ViewBag.Title</h3>
    </div>
</div>
<div class="clearfix"></div>
<div class="row">
    <div class="col-md-12">
        <div class="tabbable-line boxless tabbable-reversed">
            
            <div class="tab-content">
                <div class="tab-pane active" id="tab_0">
                    <div class="x_panel">
                        <div class="x_content">
                            <form method="get" class="row">                               
                                   
                                    <div class="col-md-6 col-sm-6 col-xs-12">
                                        <div class="form-group">
                                            <label>Từ khóa</label>
                                            <input type="text" title="Mã kho" placeholder="Mã kho" class="form-control input-sm " value="@ViewBag.Query" name="query" />
                                        </div>
                                    </div>
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                        <div class="form-group">
                                            <br />
                                            <input type="submit" value="Tìm kiếm" class="btn btn-success" />
                                        </div>
                                    </div>
                            </form>
                            <div class="table-responsive">
                                <table class="table">
                                    <thead>
                                        <tr class="success">
                                            <th>Mã kho</th>
                                            <th>Tên kho</th>
                                            <th>Số tiền khời tạo</th>
                                            <th>Tổng tiền</th>
                                            <th>Phần trăm giá vốn</th>  
                                            <th>Loại kho</th>                      
                                            <th>Nhà cung cấp</th>                                            
                                            <th></th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                           tongtien += item.TongTien.ToString() == "" ? 0 : Convert.ToDouble(item.TongTien);
                                            <tr>
                                                <td>@item.MaKho</td>
                                                <td>@item.TenKho</td>
                                                <td class="number">@TNK.Core.Common.ToCurrencyString(item.SoTienKhoiTao.Value)</td>
                                                @if (item.TongTien != null)
                                                {
                                                    <td class="number">@TNK.Core.Common.ToCurrencyString(item.TongTien.Value)</td>
                                                }
                                                else
                                                {
                                                    <td class="number">0</td>
                                                }
                                                <td>@item.PhanTramGiaVon</td>
                                                <td>@item.LoaiKho</td>
                                                <td>@item.MaNCC</td>

                                                <td style="width:5%" class="center">
                                                    <a href="/KhoPhuTung/Edit/@item.MaKho"><i title="Edit" class="fa fa-edit"></i></a>
                                                </td>
                                            </tr>
                                        }
                                        <tr class="even pointer" style="background-color:lightblue;font-weight:bold">
                                            <td colspan="3"><b>TỔNG TIỀN</b></td>
                                            <td colspan="5" class="number" >@TNK.Core.Common.ToCurrencyString(tongtien)</td>
                                        </tr>
                                    </tbody>
                                </table>
                                @*<div class="right">
                                    @Html.Partial("~/Views/Shared/_Paging.cshtml")
                                </div>*@
                            </div>
                        </div>
                    </div>
                </div>
                
            </div>
        </div>
    </div>
    <div class="col-md-12 col-sm-12 col-xs-12">
    </div>
    <div class="clearfix"></div>
</div>
@section scripts
{
    <script>
        $("td.number").map(function (key, val) {
            var val = $(this).html();
            //val = val.replace(",", ".");
            val = val.split(",").join("");
            val = parseFloat(val);
            $(this).html(val.toLocaleString('en-us'));
        })
        var p = 1;
        $("#Search").click(function () {
            Search();
        })
        function change() {
            p = 1;
        }
        function Search() {
            var from = $("#from").val();
            var to = $("#to").val();
            var query = $("#query").val();
            console.log(query);
            $.get("/SoThu/TBAXEComplete?query=" + query + "&from=" + from + "&to=" + to + "&p=" + p).success(function (response) {
                $("#tbody").html(response);
            })
        }
        var a;
        $(document).on("click", "#tbody a", function () {
            a = $(this).attr("href");
            var b = a.split("&");
            p = b[2].split("=")[1];
            console.log(p);
            Search();
            return false;
        })
        $('.date').datepicker({
            orientation: "left",
            autoclose: true
        });
        function Delete(a, id) {
            if (confirm('Xác nhận')) {
                data = { id: id, type: 'TBAXE' };
                $.post("/SoThu/DeletePhieuThu", data).success(function (response) {
                    if (response == "success") {
                        $(a).closest("tr").remove();
                    }
                });
            }
        }
    </script>
}