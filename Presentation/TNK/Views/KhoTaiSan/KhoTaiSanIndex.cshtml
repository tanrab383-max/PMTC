@model List<TNK.Core.Domain.View.ViewKhoTaiSan>
<div class="page-title">
    <div class="title_left">
        <h3>@ViewBag.Title</h3>
    </div>
</div>
<div class="clearfix"></div>
<div class="row">
    <div class="col-md-12">
        <div class="tabbable-line boxless tabbable-reversed">
            
            <div class="tab-content">
                <div class="tab-pane active" id="tab_0" data-url="/KhoTaiSan/Index">
                    <div class="x_panel">
                        <div class="x_content">
                            <form method="get" class="row">
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                        <div class="form-group">
                                            <label>Từ ngày nhập</label>
                                            <input type="text" class="form-control input-sm date" value="@ViewBag.From" name="from" id="FromDate"/>
                                        </div>
                                    </div>
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                        <div class="form-group">
                                            <label>Đến ngày nhập</label>
                                            <input type="text" class="form-control input-sm date" value="@ViewBag.To" name="to" id="ToDate"/>
                                        </div>
                                    </div>
                                    <div class="col-md-5 col-sm-5 col-xs-12">
                                        <div class="form-group">
                                            <label>Từ khóa</label>
                                            <input type="text" title="Phiếu chi,Tên loại tài sản, Tên tài sản" placeholder="Phiếu chi,Tên loại tài sản, Tên tài sản" class="form-control input-sm " value="@ViewBag.Query" name="query" id="Query" />
                                        </div>
                                    </div>
                                <div class="col-md-3 col-sm-3 col-xs-12">
                                        <div class="form-group">
                                            <br />
                                            <input type="submit" value="Tìm kiếm" class="btn btn-success" />
                                            <input type="button" value="Xuất excel" class="btn btn-info" id="btnExportExcel" />
                                        </div>
                                    </div>
                        </form>
                            <div class="table-responsive" id="Index">
                                <table class="table">
                                    <thead>
                                        <tr class="success">
                                            <th>STT</th>
                                            <th>Ngày nhập</th>
                                            <th>Phiếu nhập</th>
                                            <th>Tên loại tài sản</th>
                                            <th>Tên tài sản</th>
                                            <th>Giá mua</th>
                                            <th>Thời gian khấu hao</th>
                                            <th>Hình thức khấu hao</th>
                                            <th>Giá trị còn lại</th>
                                            <th>Giá bán TS</th>
                                            <th>Ngày bán TS</th>
                                            <th>Nhà cung cấp</th>
                                            <th></th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int i = 1;
                                            foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td>@(ViewBag.PageSize * (ViewBag.PageIndex - 1) + i++)</td>
                                                    <td>@item.NgayNhapKho.ToString(ViewBag.DateFormat)</td>
                                                    <td>@item.MaPhieuNhap</td>
                                                    <td>@item.TenLoaiTS</td>
                                                    <td>@item.TenTaiSan</td>
                                                    <td class="number2">@TNK.Core.Common.ToCurrencyString(item.GiaMua)</td>
                                                    <td>@item.ThoiGianKhauHao</td>
                                                    <td>@item.HinhThucKhauHao</td>
                                                    <td class="number2">@TNK.Core.Common.ToCurrencyString(item.GiaTriConLai)</td>
                                                    <td class="number2">@TNK.Core.Common.ToCurrencyString(item.GiaBan)</td>
                                                    <td>@(item.NgayThu.ToString(ViewBag.DateFormat) == "01/01/2018" ? "" : item.NgayThu.ToString(ViewBag.DateFormat))</td>
                                                    <td>@item.NhaCungCap</td>
                                                    <td style="width:5%" class="center">
                                                        <!--Tam thoi khong cho sua kho tai san-->
                                                      <!--  <a href="/KhoTaiSan/Edit/@item.KId"><i title="Edit" class="fa fa-edit"></i></a> -->
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        
                                    </tbody>
                                </table>
                                <div class="right">
                                    @Html.Partial("~/Views/Shared/_Paging.cshtml")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
            </div>
        </div>
    </div>
    <div class="col-md-12 col-sm-12 col-xs-12">
    </div>
    <div class="clearfix"></div>
</div>
@section scripts
{
    <script src="~/Scripts/jquery.fileDownload.js"></script>
    <script>
        var p = 1;
        $("#Search").click(function () {
            Search();
        })
        function change() {
            p = 1;
        }
        function Search() {
            var from = $("#from").val();
            var to = $("#to").val();
            var query = $("#query").val();
            console.log(query);
            $.get("/SoThu/TBAXEComplete?query=" + query + "&from=" + from + "&to=" + to + "&p=" + p).success(function (response) {
                $("#tbody").html(response);
            })
        }
        var a;
        $(document).on("click", "#tbody a", function () {
            a = $(this).attr("href");
            var b = a.split("&");
            p = b[2].split("=")[1];
            console.log(p);
            Search();
            return false;
        })
        $('.date').datepicker({
            orientation: "left",
            autoclose: true
        });
        function Delete(a, id) {
            if (confirm('Xác nhận')) {
                data = { id: id, type: 'TBAXE' };
                $.post("/SoThu/DeletePhieuThu", data).success(function (response) {
                    if (response == "success") {
                        $(a).closest("tr").remove();
                    }
                });
            }
        }

