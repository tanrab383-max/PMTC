@model TNK.Model.KhoTaiSanModel
@{
    var item = Model.Item;
}
<div class="">
    <div class="page-title">
        <div class="title_left">
            <h3>Cập nhật tài sản</h3>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="row">
        <div class="col-md-12 col-sm-12 col-xs-12">
            <div class="x_panel">
                <div class="x_title">
                    <h2><b>Thông tin</b></h2>
                    <ul class="nav navbar-right panel_toolbox">
                        <li>
                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                        </li>
                    </ul>
                    <div class="clearfix"></div>
                </div>
                <div class="x_content">
                    <form method="post" id="form-data" class="form-horizontal form-label-left">
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        @Html.HiddenFor(x => item.Id)
                        <div class="row">
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Mã phiếu nhập</label>
                                    @Html.EditorFor(x => item.MaPhieuNhap, new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "15" } })
                                    
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Ngày nhập</label>
                                    @Html.EditorFor(x => item.NgayNhapKho, new { htmlAttributes = new { @class = "form-control input-sm date", @Value = @item.NgayNhapKho.Value.ToString("dd/MM/yyyy") } })
                                </div>
                            </div>

                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Giá mua</label>
                                    @Html.EditorFor(x => item.GiaMua, new { htmlAttributes = new { @class = "number form-control input-sm", @readonly = "" } })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Giá trị còn lại</label>
                                    @Html.EditorFor(x => item.GiaTriConLai, new { htmlAttributes = new { @class = "number form-control input-sm" } })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Nhà cung cấp</label>
                                    @Html.DropDownListFor(x => item.NhaCungCap, Model.ListNhaCungCap.Select(x => new SelectListItem { Text = x.TenDoiTac, Value = x.MaDoiTac }), "Chọn", new { @class = "select2 fullwidth" })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Loại tài sản</label>
                                    @Html.DropDownListFor(x => item.MaLoaiTS, Model.ListTenTaiSan.Select(x => new SelectListItem { Text = x.Name, Value = x.Code }), "Chọn", new { @class = "select2 fullwidth" })
                                </div>
                            </div>
                                                     
                           
                            <div class="col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label>Ghi chú</label>
                                    @Html.TextAreaFor(x => item.GhiChu, new { @class = "form-control input-sm" })
                                </div>
                            </div>
                            
                        </div>
                        <div class="ln_solid"></div>
                        <div class="form-group">
                            <div class="col-md-6 col-sm-6 col-xs-12 col-md-offset-3">
                                <input type="submit" value="Save" class="btn btn-success" />
                            </div>
                        </div>
                        <div class="ln_solid"></div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<a href="/KhoTaiSan/Index">Quay lại</a>
