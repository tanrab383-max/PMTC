@model TNK.Core.Domain.DoiTac

@{
    ViewBag.Title = "Thêm Đối Tác";
    var doitac = (List<TNK.Core.Domain.CategoryItem>)ViewBag.DoiTac;

    var lstDoiTacNoiBo = new List<SelectListItem>
        {
            new SelectListItem { Value = "0", Text = "Ngoài" },
            new SelectListItem { Value = "1", Text = "Nội bộ" },           
        };

}
<div class="">
    <div class="page-title">
        <div class="title_left">
            <h3>@ViewBag.Title</h3>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="row">
        <div class="col-md-12 col-sm-12 col-xs-12">
            <div class="x_panel">
                <div class="x_title">
                    <h2><b></b></h2>
                    <ul class="nav navbar-right panel_toolbox">
                        <li>
                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                        </li>
                    </ul>
                    <div class="clearfix"></div>
                </div>
                <div class="x_content">
                    @if (ViewBag.Alert != null && ViewBag.Alert != "")
                    {
                        <div class="alert alert-success alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">x</span>
                            </button>
                            @ViewBag.Alert
                        </div>
                    }
                    <form method="post" class="form-horizontal form-label-left">
                        <div class="form-body">
                            @Html.AntiForgeryToken()
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Mã đối tác</label>
                                <div class="col-md-6 col-sm-6 col-xs-12">
                                    @if (ViewBag.Edit)
                                    {
                                        @Html.EditorFor(model => model.MaDoiTac, new { htmlAttributes = new { @class = "form-control input", @required = "", @disabled = "", @id = "MaDoiTac" } })
                                    }
                                    else
                                    {
                                        @Html.EditorFor(model => model.MaDoiTac, new { htmlAttributes = new { @class = "form-control input", @required = "", @id = "MaDoiTac" } })
                                    }
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Loại đối tác</label>
                                <div class="col-md-6 col-sm-6 col-xs-12">
                                    <select class="select2 fullwidth" required name="LoaiDoiTac">
                                        <option value="">Chọn</option>
                                        @foreach (var item in doitac)
                                        {
                                            <option value="@item.Code" @(Model != null && Model.LoaiDoiTac.Trim() == item.Code.Trim() ? "selected" : "")>@item.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Hạn mức vay</label>
                                <div class="col-md-6 col-sm-6 col-xs-12">
                                    @Html.EditorFor(model => model.HanMucVay, new { htmlAttributes = new { @class = "form-control input-sm number", @type = "number" } })
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Mã viết tắt</label>
                                <div class="col-md-6 col-sm-6 col-xs-12">
                                    @Html.EditorFor(model => model.MaVietTat, new { htmlAttributes = new { @class = "form-control ", @required = "" } })
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Tên đối tác</label>
                                <div class="col-md-6 col-sm-6 col-xs-12">
                                    @Html.EditorFor(model => model.TenDoiTac, new { htmlAttributes = new { @class = "form-control ", @required = "" } })
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Ghi chú</label>
                                <div class="col-md-6 col-sm-6 col-xs-12">
                                    @Html.EditorFor(model => model.GhiChu, new { htmlAttributes = new { @class = "form-control ", } })
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Tỷ lệ hoa hồng</label>
                                <div class="col-md-6 col-sm-6 col-xs-12">
                                    @Html.EditorFor(model => model.TyLeHoaHong, new { htmlAttributes = new { @class = "form-control", @Value = 0, @required = "", @type = "number" } })
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Đối tác nội bộ?</label>
                                <div class="col-md-3 col-sm-3 col-xs-12" style="margin:5px">
                                    @Html.DropDownListFor(model => model.DoiTacNoiBo, lstDoiTacNoiBo, "Chọn loại", new { htmlAttributes = new { @class = "form-control" } })
                                </div>
                                <label class="control-label col-md-2 col-sm-2 col-xs-12">TẠO TÚI TIỀN THANH TOÁN?</label>
                                <div class="col-md-2 col-sm-2 col-xs-12" style="margin:5px">
                                    <label>
                                        <input type="checkbox" id="TaoTuiDKHoan" name="TaoTuiDKHoan" value="true" onchange="this.value = this.checked ? 'true' : 'false';" />
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="form-actions margin-top-10">
                            <div class="row">
                                <div class="col-md-offset-2 col-md-10">
                                    <input type="submit" value="Save" class="btn btn-success" onclick="Save()" />
                                </div>
                            </div>
                        </div>
                    </form>
                    <br>
                </div>
            </div>
        </div>
    </div>

</div>
<div>
    <a href="/DoiTac/ListEdit">Quay lại</a>

</div>

@section scripts{
<script src="~/Scripts/IndexCommon.js"></script>
    <script>
        $(".select2").select2();
        $(document).ready(function () {
            $("input[id = 'MaDoiTac']").focusout(function () {
                debugger;
                var MaDoiTac = $("#MaDoiTac").val();
                if (MaDoiTac != "" && MaDoiTac != null) {
                    debugger;
                    $.ajax({
                        url: "/DoiTac/LayMaDoiTac",
                        type: "POST",
                        data: { MaDoiTac: MaDoiTac },
                        success: function (result) {
                            if(result == false)
                            {
                                toastr.warning("Đã có mã trùng");
                                $("#MaDoiTac").focus();
                                return false;
                            }
                        }
                    });
                }
            }).focus();
        })


            $("#MaDoiTac").change(function () {
                var text = $(this).val();
                var text_create;
                text_create = text.replace(/à|á|ạ|ả|ã|â|ầ|ấ|ậ|ẩ|ẫ|ă|ằ|ắ|ặ|ẳ|ẵ/g, "a").replace(/\ /g, '-').replace(/đ/g, "d").replace(/đ/g, "d").replace(/ỳ|ý|ỵ|ỷ|ỹ/g, "y").replace(/ù|ú|ụ|ủ|ũ|ư|ừ|ứ|ự|ử|ữ/g, "u").replace(/ò|ó|ọ|ỏ|õ|ô|ồ|ố|ộ|ổ|ỗ|ơ|ờ|ớ|ợ|ở|ỡ.+/g, "o").replace(/è|é|ẹ|ẻ|ẽ|ê|ề|ế|ệ|ể|ễ.+/g, "e").replace(/ì|í|ị|ỉ|ĩ/g, "i");
                $('#MaDoiTac').val(text_create);
            }).keyup();

    </script>
    
}



