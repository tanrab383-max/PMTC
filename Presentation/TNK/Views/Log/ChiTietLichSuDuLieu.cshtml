<script src="~/Scripts/IndexCommon.js"></script>
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script type="text/javascript">
    $("td.number").map(function (key, val) {
        var val = $(this).html();
        val = val.replace(",", ".");
        val = val.split(",").join("");
        val = parseInt(val);
        $(this).html(val.toLocaleString('en-us'));
    })
</script>