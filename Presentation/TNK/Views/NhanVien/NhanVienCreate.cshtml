@model TNK.Model.NhanVienModel
@{
    var item = Model.Item;

    ViewBag.Title = "Nhân Viên";
}
<div class="page-title">
    <div class="title_left">
        <h3>@ViewBag.Title</h3>
    </div>
</div>
<div class="clearfix"></div>
<!--phần thêm nhân viên START-->
<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_panel">
            <div class="x_title">
                @ViewBag.TieuDe
                <ul class="nav navbar-right panel_toolbox">
                    <li>
                        <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                    </li>
                </ul>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">
                <form method="post" class="form-horizontal form-label-left">
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="row">
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Họ Tên</label>
                                @Html.EditorFor(x => item.HoTen, new { htmlAttributes = new { @class = "form-control number input-sm" } })
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Nam</label>
                                @Html.RadioButtonFor(x => item.GioiTinh, "1")
                                <label>Nữ</label>
                                @Html.RadioButtonFor(x => item.GioiTinh, "0")
                            </div>
                        </div>
                    </div>
                    <div class="ln_solid"></div>
                    <div class="form-group">
                        <div class="col-md-6 col-sm-6 col-xs-12 col-md-offset-3">
                            <input type="submit" value="Save" class="btn btn-success" />
                        </div>
                    </div>
                    <div class="ln_solid"></div>
                </form>
            </div>
        </div>
    </div>
</div>

<!--phần thêm nhân viên END-->
<!--Start Footer-->
<a href="~/NhanVien/Index">Quay lại</a>
<!--End Footer-->
<!--JS-->


@section scripts{
    <script>
        $(".select2").select2();
    </script>
}



