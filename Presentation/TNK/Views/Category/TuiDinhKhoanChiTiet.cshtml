@model List<TNK.Core.Domain.View.ViewGiaoDichTuiTien>
@{
   
}
<div class="page-title">
    <div class="title_left">
        <h3>@ViewBag.Title </h3>
      
    </div>
</div>

<div class="clearfix"></div>
<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_panel">
            
            <div class="x_content">
                <form method="get" class="row">
                    <input type="hidden" value="@ViewBag.Type" name="type" />
                    <div class="col-md-3 col-sm-3 col-xs-12">
                        <div class="form-group">
                            <label>Từ ngày</label>
                            <input type="text" class="form-control input-sm date" value="@ViewBag.From" name="from" />
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12">
                        <div class="form-group">
                            <label>Đến ngày</label>
                            <input type="text" class="form-control input-sm date" value="@ViewBag.To" name="to" />
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12">
                        <div class="form-group">
                            <label>Túi tiền</label>
                            <input type="text" title="Túi tiền" placeholder="Mã phiếu chi, Khách hàng, Số chứng từ, Số HĐ, Số khung, Số máy" class="form-control input-sm " value="@ViewBag.MaTui" name="query" />
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12">
                        <div class="form-group">
                            <br />
                            <input type="submit" value="Tìm kiếm" class="btn btn-success" />
                        </div>
                    </div>
                </form>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr class="success">
                                <th>Mã túi</th>
                                <th>Thao tác</th>
                                <th>Mã phiếu phát sinh</th>
                                <th>Hình thức thanh toán</th>
                                <th>Số tiền</th>
                                <th>Phát sinh</th>
                                <th>Ghi chú</th>                             
                                <th>Ngày tạo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.MaTuiTien</td>
                                    <td>
                                        @if (@item.LoaiThuChi == "T")
                                        {
                                            <label>Thu</label> 
                                    }
                                        @if (@item.LoaiThuChi == "C")
                                        {
                                            <label>Chi</label>
                                    }
                                        </td>
                                    <td>@item.MaPhieuPhatSinh</td>
                                    <td>@item.HinhThucThanhToan</td>
                                    <td>@item.SoTien.ToString("0,0")</td>
                                    <td>
                                        @if (@item.TangGiam>0)
                                        {
                                            <label>Tăng</label>
                                        }
                                        @if (@item.TangGiam<0)
                                        {
                                            <label>Giảm</label>
                                        }
                                    </td>
                                    <td>@item.GhiChu</td>
                                    <td>@item.CreatedDate.ToString("yyyy/MM/dd HH:mm:ss")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<a href="TuiDinhKhoan/Index">Quay lại</a>
@section scripts
{
    <script>

        $('.date').datepicker({
            orientation: "left",
            autoclose: true
        });
    </script>
}
