                                    <a href="#" onclick="Edit('@obj.Id','@obj.MaLoaiXe')"><i title="Lưu" class="fa fa-save"></i></a>
                                </td>
                                <td style="width:5%" class="center">
                                    @*<a href="/LoaiXe/Delete/@obj.MaLoaiXe"><i title="Delete" class="fa fa-close"></i></a>*@
                                    <a href="#"><i title="Delete" class="fa fa-close" onclick="Delete('@obj.MaLoaiXe')"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="right">
                    @Html.Partial("~/Views/Shared/_Paging_v2.cshtml")
                </div>
            </div>
        </div>
    </div>
</div>




