@using System.Data;

<div class="x_content">
    <div id="BCTongCocPT" class="table-responsive">
        <table class="table table-striped table-bordered table-condensed">
            <thead>
                <tr class="headings">
                    @*<th class="column-title">Ngày Kết Chuyển</th>
        <th class="column-title">Người Kết Chuyển</th>
        <th class="column-title">Ngày Tạo</th>
        <th class="column-title">Người Hủy</th>
        <th class="column-title">Ngày Hủy</th>
        <th class="column-title">Ghi Chú</th>*@
                    <th class="column-title">Ngày Khóa Kho</th>
                    <th class="column-title">Người Khóa Kho</th>
                    <th class="column-title">Ngày Tạo</th>
                    <th class="column-title">Người Hủy</th>
                    <th class="column-title">Ngày Hủy</th>
                    <th class="column-title">Ghi Chú</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (DataRow row in (Model as DataTable).Rows)
                    {
                        <tr class="even pointer">
                            <td>@row["NgayKetChuyen"]</td>
                            <td>@row["NguoiKetChuyen"]</td>
                            <td>@row["CreatedDate"]</td>
                            <td>@row["UpdatedBy"]</td>
                            <td>@row["UpdatedDate"]</td>
                            <td>@row["GhiChu"]</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $("td.number").map(function (key, val) {
        var val = $(this).html();
        val = val.split(",").join("");
        val = parseInt(val);
        $(this).html(val.toLocaleString('en-us'));
    })
</script>