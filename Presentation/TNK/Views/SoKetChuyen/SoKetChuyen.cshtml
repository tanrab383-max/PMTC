@using System.Data;

<div class="x_content">
    <div id="BCTongCocPT" class="table-responsive">
        <table class="table table-striped table-bordered table-condensed">
            <thead>
                <tr class="headings">
                    @*<th class="column-title">Ngày Kết Chuyển</th>
        <th class="column-title">Người Kết Chuyển</th>
        <th class="column-title">Ngày Tạo</th>
        <th class="column-title">Hủy Kết Chuyển</th>*@
                    <th class="column-title">Ngày Khóa Kho</th>
                    <th class="column-title">Người Khóa</th>
                    <th class="column-title">Ngày Khóa</th>
                    <th class="column-title">Hủy Khóa</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (DataRow row in (Model as DataTable).Rows)
                    {
                        <tr class="even pointer">
                            <td>@row["NgayKetChuyen"].ToString().Substring(0, 6)</td>
                            <td>@row["NguoiKetChuyen"]</td>
                            <td>@row["CreatedDate"]</td>
                            <td><a title="Hủy Khóa Kho" onclick="HuyKC('@row["ID"]')"><i class="fa fa-trash"></i></a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
