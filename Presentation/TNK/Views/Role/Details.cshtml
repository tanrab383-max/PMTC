@model TNK.Core.Domain.Role

@{
    ViewBag.Title = "Details";
}

<div class="">
    <div class="page-title">
        <div class="title_left">
            <h3>@ViewBag.Title</h3>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="row">
        <div class="col-md-12 col-sm-12 col-xs-12">
            <div class="x_panel">
                <div class="x_title">
                    <h2><b></b></h2>
                    <ul class="nav navbar-right panel_toolbox">
                        <li>
                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                        </li>
                    </ul>
                    <div class="clearfix"></div>
                </div>
                <div class="x_content">
                    @if (ViewBag.Alert != null && ViewBag.Alert != "")
                    {
                        <div class="alert alert-success alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            @ViewBag.Alert
                        </div>
                    }

                    <br>

                    <div class="form-horizontal form-label-left">
                        <div class="form-group">
                            @Html.Label("Name:", htmlAttributes: new { @class = "control-label col-md-3 col-sm-3 col-xs-12" })
                            <label class="control-label col-md-3 col-sm-3 col-xs-12">@Model.Name </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<p>
    @Html.ActionLink("Edit", "Edit", new { id = Model.Id }) |
    @Html.ActionLink("Quay lại", "Index")
</p>


