@model TNK.Core.Domain.Role

@{
    ViewBag.Title = "Cập nhật role";
}

<div class="">
    <div class="page-title">
        <div class="title_left">
            <h3>@ViewBag.Title</h3>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="row">
        <div class="col-md-6 col-sm-12 col-xs-12">
            <div class="x_panel">
                <div class="x_title">
                    <h2><b></b></h2>
                    <ul class="nav navbar-right panel_toolbox">
                        <li>
                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                        </li>
                    </ul>
                    <div class="clearfix"></div>
                </div>
                <div class="x_content">
                    @if (ViewBag.Alert != null && ViewBag.Alert != "")
                    {
                        <div class="alert alert-success alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            @ViewBag.Alert
                        </div>
                    }

                    <br>

                    <form method="post" class="form-horizontal form-label-left">
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        @Html.HiddenFor(model => model.Id)
                        <div class="form-group">
                            @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-3 col-sm-3 col-xs-12" })
                            <div class="col-md-6 col-sm-6 col-xs-12">
                                @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="ln_solid"></div>
                        <div class="form-group">
                            <div class="col-md-6 col-sm-6 col-xs-12 col-md-offset-3">
                                <input type="submit" value="Save" class="btn btn-success" />
                            </div>
                        </div>
                        <div class="ln_solid"></div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-12 col-sm-12 col-xs-12">
            <div class="x_panel">
                <div class="x_title">
                    <h2><b>Menu</b></h2>
                    <ul class="nav navbar-right panel_toolbox">
                        <li>
                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                        </li>
                    </ul>
                    <div class="clearfix"></div>
                </div>
                <div class="x_content">

                    <table class="table">
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>Active</th>
                                <th>Types</th>
                            </tr>
                        </thead>
                        <tbody>
                            @Html.Action("GetMenuChild","Role", new { id = Model.Id, parent=0,tab=0 })
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
    </div>

</div>

<div>
    @Html.ActionLink("Quay lại", "Index")
</div>
@section scripts{
    <script>
        var id = '@Model.Id';
        $(".MenuTypeActive").change(function () {
            var checked = $(this).prop("checked");
            var mtId = $(this).closest("td").children("input.mtId").val();
            $.ajax({
                method: "POST",
                url: "/Role/UpdateActiveRoleMenuType",
                data: { roleId: id, isActive: checked, typeId: mtId },
                dataType: "json"
            })
              .done(function (msg) {
                  console.log(msg.result);
              });
        });

        $(".MenuActive").change(function () {
            var checked = $(this).prop("checked");
            var mid = $(this).closest("td").children("input.mid").val();
            $.ajax({
                method: "POST",
                url: "/Role/UpdateActiveRoleMenu",
                data: { roleId: id, isActive: checked, menuId: mid },
                dataType: "json"
            })
              .done(function (msg) {
                  console.log(msg.result);
              });
        })


    </script>
}
