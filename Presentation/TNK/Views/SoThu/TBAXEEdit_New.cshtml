@model TNK.Model.BanXeModel
@{
}

<form id="form-data" method="post">
    @Html.HiddenFor(x => Model.obj.MaPhieuThu)
   @* @Html.HiddenFor(x => Model.obj.GiaBan)*@
    @Html.HiddenFor(x => Model.obj.GiaNiemYet)
    @Html.HiddenFor(x => Model.obj.UpdatedDate)
    <div class="page-title">
        <div class="title_left">
            <h3>Cập nhật @ViewBag.Title</h3>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="row">
        <div class="col-md-12 col-sm-12 col-xs-12">
            <div class="x_panel">
                <div class="x_title">
                    <h2><b></b></h2>
                    <ul class="nav navbar-right panel_toolbox">
                        <li>
                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                        </li>
                    </ul>
                    <div class="clearfix"></div>
                </div>
                <div class="x_content">
                    <div class="form-horizontal form-label-left">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label>Số hợp đồng</label>
                                        @Html.EditorFor(x => Model.obj.SoHopDong, new { htmlAttributes = new { @class = "form-control input-sm", @readonly = "" } })
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label>Ngày hợp đồng</label>
                                        @*@Html.EditorFor(x => Model.obj.NgayHopDong, new { htmlAttributes = new { @class = " form-control input-sm date", @value = @Model.obj.NgayHachToan.ToString("dd/MM/yyyy") } })*@
                                        <input type="text" class="form-control input-sm date " name="obj.NgayHopDong" value="@Model.obj.NgayHopDong.ToString().Substring(0,10)" />
</div>

</div>

<div class="col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label>Ngày thu tiền</label>
                                        <input type="text" class="form-control input-sm date " name="obj.NgayHachToan" value="@Model.obj.NgayHachToan.ToString("dd/MM/yyyy")" />@*readonly*@
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label>Số khung</label>
                                        @Html.EditorFor(x => Model.obj.SoKhung, new { htmlAttributes = new { @class = "form-control input-sm", @readonly = "" } })
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label>Mã xe</label>
                                        @Html.EditorFor(x => Model.obj.MaXe, new { htmlAttributes = new { @class = "form-control input-sm", @readonly = "" } })
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label>Màu xe</label>
                                        @Html.EditorFor(x => Model.obj.MauXe, new { htmlAttributes = new { @class = "form-control input-sm", @readonly = "" } })
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label>Điện thoại</label>
                                        @Html.EditorFor(x => Model.obj.DienThoai, new { htmlAttributes = new { @class = "form-control input-sm"} })
                                    </div>
                                </div>
                                <div class="col-md-8 col-sm-8 col-xs-12">
                                    <div class="form-group">
                                        <label>Địa chỉ</label>
                                        @Html.EditorFor(x => Model.obj.DiaChi, new { htmlAttributes = new { @class = "form-control input-sm" } })
                                    </div>
                                </div>
                                <div class="col-md-12 col-sm-12 col-xs-12">
                                    <div class="form-group table-responsive">
                                        <table class="table table-striped jambo_table bulk_action">
                                            <thead>
                                                <tr>
                                                    <th>Giá niêm yết</th>
                                                    <th>Giảm giá</th>
                                                    <th>Giá bán</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td>@Html.EditorFor(x => Model.obj.GiaNiemYet, new { htmlAttributes = new { @class = "form-control input-sm number", @id = "GiaNiemYet", @maxlength = "15", @onchange = "TinhGiaBan()", @readonly = "true" } })</td>
                                                    <td>@Html.EditorFor(x => Model.obj.GiamGia, new { htmlAttributes = new { @class = "form-control input-sm number", @id = "GiamGia", @maxlength = "15", @onchange = "TinhGiaBan()" } })</td>
                                                    @*<td><input name="obj.GiaVon" class="form-control input-sm number" maxlength="15" id="GiaNiemYet" onchange="TinhGiaBan()" /></td>
                                                    <td><input name="obj.GiamGia" class="form-control input-sm number" maxlength="15" id="GiamGia" onchange="TinhGiaBan()" /></td>*@
                                                    @*<td><input class="form-control input-sm number" maxlength="15" id="GiaBan" name="GiaBan" value="@Model.obj.GiaBan" /></td>*@
                                                    <td>@Html.EditorFor(x => Model.obj.GiaBan, new { htmlAttributes = new { @class = "form-control input-sm number", @id = "GiaBan", @maxlength = "15", @readonly = "true" } })</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="col-md-12 col-sm-12 col-xs-12">
                                    <div class="form-group table-responsive">
                                        <label>Cọc</label>
                                        <table class="table table-striped jambo_table bulk_action">
                                            <thead>
                                                <tr>
                                                    <th>Phiếu cọc</th>
                                                    <th>Số tiền có thể sử dụng</th>
                                                    <th>Số tiền sử dụng</th>
                                                    <th>Còn lại</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @for (int i = 0; i < Model.Cocs.Count; i++)
                                                {
                                                    var item = Model.Cocs[i];
                                                    var ii = Model.ListCTPT.FirstOrDefault(x => x.SoThamChieu == item.MaPhieuThu.ToString());
                                                    var totali = item.TongCong;
                                                    if (ii != null)
                                                    {
                                                        totali = totali - ii.SoTienThanhToan;
                                                        <tr>
                                                            <td>
                                                                <label class="control-label">@item.HoTen+@item.NgayThu.ToString("dd/MM/yyyy")</label>
                                                                <input type="hidden" value="@ii.Id" name="coc[@i].Id" />
                                                                <input type="hidden" value="@ii.SoThamChieu" name="coc[@i].SoThamChieu" />
                                                            </td>
                                                            <td><input type="text" class="number form-control input-sm SoTienCoTheSuDung input-100" value="@(item.ConLai + ii.SoTienThanhToan)" readonly /></td>
                                                            @if (Model.noPhaiThu != null && Model.noPhaiThu.SoTienDaTra == 0)
                                                            {
                                                                <td><input type="text" width="200" class="number form-control input-sm SoTienThanhToan input-100" onchange="CalCoc(this)" name="coc[@i].SoTienThanhToan" value="@ii.SoTienThanhToan" /></td>
                                                                <td><input type="text" width="200" class="number form-control input-sm ConLai input-100" value="@item.ConLai" readonly /></td>
                                                            }
                                                            else if (Model.noPhaiThu != null && Model.noPhaiThu.SoTienDaTra != 0)
                                                            {
                                                                <td><input type="text" width="200" class="number form-control input-sm SoTienThanhToan input-100" onchange="CalCoc(this)" name="coc[@i].SoTienThanhToan" value="@ii.SoTienThanhToan" title="Không được sửa do đã có phiếu trả nợ bán xe" readonly /></td>
                                                                <td><input type="text" width="200" class="number form-control input-sm ConLai input-100" value="@item.ConLai" readonly /></td>
                                                            }

                                                        </tr>
                                                    }
                                                    else
                                                    {
                                                        <tr>
                                                            <td>
                                                                <label class="control-label">@item.HoTen+@item.NgayThu.ToString("dd/MM/yyyy")</label>
                                                                <input type="hidden" value="" name="coc[@i].Id" />
                                                                <input type="hidden" value="@item.MaPhieuThu" name="coc[@i].SoThamChieu" />
                                                            </td>
                                                            <td><input type="text" class="number form-control input-sm SoTienCoTheSuDung input-100" value="@item.ConLai" readonly /></td>

                                                            <td><input type="text" width="200" class="number form-control input-sm SoTienThanhToan input-100" onchange="CalCoc(this)" name="coc[@i].SoTienThanhToan" value="0" /></td>

                                                            <td><input type="text" width="200" class="number form-control input-sm ConLai input-100" value="@item.ConLai" readonly /></td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="col-md-12 col-sm-12 col-xs-12">
                                    <div class="form-group table-responsive">
                                        <label>Khoản vay ngân hàng</label>
                                        <table class="table table-striped jambo_table bulk_action">
                                            <thead>
                                                <tr>
                                                    <th>Khoản vay ngân hàng</th>
                                                    <th>Số tiền vay</th>
                                                    <th>Hoa hồng</th>
                                                    <th>Đã giải ngân</th>
                                                    <th>Còn lại</th>
                                                    <th>Ghi chú</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody id="KVNH">
                                                @for (int j = 0; j < Model.KVNH.Count; j++)
                                                {
                                                    var item = Model.KVNH[j];
                                                    <tr id="trKVNH">
                                                        <td>
                                                            <input type="hidden" name="IdCTPTNganHang" value="@ViewBag.IdThanhToanNganHang" />
                                                            <input type="hidden" name="KVNH[@j].MaPhieuNo" value="@item.MaPhieuNo" />
                                                            <input type="hidden" name="KVNH[@j].Id" value="@item.MaPhieuNo" />
                                                            @if (item.SoTienDaTra == 0 && (Model.noPhaiThu == null || Model.noPhaiThu.SoTienDaTra == 0))
                                                            {
                                                                <select class="select2 fullwidthx TenNh" name="KVNH[@j].DonViNo">
                                                                    <option value="">Chọn</option>
                                                                    @foreach (var i in Model.NganHang)
                                                                    {
                                                                        <option value="@i.MaDoiTac" @(item.DonViNo == i.MaDoiTac ? "selected" : "")>@i.TenDoiTac</option>
                                                                    }
                                                                </select>
                                                            }
                                                            else
                                                            {
                                                                <input type="hidden" name="KVNH[@j].DonViNo" value="@item.DonViNo" />
                                                                <select class="select2 fullwidthx TenNh" name="KVNH[@j].DonViNo" disabled>

                                                                    <option value="">Chọn</option>
                                                                    @foreach (var i in Model.NganHang)
                                                                    {
                                                                        <option value="@i.MaDoiTac" @(item.DonViNo == i.MaDoiTac ? "selected" : "")>@i.TenDoiTac</option>
                                                                    }
                                                                </select>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (item.SoTienDaTra == 0 && (Model.noPhaiThu == null || Model.noPhaiThu.SoTienDaTra == 0))
                                                            {
                                                                <input type="text" value="@item.SoTienNo" name="KVNH[@j].SoTienNo" onchange="Cal()" class="number input-100 form-control input-sm SoTienThanhToan" maxlength="15" />
                                                            }
                                                            else
                                                            {
                                                                <input type="text" value="@item.SoTienNo" name="KVNH[@j].SoTienNo" title="Không được sửa do đã có phiếu giải ngân hoặc phiếu trả nợ bán xe" onchange="Cal()" class="number input-100 form-control input-sm SoTienThanhToan" readonly />
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (ViewBag.DisableHH == false)
                                                            {
                                                                @Html.EditorFor(x => Model.obj.HoaHong, new { htmlAttributes = new { @class = "number input-100 form-control input-sm", @id = "hoahong" } })
                                                            }
                                                            else
                                                            {
                                                                @Html.EditorFor(x => Model.obj.HoaHong, new { htmlAttributes = new { @class = "number input-100 form-control input-sm",@readonly = "", @id = "hoahong" } })
                                                            }
                                                        </td>
                                                        <td>
                                                            <input type="text" value="@item.SoTienDaTra" name="KVNH[@j].SoTienDaTra" class="number input-100 form-control input-sm" readonly />
                                                        </td>
                                                        <td>
                                                            <input type="text" value="@(item.SoTienNo-item.SoTienDaTra)" class="number input-100 form-control input-sm" readonly />
                                                        </td>
                                                        <td>
                                                            @if (item.SoTienDaTra == 0 && (Model.noPhaiThu == null || Model.noPhaiThu.SoTienDaTra == 0))
                                                            {
                                                                <input type="text" class="input-100 form-control input-sm" title="Không được sửa do đã có phiếu giải ngân hoặc phiếu trả nợ bán xe" value="@item.GhiChu" name="KVNH[@j].GhiChu" />
                                                            }
                                                            else
                                                            {
                                                                <input type="text" class="input-100 form-control input-sm" value="@item.GhiChu" name="KVNH[@j].GhiChu" readonly />
                                                            }
                                                            <input type="hidden" name="KVNH[@j].IsDeleted" class="IsDeleted" value="false" />
                                                        </td>
                                                        <td>@*<i class="fa fa-remove" onclick="Remove(this)" style="cursor:pointer"></i>*@</td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    @*<td colspan="6" class="right"><i class="fa fa-plus addKVNH" style="cursor:pointer"></i></td>*@
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                </div>
                                <div class="col-md-12 col-sm-12 col-xs-12">
                                    <div class="form-group table-responsive">
                                        <label>Khách hàng thanh toán:</label>
                                        <table class="table table-striped jambo_table bulk_action">
                                            <thead>
                                                <tr>
                                                    <th style="width:40%">Túi tiền</th>
                                                    <th style="width:30%">Số tiền</th>
                                                    <th style="width:30%">Số tham chiếu</th>
                                                    <th>Treo</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody id="tbody">
                                                @for (int j = 0; j < Model.CTPT.Count; j++)
                                                {
                                                    var item = Model.CTPT[j];
                                                    <tr id="tr" class="animated fadeIn">

                                                        @if ((Model.noPhaiThu == null || Model.noPhaiThu.SoTienDaTra == 0))
                                                        {
                                                            <td>
                                                                <input type="hidden" name="httt[@j].Id" class="CTPTId" value="@item.Id" />
                                                                <select class="select2 fullwidth Temp" name="httt[@j].Temp">
                                                                    <option value="">Chọn</option>
                                                                    @foreach (var i in Model.HTTT)
                                                                    {
                                                                        if (item.Temp != null)
                                                                        {
                                                                            <option value="@i.GiaTri" @(item.Temp.ToUpper() == i.GiaTri.ToUpper() ? "selected" : "")>@i.HienThi</option>
                                                                        }
                                                                        else
                                                                        {
                                                                            <option value="@i.GiaTri" @*@(item.Temp.ToUpper() == i.GiaTri.ToUpper() ? "selected" : "")*@>@i.HienThi</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </td>

                                                            <td><input type="text" name="httt[@j].SoTienThanhToan" onchange="Cal()" value="@item.SoTienThanhToan" class="number form-control input-sm SoTienThanhToan numberSTTT" maxlength="15" /></td>

                                                            <td><input name="httt[@j].SoThamChieu" value="@item.SoThamChieu" class="form-control input-sm" /></td>
                                                            <td>
                                                                <input type="checkbox" class="chkTinhTrang" @(item.TinhTrang ? "checked" : "") />
                                                                <input type="hidden" class="TinhTrang" name="httt[@j].TinhTrang" value="@(item.TinhTrang.ToString())" />
                                                                <input type="hidden" class="IsDeleted" name="httt[@j].IsDeleted" value="false" />
                                                            </td>
                                                            <td><i class="fa fa-remove" onclick="Remove(this)" style="cursor:pointer"></i></td>

                                                        }
                                                        else /*if (Model.noPhaiThu.SoTienDaTra >0  && item.SoTienThanhToan != 0)*/
                                                        {
                                                            <td>
                                                                <input type="hidden" name="httt[@j].Id" class="CTPTId" value="@item.Id" />
                                                                <select class="select2 fullwidth Temp" name="httt[@j].Temp" disabled>
                                                                    <option value="">Chọn</option>
                                                                    @foreach (var i in Model.HTTT)
                                                                    {
                                                                        if (item.Temp != null)
                                                                        {
                                                                            <option value="@i.GiaTri" @(item.Temp.ToUpper() == i.GiaTri.ToUpper() ? "selected" : "")>@i.HienThi</option>
                                                                        }
                                                                        else
                                                                        {
                                                                            <option value="@i.GiaTri" @*@(item.Temp.ToUpper() == i.GiaTri.ToUpper() ? "selected" : "")*@>@i.HienThi</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </td>
                                                            <td><input type="text" name="httt[@j].SoTienThanhToan" onchange="Cal()" value="@item.SoTienThanhToan" class="number form-control input-sm SoTienThanhToan numberSTTT" readonly title="Không được sửa do đã có phiếu thu nợ bán xe" /></td>
                                                            <td><input name="httt[@j].SoThamChieu" value="@item.SoThamChieu" class="form-control input-sm" readonly disabled title="Không được sửa do đã có phiếu thu nợ bán xe" /></td>
                                                            <td>
                                                                <input type="checkbox" class="chkTinhTrang" @(item.TinhTrang ? "checked" : "") disabled />
                                                                <input type="hidden" class="TinhTrang" name="httt[@j].TinhTrang" value="@(item.TinhTrang.ToString())" />
                                                                <input type="hidden" class="IsDeleted" name="httt[@j].IsDeleted" value="false" />
                                                            </td>
                                                            <td></td>
                                                        }
                                                    </tr>

                                                }

                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    <td>Tổng cộng: </td>
                                                    <td class="Total"></td>
                                                    <td></td>
                                                    <td></td>
                                                    @if (Model.noPhaiThu.SoTienDaTra == 0 && Model.noPhaiThu != null)
                                                    {
                                                        <td class="right"><i class="fa fa-plus addHTTT" style="cursor:pointer"></i></td>
                                                    }
                                                    else
                                                    {
                                                        <td class="right"></td>
                                                    }
                                                </tr>
                                            </tfoot>

                                        </table>
                                    </div>
                                </div>
                                <div class="col-md-12 col-sm-12 col-xs-12">
                                    <div class="form-group table-responsive">
                                        <label>Nợ</label>
                                        <table class="table table-striped jambo_table bulk_action">
                                            <thead>
                                                <tr>
                                                    <th>Còn nợ</th>
                                                    <th>Người bảo lãnh</th>
                                                    <th>Số tiền đã trả</th>
                                                    <th>Còn lại</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td id="Total" class="number">
                                                        @Model.noPhaiThu.SoTienNo
                                                    </td>
                                                    <td>
                                                        <input type="hidden" value="@Model.noPhaiThu.MaPhieuNo" />
                                                        <input type="hidden" name="NPT.MaPhieuNo" id="NPT_MaPhieuNo" value="@Model.noPhaiThu.MaPhieuNo" />
                                                        <input type="hidden" name="NPT.SoTienNo" id="NPT_SoTienNo" value="@Model.noPhaiThu.SoTienNo" />
                                                        <input type="hidden" name="NPT.SoTienDaTra" id="NPT_SoTienDaTra" value="@Model.noPhaiThu.SoTienDaTra" />
                                                        @if (Model.noPhaiThu != null && Model.noPhaiThu.SoTienDaTra == 0)
                                                        {
                                                            <input name="NPT.NguoiBaoLanh" type="text" class="form-control input-sm" value="@Model.noPhaiThu.NguoiBaoLanh" />
                                                        }
                                                        else if (Model.noPhaiThu != null && Model.noPhaiThu.SoTienDaTra != 0)
                                                        {
                                                            <input name="NPT.NguoiBaoLanh" type="text" class="form-control input-sm" value="@Model.noPhaiThu.NguoiBaoLanh" readonly />
                                                        }
                                                    </td>
                                                    <td class="number" name="NPT.SoTienDaTra" id="NPT.SoTienDaTra">@Model.noPhaiThu.SoTienDaTra</td>
                                                    <td class="number" name="NPT.SoTienConLai" id="NPT.SoTienConLai">@Model.noPhaiThu.SoTienConLai</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label>Số hóa đơn(*)</label>
                                        @Html.EditorFor(x => Model.obj.SoHoaDon, new { htmlAttributes = new { @class = "form-control input-sm" } })
                                    </div>
                                </div>
                                <div class="col-md-8 col-sm-8 col-xs-12">
                                    <div class="form-group">
                                        <label>Chứng từ liên quan(*)</label>
                                        @Html.EditorFor(x => Model.obj.SoChungTu, new { htmlAttributes = new { @class = "form-control input-sm" } })
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label>Đối tác</label>
                                        @Html.DropDownListFor(x => Model.obj.DoiTac, Model.DoiTac.Select(x => new SelectListItem { Text = x.TenDoiTac, Value = x.MaDoiTac }), "Chọn", new { @class = "select2 fullwidth", @id = "DoiTac" })
                                    </div>
                                </div>
                                <div class="col-md-8 col-sm-8 col-xs-12">
                                    <div class="form-group">
                                        <label>Họ tên(*)</label>
                                        @Html.EditorFor(x => Model.obj.HoTen, new { htmlAttributes = new { @class = "form-control input-sm" } })
                                    </div>
                                </div>
                                <div class="col-md-8 col-sm-8 col-xs-12">
                                    <div class="form-group">
                                        <label>Tổng giá vốn Hứa tặng Phụ kiện KM</label>
                                        @if (ViewBag?.NKMPK == null || ViewBag.NKMPK.SoTienConLai == ViewBag.NKMPK.SoTienNo)
                                        {
                                            @Html.EditorFor(x => Model.obj.NoKhuyenMai, new { htmlAttributes = new { @class = "form-control input-sm number NoKhuyenMai", @maxlength = "500" } });
                                        }
                                        else
                                        {

                                            @Html.EditorFor(x => Model.obj.NoKhuyenMai, new { htmlAttributes = new { @class = "form-control input-sm number NoKhuyenMai", @maxlength = "500", @readonly = "readonly", title = "Đã có phiếu chi nợ khuyến mãi phụ kiện-phụ tùng" } });
                                        }
