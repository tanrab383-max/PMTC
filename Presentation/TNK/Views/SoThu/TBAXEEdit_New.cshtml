            //neu gia tri thay doi cua dropdown la BDTK thi tim gia cua goi va disable cac control nhap di
            if ($(a).val().includes("BDTK")) {
                var maBDTK = $(a).val();
                //lay gia von BDTK
                var giaVonBDTK = 0;
                $.ajax({
                    url: "/SoThu/LayGiaVonBDTK",
                    type: "POST",
                    data: { ma: maBDTK },
                    success: function (result) {
                        if (result != "") {
                            giaVonBDTK = result;

                            //rang buoc nhap tien khuyen mai
                            $("#KM").find("tr").map(function (key, val) {
                                if ($(val).find(".KhoKM").length > 0) {
                                    var tuitien = $(val).find(".KhoKM").select2('val');
                                    var isDisable = $(val).find(".KhoKM").is(':disabled');
                                    var sotien = $(val).find(".numberKM");
                                    var noidung = $(val).find(".noidung");
                                    var ghichu = $(val).find(".ghichu");
                                    if (tuitien.includes("BDTK"))//neu la phieu BDTK thi disable đi các ô nhập
                                    {
                                        $(sotien).attr("disabled", true);
                                        $(noidung).attr("disabled", true);
                                        $(ghichu).attr("disabled", true);
                                        if (tuitien == maBDTK) {
                                            $(sotien).val(giaVonBDTK);
                                            $(noidung).val("");
                                            $(ghichu).val("");
                                        }
                                    }
                                    else {
                                        if (isDisable == false)//neu khong phai cac control bi disabled san thi bo disable di (doi voi cac phiếu lệ thuộc phiếu trả nợ)
                                        {
                                            $(sotien).attr("disabled", false);
                                            $(sotien).removeAttr("disabled");
                                            $(noidung).removeAttr("disabled");
                                            $(ghichu).removeAttr("disabled");
                                        }
                                    }

                                }
                            })
                        }

                    }
                });

            }


        }

