        function SetSubmitType(value) {
            debugger;
            //$("#submitType").val(value);
            Cal();
            $("#form-data").submit();
        }
        function Remove(a) {
            debugger
            var tr = $(a.closest("tr"));
            tr.find(".IsDeleted").val("true");
            tr.html(tr.html().split("required").join(""));
            tr.hide();
            Cal();
            CalNumberKM();
        }
        function CalCoc(a) {
            setTimeout(function () {
                var stsd = $(a).val();
                stsd = stsd.split(",").join("");
                var stctsd = $(a).closest("tr").find(".SoTienCoTheSuDung").val().split(",").join("");
                if (stctsd - stsd < 0) {
                    toastError("Số tiền sử dụng cọc không được lớn hơn số tiền có thể sử dụng.Vui lòng nhập lại.");
                    $(a).val(0);
                    $(a).focus();
                    $(a).closest("tr").find(".ConLai").val(stctsd);
                }
                else
                    $(a).closest("tr").find(".ConLai").val((stctsd - stsd).toLocaleString('en-us'));
            }, 100);

            Cal();
        }
        var total = '@Model.obj.GiaBan';

        Cal();
        function Cal() {
            debugger;
            setTimeout(function () {
                try {
                    var tienThanhToan = 0;
                    $("#tbody").find("tr").map(function (key, val) {
                        if ($(val).is(":visible")) {
                            var isDeleted = $(val).find(".IsDeleted").val();
                            if (isDeleted != "true") {
                                var sotien = parseInt($(val).find(".number").val().split(",").join(""));
                                if (isNaN(sotien))
                                    sotien = 0;
                                tienThanhToan += sotien;
                            }
                        }
                    });
                    $(".Total").html(tienThanhToan.toLocaleString('en-us'));
                    var result = $("#GiaBan").val().split(",").join("");
                    debugger
                    $(".SoTienThanhToan").map(function (key, val) {
                        if ($(val).is(":visible")) {
                            var num = $(val).val().split(",").join("");
                            result = result - num;
                        }
                    });
                    var soTienDaTra = parseFloat($("#NPT_SoTienDaTra").val().split(",").join(""));
                    $("#NPT.SoTienConLai").html((result - soTienDaTra).toLocaleString('en-us'));
                    $("#NPT.SoTienConLai").val((result - soTienDaTra).toLocaleString('en-us'));
                    $("#Total").html(result.toLocaleString('en-us'));
                    $("#Total").val(result.toLocaleString('en-us'));
                    $("#NPT_SoTienNo").val(result);
                }
                catch (e) {
                    // alert("Cal:" + e);
                }
            }, 100);
            //if (CheckValidateThongTinNguoiThanhToan_PhieuThu() == false)
            //    return false;
        }
        $(document).on("click", ".chkTinhTrang", function () {
            a = this;
            $(this).closest("td").children(".TinhTrang").val($(this).is(":checked"));
        })
        //$(document).on("click", ".chkTinhTrang", function () {
        //    $(this).closest("td").children(".TinhTrang").val($(this).is(":checked"));
        //})
        //form submit
        $("#form-data").submit(function () {
            //xu ly tinh toan cac gia tri nhap tren luoi
            Cal();
            debugger;
            let flag = true;
            $("#tbody").find("tr").map(function (key, val) {
                if ($(val).is(":visible")) {

                    var tuitien = $(val).find(".Temp").select2('val');
                    var sotien = $(val).find(".number").val().split(",").join("");
                    tuitien = tuitien == "Chọn" ? "" : tuitien;
                    sotien = sotien == "" ? 0 : parseInt(sotien);
                    if (tuitien != "" && sotien === 0) {
                        toastWarning("Vui lòng nhập số tiền");
                        $(val).find(".number").focus();
                        flag = false;
                        return;
                    }
                    if (tuitien == "" && sotien != 0) {
                        toastWarning("Vui lòng nhập túi tiền");
                        $(val).find(".Temp").focus();
                        flag = false;
                        return;
                    }
                }
            })


            //rang buoc nhap tien vay ngan hang
            $("#KVNH").find("tr").map(function (key, val) {
                var tuitien = $(val).find(".TenNh").select2('val');
                var sotien = $(val).find(".SoTienThanhToan").val().split(",").join("");
                var hoahong = $(val).find("#hoahong").val().split(",").join("");
                tuitien = tuitien == "Chọn" ? "" : tuitien;
                sotien = sotien == "" ? 0 : parseInt(sotien);
                if (tuitien != "" && sotien === 0) {
                    toastWarning("Vui lòng nhập số tiền vay ngân hàng");
                    $(val).find(".number").focus();
                    flag = false;
                    return;
                }
                if (tuitien == "" && (sotien != 0 || hoahong != 0)) {
                    toastWarning("Vui lòng nhập ngân hàng");
                    $(val).find(".SoTienThanhToan").focus();
                    flag = false;
                    return;
                }
            })

            //rang buoc nhap tien khuyen mai
            var soGoiKMBDTK = 0;
            $("#KM").find("tr").map(function (key, val) {
                debugger;
                if ($(val).find(".KhoKM").length > 0 && $(val).find(".numberKM").length > 0) {
                    var tuitien = $(val).find(".KhoKM").select2('val');
                    var sotien = $(val).find(".numberKM").val().split(",").join("");
                    var isDeleted = $(val).find(".IsDeleted").val();

                    if (isDeleted == "false") {
                        if (tuitien.includes("BDTK"))
                            soGoiKMBDTK = soGoiKMBDTK + 1
                        if (tuitien != null || soTien != null) {

                            tuitien = tuitien == "Chọn" ? "" : tuitien;
