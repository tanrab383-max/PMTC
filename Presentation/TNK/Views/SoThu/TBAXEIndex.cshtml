                                    </div>
                                    <div class="col-md-2 col-sm-2 col-xs-12">
                                    </div>
                                    <div class="col-md-6 col-sm-6 col-xs-12">
                                        <div class="form-group">
                                            @Html.RadioButton("tinhtrang", "", true, new { id = "All" }) Tất cả
                                            @Html.RadioButton("tinhtrang", "TK", false, new { id = "TK" }) Trong kho
                                            @Html.RadioButton("tinhtrang", "CNK", false, new { id = "CNK" }) Chưa nhập kho
                                        </div>
                                    </div>
