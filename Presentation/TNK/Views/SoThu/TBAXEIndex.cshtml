    </div>
    <div class="col-md-12 col-sm-12 col-xs-12">
    </div>
    <div class="clearfix"></div>
    <div style="display:none"><input type="file" id="txtUploadFile" /></div>
</div>
@section scripts
{
    <script src="~/Scripts/IndexCommon.js"></script>
    <script src="~/Scripts/jquery.fileDownload.js"></script>
    <script>
        //$(document).ready(function () {
        //    $('#Search').trigger('click');
        //});
        var p = 1;
        $("#Search").click(function () {
            $(this).val("Loading...");
            $(this).prop('disabled', true);
            Search(this);
        })
        function change() {
            p = 1;
        }
        function Search(obj) {
            var from = $("#from").val();
            var to = $("#to").val();
            var query = $("#query").val();
            var pageSizes = document.getElementById('pageSizeTBAXEComplete');
            var size = pageSizes != undefined ? pageSizes.value : '';
            $.get("/SoThu/TBAXEComplete?query=" + query + "&from=" + from + "&to=" + to + "&p=" + p + "&pageSize=" + size).success(function (response) {
                $("#tbody").html(response);
                $(obj).val("Tìm kiếm");
                $(obj).prop('disabled', false);
            })
        }
        var a;
        $(document).on("click", "#tbody a", function () {
            a = $(this).attr("href");
            var b = a.split("&");
            p = b[3].split("=")[1];
            console.log(p);
            Search();
            return false;
        })
        $('.date').datepicker({
            orientation: "left",
            autoclose: true
        });
        function Delete(a, id) {
            if (confirm('Xác nhận')) {
                data = { id: id, type: 'TBAXE' };
                $.post("/SoThu/DeletePhieuThu", data).success(function (response) {
                    if (response == "success") {
                        $(a).closest("tr").remove();
                        toastSuccess("Đã xóa thành công");
                    }
                    else
                        toastError(response);
                });
            }
        }
        $("#FileMau").click(function () {
            debugger;
            $.fileDownload("/SoThu/ExportFile_BanXe", {
                httpMethod: "POST",
                data: {},
                failMessageHtml: "Có lỗi trong khi tải file excel."
            });
            return false;
        });
        var datafile = new FormData();
        function ImportData() {
            $("#txtUploadFile").trigger('click');
        }
        $('#txtUploadFile').on('change', function (e) {
            //alert(("#txtUploadFile").val());
            if (document.getElementById("txtUploadFile").value != "") {
                var files = e.target.files;
                if (files.length > 0) {
                    if (window.FormData !== undefined) {
                        for (var x = 0; x < files.length; x++) {
                            datafile.append('file', files[x]);
                        }
                    }
                }

                $.ajax({
                    type: "POST",
                    url: "/SoThu/ImportData_ThuBanXe",
                    contentType: false,
                    processData: false,
                    data: datafile,
                    beforeSend: function () {
                        // Đang thực hiện ajax
                        //để Loading...
                    },
                    complete: function () {
                        // Hoàn tất ajax
                        document.getElementById("txtUploadFile").value = "";
                        datafile.delete('file');
                    },
                    success: function (result) {
                        if (result.IsError)
                            toastError(result.Message);
                        else {
                            toastSuccess("Import thành công");
                            //window.location.reload();
                        }
                    },
                    error: function (xhr, status, p3, p4) {
                        toastError("Lỗi: Import file excel.");
                        //window.location.reload();
                    }
                });
            }
        });
    </script>
}