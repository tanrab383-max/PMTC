@model List<TNK.Core.Domain.View.ViewTBAXE>
@{
    ViewBag.Title = "Phiếu bán xe";
}
<div class="page-title">
    <div class="title_left">
        <h3>@ViewBag.Title</h3>
    </div>
    <div class="title_right" style="margin-left:88%">
        <a href="#" download><span style="font-style:italic;color:blue;font-size:15px" id="FileMau">Lấy file mẫu(*.xlxs)</span></a>
    </div>
</div>
<div class="clearfix"></div>
<div class="row">
    <div class="col-md-12">
        <div class="tabbable-line boxless tabbable-reversed">
            <ul class="nav nav-tabs">
                @if (ViewBag.Tab == 1)
                {
                    <li class="active">
                        <a href="#tab_0" data-toggle="tab" aria-expanded="true">
                            Phiếu tạm
                        </a>
                    </li>
                    <li class="">
                        <a id="a_1" href="#tab_1" data-toggle="tab" aria-expanded="false">
                            Phiếu hoàn thành
                        </a>
                    </li>
