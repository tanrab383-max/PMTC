                                                {
                                                    int i = 1;
                                                    foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>@(ViewBag.PageSize * (ViewBag.PageIndex - 1) + i++)</td>
                                                            <td>@item.SoHopDong</td>
                                                            <td>@item.NgayHopDong.ToString(ViewBag.DateFormat)</td>
                                                            <td>@item.HoTen</td>
                                                            <td>@item.DienThoai</td>
                                                            <td>@item.SoKhung</td>
                                                            <td>@item.LoaiXe</td>
                                                            <td class="number2">@item.GiaNiemYet</td>
                                                            <td class="number2">@item.PhuKienHuaTang</td>
                                                            @if (@item.TinhTrang == "TK")
                                                            {
                                                                <td>
                                                                    Trong kho
                                                                </td>
                                                            }
                                                            @if (@item.TinhTrang == "Sai_GNY")
                                                            {
                                                                <td>
                                                                    Sai GNY
                                                                </td>
                                                            }
                                                            @if (@item.TinhTrang == "CNK")
                                                            {
                                                                <td>
                                                                    Chưa nhập kho
                                                                </td>
                                                            }
                                                            @if (@item.TinhTrang == "TC")
                                                            {
                                                                <td>
                                                                    Đang thế chấp
                                                                </td>
                                                            }
                                                            <td style="width:5%" class="center">
                                                                @if (@item.TinhTrang == "TK")
                                                                {
                                                                    <a href="/SoThu/TBAXECreate/@HttpUtility.UrlEncode(item.SoKhung)"><i title="Edit" class="fa fa-edit"></i></a>

                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            }
                                        </tbody>
                                    </table>
                                    <div class="right">
                                        @Html.Partial("~/Views/Shared/_Paging_v2.cshtml")
                                    </div>
                                </div>
                            </div>
