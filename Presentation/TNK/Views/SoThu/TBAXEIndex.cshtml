                                                <th>Ngày hợp đồng</th>
                                                <th>Khách hàng</th>
                                                <th>Số điện thoại</th>
                                                <th>SK/SM</th>
                                                <th>Loại xe</th>
                                                <th>Giá niêm yết</th>
                                                <th>Phụ kiện hứa tặng</th>
                                                <th>Tình trạng</th>
                                                <th></th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
