@model List<TNK.Core.Domain.View.ViewPhieuThu>
@{
    Layout = null;
    int i = 1;
}
<table class="table">
    <thead>
        <tr class="success">
            <th>STT</th>
            <th>Ngày thu</th>
            <th>Mã phiếu thu</th>
            <th>Chứng từ thu</th>
            <th>Khách hàng</th>
            <th>Số hợp đồng</th>
            <th>Số Khung</th>
            <th>Giá niêm yết</th>
            <th>Giá bán</th>
            <th>Khuyến mãi</th>
            <th>Thực bán</th>
            <th></th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@(ViewBag.PageSize * (ViewBag.PageIndex - 1) + i)</td>
                <td>@item.NgayThu.ToString("dd/MM/yyyy")</td>
                <td>@item.MaPhieuThu</td>
                <td>@item.SoChungTu</td>
                <td>@item.Hoten</td>
                <td>@item.SoHopDong</td>
                <td>@item.SoKhung</td>
                <td class="number">@TNK.Core.Common.ToCurrencyString(@item.GiaNiemYet.Value)</td>
                <td class="number">@TNK.Core.Common.ToCurrencyString(@item.GiaBan)</td>
                <td class="number">@TNK.Core.Common.ToCurrencyString(@item.GiamGia)</td>
                <td class="number">@TNK.Core.Common.ToCurrencyString(@item.TongCong)</td>
                <td style="width:5%" class="center">
                    <a href="/SoThu/PhieuThu/@item.MaPhieuThu?type=TBDTKKM&actiontype=Update"><i title="Edit" class="fa fa-edit"></i></a>
                </td>
                <td style="width:5%" class="center">
                    <a href="javascript:;" onclick="Delete(this,'@item.MaPhieuThu')"><i title="Delete" class="fa fa-close"></i></a>
                </td>
            </tr>
            i++;
        }
    </tbody>
</table>
<div class="right">
    @Html.Partial("~/Views/Shared/_Paging_v2.cshtml")
</div>