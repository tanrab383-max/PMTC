        cd = '@congdong.Count';
        $(".addCD").click(function () {
            debugger;
            var htmlCD = trCD.split("ptdv2[0]").join("ptdv2[" + cd + "]");
            @if(congdong.Count>0)
            {
            }
            $("#CongDong").append("<tr>" + htmlCD + "</tr>");
