@model TNK.Model.DichVuModelCyber
@{
    //HttpContext context = HttpContext.Current;
    //string value = context.Request.RawUrl;
    //string[] arr = new string[3];
    //string url = arr[2].ToString();
    ViewBag.Title = "Phiếu dịch vụ";
    var item = new TNK.Model.CTPDVTamCyber();   
    List<TNK.Core.Domain.ChiTietPhieuDichVu> ptdv = new List<TNK.Core.Domain.ChiTietPhieuDichVu>();
    if (Model.obj!= null)
    {
        item = Model.obj;
    }
    var suachuachung = Model.lst.Where(x => x.ROTYPE == "GJ" && x.WTCODE == "J").ToList();
    if (suachuachung.Count == 0)
    {
        suachuachung.Add(new TNK.Model.CTPDVTamCyber());
    }
    var congdong = Model.lst.Where(x => x.ROTYPE == "GJ" && x.WTCODE == "J").ToList();
    if (congdong.Count == 0)
    {
        congdong.Add(new TNK.Model.CTPDVTamCyber());
    }
    var dongsonsonxe = Model.lst.Where(x => x.ROTYPE == "BP" && (x.KPI_PART_TYPE == null)).ToList();//chỉnh lại do quy tắt lấy đồng sơn ban đầu bị sai so vơi hiện tại. Nếu x.KPI_PART_TYPE == null thì mơi là Đồng sơn
    if (dongsonsonxe.Count == 0)
    {
        dongsonsonxe.Add(new TNK.Model.CTPDVTamCyber());
    }
    string[] ptt = { "KEY PRODUCTS", "GP", "OIL", "CHEMICALS", "PART_GENUINE_OTHER", "ACC", "BODY PARTS", "Y" /*Cho phieu ban phu tung GENUINE = 'Y'*/ };
    var phutungtrong = Model.lst.Where(x => ptt.Contains(x.KPI_PART_TYPE)).ToList();
    if (phutungtrong.Count == 0)
    {
        phutungtrong.Add(new TNK.Model.CTPDVTamCyber());
    }
    string[] ptn = { "PART_NON_GENUINE", "N" /*Cho phieu ban phu tung GENUINE = 'N'*/};
    var phutungngoai = Model.lst.Where(x => ptn.Contains(x.KPI_PART_TYPE)).ToList();
    if (phutungngoai.Count == 0)
    {
        phutungngoai.Add(new TNK.Model.CTPDVTamCyber());
    }
    var phukiendichvu = Model.lst.Where(x => (x.ROTYPE != "GJ" || x.WTCODE != "J")
                        && !(x.ROTYPE == "BP" && (x.KPI_PART_TYPE == null))
                        && !ptt.Contains(x.KPI_PART_TYPE) && !ptn.Contains(x.KPI_PART_TYPE)).ToList();
    if (phukiendichvu.Count == 0)
    {
        phukiendichvu.Add(new TNK.Model.CTPDVTamCyber());
    }
    var vattungoai = Model.lst.Where(x => (x.ROTYPE != "GJ" || x.WTCODE != "J")
                        && !(x.ROTYPE == "BP" && (x.KPI_PART_TYPE == null))
                        && !ptt.Contains(x.KPI_PART_TYPE) && !ptn.Contains(x.KPI_PART_TYPE)).ToList();
    if (vattungoai.Count == 0)
    {
        vattungoai.Add(new TNK.Model.CTPDVTamCyber());
    }
    var vattugtgt = Model.lst.Where(x => (x.ROTYPE != "GJ" || x.WTCODE != "J")
                        && !(x.ROTYPE == "BP" && (x.KPI_PART_TYPE == null))
                        && !ptt.Contains(x.KPI_PART_TYPE) && !ptn.Contains(x.KPI_PART_TYPE)).ToList();
    if (vattugtgt.Count == 0)
    {
        vattugtgt.Add(new TNK.Model.CTPDVTamCyber());
    }
    var quatang = Model.lst.Where(x => x.ROTYPE == "GJ" && x.WTCODE == "J").ToList();
    if (quatang.Count == 0)
    {
        quatang.Add(new TNK.Model.CTPDVTamCyber());
    }
    var noPhaiTra = Model.noPhaiTra;
    var z = 0;
    double tongcong = 0;
}
