                                                            <td><input style="width:80px" value="0" name="ptdv1[@i].DISCOUNT" class="form-control input-sm number b_SCC" id="ptdv1[@i]b" onchange="CalSCC()" maxlength="15" /></td>
                                                            <td><input style="width:80px" value="0" class="form-control input-sm number" id="ptdv1[@i]" readonly /></td>
                                                            <td><input style="width:80px" id="ptdv1[@i].GCN" name="ptdv1[@i].GCN" class="form-control input-sm number GCN" value="0" onchange="CalThanhToanGCN()" /></td>
                                                            <td class="SUACHUACHUNG VAT"><input style="width:40px" value="10" name="ptdv1[@i].VAT" class="form-control input-sm number b_VAT" id="ptdv1[@i]VAT" onchange="CalSCC()" /></td>
                                                            <td><i class="fa fa-remove" onclick="RemoveSCC(this)" style="cursor:pointer"></i></td>
                                                        </tr>
                                                        z++;
                                                    }
                                                </tbody>
                                                <tfoot>
