            var table = $(e).closest('.row').parent().find('.table');
            var column = "." + $(table).attr("id") + ".VAT";
            var columns = $(column);
            let result = '';
            switch (tr) {
                case 'trSC':
                    trSC = replaceTrVAT(trSC);
                    break;
                case 'trCD':
                    trCD = replaceTrVAT(trCD);
                    break;
                case 'trDS':
                    trDS = replaceTrVAT(trDS);
                    break;
                    break;
                case 'trPTT':
                    trPTT = replaceTrVAT(trPTT);
                    break;
                case 'trPTN':
                    trPTN = replaceTrVAT(trPTN);
                    break;
                case 'trPKDV':
                    trPKDV = replaceTrVAT(trPKDV);
                    break;
                case 'trVTN':
                    trVTN = replaceTrVAT(trVTN);
                    break;
                case 'trVTGTGT':
                    trVTGTGT = replaceTrVAT(trVTGTGT);
                    break;
                default:
                // code block
            }
            $(columns).toggle();
        }
        function replaceTrVAT(data) {
            if (data.includes("display: none;") == true)
                data = data.replace(/display: none;/g, '');
            else
                data = data.replace(/style=""/g, 'style="display: none;"');
            return data;
        }
