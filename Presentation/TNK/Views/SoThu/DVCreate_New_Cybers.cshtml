                                                    {
                                                        a += dongsonsonxe[i].COST;
                                                        if (dongsonsonxe[i].DISCOUNT == null)
                                                        {
                                                            dongsonsonxe[i].DISCOUNT = 0;
                                                        }
                                                        b += (double)dongsonsonxe[i].DISCOUNT;
