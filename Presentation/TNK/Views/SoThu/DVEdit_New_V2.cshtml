                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label>Ngày quyết toán</label>
                                        <input type="text" class="form-control input-sm" name="obj.NgayQuyetToan" value="@Model.obj.NgayQuyetToan.ToString("dd/MM/yyyy")" readonly />
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label>Ngày thu tiền</label>
                                        <input type="text" class="form-control input-sm date" name="obj.NgayHachToan" value="@Model.obj.NgayHachToan.ToString("dd/MM/yyyy")" />@*readonly*@
                                        @*@Html.EditorFor(x => Model.obj.NgayHachToan, new { htmlAttributes = new { @class = "form-control input-sm date ", @value = "@Model.obj.NgayHachToan.ToString("dd/MM/yyyy")", @readonly = "" } })*@
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label>Biển số</label>
                                        @Html.EditorFor(x => Model.obj.BienSo, new
                                   {
                                       htmlAttributes = new { @class = "form-control input-sm BienSo", @readonly = "" }
                                   })
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label>Số khung / Số máy</label>
                                        @Html.EditorFor(x => Model.obj.SoKhung, new { htmlAttributes = new { @class = "form-control input-sm", @readonly = "", @id = "sokhung" } })
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label>Tên khách hàng</label>
                                        @Html.EditorFor(x => Model.obj.HoTen, new
                                        {
                                            htmlAttributes = new
                                            {
                                                @class = "form-control input-sm HoTen",@*@readonly = ""*@}
})
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label>Loại xe</label>
                                        @Html.EditorFor(x => Model.obj.MaXe, new { htmlAttributes = new { @class = "form-control input-sm", @readonly = "" } })
                                    </div>
                                </div>

                                <div class="col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label>Tên xe</label>
                                        @Html.EditorFor(x => Model.obj.TenXe, new { htmlAttributes = new { @class = "form-control input-sm", @readonly = "" } })
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label>Điện thoại</label>
                                        @Html.EditorFor(x => Model.obj.DienThoai, new { htmlAttributes = new { @class = "form-control input-sm", @readonly = "" } })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">

                                <div class="col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label>Số hóa đơn</label>
                                        @Html.EditorFor(x => Model.obj.SoHoaDon, new { htmlAttributes = new { @class = "form-control input-sm " } })
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label>Chứng từ liên quan</label>
                                        @Html.EditorFor(x => Model.obj.SoChungTu, new { htmlAttributes = new { @class = "form-control input-sm" } })
                                    </div>
                                </div>
                                <div class="col-md-1 col-sm-1 col-xs-12">
                                    <div class="form-group">
                                        <label></label>
                                        <label></label>
                                        @if (Model.obj.LoaiBaoHiem == "XKG")
                                        {
                                            <input type="checkbox" class="form-control" checked="checked" id="LoaiBH" onclick="OnChecked()" />
                                        }
                                        else
                                        {
                                            <input type="checkbox" class="form-control" id="LoaiBH" onclick="OnChecked()" />
                                        }
                                        @Html.EditorFor(x => Model.obj.LoaiBaoHiem, new { htmlAttributes = new { @class = "form-control input-sm hidden ", @id = "LoaiBaoHiem", @hidden = "" } })
                                    </div>
                                </div>
                                <div class="col-md-3 col-sm-3 col-xs-12">
                                    <div class="form-group">
                                        <label style="margin-top:30px">Xe ký gửi</label>
                                    </div>
                                </div>
                                <div class="col-md-12 col-sm-12 col-xs-12 row">
                                    <div class="form-group col-md-7 ">
                                        <label>Địa chỉ</label>
                                        <input type="text" readonly value="@Model.obj.DiaChi" class="form-control input-sm" name="obj.DiaChi" />
                                    </div>
                                    <div class="form-group col-md-5">
                                        <label>Đối tác</label>
                                        @Html.DropDownListFor(x => Model.obj.DoiTac, Model.DoiTac.Select(x => new SelectListItem { Text = x.TenDoiTac, Value = x.MaDoiTac }), "Chọn", new { @class = "select2 fullwidth", @id = "DoiTac" })
                                    </div>
                                </div>
                                <div class="col-md-12 col-sm-12 col-xs-12">
                                    <div class="form-group">
                                        <label>Yêu cầu KH</label>
                                        <input type="text" readonly value="@Model.obj.YeuCauKH" class="form-control input-sm" name="obj.YeuCauKH" />
                                    </div>
                                </div>
                            </div>
                            <!--SCC-->
                            <div class="col-md-12">
                                @if (suachuachung.Count > 0)
                                {
                                    double a = 0;
                                    double b = 0;
                                    int count = 0;
                                    double sl = 0;
                                    <div class="col-md-6 col-sm-6 col-xs-12">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <label>Tiền công:</label>
                                            </div>
                                            <div class="col-md-6 right">
                                                @*<i class="fa fa-plus-square" aria-hidden="true" style="cursor:pointer" onclick="showVAT(this,'trSC')" title="VAT"></i>*@
                                            </div>
                                        </div>
                                        <div class="form-group table-responsive">
                                            <table class="table table-striped jambo_table bulk_action" id="SUACHUACHUNG">
                                                <thead>
                                                    <tr>
                                                        <th style="width:30%">Tên công việc</th>
                                                        <th>Số lượng</th>
                                                        <th>Giá bán</th>
                                                        <th>Giảm giá</th>
                                                        <th>Thực thu</th>
                                                        <th>Chi GCN</th>
                                                        <th class="SUACHUACHUNG VAT">VAT</th>
                                                        <th>Giá vốn</th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                                <tbody id="SuaChua">
                                                    @for (int i = 0; i < suachuachung.Count; i++)
                                                    {
                                                        a += suachuachung[i].COST;
                                                        if (suachuachung[i].DISCOUNT == null)
                                                        {
                                                            suachuachung[i].DISCOUNT = 0;
                                                        }
                                                        b += (double)suachuachung[i].DISCOUNT;
                                                        sl += (double)suachuachung[i].QUANTITY;
                                                    <tr id="trSC" class="animated fadeIn">
                                                        <td>
                                                            <input style="min-width:160px" value="@suachuachung[i].JOBSNAME" name="ptdv1[@i].JOBSNAME" class="form-control input-sm" id="ptdv1[@i]" />
                                                            <input type="hidden" name="ptdv1[@i].Id" value="@suachuachung[i].Id" />
                                                            <input type="hidden" name="ptdv1[@i].MaKho" class="MaKho" value="@suachuachung[i].MaKho" />
                                                            <input type="hidden" name="ptdv1[@i].JOBSNAME" value="@suachuachung[i].JOBSNAME" />
                                                            <input type="hidden" name="ptdv1[@i].REPAIRORDERNO" value="@suachuachung[i].REPAIRORDERNO" />
                                                            <input type="hidden" name="ptdv1[@i].QUANTITY" value="@suachuachung[i].QUANTITY" />
                                                            <input type="hidden" name="ptdv1[@i].ROTYPE" value="@suachuachung[i].ROTYPE" />
                                                            <input type="hidden" name="ptdv1[@i].KPI_PART_TYPE" value="@suachuachung[i].KPI_PART_TYPE" />
                                                            <input type="hidden" name="ptdv1[@i].WTCODE" value="@suachuachung[i].WTCODE" />
                                                            <input type="hidden" name="ptdv1[@i].MaKho" class="MaKho" value="SUACHUA" />
                                                            <input type="hidden" name="ptdv1[@i].PhanLoai" class="PhanLoai" value="SUACHUA" />

                                                            @*<input type="hidden" name="ptdv1[@i].VAT" value="@suachuachung[i].VAT" />*@
                                                        </td>
                                                        <td>@suachuachung[i].QUANTITY</td>
                                                        <td><input style="min-width:80px" value="@suachuachung[i].COST" name="ptdv1[@i].COST" id="ptdv1[@i].COST" class="form-control input-sm number a_SCC" onchange="CalSCC()" maxlength="15" @readOnly /></td>
                                                        <td><input style="min-width:80px" value="@suachuachung[i].DISCOUNT" name="ptdv1[@i].DISCOUNT" id="ptdv1[@i]b" class="form-control input-sm number b_SCC" onchange="CalSCC()" maxlength="15" @readOnly /></td>
                                                        <td><input style="min-width:80px" value="@(suachuachung[i].COST - suachuachung[i].DISCOUNT)" id="ptdv1[@i]ab" class="form-control input-sm number c_SCC" @readOnly /></td>
                                                        @if (suaGCN == false)
                                                        {
                                                            <td><input readonly style="min-width:80px" type="text" name="ptdv1[@i].GCN" id="ptdv1[@i]GCN" value="@suachuachung[i].GCN" class="form-control input-sm number GCN" onchange="CalThanhToanGCN()" required="" title="Không được sửa do đã có phiếu chi gia công ngoài" @readOnly /></td>
                                                        }
                                                        else
                                                        {
                                                            <td><input style="min-width:80px" type="text" name="ptdv1[@i].GCN" id="ptdv1[@i]GCN" value="@suachuachung[i].GCN" class="form-control input-sm number GCN" onchange="CalThanhToanGCN()" required="" title="Không được sửa do đã có phiếu chi gia công ngoài" @readOnly /></td>
                                                        }
                                                        <td class="SUACHUACHUNG VAT"><input value="@(suachuachung[i].VAT * 100)" style="width:40px" name="ptdv1[@i].VAT" class="form-control input-sm number b_VAT" id="ptdv1[@i]VAT" maxlength="15" onchange="CalSCC()" /></td>
                                                        <td><input value="@(suachuachung[i].GiaVonVAT)" style="width:70px" name="ptdv1[@i].GiaVonVAT" class="form-control input-sm number GiaVon" id="ptdv1[@i]GiaVonVAT" @readOnly /></td>
                                                        <td>
                                                            <input type="hidden" class="IsDeleted" name="ptdv1[@i].IsDeleted" value="false" />
                                                            @if (suaGCN != false)
                                                            {
                                                                <i class="fa fa-remove" onclick="RemovePKDV(this,'SCC')" style="cursor:pointer" @readOnly></i>
                                                            }
                                                            else
                                                            {
                                                                if (suachuachung[i].GCN == 0)
                                                                {
                                                                    <i class="fa fa-remove" onclick="RemovePKDV(this,'SCC')" style="cursor:pointer" @readOnly></i>
                                                                }
                                                                else
                                                                {
                                                                    <i class="fa fa-remove" title="Không được xóa vì đã có phiếu chi nợ GCN" style="cursor:pointer" @readOnly></i>
                                                                }

                                                            }
                                                        </td>
                                                    </tr>
                                                        z++;
                                                    }
                                                </tbody>

                                                <tfoot>
                                                    <tr>
                                                        <td>Tổng cộng:</td>
                                                        <td>@sl</td>
                                                        <td class="number TotalSCC_a">@a</td>
                                                        <td class="number TotalSCC_b">@b</td>
                                                        <td class="number TotalSCC_a_b">@(a - b)</td>
                                                        <td class="number TotalGCN">@TNK.Core.Common.ToCurrencyString(GiaCongNgoai)</td>
                                                        <td class="SUACHUACHUNG VAT"></td>
                                                        <td></td>
                                                        <td class="right">
                                                            @if (readOnly == "")
                                                            {
