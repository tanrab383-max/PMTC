        function CalThanhToanGCN() {
            a = true;
            var SoTien = 0;
            var i = 0;
            $("#SuaChua").find("tr").map(function (key, val) {
                if ($(val).is(":visible")) {
                    var isDeleted = $(val).find(".IsDeleted").val();
                    if (isDeleted != "true") {
                        var sotien = parseInt($(val).find("#ptdv1\\[" + i + "\\]GCN").val().split(",").join(""));
                        if (isNaN(sotien))
                            sotien = 0;
                        SoTien += sotien;
                        $("#SuaChua").find("#ptdv1\\[" + i + "\\]GCN").val(sotien.toLocaleString('en-us'));
                        i++;
                    }
                }
            });
            $("#SUACHUACHUNG").find(".TotalGCN").html(SoTien.toLocaleString('en-us'));
            $("#SUACHUACHUNG").find(".TotalGCN").val(SoTien.toLocaleString('en-us'));
        }

        function CalThanhToanGCN_OFCD() {
            a = true;
            var SoTien = 0;
            var i = 0;
            $("#CongDong").find("tr").map(function (key, val) {
