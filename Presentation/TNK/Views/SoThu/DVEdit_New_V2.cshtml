@model TNK.Model.DichVuEditModel
@{
    ViewBag.Title = "Phiếu dịch vụ";
    var suachuachung = Model.CTPDV.Where(x => x.PhanLoai.ToUpper() == "SUACHUA").ToList();
    //sửa chữa chung
    if (suachuachung.Count == 0)
    {
        suachuachung.Add(new TNK.Core.Domain.ChiTietPhieuDichVu());
        suachuachung[0].MaKho = "SuaChua";
        suachuachung[0].PhanLoai = "SuaChua";
        suachuachung[0].IsActive = true;
        suachuachung[0].IsDeleted = false;
        suachuachung[0].GiaVon = 0;
    }
    //công đồng
    var congdong = Model.CTPDV.Where(x => x.PhanLoai.ToUpper() == "CÐ").ToList();
    if (congdong.Count == 0)
    {
        congdong.Add(new TNK.Core.Domain.ChiTietPhieuDichVu());
        congdong[0].MaKho = "SuaChua";
        congdong[0].PhanLoai = "SuaChua";
        congdong[0].IsActive = true;
        congdong[0].IsDeleted = false;
        congdong[0].GiaVon = 0;
    }
    //đồng sơn xe
    var dongsonsonxe = Model.CTPDV.Where(x => x.PhanLoai.ToUpper() == "KHO_DTS" || x.PhanLoai.ToUpper() == "KHO_DS").ToList();
    if (dongsonsonxe.Count == 0)
    {
        dongsonsonxe.Add(new TNK.Core.Domain.ChiTietPhieuDichVu());
        dongsonsonxe[0].MaKho = "KHO_DS";
        dongsonsonxe[0].PhanLoai = "KHO_DS";
        dongsonsonxe[0].IsActive = true;
        dongsonsonxe[0].IsDeleted = false;
        dongsonsonxe[0].GiaVon = 0;
    }
    //phụ tùng trong
    var phutungtrong = Model.CTPDV.Where(x => x.PhanLoai.ToUpper() == "KHO_PTT" || x.PhanLoai.ToUpper() == "PTN").ToList();
    if (phutungtrong.Count == 0)
    {
        phutungtrong.Add(new TNK.Core.Domain.ChiTietPhieuDichVu());
        phutungtrong[0].MaKho = "KHO_PTT";
        phutungtrong[0].PhanLoai = "KHO_PTT";
        phutungtrong[0].IsActive = true;
        phutungtrong[0].IsDeleted = false;
        phutungtrong[0].GiaVon = 0;
    }
    //phụ tùng ngoài
    var phutungngoai = Model.CTPDV.Where(x => x.PhanLoai.ToUpper() == "KHO_PKT").ToList();
    if (phutungngoai.Count == 0)
    {
        phutungngoai.Add(new TNK.Core.Domain.ChiTietPhieuDichVu());
        phutungngoai[0].MaKho = "KHO_PTT";
        phutungngoai[0].PhanLoai = "KHO_PTN";
        phutungngoai[0].IsActive = true;
        phutungngoai[0].IsDeleted = false;
        phutungngoai[0].GiaVon = 0;
    }
    //phụ kiện trong
    var phukiendichvu = Model.CTPDV.Where(x => x.PhanLoai == "KHO_PKN").ToList();
    if (phukiendichvu.Count == 0)
    {
        phukiendichvu.Add(new TNK.Core.Domain.ChiTietPhieuDichVu());
        phukiendichvu[0].MaKho = "KHO_PKIEN";
        phukiendichvu[0].PhanLoai = "KHO_PKDV";
        phukiendichvu[0].IsActive = true;
        phukiendichvu[0].IsDeleted = false;
        phukiendichvu[0].GiaVon = 0;
    }
    //vật tư ngoài
    var vattungoai = Model.CTPDV.Where(x => x.PhanLoai == "KHO_VTN").ToList();
    if (vattungoai.Count == 0)
    {
        vattungoai.Add(new TNK.Core.Domain.ChiTietPhieuDichVu());
        vattungoai[0].MaKho = "KHO_PKIEN";
        vattungoai[0].PhanLoai = "KHO_PKDV";
        vattungoai[0].IsActive = true;
        vattungoai[0].IsDeleted = false;
        vattungoai[0].GiaVon = 0;
    }
    //vật tư giá trị gia tăng
    var vatugtgt = Model.CTPDV.Where(x => x.PhanLoai == "KHO_VTGTGT").ToList();
    if (vatugtgt.Count == 0)
    {
        vatugtgt.Add(new TNK.Core.Domain.ChiTietPhieuDichVu());
        vatugtgt[0].MaKho = "KHO_PKIEN";
        vatugtgt[0].PhanLoai = "KHO_PKDV";
        vatugtgt[0].IsActive = true;
        vatugtgt[0].IsDeleted = false;
        vatugtgt[0].GiaVon = 0;
    }
    //quà tặng
    var quatang = Model.CTPDV.Where(x => x.PhanLoai == "KHO_QTKM").ToList();
    if (quatang.Count == 0)
    {
        quatang.Add(new TNK.Core.Domain.ChiTietPhieuDichVu());
        quatang[0].MaKho = "KHO_QTKM";
        quatang[0].PhanLoai = "KHO_QTKM";
        quatang[0].IsActive = true;
        quatang[0].IsDeleted = false;
        quatang[0].GiaVon = 0;
    }

    var coc = Model.CTPT.Where(x => x.HinhThucThanhToan == "DC").ToList();
    var bh = Model.CTPT.FirstOrDefault(x => x.HinhThucThanhToan == "BH");
    var maCtyBH = (bh != null ? bh.Id : Guid.Empty);
    var soTienCtyBH = (bh != null ? bh.SoTienThanhToan : 0);
    var khtt = Model.CTPT.Where(x => x.HinhThucThanhToan != "DC" && x.HinhThucThanhToan != "BH" && x.HinhThucThanhToan != "HA").ToList();
    if (khtt == null || khtt.Count == 0)
    {
        khtt = new List<TNK.Core.Domain.ChiTietPhieuThu>();
        khtt.Add(new TNK.Core.Domain.ChiTietPhieuThu());
    }
    var HANG_TT = Model.CTPT.Where(s => s.HinhThucThanhToan == "HA").ToList();
    if (HANG_TT == null || HANG_TT.Count == 0)
    {
        HANG_TT = new List<TNK.Core.Domain.ChiTietPhieuThu>();
        HANG_TT.Add(new TNK.Core.Domain.ChiTietPhieuThu());
    }
    var z = 0;
    //no ban xe khach le
    var nophaithu = Model.noPhaiThu.FirstOrDefault(x => x.LoaiPhieuNo == "NDIVU");
    if (nophaithu != null)
    {
        nophaithu.SoTienNo = Convert.ToInt32(nophaithu.SoTienNo);
        nophaithu.SoTienConLai = Convert.ToInt32(nophaithu.SoTienConLai);
    }
    //nophaithu.SoTienNo = Math.Round(nophaithu.SoTienNo,0);
    //nophaithu.SoTienConLai = Math.Round(nophaithu.SoTienConLai, 0);
    //no gia cong ngoai
    var suaGCN = Model.noGCN.Count == 0 || Model.noGCN[0].SoTienDaTra == 0;
    //no phai tra hoa hong tai xe
    var suaHHTX = Model.noPhaiTra.Count == 0 || Model.noPhaiTra[0].SoTienDaTra == 0;
    //no phai thu bao hiem dich vu
    var suaBHTT = false;
    if (nophaithu != null)
    {
        suaBHTT = nophaithu.SoTienDaTra == 0 && (Model.noBaoHiem.Count == 0 || Model.noBaoHiem[0].SoTienDaTra == 0);
    }



    var maPhieuNoGCN = Model.noGCN.Count == 0 ? "" : Model.noGCN[0].MaPhieuNo;
    var soTienDaTraNoGCN = Model.noGCN.Count == 0 ? 0 : Model.noGCN[0].SoTienDaTra;

    var maPhieuNoHHTX = Model.noPhaiTra.Count == 0 ? "" : Model.noPhaiTra[0].MaPhieuNo;
    var soTienDaTraNoHHTX = Model.noPhaiTra.Count == 0 ? 0 : Model.noPhaiTra[0].SoTienDaTra;

    var maPhieuNoBHTT = Model.noBaoHiem.Count == 0 ? "" : Model.noBaoHiem[0].MaPhieuNo;
    var soTienDaTraNoBHTT = Model.noBaoHiem.Count == 0 ? 0 : Model.noBaoHiem[0].SoTienDaTra;
    double GiaCongNgoai = 0;
    if (suachuachung.Count > 0)
    {
        foreach (var scc in suachuachung)
        {
            GiaCongNgoai += scc.GCN;

            if (scc.GiaVon == null)
            {
                scc.GiaVon = 0;
            }
        }
    }
    double GiaCongNgoai_OFCD = 0;
    if (congdong.Count > 0)
    {
        foreach (var scc in congdong)
        {
            GiaCongNgoai_OFCD += scc.GCN;
        }
    }
    var readOnly = "";
    if (nophaithu != null)
    {
        readOnly = nophaithu.SoTienDaTra > 0 ? "readonly" : "";
    }

    var readOnlyNoHang =false;
    var noHang = Model.noHang.FirstOrDefault(x => x.SoTienDaTra>0);
    if (noHang != null)
    {
        readOnlyNoHang = noHang.SoTienDaTra > 0 ? true : false;
    }
}
<form id="form-data" method="post">
    @Html.HiddenFor(x => Model.obj.MaPhieuThu)
    @Html.HiddenFor(x => Model.obj.UpdatedDate)


    <input type="hidden" name="obj.SoTienThu" value="@Model.obj.SoTienThu" />
    @*<input type="hidden" name="obj.TongCong" value="@ViewBag.TongThucThuSauVAT" />*@

    <input type="hidden" name="NoGCN.MaPhieuNo" value="@maPhieuNoGCN" />
    <input type="hidden" name="NoGCN.SoTienDaTra" value="@soTienDaTraNoGCN" />

    <input type="hidden" name="NoHHTX.MaPhieuNo" value="@maPhieuNoHHTX" />
    <input type="hidden" name="NoHHTX.SoTienDaTra" value="@soTienDaTraNoHHTX" />

    <input type="hidden" name="NoBHTT.MaPhieuNo" value="@maPhieuNoBHTT" />
    <input type="hidden" name="NoBHTT.SoTienDaTra" value="@soTienDaTraNoBHTT" />

    <div class="page-title">
        <div class="title_left">
            <h3>Cập nhật @ViewBag.Title</h3>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="row">
        <div class="col-md-12 col-sm-12 col-xs-12">
            <div class="x_panel">
                <div class="x_title">
                    @*<h2><b>Thông tin phiếu</b></h2>*@
                    <ul class="nav navbar-right panel_toolbox">
                        <li>
                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                        </li>
                    </ul>
                    <div class="clearfix"></div>
                </div>
                <div class="x_content">
                    <div class="form-horizontal form-label-left">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label>Số phiếu</label>
