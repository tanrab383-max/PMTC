@model List<TNK.Core.Domain.View.ViewPhieuThu>
@{
    ViewBag.Title = "Cập nhật hóa đơn thu";
}
<div class="page-title">
    <div class="title_left">
        <h3>@ViewBag.Title</h3>
    </div>
</div>
<div class="clearfix"></div>
<div class="row">
    <div class="col-md-12">
        <div class="tabbable-line boxless tabbable-reversed">
            <div class="tab-content">
                <div class="tab-pane active" id="tab_0">
                    <div class="x_panel">
                        <div class="x_content">
                            <form id="formSearch" method="get" class="row">
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <label>Từ ngày thu</label>
                                        <input type="text" class="form-control input-sm date" value="@ViewBag.From" name="from" />
                                    </div>
                                </div>
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <label>Đến ngày thu</label>
                                        <input type="text" class="form-control input-sm date" value="@ViewBag.To" name="to" />
                                    </div>
                                </div>
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <label>Loại phiếu thu</label>
                                        <select name="maLoaiPhieu" class="select2" style="height:29px">
                                            <option value="">Chọn</option>
                                            @foreach(var maLoaiPhieu in ViewBag.ListLoai)
                                            {
                                                <option value="@maLoaiPhieu.MaVietTat">@maLoaiPhieu.DienGiai</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label>Từ khóa</label>
                                        <input type="text" title="Số hợp đồng, Khách hàng" placeholder="Số hợp đồng, Khách hàng" class="form-control input-sm " value="@ViewBag.Query" name="query" />
                                    </div>
                                </div>
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <br />
                                        <input type="submit" value="Tìm kiếm" class="btn btn-success search" />
                                    </div>
                                </div>
                            </form>
                            @*<div class="right">
                                    <a href="/SoThu/TBAXECreate?id=0"> <i class="fa fa-plus addNew" style="cursor:pointer" id="ThemMoi"></i></a>
                                </div>*@
                            <div class="table-responsive">
                                <table class="table">
                                    <thead>
                                        <tr class="success">
                                            <th>STT</th>
                                            <th>Mã Phiếu Thu</th>
                                            <th>Loại Phiếu Thu</th>
                                            <th>Số Hợp Đồng</th>
                                            <th>Số Hóa Đơn</th>
                                            <th>Số Chứng Từ</th>
                                            <th>Khách hàng</th>
                                            <th>Tổng Cộng Tiền</th>
                                            <th>Thao Tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int i = 1;
                                            foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td>@(ViewBag.PageSize * (ViewBag.PageIndex - 1) + i++)</td>
                                                    <td>@item.MaPhieuThu</td>
                                                    <td>@item.MaLoaiPhieu</td>
                                                    <td>@item.SoHopDong</td>
                                                    <td>
                                                        @Html.EditorFor(x => item.SoHoaDon, new { htmlAttributes = new { @class = "form-control number input-sm",@id= "SoHD_" + item.MaPhieuThu, @maxlength="20" } })
                                                    </td>
                                                    @if (item.MaLoaiPhieu == "TDIVU" || item.MaLoaiPhieu == "TBAXE")
                                                    {
                                                        <td>
                                                            @Html.EditorFor(x => item.SoChungTu, new { htmlAttributes = new { @class = "form-control number input-sm", @id = "SoCT_" + item.MaPhieuThu, @maxlength = "20" } })
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td></td>
                                                    }
                                                    <td>@item.Hoten</td>
                                                    <td class="number2">@item.TongCong</td>
                                                    <td style="width:5%" class="center">
                                                        <a href="" onclick="Edit('@item.MaPhieuThu')"><i title="Lưu" class="fa fa-save"></i></a>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                                <div class="right">
                                    @Html.Partial("~/Views/Shared/_Paging.cshtml")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-12 col-sm-12 col-xs-12">
    </div>
    <div class="clearfix"></div>
</div>


@section scripts
{
    <script src="~/Scripts/IndexCommon.js"></script>
    <script>
        var p = 1;
        $("#Search").click(function () {
            $(this).val("Loading...");
            $(this).prop('disabled', true);
            Search(this);
        })
        function change() {
            p = 1;
        }
        function Search(obj) {
            var from = $("#from").val();
            var to = $("#to").val();
            var query = $("#query").val();

            $.get("/SoThu/TBAXEComplete?query=" + query + "&from=" + from + "&to=" + to + "&p=" + p).success(function (response) {
                $("#tbody").html(response);
                $(obj).val("Tìm kiếm");
                $(obj).prop('disabled', false);
            })
        }
        var a;
        $(document).on("click", "#tbody a", function () {
            a = $(this).attr("href");
            var b = a.split("&");
            p = b[3].split("=")[1];
            console.log(p);
            Search();
            return false;
        })
        $('.date').datepicker({
            orientation: "left",
            autoclose: true
        });
        function Delete(a, id) {
            if (confirm('Xác nhận')) {
                data = { id: id, type: 'TBAXE' };
                $.post("/SoThu/DeletePhieuThu", data).success(function (response) {
                    if (response == "success") {
                        $(a).closest("tr").remove();
                        toastSuccess("Đã xóa thành công");
                    }
                    else
                        toastError(response);
                });
            }
        }
        function Edit(MaPhieuThu)
        {
            if (MaPhieuThu == "")
            {
                toastWarning("Cập nhật thất bại");
                return False;
            }
            var SoHoaDon = $("#SoHD_" + MaPhieuThu).val();
            var SoChungTu = $("#SoCT_" + MaPhieuThu).val();
            $.ajax({
                url: "/SoThu/Update_SoHoaDon",
                type: "POST",
                data: { maPhieuThu: MaPhieuThu, soHoaDon: SoHoaDon, soChungTu: SoChungTu },
                success: function (result) {
                    if (!result.IsError) {
                        toastSuccess(result.Message);
                    }
                    else {
                        toastWarning(result.Message);
                    }
                },
                error: function (result) {
                    toastWarning("Lỗi: Cập nhật hóa đơn thu.");
                }
            });
        }
    </script>
}
