        function TinhGiaBan()
        {
            debugger;
            var GiamGia = 0;
            var GNY = $("#GiaNiemYet").val().split(",").join("");
            GNY = parseInt(GNY);
            var GiaBan = $("#GiaBan").val().split(",").join("");
            if (GiaBan == undefined || GiaBan == "")
                GiaBan = 0;
            else
                GiaBan = parseInt(GiaBan);
            if (GNY > GiaBan)
                GiamGia = GNY - GiaBan;
            else
            {
                GiaBan = GNY;
                GiamGia = 0;
            }
            $("#GiamGia").val(GiamGia.toLocaleString('en-us'));
            $("#GiaBan").val(GiaBan.toLocaleString('en-us'));
            Cal();
        }
