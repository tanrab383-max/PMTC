            debugger
            try {
                let total = 0;
                $(".numberKM").map(function (key, val) {
                    let number = $(this).val();
                    if (number != "" && $(this).is(":visible")) {
                        number = number.split(",").join("");
                        number = parseInt(number);
                        total += number;
                    }

                });
                $(".TotalKM").html(total.toLocaleString('en-us'));
