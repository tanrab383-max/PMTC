@model TNK.Model.BanXeModel
@{
}

<form id="form-data" method="post">
    <input hidden value="TBAXE" id="type" />
    <div class="page-title">
        <div class="title_left">
            <h3>Tạo mới @ViewBag.Title</h3>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="row">
        <div class="col-md-12 col-sm-12 col-xs-12">
            <div class="x_panel">
                <div class="x_title">
                    <ul class="nav navbar-right panel_toolbox">
                        <li>
                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                        </li>
                    </ul>
                    <div class="clearfix"></div>
                </div>
                <div class="x_content">
                    <div class="form-horizontal form-label-left">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="col-md-6">
                                    <div class="col-md-4 col-sm-4 col-xs-12">
                                        <div class="form-group">
                                            <label>Số hợp đồng</label>
                                            @Html.EditorFor(x => Model.obj.SoHopDong, new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "15", @Value = ViewBag.SoPhieu } })
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-4 col-xs-12">
                                        <div class="form-group">
                                            <label>Ngày hợp đồng</label>
                                            @Html.EditorFor(x => Model.obj.NgayHopDong, new { htmlAttributes = new { @class = "form-control input-sm date", @Value = Model.obj.NgayHopDong.Value.ToString("dd/MM/yyyy") } })
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-4 col-xs-12">
                                        <div class="form-group">
                                            <label>Ngày thu tiền</label>
                                            <input type="text" class="form-control input-sm date " name="obj.NgayThu" value="@Model.obj.NgayThu.ToString("dd/MM/yyyy")" />
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-4 col-xs-12">
                                        <div class="form-group">
                                            <label>Số khung</label>
                                            @Html.EditorFor(x => Model.obj.SoKhung, new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "17", @id = "SoKhung" } })
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-4 col-xs-12">
                                        <div class="form-group">
                                            <label>Mã xe</label>
                                            @Html.EditorFor(x => Model.obj.MaXe, new { htmlAttributes = new { @class = "form-control input-sm MaXe" } })
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-4 col-xs-12">
                                        <div class="form-group">
                                            <label>Màu xe</label>
                                            @Html.EditorFor(x => Model.obj.MauXe, new { htmlAttributes = new { @class = "form-control input-sm" } })
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-4 col-xs-12">
                                        <div class="form-group">
                                            <label>Điện thoại</label>
                                            @Html.EditorFor(x => Model.obj.DienThoai, new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "11" } })
                                        </div>
                                    </div>
                                    <div class="col-md-8 col-sm-8 col-xs-12">
                                        <div class="form-group">
                                            <label>Địa chỉ</label>
                                            @Html.EditorFor(x => Model.obj.DiaChi, new { htmlAttributes = new { @class = "form-control input-sm" } })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="col-md-4 col-sm-4 col-xs-12">
                                        <div class="form-group">
                                            <label>Số hóa đơn</label>
                                            @Html.EditorFor(x => Model.obj.SoHoaDon, new { htmlAttributes = new { @class = "form-control input-sm" } })
                                        </div>
                                    </div>
                                    <div class="col-md-8 col-sm-8 col-xs-12">
                                        <div class="form-group">
                                            <label>Chứng từ liên quan</label>
                                            @Html.EditorFor(x => Model.obj.SoChungTu, new { htmlAttributes = new { @class = "form-control input-sm" } })
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-4 col-xs-12">
                                        <div class="form-group">
                                            <label>Đối tác</label>
                                            @Html.DropDownListFor(x => Model.obj.DoiTac, Model.DoiTac.Select(x => new SelectListItem { Text = x.TenDoiTac, Value = x.MaDoiTac }), "Chọn", new { @class = "select2 fullwidth", @id = "DoiTac" })
                                        </div>
                                    </div>
                                    <div class="col-md-8 col-sm-8 col-xs-12">
                                        <div class="form-group">
                                            <label>Họ tên(*)</label>
                                            @Html.EditorFor(x => Model.obj.HoTen, new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "500" } })
                                        </div>
                                    </div>
                                    <div class="col-md-8 col-sm-8 col-xs-12">
                                        <div class="form-group">
                                            <label>Tổng giá vốn Hứa tặng Phụ kiện KM</label>
                                            @Html.EditorFor(x => Model.obj.NoKhuyenMai, new { htmlAttributes = new { @class = "form-control input-sm number NoKhuyenMai", @maxlength = "500" } })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="col-md-6">
                                    <div class="form-group table-responsive">
                                        <br />
                                        <table class="table table-striped jambo_table bulk_action">
                                            <thead>
                                                <tr>
                                                    <th>Giá niêm yết</th>
                                                    <th>Giảm giá</th>
                                                    <th>Thực bán</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td><input name="obj.GiaVon" value="@Model.obj.GiaNiemYet" class="form-control input-sm number" id="GiaNiemYet" onchange="TinhGiaBan()" readonly /></td>
                                                    <td><input name="obj.GiamGia" value="@Model.obj.GiamGia" class="form-control input-sm number" id="GiamGia" readonly /></td>
                                                    <td><input class="form-control input-sm number" maxlength="15" id="GiaBan" onchange="TinhGiaBan()" /></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="col-md-12 col-sm-12 col-xs-12">
                                        <div class="form-group table-responsive">
                                            <label>Khuyến mãi:</label>
                                            <table class="table table-striped jambo_table bulk_action" width="80%">
                                                <thead>
                                                    <tr>
                                                        <th>Loại khuyến mãi</th>
                                                        <th>Nội dung</th>
                                                        <th>Giá vốn</th>
                                                        <th>Ghi chú</th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                                <tbody id="KM">
                                                    @if (Model.ListKMBaoHiem != null)
                                                    {
                                                        for (int i = 0; i < Model.ListKMBaoHiem.Count; i++)
                                                        {
                                                            <tr>
                                                                <td>Bảo hiểm @Model.ListKMBaoHiem[i].CTBH</td>
                                                                <td>@Model.ListKMBaoHiem[i].NoiDung</td>
                                                                <td><input type="text" value="@Model.ListKMBaoHiem[i].GiaVon" class="number input-100 form-control input-sm numberKM" readonly /></td>
                                                                <td>@Model.ListKMBaoHiem[i].GhiChu</td>
                                                                <td></td>
                                                            </tr>
                                                        }
                                                    }

                                                    @if (Model.ListKMPKien != null)
                                                    {
                                                        for (int i = 0; i < Model.ListKMPKien.Count; i++)
                                                        {
                                                            double giaKM = 0;
                                                            if (Model.ListKMPKien[i].GiaBan > 0) //phieu thu PTPK theo cach hach toan cu khong co tien cong thi gia KM = giaBan
                                                            {
                                                                giaKM = Model.ListKMPKien[i].GiaBan;
                                                            }
                                                            else
                                                            {
                                                                giaKM = Model.ListKMPKien[i].GiaVon + Model.ListKMPKien[i].TienCong;
                                                            }
                                                            <tr>

                                                                <td colspan="2">@Model.ListKMPKien[i].TenHang</td>
                                                                <td><input type="text" value="@giaKM" class="number input-100 form-control input-sm numberKM" readonly /></td>

                                                                <td>@Model.ListKMPKien[i].MaKho</td>
                                                                <td></td>
                                                            </tr>
                                                        }
                                                    }
                                                    <tr>
                                                        <td></td>
                                                        <td></td>
                                                        <td><input type="text" value="@ViewBag.NoKhuyenMai" class="number input-100 form-control input-sm numberKM" readonly maxlength="15" /></td>
                                                        <td>Nợ khuyến mãi</td>
                                                        <td></td>
                                                    </tr>
                                                    @if (Model.ListBDTK != null)
                                                    {
                                                        for (int i = 0; i < Model.ListBDTK.Count; i++)
                                                        {
                                                            var item = Model.ListBDTK[i];
                                                            <tr>
                                                                <td colspan="2">@item.TenChuongTrinh</td>

                                                                <td><input type="text" value="@item.GiamGia" class="number input-100 form-control input-sm numberKM" readonly maxlength="15" /></td>

                                                                <td>Bảo dưỡng tiết kiệm</td>
                                                                <td></td>
                                                            </tr>
                                                        }
                                                    }
                                                    @for (int i = 0; i < Model.CTKM.Count; i++)
                                                    {
                                                        var item = Model.CTKM[i];
                                                        if (item.TenChuongTrinh == null)
                                                        {
                                                            <tr id="trKM">
                                                                <td style="width:150px">
                                                                    <select class="select2 fullwidthx KhoKM" id="ddlKhoKM" style="width:50px" name="CTKM[@i].NguonKhuyenMai" onchange="LoadChiTietKhuyenMai(this,@i)">
                                                                        <option value="">Chọn</option>
                                                                        @foreach (var j in Model.NKM)
                                                                        {
                                                                            <option value="@j.NguonKhuyenMai" @(item.NguonKhuyenMai == j.NguonKhuyenMai ? "selected" : "")>@j.TenKhuyenMai</option>
                                                                        }
                                                                    </select>
                                                                </td>
                                                                <td>
                                                                    <input type="text" id="CTKM[@i].NoiDung" name="CTKM[@i].NoiDung" value="@item.NoiDung" class="form-control input-sm noidung" />
                                                                </td>
                                                                <td>
                                                                    <input type="text" id="CTKM[@i].GiaBan" name="CTKM[@i].GiaBan" value="@item.GiaBan" class="number form-control input-sm numberKM" maxlength="15" />
                                                                </td>
                                                                <td>
                                                                    <input type="text" id="CTKM[@i].GhiChu" name="CTKM[@i].GhiChu" value="@item.GhiChu" class="form-control input-sm ghichu" />
                                                                    <input type="hidden" class="IsDeleted" name="CTKM[@i].IsDeleted" value="false" />
                                                                </td>
                                                                <td>
                                                                    <i class="fa fa-remove" onclick="Remove(this)" style="cursor:pointer"></i>
                                                                </td>
                                                            </tr>
                                                        }

                                                    }

                                                </tbody>
                                                <tfoot>
                                                    <tr>
                                                        <td>Tổng cộng:</td>
                                                        <td></td>
                                                        <td class="TotalKM"></td>
                                                        <td></td>
                                                        <td class="right"><i class="fa fa-plus addKM" style="cursor:pointer"></i></td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="col-md-12 col-sm-12 col-xs-12">
                                    <div class="form-group table-responsive">
                                        <label>Thưởng/chiết khấu hãng:</label>
                                        <table class="table table-striped jambo_table bulk_action" width="80%">
                                            <thead>
                                                <tr>
                                                    <th>Loại khuyến mãi</th>
                                                    <th>Nội dung</th>
                                                    <th>Giá vốn</th>
                                                    <th>Ghi chú</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody id="KM">
                                                @if (Model.ListKMBaoHiem != null)
                                                {
                                                    for (int i = 0; i < Model.ListKMBaoHiem.Count; i++)
                                                    {
                                                        <tr>
                                                            <td>Bảo hiểm @Model.ListKMBaoHiem[i].CTBH</td>
                                                            <td>@Model.ListKMBaoHiem[i].NoiDung</td>
                                                            <td><input type="text" value="@Model.ListKMBaoHiem[i].GiaVon" class="number input-100 form-control input-sm numberKM" readonly /></td>
                                                            <td>@Model.ListKMBaoHiem[i].GhiChu</td>
                                                            <td></td>
                                                        </tr>
                                                    }
                                                }

                                                @if (Model.ListKMPKien != null)
                                                {
                                                    for (int i = 0; i < Model.ListKMPKien.Count; i++)
                                                    {
                                                        double giaKM = 0;
                                                        if (Model.ListKMPKien[i].GiaBan > 0) //phieu thu PTPK theo cach hach toan cu khong co tien cong thi gia KM = giaBan
                                                        {
                                                            giaKM = Model.ListKMPKien[i].GiaBan;
                                                        }
                                                        else
                                                        {
                                                            giaKM = Model.ListKMPKien[i].GiaVon + Model.ListKMPKien[i].TienCong;
                                                        }
                                                        <tr>

                                                            <td colspan="2">@Model.ListKMPKien[i].TenHang</td>
                                                            <td><input type="text" value="@giaKM" class="number input-100 form-control input-sm numberKM" readonly /></td>

                                                            <td>@Model.ListKMPKien[i].MaKho</td>
                                                            <td></td>
                                                        </tr>
                                                    }
                                                }
                                                <tr>
                                                    <td></td>
                                                    <td></td>
                                                    <td><input type="text" value="@ViewBag.NoKhuyenMai" class="number input-100 form-control input-sm numberKM" readonly maxlength="15" /></td>
                                                    <td>Nợ khuyến mãi</td>
                                                    <td></td>
                                                </tr>
                                                @if (Model.ListBDTK != null)
                                                {
                                                    for (int i = 0; i < Model.ListBDTK.Count; i++)
                                                    {
                                                        var item = Model.ListBDTK[i];
                                                        <tr>
                                                            <td colspan="2">@item.TenChuongTrinh</td>

                                                            <td><input type="text" value="@item.GiamGia" class="number input-100 form-control input-sm numberKM" readonly maxlength="15" /></td>

                                                            <td>Bảo dưỡng tiết kiệm</td>
                                                            <td></td>
                                                        </tr>
                                                    }
                                                }
                                                @for (int i = 0; i < Model.CTKM.Count; i++)
                                                {
                                                    var item = Model.CTKM[i];
                                                    if (item.TenChuongTrinh == null)
                                                    {
                                                        <tr id="trKM">
                                                            <td style="width:150px">
                                                                <select class="select2 fullwidthx KhoKM" id="ddlKhoKM" style="width:50px" name="CTKM[@i].NguonKhuyenMai" onchange="LoadChiTietKhuyenMai(this,@i)">
                                                                    <option value="">Chọn</option>
                                                                    @foreach (var j in Model.NKM)
                                                                    {
                                                                        <option value="@j.NguonKhuyenMai" @(item.NguonKhuyenMai == j.NguonKhuyenMai ? "selected" : "")>@j.TenKhuyenMai</option>
                                                                    }
                                                                </select>
                                                            </td>
                                                            <td>
                                                                <input type="text" id="CTKM[@i].NoiDung" name="CTKM[@i].NoiDung" value="@item.NoiDung" class="form-control input-sm noidung" />
                                                            </td>
                                                            <td>
                                                                <input type="text" id="CTKM[@i].GiaBan" name="CTKM[@i].GiaBan" value="@item.GiaBan" class="number form-control input-sm numberKM" maxlength="15" />
                                                            </td>
                                                            <td>
                                                                <input type="text" id="CTKM[@i].GhiChu" name="CTKM[@i].GhiChu" value="@item.GhiChu" class="form-control input-sm ghichu" />
                                                                <input type="hidden" class="IsDeleted" name="CTKM[@i].IsDeleted" value="false" />
                                                            </td>
                                                            <td>
                                                                <i class="fa fa-remove" onclick="Remove(this)" style="cursor:pointer"></i>
                                                            </td>
                                                        </tr>
                                                    }

                                                }

                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    <td>Tổng cộng:</td>
                                                    <td></td>
                                                    <td class="TotalKM"></td>
                                                    <td></td>
                                                    <td class="right"><i class="fa fa-plus addKM" style="cursor:pointer"></i></td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                            <div class="col-md-12 col-sm-12 col-xs-12">
                                <div class="col-md-6">
                                    <div class="col-md-12 col-sm-12 col-xs-12">
                                        <div class="form-group table-responsive">
                                            <label>Cọc:</label>
                                            <table class="table table-striped jambo_table bulk_action">
                                                <thead>
                                                    <tr>
                                                        <th>Phiếu cọc</th>
                                                        <th>Số tiền có thể sử dụng</th>
                                                        <th>Số tiền sử dụng</th>
                                                        <th>Còn lại</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @for (int i = 0; i < Model.Cocs.Count; i++)
                                                    {
                                                        var item = Model.Cocs[i];
                                                        <tr>
                                                            <td>
                                                                <label class="control-label">@item.HoTen + @item.NgayThu.ToString("dd/MM/yyyy")</label>
                                                                <input type="hidden" value="@item.MaPhieuThu" name="coc[@i].MaPhieuThu" />
                                                            </td>
                                                            <td><input type="text" class="form-control input-sm SoTienCoTheSuDung input-100 number" value="@item.ConLai" readonly /></td>
                                                            <td><input type="text" width="200" class="form-control input-sm SoTienThanhToan input-100 number" onchange="CalCoc(this)" name="coc[@i].SoTienDaSuDung" value="0" /></td>
                                                            <td><input type="text" width="200" class="form-control input-sm ConLai input-100 number" value="@item.ConLai" readonly /></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                    <div class="col-md-12 col-sm-12 col-xs-12">
                                        <div class="form-group table-responsive">
                                            <label>Khoản vay ngân hàng</label>
                                            <table class="table table-striped jambo_table bulk_action">
                                                <thead>
                                                    <tr>
                                                        <th>Khoản vay ngân hàng</th>
                                                        <th>Số tiền vay</th>
                                                        <th>Hoa hồng</th>
                                                        <th>Đã giải ngân</th>
                                                        <th>Còn lại</th>
                                                        <th>Ghi chú</th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                                <tbody id="KVNH">
                                                    @for (int j = 0; j < Model.KVNH.Count; j++)
                                                    {
                                                        var item = Model.KVNH[j];
                                                        <tr id="trKVNH">
                                                            <td>
                                                                <select class="select2 fullwidthx TenNh" name="KVNH[@j].DonViNo">
                                                                    <option value="">Chọn</option>
                                                                    @foreach (var i in Model.NganHang)
                                                                    {
                                                                        <option value="@i.MaDoiTac">@i.TenDoiTac</option>
                                                                    }
                                                                </select>
                                                            </td>
                                                            <td>
                                                                <input type="text" value="@item.SoTienNo" name="KVNH[@j].SoTienNo" onchange="Cal()" class="number input-100 form-control input-sm SoTienThanhToan" maxlength="15" />
                                                            </td>
                                                            <td>
                                                                @Html.EditorFor(x => Model.obj.HoaHong, new { htmlAttributes = new { @class = "number input-100 form-control input-sm" } })
                                                            </td>
                                                            <td>
                                                                <input type="text" class="number input-100 form-control input-sm" readonly value="@item.SoTienDaTra" />
                                                            </td>
                                                            <td>
                                                                <input type="text" class="number input-100 form-control input-sm" readonly value="@item.SoTienConLai" />
                                                            </td>
                                                            <td>
                                                                <input type="text" class="input-100 form-control input-sm" value="@item.GhiChu" name="KVNH[@j].GhiChu" />
                                                                <input type="hidden" name="KVNH[@j].IsDeleted" class="IsDeleted" value="false" />
                                                            </td>
                                                            <td>@*<i class="fa fa-remove" onclick="Remove(this)" style="cursor:pointer"></i>*@</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                                <tfoot>
                                                    <tr>
                                                        @*<td colspan="6" class="right"><i class="fa fa-plus addKVNH" style="cursor:pointer"></i></td>*@
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>
                                    </div>
                                    <div class="col-md-12 col-sm-12 col-xs-12">
                                        <div class="form-group table-responsive">
                                            <label>Khách hàng thanh toán:</label>
                                            <table class="table table-striped jambo_table bulk_action">
                                                <thead>
                                                    <tr>
                                                        <th style="width:40%">Túi tiền</th>
                                                        <th style="width:30%">Số tiền</th>
                                                        <th style="width:30%">Số tham chiếu</th>
                                                        <th>Treo</th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                                <tbody id="tbody">
                                                    @for (int j = 0; j < Model.CTPT.Count; j++)
                                                    {
                                                        var item = Model.CTPT[j];
                                                        <tr id="tr" class="animated fadeIn">
                                                            <td>
                                                                <input type="hidden" name="httt[@j].Id" class="CTPTId" value="@item.Id" />
                                                                <select class="select2 fullwidth Temp" name="httt[@j].Temp">
                                                                    <option value="">Chọn</option>
                                                                    @foreach (var i in Model.HTTT)
                                                                    {
                                                                        <option value="@i.GiaTri" @(item.Temp == i.GiaTri ? "selected" : "")>@i.HienThi</option>
                                                                    }
                                                                </select>
                                                            </td>
                                                            <td><input type="text" name="httt[@j].SoTienThanhToan" onchange="Cal()" value="@item.SoTienThanhToan" class="number form-control input-sm SoTienThanhToan numberSTTT" maxlength="15" /></td>
                                                            <td><input name="httt[@j].SoThamChieu" value="@item.SoThamChieu" class="form-control input-sm" /></td>
                                                            <td>
                                                                <input type="checkbox" class="chkTinhTrang" @(item.TinhTrang ? "checked" : "") />
                                                                <input type="hidden" class="TinhTrang" name="httt[@j].TinhTrang" value="@item.TinhTrang" />
                                                                <input type="hidden" class="IsDeleted" name="httt[@j].IsDeleted" value="false" />
                                                            </td>
