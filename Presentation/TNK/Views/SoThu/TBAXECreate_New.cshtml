        function CalNumber3() {
            let total = 0;
            $(".numberSTTT").map(function (key, val) {
                let number = $(this).val();
                number = number.split(",").join("");
                number = parseInt(number);
                if (isNaN(number))
                    number = 0;
                total += number;
                if (isNaN(total))
                    total = 0;
                $(".Total").html(total.toLocaleString('en-us'));
            });
        }
        CalNumberKM();
        $(document).on("change", ".numberKM", function () {
            CalNumberKM();
        });
