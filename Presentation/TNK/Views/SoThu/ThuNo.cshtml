        var tableToExcel = (function () {
            debugger;
            var uri = 'data:application/vnd.ms-excel;base64,'
            , template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>{table}</table></body></html>'
            , base64 = function (s) { return window.btoa(unescape(encodeURIComponent(s))) }
            , format = function (s, c) { return s.replace(/{(\w+)}/g, function (m, p) { return c[p]; }) }
            return function (table, name) {
                //if (!table.nodeType) table = document.getElementById(table)
                var ctx = { worksheet: name || 'Worksheet', table: table }
                var link = document.createElement("A");
                link.href = uri + base64(format(template, ctx));
                link.download = name || 'Baocao.xls';
                link.target = '_blank';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            }
        })()
        function Save(MaPhieuNo)
        {
            debugger;
            var Sales = $("#Sales_" + MaPhieuNo).val();
            var GhiChu = $("#GhiChu_" + MaPhieuNo).val();
            $.ajax({
                url: "/SoThu/Update_SalesNote",
                type: "POST",
                data: { MaPhieuNo: MaPhieuNo, Sales: Sales, GhiChu: GhiChu },
                success: function (result) {
                    if (!result.IsError) {
                        toastSuccess(result.Message);
                    }
                    else {
                        toastWarning(result.Message);
                    }
                },
                error: function (result) {
                    toastWarning("Lỗi: Cập nhật Sales và Ghi chú.");
                }
            });
        }

        function SaveGiaiTrinh(MaPhieuNo) {
            debugger;
            var GiaiTrinh = $("#GiaiTrinh_" + MaPhieuNo).val();

            if ($("#LDQH_" + MaPhieuNo).val() === "" && GiaiTrinh != "") {
                toastWarning("Vui lòng chọn lý do quá hạn");
                $("#LDQH_" + MaPhieuNo).focus();
                return false;
            }
            var LyDoQuaHan = $("#LDQH_" + MaPhieuNo).val();
            //var GhiChu = $("#GhiChu_" + MaPhieuNo).val();
            $.ajax({
                url: "/SoThu/Update_GiaiTrinh",
                type: "POST",
                data: { MaPhieuNo: MaPhieuNo, GiaiTrinh: GiaiTrinh, LyDoQuaHan: LyDoQuaHan },
                success: function (result) {
                    if (!result.IsError) {
                        toastSuccess(result.Message);
                    }
                    else {
                        toastWarning(result.Message);
                    }
                },
                error: function (result) {
                    toastWarning("Lỗi cập nhật giải trình.");
                }
            });
        }
        function SaveSHD(MaPhieuNo) {
            debugger;
            var SoHoaDon = $("#SHD_" + MaPhieuNo).val();
            var NgayXHD = $("#NgayXHD_" + MaPhieuNo).val();
            var NgayXNCN = $("#NgayXNCN_" + MaPhieuNo).val();
            var NgayNo = $(".NgayNo_" + MaPhieuNo).text();
            var SoTienDaTra = $(".soTienDaTra_" + MaPhieuNo).text();
            var GhiChu = $("#GhiChu_" + MaPhieuNo).val();
            if (SoTienDaTra != "0" && (NgayXNCN == "" || SoHoaDon == "" || NgayXHD == ""))
            {
                toastWarning("[" + MaPhieuNo + "]: Vui lòng nhập đầy đủ thông tin hóa đơn và công nợ vì phiếu đã có thu tiền nợ.");
                if (NgayXNCN == "") $("#NgayXNCN_" + MaPhieuNo).focus();
                if (NgayXHD == "") $("#NgayXHD_" + MaPhieuNo).focus();
                if (SoHoaDon == "") $("#SHD_" + MaPhieuNo).focus();
                return;
            }
            if (NgayXHD.length == 8) {
                NgayXHD = NgayXHD.substring(0, 2) + '/' + NgayXHD.substring(2, 4) + '/' + NgayXHD.substring(4, 8);
            }
            if (NgayXNCN.length == 8) {
                NgayXNCN = NgayXNCN.substring(0, 2) + '/' + NgayXNCN.substring(2, 4) + '/' + NgayXNCN.substring(4, 8);
            }
           // alert(ngayNo.text());
            console.log("Ngày XHĐ:" + NgayXHD);
            console.log("NgàyXNCN:" + NgayXNCN);
            //kiểm tra định dạng ngày
            if (NgayXHD != "" && !isDate(NgayXHD))
            {
                toastWarning("[" + MaPhieuNo + "]: Vui lòng nhập [Ngày xuất hóa đơn] theo định dạng dd/MM/yyyy ");
                $("#NgayXHD_" + MaPhieuNo).focus();
                return;
            }
            if (NgayXNCN != "" && !isDate(NgayXNCN))
            {
                toastWarning("[" + MaPhieuNo + "]: Vui lòng nhập [Ngày ghi nhận công nợ] theo định dạng dd/MM/yyyy ");
                $("#NgayXNCN_" + MaPhieuNo).focus();
                return;
            }
            //kiem tra neu co số hóa đơn thì phải bắt nhập nsgày nhập hóa đơn
            if (SoHoaDon != "" && NgayXHD == "")
            {
                toastWarning("[" + MaPhieuNo + "]: Vui lòng nhập [Ngày xuất hóa đơn]");
                $("#NgayXHD_" + MaPhieuNo).focus();
                return;
            }
            //kiem tra neu co số hóa đơn thì phải bắt nhập nsgày nhập hóa đơn
            if (SoHoaDon == "" && NgayXHD != "") {
                toastWarning("[" + MaPhieuNo + "]: Vui lòng nhập [Số hóa đơn]");
                $("#SHD_" + MaPhieuNo).focus();
                return;
            }
            //kiem tra neu co ngày xác nhạn công nợ thì phải có nhập số hóa đơn + ngày xuất hóa đơn
            if (NgayXHD == "" && NgayXNCN != "")
            {
                toastWarning("[" + MaPhieuNo + "]: Vui lòng nhập [Ngày xuất hóa đơn] và [Số hóa đơn]");
                $("#NgayXHD_" + MaPhieuNo).focus();
                return;
            }
            //kiem tra ngày xuất hóa đơn >= ngày nợ
            if (isDate(NgayXHD) && toDate(NgayXHD) < toDate(NgayNo))
            {
                toastWarning("[" + MaPhieuNo + "]: [Ngày xuất hóa đơn] không được nhỏ hơn [Ngày nợ]");
                $("#NgayXHD_" + MaPhieuNo).focus();
                return;
            }
            //kiem tra ngày ghi nhận công nợ >= ngày xuất hóa đơn
            if (isDate(NgayXHD) && isDate(NgayXNCN) && toDate(NgayXNCN) < toDate(NgayXHD))
