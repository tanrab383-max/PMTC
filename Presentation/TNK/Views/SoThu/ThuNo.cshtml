@model List<TNK.Core.Domain.View.ViewNoPhaiThuBHDV>
@{
    int i = 1;
    var flag = ViewBag.Type == "NBHDV" || ViewBag.Type == "NHHBH";
    var count = Model.Count;
    //var ModelGiaiTrinh = ViewBag.ModelGiaiTrinh;
    var activeSearch = ViewBag.Submit == "Search" ? "active" : "";
    var activeGiaiTrinh = ViewBag.Submit == "SearchGiaiTrinh" ? "active" : "";
    var lstLoaiBH = new List<SelectListItem>
    {
        new SelectListItem { Value = "KL", Text = "Thu hộ" },
        new SelectListItem { Value = "KM", Text = "Khuyến mãi" },
    };
}
<div class="page-title">
    <div class="title_left">
        <h3>@ViewBag.Title</h3>
    </div>
</div>
<div class="clearfix"></div>
<div class="row">
    <div class="col-md-12">
        <div class="tabbable-line boxless tabbable-reversed">
            <ul class="nav nav-tabs" id="tab_data">
                @if (ViewBag.Submit == "Search")
                {
                    <li class='active' data-url="/SoThu/PhieuThu/@ViewBag.Type">
                        <a href="#tab_0" data-toggle="tab" aria-expanded="true">
                            Phiếu nợ
                        </a>
                    </li>
                }
                else
                {
                    <li class="" data-url="/SoThu/PhieuThu/@ViewBag.Type">
                        <a href="#tab_0" data-toggle="tab" aria-expanded="true">
                            Phiếu nợ
                        </a>
                    </li>
                }
                <li class="">
                    <a id="a_1" href="#tab_1" data-toggle="tab" aria-expanded="false">
                        Chi tiết phiếu thu nợ
                    </a>
                </li>
                @if (ViewBag.Type == "NBHDV")
                {
                    if (ViewBag.Submit == "SearchGiaiTrinh")
                    {
                        <li class="active">
                            <a id="a_2" href="#tab_2" data-toggle="tab" aria-expanded="false">
                                Giải trình
                            </a>
                        </li>
                    }
                    else
                    {
                        <li>
                            <a id="a_2" href="#tab_2" data-toggle="tab" aria-expanded="false">
                                Giải trình
                            </a>
                        </li>
                    }
                }
            </ul>
            <div class="tab-content">

                <div class='tab-pane @activeSearch' id="tab_0">
                    <div class="x_panel">
                        <div class="x_content">
                            @if (ViewBag.Type == "NHHGP" || ViewBag.Type == "NHHHB" || ViewBag.Type == "NTKHA" || ViewBag.Type == "NHANG")
                            {
                                <div class="title_right" style="margin-left:88%">
                                    <a href="#" download><span style="font-style:italic;color:blue;font-size:15px" id="FileMau">Lấy file mẫu(*.xlxs)</span></a>
                                </div>
                            }
                            <form method="get" class="row">
                                <input name="id" type="hidden" value="@ViewBag.Type" />
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <label>Từ ngày thu</label>
                                        <input type="text" class="form-control input-sm date" value="@ViewBag.From" name="from" id="FromDate" />
                                    </div>
                                </div>
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <label>Đến ngày thu</label>
                                        <input type="text" class="form-control input-sm date" value="@ViewBag.To" name="to" id="ToDate" />
                                    </div>
                                </div>
                                @if (ViewBag.Type != "NHHBH")
                                {
                                    <div class="col-md-5 col-sm-5 col-xs-12">
                                        <div class="form-group">
                                            <label>Từ khóa</label>
                                            <input type="text" title="@ViewBag.SearchHolder" placeholder="@ViewBag.SearchHolder" class="form-control input-sm " value="@ViewBag.Query" name="query" id="query" />
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="col-md-2 col-sm-2 col-xs-12">
                                        <div class="form-group">
                                            <label>Loại bảo hiểm</label>
                                            @Html.DropDownList("loaiBH", lstLoaiBH, "Chọn", new { @class = "select2 fullwidth", @id = "LoaiBH" })
                                        </div>
                                    </div>
                                     <div class="col-md-3 col-sm-3 col-xs-12">
                                        <div class="form-group">
                                            <label>Từ khóa</label>
                                            <input type="text" title="@ViewBag.SearchHolder" placeholder="@ViewBag.SearchHolder" class="form-control input-sm " value="@ViewBag.Query" name="query" id="query" />
                                        </div>
                                    </div>
                                }
                                <div class="col-md-3 col-sm-3 col-xs-12">
                                    <div class="form-group">
                                        <br />
                                        <input type="submit" id="SearchNPT" name="submit" value="Tìm kiếm" title="Tìm kiếm phiếu nợ" class="btn btn-success" />
                                        @if (ViewBag.Type == "NHHGP")
                                        {
                                            <input type="submit" name="export_Excel" id="exportExcel" value="Xuất Excel" class="btn btn-info" />
                                            <input style="width:50%" onclick="ImportData_NHHGP()" id="btnimportData" title="Import số tiền nợ HHGP" value="Import số tiền nợ HHGP" class="btn btn-primary" />
                                            <div style="display:none"><input type="file" id="txtUploadFile1" /></div>
                                        }
                                        else if (ViewBag.Type == "NHHHB")
                                        {
                                            <input type="button" value="Xuất excel" class="btn btn-info" id="btnExportExcel" />
                                            <input style="width: 50%" onclick="ImportData_CKTM()" id="btnimportCKTM" title="Import chiết khấu thương mại" value="Import CKTM" class="btn btn-primary" />
                                            <div style="display:none"><input type="file" id="txtUploadFile2" /></div>
                                        }
                                        else if (ViewBag.Type == "NTKHA")
                                        {
                                            <input type="button" value="Xuất excel" class="btn btn-info" id="btnExportExcel" />
                                            <input style="width: 50%" onclick="ImportData_NTKHA()" id="btnImportNTKHA" title="Import nợ thu khác" value="Import NTKHA" class="btn btn-primary" />
                                            <div style="display:none"><input type="file" id="txtUploadFile3" /></div>
                                        }
                                        else if (ViewBag.Type == "NHANG")
                                        {
                                            <input type="button" value="Xuất excel" class="btn btn-info" id="btnExportExcel" />
                                            <input style="width: 50%" onclick="ImportData_NHANG()" id="btnImportNHANG" title="Import nợ hãng" value="Import" class="btn btn-primary" />
                                            <div style="display:none"><input type="file" id="txtUploadFile3" /></div>
                                        }
                                        else
                                        {
                                            <input type="button" value="Xuất excel" class="btn btn-info" id="btnExportExcel" />
                                            <input style="width:50%" onclick="ImportData_HoaDon()" id="btnimportData" title="Import hóa đơn" value="Import hóa đơn" class="btn btn-primary" />
                                            <div style="display:none"><input type="file" id="txtUploadFile" /></div>
                                        }


                                    </div>
                                </div>
                                @if (ViewBag.Type == "NNHBX" || ViewBag.Type == "NBHDV"
                                    || ViewBag.Type == "NDIVU" || ViewBag.Type == "NHHBH"
                                    || ViewBag.Type == "NDIVU" || ViewBag.Type == "NPTPK"
                                    || ViewBag.Type == "NTAUN" || ViewBag.Type == "NTKHA"
                                    || ViewBag.Type == "NBAXE" || ViewBag.Type == "NVAMU"
                                    || ViewBag.Type == "NoTMV" || ViewBag.Type == "NHHHB"
                                    || ViewBag.Type == "NHHGP" || ViewBag.Type == "CHIHO"
                                    )
                                {
                                    <div class="col-md-2 col-sm-2 col-xs-12">
                                    </div>
                                    <div class="col-md-2 col-sm-2 col-xs-12">
                                    </div>
                                    <div class="col-md-6 col-sm-6 col-xs-12">
                                        <div class="form-group">
                                            @Html.RadioButton("tinhtrang", "", true, new { id = "All" }) Tất Cả
                                            @*@Html.RadioButton("tinhtrang", "D", false, new { id = "D" }) Đang sử dụng*@
                                            @Html.RadioButton("tinhtrang", "H", false, new { id = "H" }) Hoàn tất
                                            @Html.RadioButton("tinhtrang", "C", false, new { id = "C" }) Chưa hoàn tất
                                        </div>
                                    </div>
                                }
                            </form>
                            <div class="table-responsive" id="@ViewBag.Type">
                                @if (flag || ViewBag.Type == "NHHHB" || ViewBag.Type == "NHHGP"
                                    || ViewBag.Type == "NTKHA" || ViewBag.Type == "NHANG" || ViewBag.Type == "CHIHO")
                                {
                                    <div class="right">
                                        <i class="fa fa-plus" style="cursor:pointer" id="ThemMoi"></i>
                                    </div>
                                }
                                <table class="table">
                                    <thead>
                                        <tr class="success">
                                            <th>STT</th>
                                            @if (flag || ViewBag.Type == "NHHHB" || ViewBag.Type == "NHHGP" || ViewBag.Type == "NTKHA" || ViewBag.Type == "NHANG" || ViewBag.Type == "CHIHO")
                                            {
                                                <th>
                                                    <input type="checkbox" id="CHKALL" />
                                                </th>
                                            }
                                            <th>Ngày nợ</th>
                                            <th>Mã phiếu</th>

                                            @if (ViewBag.Type == "NHHHB")
                                            {
                                                <th>Số khung</th>
                                                <th>Số máy</th>
                                                <th>Nhà cung cấp</th>
                                            }

                                            @if (ViewBag.Type == "NVAMU")
                                            {
                                                <th>Người vay</th>
                                            }
                                            @if (ViewBag.Type == "NBAXE" || ViewBag.Type == "NTAUN")
                                            {
                                                <th>Họ tên</th>
                                            }
                                            @if (ViewBag.Type == "NBATS")
                                            {
                                                <th>Khách hàng</th>
                                                <th>Số điện thoại</th>
                                            }
                                            @if (flag || ViewBag.Type == "NNHBX")
                                            {
                                                <th>@ViewBag.KhachHangNoTitle</th>
                                                <th>Khách hàng</th>
                                                if (ViewBag.Type == "NBHDV")
                                                {
                                                    <th>Số phiếu quyết toán</th>
                                                }
                                                else
                                                {
                                                    <th>Số hợp đồng</th>
                                                }
                                            }
                                            @if (ViewBag.Type == "NDIVU" || ViewBag.Type == "NPTPK")
                                            {
                                                <th>Khách hàng</th>
                                                <th>Biển số</th>
                                                <th>Điện thoại</th>
                                            }
                                            @if (ViewBag.Type == "NBHDV")
                                            {
                                                <th>Biển số</th>
                                            }
                                            @if (ViewBag.Type == "NBAXE")
                                            {
                                                <th>Số hợp đồng</th>
                                                <th>Ngày Thu</th>
                                            }
                                            @if (ViewBag.Type == "NTKHA" || ViewBag.Type == "CHIHO")
                                            {
                                                <th>Số khung</th>
                                                <th>Đối tác</th>
                                                <th>Thông tin khác</th>
                                                <th>Số quyết toán</th>
                                            }
                                            @if (ViewBag.Type == "NHANG")
                                            {
                                                <th>Đối tác</th>
                                                <th>Thông tin khác</th>
                                            }
                                            @*@if (ViewBag.Type == "NHHHB")
                                                {
                                                    <th>Số khung</th>
                                                    <th>Nhà cung cấp</th>
                                                }*@

                                            @if (ViewBag.Type == "NHHGP")
                                            {
                                                <th>Ngân hàng</th>
                                                <th>Khách hàng</th>

                                            }
                                            <th>Nội dung</th>
                                            @if (ViewBag.Type == "NTAUN")
                                            {
                                                <th>Lý do chi</th>
                                            }
                                            @if (ViewBag.Type == "NHHBH")
                                            {
                                                <th>Loại bảo hiểm</th>
                                            }
                                            <th>Số tiền nợ</th>
                                            <th>Đã thanh toán</th>
                                            <th>Còn nợ</th>
                                            @if (ViewBag.Type == "NNHBX" || ViewBag.Type == "NBHDV"
                                                || ViewBag.Type == "NDIVU" || ViewBag.Type == "NHHBH"
                                                || ViewBag.Type == "NDIVU" || ViewBag.Type == "NPTPK"
                                                || ViewBag.Type == "NTAUN" || ViewBag.Type == "NTKHA"
                                                || ViewBag.Type == "NBAXE" || ViewBag.Type == "NVAMU"
                                                || ViewBag.Type == "NoTMV" || ViewBag.Type == "NHHHB"
                                                )
                                            {
                                                <th style="display:@ViewBag.HienThiNguoiBaoLanh">Người bảo lãnh</th>
                                            }

                                            <th>Tình trạng</th>
                                            @if (ViewBag.Type == "NNHBX" || ViewBag.Type == "NBAXE")
                                            {
                                                <th>Hoa hồng</th>
                                                <th>Sales</th>
                                                <th>Ghi chú</th>
                                            }
                                            @if (!flag)
                                            {
                                                <th></th>
                                                <th></th>
                                            }
                                            @if (ViewBag.Type == "NBHDV")
                                            {
                                                <th style="width:200px">Số hóa đơn</th>
                                                <th style="width:200px" title="Ngày xuất hóa đơn">Ngày XHĐ</th>
                                                <th style="width:200px" title="Ngày thao tác trên bên mềm việc xuất hóa đơn">Ngày thao tác XHĐ</th>
                                                <th style="width:200px" title="Ngày xác nhận công nợ">Ngày XNCN</th>
                                                <th style="width:200px" title="Ngày thao tác trên phần mềm ghi nhận công nợ">Ngày thao tác XNCN</th>
                                                <th>Ghi chú</th>
                                            }
                                            @if (ViewBag.Type == "NNHBX")
                                            {
                                                <th></th>
                                            }
                                            else if (ViewBag.Type == "NBHDV")
                                            {
                                                <th></th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@(ViewBag.PageSize * (ViewBag.PageIndex - 1) + i++)</td>

                                                @if (flag || ViewBag.Type == "NHHHB" || ViewBag.Type == "NHHGP" || ViewBag.Type == "NTKHA" || ViewBag.Type == "NHANG" || ViewBag.Type == "CHIHO")
                                                {
                                                    <th>
                                                        @if (item.TinhTrang.Length > 8)
                                                        {
                                                            if (ViewBag.Type == "NBHDV" && item.NgayXacNhanCongNo == null)
                                                            {
                                                                <input type="checkbox" id="chk_@item.MaPhieuNo" value="@item.MaPhieuNo" style="display:none" class="checkbox" />
                                                            }
                                                            else
                                                            {
                                                                <input type="checkbox" id="chk_@item.MaPhieuNo" value="@item.MaPhieuNo" class="checkbox" />
                                                            }
                                                        }
                                                        @if (flag)
                                                        {

                                                            <input type="hidden" value="@(string.IsNullOrEmpty(item.KhachHang) ? "null" : item.KhachHang)" />

                                                        }
                                                        else if (ViewBag.Type == "NHHHB" || ViewBag.Type == "NTKHA" || ViewBag.Type == "NHHGP" || ViewBag.Type == "NHANG" || ViewBag.Type == "CHIHO")
                                                        {
                                                            <input type="hidden" value="@(string.IsNullOrEmpty(item.TenDoiTac) ? "null" : item.TenDoiTac)" />
                                                        }
                                                        else if (ViewBag.Type == "NHHGP")
                                                        {
                                                            <input type="hidden" value="@(string.IsNullOrEmpty(item.Hoten) ? "null" : item.Hoten)" />
                                                        }
                                                    </th>
                                                }
                                                <td class="NgayNo_@item.MaPhieuNo">@item.NgayNo.ToString("dd/MM/yyyy")</td>
                                                <td>@item.MaPhieuNo</td>

                                                @if (ViewBag.Type == "NHHHB")
                                                {
                                                    <td>@item.SoKhung</td>
                                                    <td>@item.SoMay</td>
                                                    <td>@item.TenDoiTac</td>
                                                }
                                                @if (ViewBag.Type == "NVAMU")
                                                {
                                                    <td>@item.KhachHang</td>
                                                }
                                                @if (ViewBag.Type == "NBAXE")
                                                {
                                                    <td>@item.Hoten</td>
                                                }
                                                @if (ViewBag.Type == "NTAUN")
                                                {
                                                    <td>@item.KhachHang</td>
                                                }
                                                @if (ViewBag.Type == "NBATS")
                                                {
                                                    <td>@item.Hoten</td>
                                                    <td>@item.DienThoai</td>
                                                }
                                                @if (flag || ViewBag.Type == "NNHBX")
                                                {

                                                    <td>@item.KhachHang</td>
                                                    if (ViewBag.Type == "NBHDV" || ViewBag.Type == "NNHBX")
                                                    {
                                                        <td>@item.Hoten</td>
                                                    }
                                                    else
                                                    {
                                                        <td>@item.HoTenKH</td>
                                                    }
                                                    if (ViewBag.Type == "NBHDV")
                                                    {
                                                        <td>@item.SoHopDong</td>
                                                    }
                                                    else
                                                    {
                                                        if (@item.SoHopDong != null && @item.SoHopDong != "")
                                                        {
                                                            <td>@item.SoHopDong</td>
                                                        }
                                                        else
                                                        {
                                                            <td>@item.ChungTuThu</td>
                                                        }
                                                    }
                                                }
                                                @if (ViewBag.Type == "NDIVU" || ViewBag.Type == "NPTPK")
                                                {
                                                    <td>@item.Hoten</td>
                                                    <td>@item.BienSo</td>
                                                    <td>@item.DienThoai</td>
                                                }
                                                @if (ViewBag.Type == "NBHDV")
                                                {
                                                    <td>@item.BienSo</td>
                                                }
                                                @if (ViewBag.Type == "NBAXE")
                                                {
                                                    <td>@item.SoHopDong</td>
                                                    <td>@item.NgayThu.ToString("yyyy/MM/dd")</td>
                                                }
                                                @if (ViewBag.Type == "NTKHA" || ViewBag.Type == "CHIHO")
                                                {
                                                    <td>@item.SoKhung</td>
                                                    <td>@item.TenDoiTac</td>
                                                    <td>@item.ThongTinKhac</td>
                                                    <td>@item.SoQuyetToanDV</td>
                                                }
                                                @if (ViewBag.Type == "NHANG")
                                                {
                                                    <td>@item.TenDoiTac</td>
                                                    <td>@item.ThongTinKhac</td>
                                                    @*<td>@item.LoaiThanhToanHang</td>*@
                                                }
                                                @*@if (ViewBag.Type == "NHHHB")
                                                    {
                                                        <td>@item.SoKhung</td>
                                                        <td>@item.DonViNo</td>
                                                    }*@

                                                @if (ViewBag.Type == "NHHGP")
                                                {
                                                    if (item.MaPhieuPhatSinh.Contains("TBAXE") == true)
                                                    {
                                                        <td>@item.TenDoiTac</td>
                                                        <td>@item.Hoten</td>
                                                    }
                                                    else
                                                    {
                                                        <td>@item.Hoten</td>
                                                        <td>@item.KhachHang</td>
                                                    }
                                                }

                                                <td>@item.NoiDung</td>
                                                @if (ViewBag.Type == "NTAUN")
                                                {
                                                    switch (item.LyDoChi)
                                                    {
                                                        case "CP":
                                                            <td>Chi Phí</td>
                                                            break;
                                                        case "GCN":
                                                            <td>Gia Công Ngoài</td>
                                                            break;
                                                        case "VTX":
                                                            <td>Vật Tư Xưởng</td>
                                                            break;
                                                        case "GTX":
                                                            <td>Giấy Tờ Xe</td>
                                                            break;
                                                        case "KHAC":
                                                            <td>Khác</td>
                                                            break;
                                                        default:
                                                            <td></td>
                                                            break;
                                                    }
                                                }
                                                @if (ViewBag.Type == "NHHBH")
                                                {
                                                    if (item.LoaiNo == "KM")
                                                    {
                                                        <td>Khuyến mãi</td>
                                                    }
                                                    else
                                                    {
                                                        <td>Thu hộ</td>
                                                    }
                                                }
                                                @if (ViewBag.Type == "NHHGP" && item.SoTienDaTra == 0 && (item.IsActive == true || ViewBag.IsPTC == true))
                                                {
                                                    <td><input id="STN_@item.MaPhieuNo" class="form-control input-sm number" value="@TNK.Core.Common.ToCurrencyString(item.SoTienNo)" style="width:100%" /> </td>
                                                }
                                                else
                                                {
                                                    <td class="number2">@TNK.Core.Common.ToCurrencyString(item.SoTienNo)</td>
                                                }
                                                <td class="number2 soTienDaTra_@item.MaPhieuNo">
                                                    @TNK.Core.Common.ToCurrencyString(item.SoTienDaTra)
                                                    <input id="soTienDaTra_@item.MaPhieuNo" type="hidden" value="@item.SoTienDaTra" />

                                                </td>
                                                <td class="number2">@TNK.Core.Common.ToCurrencyString(item.SoTienConLai)</td>
                                                @if (ViewBag.Type == "NNHBX" || ViewBag.Type == "NBHDV"
                                                    || ViewBag.Type == "NDIVU" || ViewBag.Type == "NHHBH"
                                                    || ViewBag.Type == "NDIVU" || ViewBag.Type == "NPTPK"
                                                    || ViewBag.Type == "NTAUN" || ViewBag.Type == "NTKHA"
                                                    || ViewBag.Type == "NBAXE" || ViewBag.Type == "NVAMU"
                                                    || ViewBag.Type == "NoTMV" || ViewBag.Type == "NHHHB"
                                                    )
                                                {
                                                    <td style="display:@ViewBag.HienThiNguoiBaoLanh">@item.NguoiBaoLanh</td>
                                                }


                                                @if (!string.IsNullOrEmpty(item.MaPhieuThu))
                                                {
                                                    <td style="width:5%" class="center">
                                                        <a href="/SoThu/ThuNoEdit/@item.MaPhieuThu?type=@ViewBag.Type" style="color:blue;" title="Xem chi tiết phiếu thu nợ">
                                                            @item.TinhTrang
                                                        </a>
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td>@item.TinhTrang</td>
                                                }
                                                @if (ViewBag.Type == "NNHBX" || ViewBag.Type == "NBAXE")
                                                {
                                                    <td>@TNK.Core.Common.ToCurrencyString(item.HoaHong ?? 0.0)</td>
                                                    <td><input id="Sales_@item.MaPhieuNo" class="form-control input-sm" value="@item.Sales" style="width:100%" /></td>
                                                    <td><input id="GhiChu_@item.MaPhieuNo" class="form-control input-sm" value="@item.GhiChu" style="width:100%" /></td>
                                                }
                                                @*@if (!flag && ViewBag.Type != "NTKHA")
                                                    {
                                                        <td style="width:5%" class="center">
                                                            @if (item.SoTienConLai > 0)
                                                            {
                                                                <a href="/SoThu/ThuNoCreate/@item.MaPhieuNo?type=@ViewBag.Type"><i title="Tạo phiếu thu nợ" class="fa fa-plus"></i></a>
                                                            }
                                                        </td>
                                                    }*@
                                                @if (ViewBag.Type == "NPTPK" || ViewBag.Type == "NDIVU" || ViewBag.Type == "NBHDV")
                                                {
                                                    if (item.SoTienConLai > 0 && item.NgayXacNhanCongNo != null)
                                                    {
                                                        <td style="width:5%" class="center">
