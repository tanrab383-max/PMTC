@model TNK.Model.SoThuModel
@{
    var item = Model.Item;
}

<div class="page-title">
    <div class="title_left">
        <h3> @ViewBag.Title</h3>
    </div>
</div>
<div class="clearfix"></div>

<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_panel">
            <div class="x_title">
                <h2><b>Thông tin hóa đơn</b></h2>
                <ul class="nav navbar-right panel_toolbox">
                    <li>
                        <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                    </li>
                </ul>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">
                <form id="form-data" method="post" class="form-horizontal form-label-left FormPhieuChi">
                    @try
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        @Html.HiddenFor(x => item.MaLoaiPhieu)
                        @Html.HiddenFor(x => item.MaPhieuThu)
                        @Html.HiddenFor(x => item.MaPhieuLienQuan)
                        @Html.HiddenFor(x => item.UpdatedDate)
                        <input hidden type="text" id="type" value="@item.MaLoaiPhieu" />
                        <input type="hidden" name="ChuoiUpdatedDate" value="@ViewBag.ChuoiUpdatedDate" />
                        <div class="row">
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Số chứng từ (*)</label>
                                    @Html.EditorFor(x => item.SoChungTu, new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "15", @required = "" } })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Ngày thu</label>
                                    <input type="text" class="form-control input-sm date1 " name="item.NgayThu" value="@item.NgayThu.ToString("dd/MM/yyyy")" />
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Đối tác</label>
                                    @Html.DropDownListFor(x => item.DoiTac, Model.DoiTac.Select(x => new SelectListItem { Text = x.TenDoiTac, Value = x.MaVietTat }), "Chọn", new { @class = "select2 fullwidth" })
                                </div>
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12">
                                @Html.Partial("~/Views/Shared/_ThanhToan_1.cshtml", null, new ViewDataDictionary { { "CTPT", Model.CTPT }, { "HTTT", Model.HTTT } })
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label>Ghi chú</label>
                                    @Html.TextAreaFor(x => item.GhiChu, new { @class = "form-control input-sm " })
                                </div>
                            </div>
                            @*@Html.Partial("~/Views/Common/UserComfirm.cshtml", null, new ViewDataDictionary { { "User", Model.Users } })*@
                            <div class="row">
                                <div class="col-md-3 col-sm-3 col-xs-12">
                                    <div class="form-group">
                                        <label>Kế toán trưởng</label>
                                        @Html.DropDownListFor(x => item.KeToanTruong, Model.Users.Select(x => new SelectListItem { Text = x.UserName, Value = x.UserId.ToString() }), "Chọn", new { @class = "select2 fullwidth" })
                                    </div>
                                </div>
                                <div class="col-md-3 col-sm-3 col-xs-12">
                                    <div class="form-group">
                                        <label>Người lập phiếu</label>
                                        @Html.DropDownListFor(x => item.NguoiLapPhieu, Model.Users.Select(x => new SelectListItem { Text = x.UserName, Value = x.UserId.ToString() }), "Chọn", new { @class = "select2 fullwidth" })
                                    </div>
                                </div>
                                <div class="col-md-3 col-sm-3 col-xs-12">
                                    <div class="form-group">
                                        <label>Người nộp tiền</label>
                                        @Html.DropDownListFor(x => item.NguoiNopTien, Model.Users.Select(x => new SelectListItem { Text = x.UserName, Value = x.UserId.ToString() }), "Chọn", new { @class = "select2 fullwidth" })
                                    </div>
                                </div>
                                <div class="col-md-3 col-sm-3 col-xs-12">
                                    <div class="form-group">
                                        <label>Người thu tiền (*)</label>
                                        @Html.DropDownListFor(x => item.NguoiThuTien, Model.Users.Select(x => new SelectListItem { Text = x.UserName, Value = x.UserId.ToString() }), "Chọn", new { @class = "select2 fullwidth" })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="ln_solid"></div>
                        <div class="form-group center">
                            <div class="col-md-6 col-sm-6 col-xs-12 col-md-offset-3">
                                <input type="submit" value="Lưu" class="btn btn-success" />
                            </div>
                        </div>
                        <div class="ln_solid"></div>
                    }
                    catch (Exception ex)
                    {
                        Console.Write(ex.ToString());
                    }
                </form>
            </div>
        </div>
    </div>
</div>
@section scripts
{
    <script src="~/Scripts/IndexCommon.js"></script>
    <link href="~/assests/plugins/select2/select2.css" rel="stylesheet" />
    <link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <script src="~/Scripts/jquery-ui.js"></script>
    <script src="~/assests/plugins/select2/select2.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/SoThuCommon.js"></script>
    <script>

        $(document).ready(function () {
            var Mang = new Array();
            $(function () {
                $.ajax({
                    url: "/SoChi/AutoComplete",
                    type: "POST",
                    dataType: "json",
                    success: function (data) {
                        for (var i = 0; i < data.length; i++) {
                            Mang.push(data[i]);
                        }
                        return Mang;
                    }
                });
                $("#auto_complete").autocomplete({
                    source: Mang
                });
            });
        });

        var conlai = @item.ConLai;
        $("#form-data").submit(function () {
            var lst = $(".number,.number2");
            lst.map(function (key, val) {
                $(val).val($(val).val().split(",").join(""));
            });
        })
        $(document).on("change", ".number", function () {
            var val = $(this).val();
            if (val != "") {
                val = val.split(",").join("");
                val = parseInt(val);
                //   val = val * 1000;
                $(this).val(val.toLocaleString('en-us'));
            }
            else {
                $(this).val(0);
            }
            Cal();
        });

        function Cal()
        {
            debugger;
            let total = 0;
            $("table").find(".number").map(function (key, val) {
                let number = $(this).val();
                if (number != "") {
                    number = number.split(",").join("");
                    number = parseInt(number);
                    total += number;
                    $(".Total").html(total.toLocaleString('en-us'));
                }
            });
            $(".ConLai").val((conlai-total).toLocaleString('en-us'));
            $(".ConLai").html((conlai-total).toLocaleString('en-us'));
        }
        i = '@Model.CTPT.Count';
        $(".addHTTT").click(function () {
            var html = tr.split("httt[0]").join("httt[" + i + "]");
            @if(Model.CTPT.Count>0)
            {
             @Html.Raw("html=html.replace('" + Model.CTPT[0].Id+"','');")
             @Html.Raw("html=html.replace('" + Model.CTPT[0].SoTienThanhToan+"','');")
             @Html.Raw("html=html.replace('selected','');")
             @Html.Raw("html=html.replace('" + Model.CTPT[0].SoThamChieu + "','');")
            }
            $("#tbody").append("<tr>" + html + "</tr>");
            i++;
            setTimeout(function () {
                $('.select2').select2({
                    placeholder: "Select an option",
                    allowClear: true
                });
                removeSelect();
            }, 200);
        })
    </script>
}



