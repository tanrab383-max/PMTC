@section scripts
{
    <link href="~/assests/plugins/select2/select2.css" rel="stylesheet" />
    <script src="~/assests/plugins/select2/select2.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/SoThuCommon.js"></script>
    <style>
        .changeType {
            cursor: pointer;
        }
    </style>
    <script>
        function SetSubmitType(value) {

            $("#submitType").val(value);
        }
        function OnChecked() {
            var LBH = $("#LoaiBH").prop('checked') == true ? "XKG" : "";
            $("#LoaiBaoHiem").val(LBH);
        }
        $("#form-data").submit(function () {
            Cal();
            let flag = true;
            $("#tbody").find("tr").map(function (key, val) {
                if ($(val).is(":visible")) {
                    var tuitien = $(val).find(".Temp").select2('val');
                    var sotien = $(val).find(".number").val().split(",").join("");
                    tuitien = tuitien == "Chọn" ? "" : tuitien;
                    sotien = sotien == "" ? 0 : parseInt(sotien);
                    if (tuitien != "" && sotien === 0) {
                        toastWarning("Vui lòng nhập số tiền");
                        $(val).find(".number").focus();
                        flag = false;
                        return;
                    }
                    if (tuitien == "" && sotien != 0) {
                        toastWarning("Vui lòng nhập túi tiền");
                        $(val).find(".Temp").focus();
                        flag = false;
                        return;
                    }
                }
            })
            if (!flag) {
                return false;
            }

            //if (totalresult > 0 && $("#NguoiBaoLanh").val() == "") {
            //    toastWarning("Vui lòng nhập thông tin Người bảo lãnh.");
            //    $("#NguoiBaoLanh").focus();
            //    return false;
            //}

            if (CheckValidatePhieuDichVu() == false)
                return false;


            if (CheckValidateThongTinNguoiThanhToan_PhieuThu() == false)
                return false;
            var lst = $(".number");
            lst.map(function (key, val) {
                $(val).val($(val).val().split(",").join(""));
            });
        })
        i = '@Model.CTPT.Count';
        $(".addHTTT").click(function () {
            var html = tr.split("httt[0]").join("httt[" + i + "]");
            @if(Model.CTPT.Count>0)
            {
             @Html.Raw("html=html.replace('" + Model.CTPT[0].Id+"','');")
             @Html.Raw("html=html.replace('" + Model.CTPT[0].SoTienThanhToan+"','');")
             @Html.Raw("html=html.replace('selected','');")
             @Html.Raw("html=html.replace('" + Model.CTPT[0].SoThamChieu + "','');")
            }
            $("#tbody").append("<tr>" + html + "</tr>");
            i++;
            setTimeout(function () {
                $('.select2').select2({
                    placeholder: "Select an option",
                    allowClear: true
                });
                removeSelect();
            }, 200);
        })
        function Remove(a) {
            var tr = $(a.closest("tr"));
            tr.find(".IsDeleted").val("true");
            tr.html(tr.html().split("required").join(""));
            tr.hide();
            Cal();
        }
        var tongTienPhaiThuDaCoVAT = parseInt('@(ViewBag.TongThucThuSauVAT)');
        var totalresult = 0;
        Cal();
        //tinh toa lai so tien con no
        function Cal() {
            setTimeout(function () {

                var soTienNo = tongTienPhaiThuDaCoVAT;
                var tienThanhToan = 0;
                $("#tbody").find("tr").map(function (key, val) {
                    if ($(val).is(":visible")) {
                        var isDeleted = $(val).find(".IsDeleted").val();
                        if (isDeleted != "true") {
                            var sotien = parseInt($(val).find(".number").val().split(",").join(""));
                            if (isNaN(sotien))
                                sotien = 0;
                            tienThanhToan += sotien;
                        }
                    }
                });
                //tru di so tien thanh toan tu bao hiem, coc, thanh toan ngan hang
                $(".SoTienThanhToan").map(function (key, val) {
                    if ($(val).is(":visible")) {
                        let number = $(this).val();
                        if (number != "") {
                            var num = $(val).val().split(",").join("");
                            if (num != "") {
                                num = parseInt(num);
                                if (isNaN(num))
                                    num = 0;
                                soTienNo = soTienNo - num;
                            }
                        }
                    }
                });
                //set so tien thanh toan vao tong cong thanh toan
                $("#ThanhToan").find(".Total").html(tienThanhToan.toLocaleString('en-us'));
                //set so tien con no tren form
                $("#Total").html(soTienNo.toLocaleString('en-us'));
                //set so tien con no vao hidden truyen len action
                $("#NPT_SoTienNo").val(soTienNo);

            }, 100);
        }
        $("td.number").map(function (key, val) {
            var val = $(this).html();
            val = val.split(",").join("");
            val = parseInt(val);
            $(this).html(val.toLocaleString('en-us'));
        })
        $(document).on("change", ".number", function () {
            var val = $(this).val();
            if (val != "") {
                val = val.split(",").join("");
                val = parseInt(val);
                $(this).val(val.toLocaleString('en-us'));
            }
            else {
                $(this).val(0);
            }
            //let total = 0;  //thang moi bo o day
            Cal();
        });
        function calCoc(a) {
            //var num = $(a).val().split(",").join("");
            //var tot = $(a).closest("tr").find(".SoTienCoTheSuDung").val().split(",").join("");
            //$(a).closest("tr").find(".SoTienConLai").val((tot - num).toLocaleString('en-us'));
            //Cal();
            setTimeout(function () {
                var stsd = $(a).val();
                stsd = stsd.split(",").join("");
                var stctsd = $(a).closest("tr").find(".SoTienCoTheSuDung").val().split(",").join("");
                if (stctsd - stsd < 0) {
                    toastError("Số tiền sử dụng cọc không được lớn hơn số tiền có thể sử dụng.Vui lòng nhập lại.");
                    $(a).focus();
                    $(a).val(0);
                    $(a).closest("tr").find(".SoTienConLai").val(stctsd);
                }
                else
                    $(a).closest("tr").find(".SoTienConLai").val((stctsd - stsd).toLocaleString('en-us'));
            }, 100);
            Cal();
        }
        var selected = {};
        var a;
        $.contextMenu({
            selector: '.changeType',
            callback: function (key, options) {
                selected = $(this);
                if (key != "SuaChua") {
                    $(selected).find(".numberGCN").hide();
                }
                else {
                    $(selected).find(".numberGCN").show();
                }
                $(selected).find(".PhanLoai").val(key);
                var html = "<tr class='changeType'>" + $(selected).html() + "</tr>";
                $("." + key).append(html);
                $(selected).remove();
                CalChange();
            },
            items: {
                "SuaChua": { name: "Sửa chữa chung" },
                "KHO_DS": { name: "Đồng sơn - sơn xe" },
                "KHO_PTT": { name: "Phụ tùng trong" },
                "KHO_PTN": { name: "Phụ tùng ngoài" },
                "KHO_PKDV": { name: "Phụ kiện dịch vụ" },
            }
        });
