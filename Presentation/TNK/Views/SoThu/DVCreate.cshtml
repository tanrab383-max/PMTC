        $("#txtSoPhieu").focusout(function () {
            GetInfoTicket();
        })

        function KeyEnter(e) {
            if (e.keyCode == 13) {
                GetInfoTicket();
            }
        }

        function GetInfoTicket() {
            debugger;
            var strTicket = $("#txtSoPhieu").val().trim();
            if (strTicket.length > 0) {
                $.ajax({
                    url: "/SoThu/GetInfoTicketDV",
                    type: "POST",
                    data: { "strSoPhieu": strTicket },
                    success: function (result) {
                        if (!result.IsError) {
                            window.location.href = "/SoThu/" + result.Message;
                        }
                        else {
                            toastWarning(result.Message);
                            window.location.href = "/SoThu/DVCreate_New_V2?id=" + encodeURIComponent(strTicket);
                        }
                    },
                    error: function (result) {
                        $("#txtSoPhieu").focus();
                        toastWarning("Lỗi: Tìm kiếm số phiếu.");
                    }
                });
            }
            else{
                toastWarning("Vui lòng nhập số phiếu dịch vụ.");
            }
        }

        function ChangeType(result) {
            debugger;
            if (result == "SuaChua" && selected.find(".numberGCN").prop('readOnly', true)) {
                return;
            }
            if (result != "SuaChua") {
                selected.find(".numberGCN").hide();
            }
            else {
                selected.find(".numberGCN").show();
            }

            selected.find(".PhanLoai").val(result);
            var html = "<tr class='changeType'>" + selected.html() + "</tr>";
            $("." + result).append(html);
            selected.remove();
            CalChange();
        }
        $(document).on("click", "#ChangeType", function () {

            var result = $("#selectType").val();
            if (result != "SuaChua") {
                selected.find(".numberGCN").hide();
            }
            else {
                selected.find(".numberGCN").show();
            }
            selected.find(".PhanLoai").val(result);
            var html = "<tr class='changeType'>" + selected.html() + "</tr>";
            $("." + result).append(html);
            selected.remove();
            CalChange();
        })

        function CalThanhToanGCN() {
            setTimeout(function () {
                var table = $(".SuaChua").closest("table");
                result = 0;
                $(table).find(".numberGCN").map(function (key, val) {
                    result += parseInt($(val).val().split(",").join(""));
                })
                $(table).find(".Total").html(result.toLocaleString('en-us'));
            }, 300);
        }
        var arr = "SuaChua,KHO_DS,KHO_PTT,KHO_PTN,KHO_PKDV".split(",");
        function CalChange() {
            arr.map(function (val, key) {
                giaban = 0;
                giamgia = 0;
                thucthu = 0;
                $("." + val).find("tr").map(function (key, val) {
                    var number = $(val).find("td.number");
                    giaban += parseInt($(number[0]).html().split(",").join(""));
                    giamgia += parseInt($(number[1]).html().split(",").join(""));
                    thucthu += parseInt($(number[2]).html().split(",").join(""));
                })
                var result = $("." + val).closest("table").find("tfoot").find("td.number");
                $(result[0]).html(giaban.toLocaleString('en-us'))
                $(result[1]).html(giamgia.toLocaleString('en-us'))
                $(result[2]).html(thucthu.toLocaleString('en-us'))
            })
            CalThanhToanGCN();
        }

    </script>

