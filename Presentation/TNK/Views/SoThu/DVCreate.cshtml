@model TNK.Model.DichVuModel
@{
    ViewBag.Title = "Phiếu dịch vụ";
    double TongGiaBan = 0;
    double TongGiamGia = 0;
    double TongThucThu = 0;

    double TongGiaBanVAT = 0;
    double TongGiamGiaVAT = 0;
    double TongThucThuVAT = 0;

    double TongGiaBanSauVAT = 0;
    double TongGiamGiaSauVAT = 0;
    double TongThucThuSauVAT = 0;
    var item = new TNK.Core.Domain.REPAIR_ORDER_PYS();
    if (Model.lst.Count > 0)
    {
        item = Model.lst[0];
        foreach (TNK.Core.Domain.REPAIR_ORDER_PYS i in Model.lst)
        {

            i.COST = Math.Round(i.COST, 0);
            i.DISCOUNT = Math.Round(i.DISCOUNT.Value, 0);

            TongGiaBan += i.COST;
            TongGiamGia += i.DISCOUNT.Value;
            TongThucThu += i.COST - i.DISCOUNT.Value;
        }
    }


    TongGiaBanVAT = Math.Round(0.1 * TongGiaBan);
    TongGiamGiaVAT = Math.Round(0.1 * TongGiamGia);
    TongThucThuVAT = Math.Round(0.1 * TongThucThu);

    TongGiaBanSauVAT = Math.Round(1.1 * TongGiaBan);
    TongGiamGiaSauVAT = Math.Round(1.1 * TongGiamGia);
    TongThucThuSauVAT = Math.Round(1.1 * TongThucThu);

    var suachuachung = Model.lst.Where(x => x.ROTYPE == "GJ" && x.WTCODE == "J").ToList();
    var dongsonsonxe = Model.lst.Where(x => x.ROTYPE == "BP" && (x.KPI_PART_TYPE == null)).ToList();//chỉnh lại do quy tắt lấy đồng sơn ban đầu bị sai so vơi hiện tại. Nếu x.KPI_PART_TYPE == null thì mơi là Đồng sơn
    string[] ptt = { "KEY PRODUCTS", "GP", "OIL", "CHEMICALS", "PART_GENUINE_OTHER", "ACC", "BODY PARTS", "Y" /*Cho phieu ban phu tung GENUINE = 'Y'*/ };
    var phutungtrong = Model.lst.Where(x => ptt.Contains(x.KPI_PART_TYPE)).ToList();
    string[] ptn = { "PART_NON_GENUINE", "N" /*Cho phieu ban phu tung GENUINE = 'N'*/};
    var phutungngoai = Model.lst.Where(x => ptn.Contains(x.KPI_PART_TYPE)).ToList();
    var phukiendichvu = Model.lst.Where(x => (x.ROTYPE != "GJ" || x.WTCODE != "J")
                                && !(x.ROTYPE == "BP" && (x.KPI_PART_TYPE == null))
                                && !ptt.Contains(x.KPI_PART_TYPE) && !ptn.Contains(x.KPI_PART_TYPE)).ToList();
    var noPhaiTra = Model.noPhaiTra;
    var z = 0;
    double tongcong = 0;
}
