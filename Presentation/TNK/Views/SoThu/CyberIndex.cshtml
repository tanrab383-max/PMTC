@model List<TNK.Core.Domain.View.ViewPhieuThuCyber>
@{
    int i = 1;
    var flag = ViewBag.Type == "NBHDV" || ViewBag.Type == "NHHBH";
    var count = Model.Count;
    //var ModelGiaiTrinh = ViewBag.ModelGiaiTrinh;
    var activeSearch = ViewBag.Submit == "Search" ? "active" : "";
    var activeGiaiTrinh = ViewBag.Submit == "SearchGiaiTrinh" ? "active" : "";
}
<link href="~/Content/test.css" rel="stylesheet" />
<link href="~/assests/css/loading.css" rel="stylesheet" />
<div class="page-title">
    <div class="title_left">
        <h3>@ViewBag.Title</h3>
    </div>
</div>
<div class="clearfix"></div>
<div class="row">
    <div class="col-md-12">
        <div class="tabbable-line boxless tabbable-reversed">
            <div class="x_panel">
                <div class="x_content">
                    <form method="get" class="row">
                        <div class="col-md-2 col-sm-2 col-xs-12">
                            <div class="form-group">
                                <label>Từ ngày thu</label>
                                <input type="text" class="form-control input-sm date" value="@ViewBag.From" name="from" id="FromDate" />
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-2 col-xs-12">
                            <div class="form-group">
                                <label>Đến ngày thu</label>
                                <input type="text" class="form-control input-sm date" value="@ViewBag.To" name="to" id="ToDate" />
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-2 col-xs-12">
                            <div class="form-group">
                                <label>Loại thu</label><br />
                                <select style="height: 30px;" class="form-control" name="typeSearch" id="typeSearch">
                                    <option value="">Chọn</option>
                                    @*<option value="TDIVU" @(ViewBag.TypeSearch == "TDIVU" ? "selected" : "")>Thu dịch vụ</option>*@
                                    <option value="TCODV" @(ViewBag.TypeSearch == "TCODV" ? "selected" : "")>Thu cọc dịch vụ</option>
                                    <option value="TCOBX" @(ViewBag.TypeSearch == "TCOBX" ? "selected" : "")>Thu cọc bán xe</option>
                                    @*<option value="TPHKI" @(ViewBag.TypeSearch == "TPHKI" ? "selected" : "")>Thu phụ kiện</option>*@
                                    @*<option value="TBAXE" @(ViewBag.TypeSearch == "TBAXE" ? "selected" : "")>Thu bán xe</option>
                                    <option value="TBAHI" @(ViewBag.TypeSearch == "TBAHI" ? "selected" : "")>Thu bảo hiểm</option*@>
                                </select>

                            </div>
                        </div>

                        <div class="col-md-5 col-sm-5 col-xs-12">
                            <div class="form-group">
                                <label>Từ khóa</label>
                                <input autocomplete="off" type="text" title="@ViewBag.SearchHolder" placeholder="@ViewBag.SearchHolder" class="form-control input-sm " value="@ViewBag.Query" name="query" id="query" />
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12">
                            <div class="form-group">
                                <br />
                                <input type="submit" value="Tìm kiếm" id="submit" title="Tìm kiếm phiếu thu Cyber" class="btn btn-success" />
                                <input type="button" value="Xuất excel" class="btn btn-info" id="exportExcel" />
                                @*<input style="width:50%" onclick="ImportData_HoaDon()" id="btnimportData" title="Import hóa đơn" value="Import hóa đơn" class="btn btn-primary" />
                <div style="display:none"><input type="file" id="txtUploadFile" /></div>*@
                            </div>
                        </div>
                    </form>
                    <div class="table-responsive" id="@ViewBag.Type">
                        @*ImportData_HoaDon*@
                        <div class="right" style="margin-bottom: 10px">
                            <select id="type" class="select2-active" style="height: 25px">
                                <option value="">Chọn loại phiếu</option>
                                @*<option value="TDIVU" @(ViewBag.TypeSearch == "TDIVU" ? "selected" : "")>Thu dịch vụ</option>*@
                                <option value="TCODV" @(ViewBag.TypeSearch == "TCODV" ? "selected" : "")>Thu cọc dịch vụ</option>
                                <option value="TCOBX" @(ViewBag.TypeSearch == "TCOBX" ? "selected" : "")>Thu cọc bán xe</option>
                                @*<option value="TPHKI" @(ViewBag.TypeSearch == "TPHKI" ? "selected" : "")>Thu phụ kiện</option>
                                <option value="TBAXE" @(ViewBag.TypeSearch == "TBAXE" ? "selected" : "")>Thu bán xe</option>
                                <option value="TBAHI" @(ViewBag.TypeSearch == "TBAHI" ? "selected" : "")>Thu bảo hiểm</option>*@
                            </select>
                            <i class="fa fa-plus" style="cursor:pointer" id="ThemMoi"></i>
                        </div>
                        <div id="tbody">
                            <table class="table">
                                <thead>
                                    <tr class="success">
                                        <th>STT</th>
                                        <th>
                                            <input type="checkbox" id="CHKALL" />
                                        </th>
                                        <th>Ngày thu</th>
                                        <th>Mã loại thu</th>
                                        <th>Loại thu</th>
                                        <th>Số chứng từ</th>
                                        <th>Khách hàng</th>
                                        <th>Số hợp đồng</th>
                                        <th>Số khung</th>
                                        <th>Biển số</th>
                                        <th>Nội dung</th>
                                        <th>Tổng cộng</th>
                                        <th>Chi tiết thanh toán</th>
                                        <th>Mã tài khoản đích</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@(ViewBag.PageSize * (ViewBag.PageIndex - 1) + i++)</td>
                                            <td>
                                                <input type="checkbox" id="chk_@item.SttRec" value="@item.SttRec" class="checkbox" />
                                            </td>
                                            <td class="NgayNo_@item.NgayThu">@item.NgayThu.ToString("dd/MM/yyyy")</td>
                                            <td>@item.Ma_LoaiThu</td>
                                            <td>@item.Ten_LoaiThu</td>
                                            <td>@item.SoChungTu</td>
                                            <td>@item.HoTen</td>
                                            <td>@item.SohopDong</td>
                                            <td>@item.So_Khung</td>
                                            <td>@item.BienSo</td>
                                            <td>@item.NoiDung</td>
                                            <td>@TNK.Core.Common.ToCurrencyString(item.TongCong)</td>
                                            <td>@item.ThanhToan</td>
                                            <td>@item.MaTaiKhoan</td>
                                        </tr>
                                        //i++;
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="right">
                            @Html.Partial("~/Views/Shared/_Paging_v2.cshtml")
                        </div>
                    </div>
                </div>

            </div>
        </div>
        <div class="clearfix"></div>
    </div>
</div>
<div id="CalenderModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" style="width:30%">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
        <div class="modal-content">
            <div class="modal-body" id="tsts">
                <div class="row">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true" hidden>×</button>
                    <div class="col-md-12 col-sm-12 col-xs-12" style="background-color:lightseagreen;border-radius:12px">
                        <h2 style="text-align:center; color:white" id="lblPopup">XÁC NHẬN ĐỒNG BỘ</h2>
                        <h4 style="text-align:center; color:white" id="loaiphieu"></h4>
                    </div>
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <hr style="border-top: 1px dotted" />
                    </div>

                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <div class="row">
                            <div class="col-md-12 col-sm-12 col-xs-12 chi" hidden style="margin-top: 10px" id="TaiTuc">
                                <div class="col-md-3 col-sm-3 col-xs-3">
                                    <label class="control-label"><I><U>Tái Tục</U></I></label>
                                </div>
                                <div class="col-md-9 col-sm-9 col-xs-9">
                                    <select class="select2 fullwidth" style="height:25px;" id="optTT">
                                        <option value="">Chọn</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12 chi" hidden style=" margin-top: 10px" id="CTBH">
                                <div class="col-md-3 col-sm-3 col-xs-3">
                                    <label class="control-label" id="lbdoitac"><I><U>Công ty bảo hiểm:</U></I></label>
                                </div>
                                <div class="col-md-9 col-sm-9 col-xs-9">
                                    <select class="select2 fullwidth" style="height:25px;" id="optCTBH">
                                        <option value="">- Chọn - </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12 chi" hidden id="DoiTac">
                                <div class="col-md-3 col-sm-3 col-xs-3">
                                    <label class="control-label"><I><U>Đối tác: </U></I></label>
                                </div>
                                <div class="col-md-9 col-sm-9 col-xs-9">
                                    <select class="select2 fullwidth" style="height:25px;" id="optDT">
                                        <option value="">- Chọn - </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12 chi" style="margin-top: 10px" id="Loai" hidden>
                                <div class="col-md-3 col-sm-3 col-xs-3">
                                    <label class="control-label"><I><U>Loại thu khác:</U></I></label>
                                </div>
                                <div class="col-md-9 col-sm-9 col-xs-9">
                                    <select class="select2 fullwidth" style="height:25px;" id="optLoai">
                                        <option value="">- Chọn - </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12 chi" style="margin-top: 10px" id="MLX" hidden>
                                <div class="col-md-3 col-sm-3 col-xs-3">
                                    <label class="control-label"><I><U>Mã loại xe:</U></I></label>
                                </div>
                                <div class="col-md-9 col-sm-9 col-xs-9">
                                    <select class="select2 fullwidth" style="height:25px;" id="optMLX">
                                        <option value="">- Chọn - </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12 chi" hidden style=" margin-top: 10px" id="MX">
                                <div class="col-md-3 col-sm-3 col-xs-3">
                                    <label class="control-label" id="lbdoitac"><I><U>Mã xe:</U></I></label>
                                </div>
                                <div class="col-md-9 col-sm-9 col-xs-9">
                                    <select class="select2 fullwidth" style="height:25px;" id="optMX">
                                        <option value="">- Chọn - </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12 chi" hidden style=" margin-top: 10px" id="MauXe">
                                <div class="col-md-3 col-sm-3 col-xs-3">
                                    <label class="control-label" id="lbdoitac"><I><U>Màu xe:</U></I></label>
                                </div>
                                <div class="col-md-9 col-sm-9 col-xs-9">
                                    <select class="select2 fullwidth" style="height:25px;" id="optMauXe">
                                        <option value="">- Chọn - </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12 chi" hidden id="DVCV">
                                <div class="col-md-3 col-sm-3 col-xs-3">
                                    <label class="control-label"><I><U>Đơn vị cho vay: </U></I></label>
                                </div>
                                <div class="col-md-9 col-sm-9 col-xs-9">
                                    <select class="select2 fullwidth" style="height:25px;" id="optDVCV">
                                        <option value="">- Chọn - </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12 chi" hidden id="DTTL">
                                <div class="col-md-3 col-sm-3 col-xs-3">
                                    <label class="control-label"><I><U>Đối tác trả lãi: </U></I></label>
                                </div>
                                <div class="col-md-9 col-sm-9 col-xs-9">
                                    <select class="select2 fullwidth" style="height:25px;" id="optDTTL">
                                        <option value="">- Chọn - </option>
                                    </select>
                                </div>
                            </div>

                        </div>
                    </div>
                    @*Button*@
                    <div class="col-md-12 col-sm-12 col-xs-12 center" style="margin-top:30px;">
                        <label class="control-label"><I><U>(Chọn thêm giá trị nếu cần thiết) </U></I></label>
                        </div>
                        <div class="col-md-12 col-sm-12 col-xs-12 center" style="margin-top:30px;">
                            <div id="id1">
                                <button class="btn btn-primary" onclick="DongBoPhieuThuCyber()" type="button" value="1">Lưu</button>
                                <button class="btn btn-danger" onclick="closepop()" type="button">Hủy</button>
                            </div>

                        </div>

                    </div>
                </div>
        </div>
    </div>
</div>
<div id="fc_popup" data-toggle="modal" data-target="#CalenderModal"></div>
@section scripts
{
    <script src="~/Scripts/SoThuCommon.js"></script>
    <script src="~/Scripts/jquery.fileDownload.js"></script>
    <script src="~/Scripts/IndexCommon.js"></script>
    <link href="~/assests/plugins/select2/select2.css" rel="stylesheet" />
    <script src="~/assests/plugins/select2/select2.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script>
        //$(document).ready(function () {
        //    $('#SearchGiaiTrinh').trigger('click');
        //})
        $("#CHKALL").change(function () {
            debugger;
            $("input:checkbox").prop('checked', $(this).prop("checked"));
        });
        var chk = "";
        var flag = true;
        $(".checkbox").change(function () {
            debugger;
            chk = "";
            $(".checkbox").map(function (key, val) {
                flag = true;
                if ($(val).is(":checked")) {
                    let a = $(val).closest("th").find("input[type=hidden]").val();
                    if (chk == "") {
                        chk = a;
                    }

                }
            })

        })
        function setCookie(cname, cvalue) {
            document.cookie = cname + "=" + cvalue + ";path=/SoThu/DongBoPhieuThuCyber";
        }

        $("#ThemMoi").click(function () {
            debugger;
            var result = "";
            var flag = true;
            var ctbh = "";
            var soLuong = 0;
            $(".checkbox").map(function (key, val) {
                if ($(val).is(":checked")) {
                    let a = $(val).closest("th").find("input[type=hidden]").val();
                    @*if (ctbh == "") {
                        ctbh = a;
                    }
                    if (a != ctbh) {
                        if (flag) {
                            toastError("Chỉ được chọn các phiếu nợ của cùng 1 " + '@ViewBag.KhachHangNoTitle.ToLower()');
                        }
                        flag = false;
                        return;
                    }*@
                    result += $(val).val() + ",";
                    soLuong++;

                }
            })
            if (result != "") {
                result = result.substring(0, result.length - 1);
            }
            else {
                toastWarning("Vui lòng chọn phiếu đông bộ.");
                return;
            }
            var type = $("#type").val()
            if (type == "") {

                toastWarning("Vui lòng chọn loại phiếu đông bộ.");
                return;
            }
            var loaphieu = '';
            switch (type) {
                case "TBAHI":
                    loaphieu = "Thu Bảo Hiểm";
                    break;
                case "TKHAC":
                    loaphieu = "Thu Khác";
                    break;
                case "TCOBX":
                    loaphieu = "Thu Cọc Bán Xe";
                    break;
                case "TCODV":
                    loaphieu = "Thu Cọc Dịch Vụ";
                    break;
                case "THHHB":
                    loaphieu = "Thu Hoa Hồng Holdback";
                    break;
                case "TCONO":
                    loaphieu = "Thu Công Nợ BHDV";
                    break;
                case "T2THK":
                    loaphieu = "Thu Hộ Khác";
                    break;
                case "TBHXH":
                    loaphieu = "Thu Hộ BHXH";
                    break;
                case "T2GTX":
                    loaphieu = "Thu Hộ Giấy Tờ Xe";
                    break;
                case "TVAMU":
                    loaphieu = "Thu Vay Mượn";
                    break;
                case "TLADT":
                    loaphieu = "Thu Lãi Đầu Tư";
                    break;

            }
            $("#loaiphieu").text("Bạn đang chọn import Phiếu " + loaphieu + ". Số lượng: " + soLuong + " phiếu.");
            $('select').select2("val", null);
            $.ajax({
                url: "/SoThu/GetModelPhieuThuCyber",
                type: "POST",
                data: {
                    Type: type
                },
                success: function (result) {
                    if (!result.IsError) {
                        //Tái tục -Thu bảo hiểm
                        if (result.model.ListItem != null) {
                            html = "<option value=''>- Chọn - </option>"
                            for (var i = 0; i < result.model.ListItem.length; i++) {
                                html += "<option value='" + result.model.ListItem[i].Value + "'>" + result.model.ListItem[i].Text + "</option>";
                            }
                            $("#optTT").empty();
                            $("#optTT").append(html);
                        }
                        //Công ty bảo hiểm - Đối tác - Đơn vị cho vay - đối tác trả lãi
                        if (result.model.DoiTac != null) {
                            html = "<option value=''>- Chọn - </option>"
                            var html2 = "<option value=''>- Chọn - </option>"
                            var html3 = "<option value=''>- Chọn - </option>"
                            var html4 = "<option value=''>- Chọn - </option>"
                            for (var i = 0; i < result.model.DoiTac.length; i++) {
                                html += "<option value='" + result.model.DoiTac[i].MaDoiTac + "'>" + result.model.DoiTac[i].TenDoiTac + "</option>";
                                html2 += "<option value='" + result.model.DoiTac[i].MaDoiTac + "'>" + result.model.DoiTac[i].TenDoiTac + "</option>";
                                html3 += "<option value='" + result.model.DoiTac[i].MaDoiTac + "'>" + result.model.DoiTac[i].TenDoiTac + "</option>";
                                html4 += "<option value='" + result.model.DoiTac[i].MaDoiTac + "'>" + result.model.DoiTac[i].TenDoiTac + "</option>";
                            }
                            //Option công ty bảo hiểm
                            $("#optCTBH").empty();
                            $("#optCTBH").append(html);
                            //Option đối tác
                            $("#optDT").empty();
                            $("#optDT").append(html2);
                            //Option đđơn vị cho vây
                            $("#optDVCV").empty();
                            $("#optDVCV").append(html3);
                            //Option đối tác trả lãi
                            $("#optDTTL").empty();
                            $("#optDTTL").append(html4);
                        }
                        //Loại - thu khác
                        if (result.model.LoaiBH != null) {
                            html = "<option value=''>- Chọn - </option>"
                            for (var i = 0; i < result.model.LoaiBH.length; i++) {
                                html += "<option value='" + result.model.LoaiBH[i].Value + "'>" + result.model.LoaiBH[i].Text + "</option>";
                            }
                            //Option loại thu khác
                            $("#optLoai").empty();
                            $("#optLoai").append(html);
                        }
                        //Mã loại xe - Thu cọc bán xe
                        if (result.model.MaLoaiXe != null) {
                            html = "<option value=''>- Chọn - </option>"
                            for (var i = 0; i < result.model.MaLoaiXe.length; i++) {
                                var text = result.model.MaLoaiXe[i].TenModel + "-" + result.model.MaLoaiXe[i].TenMau + "-" + result.model.MaLoaiXe[i].XuatXu + "-" + result.model.MaLoaiXe[i].TenDoiXe + "-" + result.model.MaLoaiXe[i].CodeGrad
                                html += "<option value='" + result.model.MaLoaiXe[i].MaLoaiXe + "'>" + text + "</option>";
                            }
                             //Option mã loại xe
                            $("#optMLX").empty();
                            $("#optMLX").append(html);
                        }
                      //  Mã xe - Thu cọc dịch vụ
                        if (result.model.MaXe != null) {
                            html = "<option value=''>- Chọn - </option>"
                            for (var i = 0; i < result.model.MaXe.length; i++) {
                                var text = result.model.MaXe[i].Code + "-" + result.model.MaXe[i].Name;
                                html += "<option value='" + result.model.MaXe[i].Code + "'>" + text + "</option>";
                            }
                            //Option mã xe
                            $("#optMX").empty();
                            $("#optMX").append(html);
                        }
                      //  Màu xe - Thu cọc dịch vụ
                        if (result.model.MauXe != null) {
                            html = "<option value=''>- Chọn - </option>"
                            for (var i = 0; i < result.model.MauXe.length; i++) {
                                var text = result.model.MauXe[i].Code + "-" + result.model.MauXe[i].Name;
                                html += "<option value='" + result.model.MauXe[i].Code + "'>" + text + "</option>";
                            }
                            //Option màu xe
                            $("#optMauXe").empty();
                            $("#optMauXe").append(html);
                        }

                        $("#fc_popup").click();
                       //Thu bảo hiểm
                        if (type == "TBAHI") {
                            $("#TaiTuc").attr("hidden", false);
                            $("#CTBH").attr("hidden", false);
                        }
                        //Thu khác
                        if (type == "TKHAC") {
                            $("#Loai").attr("hidden", false);
                        }
                        //Thu cọc bán xe
                        if (type == "TCOBX") {
                            $("#MLX").attr("hidden", false);
                        }
                        //Thu cọc dịch vu
                        if (type == "TCODV") {
                            $("#MX").attr("hidden", false);
                            $("#MauXe").attr("hidden", false);
                        }
                        // Thu khác - Hoa hồng HB - Công nọ BHDV - Thu hộ khác - Thu hộ BHXH - Thu hộ giấy tờ xe
                        if (type == "TKHAC" || type == "THHHB" || type == "TCONO" || type == "T2THK" || type == "TBHXH" || type == "T2GTX") {
                            $("#DoiTac").attr("hidden", false);
                        }
                        //Thu vay mượn
                        if (type == "TVAMU") {
                            $("#DVCV").attr("hidden", false);
                        }
                        //Thu lãi đầu tư
                        if (type == "TLADT") {
                            $("#DTTL").attr("hidden", false);
                        }
                    }
                    else {
                        toastWarning(result.Message);
                    }
                },
                error: function (result) {
                }
            });

        })

        function DongBoPhieuThuCyber() {
            debugger;
            var result = "";
            var flag = true;
            var ctbh = "";
            $(".checkbox").map(function (key, val) {
                if ($(val).is(":checked")) {
