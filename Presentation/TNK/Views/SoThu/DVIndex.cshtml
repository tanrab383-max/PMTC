@section scripts
{
    <script src="~/Scripts/IndexCommon.js"></script>
    <script src="~/Scripts/jquery.fileDownload.js"></script>
    <script>
        $("#CHKALL").change(function () {
            debugger;
            $("input:checkbox").prop('checked', $(this).prop("checked"));
        });
        var chk = "";
        var flag = true;
        $(".checkbox").change(function () {
            debugger;
            chk = "";
            $(".checkbox").map(function (key, val) {
                flag = true;
                if ($(val).is(":checked")) {
                    let a = $(val).closest("th").find("input[type=hidden]").val();
                    if (chk == "") {
                        chk = a;
                    }

                }
            })

        })
        $("#ThemMoi").click(function () {
            debugger;
            var result = "";
            var flag = true;
            var ctbh = "";
            $(".checkbox").map(function (key, val) {
                if ($(val).is(":checked")) {
                    let a = $(val).closest("th").find("input[type=hidden]").val();
                    result += $(val).val() + ",";
                }
            })
            if (result != "") {
                result = result.substring(0, result.length - 1);
            }

            if (result != "") {
                if (confirm("Bạn có muốn đồng bộ thành phiếu thu dịch vụ?")) {
                    setCookie("link", result);
                    $.ajax({
                        url: "/SoThu/DongBoPhieuThuDVuCyber",
                        type: "POST",
                        data: { ids: result },
                        success: function (result) {
                            if (!result.IsError) {
                                toastSuccess(result.Message);
                            }
                            else {
                                toastWarning(result.Message);
                            }
                        },
                        error: function (result) {
                            toastWarning("Lỗi cập nhật giải trình.");
                        }
                    });
                }
            }

        })

        function setCookie(cname, cvalue) {
            document.cookie = cname + "=" + cvalue + ";path=/SoThu/DongBoPhieuThuDVuCyber";
        }
        var p = 1;
        $(document).ready(function () {
            debugger;
            /* $('#Search').trigger('click');*/
        });
        $("#Search").click(function () {
            debugger;
            $(this).val("Loading...");
            $(this).prop('disabled', true);
            Search(this);
        })
        function change() {
            debugger;
            p = 1;
        }
        function Search(obj) {
            debugger;
            var from = $("#from").val();
            var to = $("#to").val();
            var query = $("#query").val();
            $.get("/SoThu/DvComplete?query=" + query + "&from=" + from + "&to=" + to + "&p=" + p).success(function (response) {
                $("#tbody").html(response);
                $(obj).val("Tìm kiếm");
                $(obj).prop('disabled', false);
            })
        }
        var a;
        $(document).on("click", "#tbody a", function () {
            a = $(this).attr("href");
            var b = a.split("&");
            p = b[3].split("=")[1];
            Search();
            return false;
        })
        $('.date').datepicker({
            orientation: "left",
            autoclose: true
        });
        function Delete(a, id) {
            if (confirm('Xác nhận')) {
                data = { id: id, type: 'DV' };
                $.post("/SoThu/DeletePhieuThu", data).success(function (response) {
                    if (response == "success") {
                        $(a).closest("tr").remove();
                        toastSuccess("Đã xóa thành công");
                    }
                    else
                        toastError(response);
                });
            }
        }
        $("#FileMau").click(function () {
           // alert(1);
            debugger;
            $.fileDownload("/SoThu/ExportFile_DV", {
                httpMethod: "POST",
                data: {},
                failMessageHtml: "Có lỗi trong khi tải file excel."
            });
            return false;
        });
        $("#FileMauQ2").click(function () {
          //  alert(1);
            debugger;
            $.fileDownload("/SoThu/ExportFile_DVQ2", {
                httpMethod: "POST",
                data: {},
               // failMessageHtml: "Có lỗi trong khi tải file excel."
            });
            return false;
        });
        $("#FileExportCyber").click(function () {
          //  alert(1);
            debugger;
            var text = $(this).text();
            $(this).text("Loading...");
           // $(this).prop('disabled', true);
            
            var f = $("#from").val();
            var t = $("#to").val();
            var q = $("#query").val();
            $.fileDownload("/SoThu/ExportDataCyber", {
                httpMethod: "POST",
                data: { from: f, to: t, query: q },
                successCallback: function (responseHtml, url) {
                    //if (responseHtml != null)
                    //    toastWarning(responseHtml);
                    //else
                    toastSuccess('Đã download file');
                    $("#FileExportCyber").text(text);
                },
                failCallback: function (responseHtml, url) {

                    toastError('Lỗi download file');
                    //toastError(responseHtml);
                    $("#FileExportCyber").text(text);
                }
                //,
                //failMessageHtml: "Có lỗi trong khi tải file excel."
                
            });
            return false;
        });
        var datafile = new FormData();
        function ImportData() {
            $("#txtUploadFile").trigger('click');
        }
        $('#txtUploadFile').on('change', function (e) {

            //alert(("#txtUploadFile").val());
            var text = $("#btnImportCyber").text();
            $("#btnImportCyber").text("Đang import");
            if (document.getElementById("txtUploadFile").value != "") {
                var files = e.target.files;
                if (files.length > 0) {
                    if (window.FormData !== undefined) {
                        for (var x = 0; x < files.length; x++) {
                            datafile.append('file', files[x]);
                        }
                    }
                }

                $.ajax({
                    type: "POST",
                    url: "/SoThu/ImportData_DVCyber",
                    contentType: false,
                    processData: false,
                    data: datafile,
                    beforeSend: function () {
                        $("#btnImportCyber").text("Đang import");
                        $("#btnImportCyber").prop('disabled', true);
                        $("#btnSearchTemp").prop('disabled', true);
                    },
                    complete: function () {
                        // Hoàn tất ajax
                        document.getElementById("txtUploadFile").value = "";
                        datafile.delete('file');
                       
                       
                    },
                    success: function (result) {
                        if (result.IsError) {                           
                         //   toastr.error(result.Message);
                            // Toastr configuration
                            toastr.options = {
                                "closeButton": true,
                                "debug": false,
                                "newestOnTop": false,
                                "progressBar": true,
                                "positionClass": "toast-top-right",
                                "preventDuplicates": false,
                                "onclick": null,
                                "showDuration": "300",
                                "hideDuration": "1000",
                                "timeOut": "15000",  // 1 minute
                                "extendedTimeOut": "1000",
                                "showEasing": "swing",
                                "hideEasing": "linear",
                                "showMethod": "fadeIn",
                                "hideMethod": "fadeOut"
                            };

                            // Display error toast with a copy button
                            toastr.error(`
                <div style="position: relative;">
                    <div>
                    <span>
                        <button class="copy-button" onclick="copyToClipboard(` + `)">Copy</button>
                    </span>
                    <span><ul><li id='divErrorMessage'> ` + result.Message + `</li></ul></span>
                    </div>                    
                   
                   
                </div>`, 'Error', {
                                closeButton: true,
                                tapToDismiss: false,
                                disableTimeOut: true
                            });

                            // Function to copy text to clipboard
                            window.copyToClipboard = function () {
                                var text = document.getElementById("divErrorMessage").innerHTML;
                                var textarea = document.createElement('textarea');
                                textarea.value = text;
                                document.body.appendChild(textarea);
                                textarea.select();
                                document.execCommand('copy');
                                document.body.removeChild(textarea);
                               // toastr.info('Đã copy');

                            };
                            $("#btnImportCyber").text(text);
                            $("#btnImportCyber").prop('disabled', false);
                            $("#btnSearchTemp").prop('disabled', false);
                        }
                        else {
                            toastSuccess("Import thành công");
                            $("#btnImportCyber").text(text);
                            $("#btnImportCyber").prop('disabled', false);
                            $("#btnSearchTemp").prop('disabled', false);
                            $("#btnSearchTemp").trigger('click');
                            //window.location.reload();
                        }
                        $("#btnImportCyber").text(text);
                        $("#btnImportCyber").prop('disabled', false);
                    },
                    error: function (xhr, status, p3, p4) {
                        toastError("Lỗi: Import file excel.");
                        $("#btnImportCyber").text(text);
                        $("#btnImportCyber").prop('disabled', false);

                        //window.location.reload();
                    }
                });
            }
        });

        function ImportData_New() {
            $("#txtUploadFile_New").trigger('click');
        }
        $('#txtUploadFile_New').on('change', function (e) {
            //alert(("#txtUploadFile").val());
            if (document.getElementById("txtUploadFile_New").value != "") {
                var files = e.target.files;
                if (files.length > 0) {
                    if (window.FormData !== undefined) {
                        for (var x = 0; x < files.length; x++) {
                            datafile.append('file', files[x]);
                        }
                    }
                }

                $.ajax({
                    type: "POST",
                    url: "/SoThu/ImportData_DVCyber",
                    contentType: false,
                    processData: false,
                    data: datafile,
                    beforeSend: function () {
                        // Đang thực hiện ajax
                        //để Loading...
                    },
                    complete: function () {
                        // Hoàn tất ajax
                        document.getElementById("txtUploadFile_New").value = "";
                        datafile.delete('file');
                    },
                    success: function (result) {
                        if (result.IsError)
