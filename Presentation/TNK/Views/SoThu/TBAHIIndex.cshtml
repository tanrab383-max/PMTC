@model List<TNK.Core.Domain.View.ViewTBAHI>
@{
    int i = 1;
}
<div class="page-title">
    <div class="title_left ">
        <h3>@ViewBag.Title</h3>
    </div>
    <div class="title_right right">
        <a  download><span style="font-style:italic;color:blue;font-size:15px" id="FileMau">Lấy file mẫu(*.xlxs)</span></a>
    </div>
</div>
<div class="clearfix"></div>
<div class="row">
    <div class="col-md-12">
        <div class="tabbable-line boxless tabbable-reversed">
            <ul class="nav nav-tabs" id="tab_data">
                <li class="unactive">
                    <a href="#tab_2" data-toggle="tab" aria-expanded="true">
                        Phiếu tạm
                    </a>
                </li>
                <li class="active">
                    <a id="a_0" href="#tab_0" data-toggle="tab" aria-expanded="false">
                        Thu khách lẻ
                    </a>
                </li>
                <li class="unactive">
                    <a id="a_1" href="#tab_1" data-toggle="tab" aria-expanded="false">
                        Khuyến mãi
                    </a>
                </li>
            </ul>
            <div class="tab-content">
                <div class="tab-pane active" id="tab_0">
                    <div class="x_panel">
                        <div class="x_content ">
                            <form id="formSearch" method="get" class="row">
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <label>Từ ngày thu</label>
                                        <input type="text" class="form-control input-sm date" value="@ViewBag.From" name="from" id="FromDate" />
                                    </div>
                                </div>
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <label>Đến ngày thu</label>
                                        <input type="text" class="form-control input-sm date" value="@ViewBag.To" name="to" id="ToDate" />
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label>Từ khóa</label>
                                        <input type="text" title="Mã phiếu thu, Số chứng từ, công ty bảo hiểm,tên khách hàng" placeholder="Mã phiếu thu, Số chứng từ, công ty bảo hiểm,tên khách hàng" class="form-control input-sm " value="@ViewBag.Query" name="query" id="Query" />
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <br />
                                        <input type="submit" style="width:30%" value="Tìm kiếm" class="btn btn-success" />
                                        <a href="/SoThu/PhieuThu?type=TBAHI" class="btn btn-success"> <i class="fa fa-plus addNew" style="cursor:pointer"> Thêm</i></a>
                                        <input id="btnExportExcel" style="width:30%" name="export" value="Xuất Excel" class="btn btn-info" />
                                        <input style="width:33%" onclick="ImportData()" title="Import dữ liệu" value="Import Excel" class="btn btn-primary" />
                                        <input hidden value="testthaydoi"/>
                                    </div>
                                </div>
                            </form>
                            <div class="table-responsive">
                                @*<ul class="nav navbar-right panel_toolbox">
                                    <li>
                                        <a href="" class="btn btn-dark"> <i class="" style="cursor:pointer" id="ThemMoi"></i>Đồng bộ</a>
                                    </li>
                                </ul>*@
                                <div id="tbodyTBAHI">
                                    <table class="table">
                                        <thead>
                                            <tr class="success">
                                                <th>STT</th>
                                                <th>Ngày thu</th>
                                                <th>Mã phiếu thu</th>
                                                <th>Tên Khách Hàng</th>
                                                <th>Số hợp đồng</th>
                                                <th>Biển số</th>
                                                <th>Số khung</th>
                                                <th>Chứng từ thu</th>
                                                <th>Công ty bảo hiểm</th>
                                                <th>Giá bán</th>
                                                <th>Giảm giá</th>
                                                <th>Hoa hồng</th>
                                                <th>Thực thu</th>
                                                <th>Phân loại</th>
                                                <th></th>
                                                <th></th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>

                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td>@(ViewBag.PageSize * (ViewBag.PageIndex - 1) + i)</td>
                                                    <td>@item.NgayThu.ToString("dd/MM/yyyy")</td>
                                                    <td>@item.MaPhieuThu</td>
                                                    <td>@item.HoTen</td>
                                                    <td>@item.SoHopDong</td>
                                                    <td>@item.BienSo</td>
                                                    <td>@item.SoKhung</td> 
                                                    <td>@item.SoChungTu</td>
                                                    <td>@item.CTBH</td>
                                                    <td class="number">@TNK.Core.Common.ToCurrencyString(@item.GiaVon)</td>
                                                    <td class="number">@TNK.Core.Common.ToCurrencyString(@item.GiamGia)</td>
                                                    <td class="number">@TNK.Core.Common.ToCurrencyString(@item.HoaHong.Value)</td>
                                                    <td class="number">@TNK.Core.Common.ToCurrencyString(@item.TongCong)</td>
                                                    @if (item.LoaiBaoHiem.ToUpper() == "TT")
                                                    {
                                                        <td>Tái tục</td>
                                                    }
                                                    else if (item.LoaiBaoHiem.ToUpper() == "KM")
                                                    {
                                                        <td>Ký mới</td>
                                                    }
                                                    else
                                                    {
                                                        <td>Chưa xác định</td>
                                                    }
                                                    <td style="width:5%" class="center">
                                                        <a href="/SoThu/PhieuThu/@item.MaPhieuThu?type=TBAHI&actiontype=Update"><i title="Edit" class="fa fa-edit"></i></a>
                                                    </td>
                                                    <td style="width:5%" class="center">
                                                        <a href="javascript:;" onclick="Delete(this,'@item.MaPhieuThu')"><i title="Delete" class="fa fa-close"></i></a>
                                                    </td>
                                                </tr>
                                                i++;

                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <div class="right">
                                    @Html.Partial("~/Views/Shared/_Paging_v3.cshtml")
                                </div>
                                <div class="center">
                                    @*Tìm thấy : @ViewBag.Total data*@
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="tab-pane" id="tab_1">
                    <div class="x_panel">
                        <div class="x_content">
                            <div method="get" class="row">
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <label>Từ ngày thu</label>
                                        <input type="text" id="from1" class="form-control input-sm date" value="@ViewBag.From" name="from" />
                                    </div>
                                </div>
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <label>Đến ngày thu</label>
                                        <input type="text" id="to1" class="form-control input-sm date" value="@ViewBag.To" name="to" />
                                    </div>
                                </div>
                                <div class="col-md-5 col-sm-5 col-xs-12">
                                    <div class="form-group">
                                        <label>Từ khóa</label>
                                        <input type="text" id="query1" title="Mã phiếu thu, Số chứng từ, công ty bảo hiểm,tên khách hàng" placeholder="Mã phiếu thu, số chứng từ, công ty bảo hiểm,tên khách hàng" class="form-control input-sm " value="@ViewBag.Query" name="query" />
                                    </div>
                                </div>
                                <div class="col-md-3 col-sm-3 col-xs-12">
                                    <div class="form-group">
                                        <br />
                                        <input type="button" style="width:50%" value="Tìm kiếm" id="SearchTab" class="btn btn-success" />
                                        @*<input type="submit" name="export" value="Excel" class="btn btn-success" />*@
                                        <input type="submit" name="export_Excel" id="exportExcel" value="Xuất Excel" class="btn btn-info" />
                                    </div>
                                </div>
                            </div>
                            <div class="table-responsive">
                                <ul class="nav navbar-right panel_toolbox">
                                    <li>
                                        <a href="/SoThu/PhieuThu?type=TBAHI"><i class="fa fa-plus addNew"></i></a>
                                    </li>
                                </ul>
                            </div>

                            <div class="table-responsive" id="tbody">

                            </div>
                        </div>
                    </div>
                    <div style="display:none"><input type="file" id="txtUploadFile" /></div>
                </div>
                <div class="tab-pane  " id="tab_2">
                    <div class="x_panel">
                        <div class="x_content ">
                            <div class="row">
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <label>Từ ngày thu</label>
                                        <input type="text" id="fromTemp" class="form-control input-sm date" value="@ViewBag.From" name="from" />
                                    </div>
                                </div>
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <label>Đến ngày thu</label>
                                        <input type="text" id="toTemp" class="form-control input-sm date" value="@ViewBag.To" name="to" />
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label>Từ khóa</label>
                                        <input type="text" id="queryTemp" title="Số hợp đồng, Chứng từ, Tên khách hàng" placeholder="Số hợp đồng, Chứng từ, Tên khách hàng" class="form-control input-sm " value="@ViewBag.Query" name="query" />
                                    </div>
                                </div>
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <br />
                                        <input type="button" style="width:50%" value="Tìm kiếm" id="SearchtabTemp" class="btn btn-success" />
                                        @*<div id="loading" style="display:none"><img src="~/assests/vendors/jquery-smart-wizard/images/loader.gif" /></div>*@
                                        @*<input type="submit" name="export" value="Excel" class="btn btn-success" />*@
                                    </div>
                                </div>
                            </div>
                            <div class="table-responsive " id="tbodyTemp">

                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="clearfix"></div>
        </div>
    </div>
</div>
@section scripts
{
    <script src="~/Scripts/jquery.fileDownload.js"></script>
    <script src="~/Scripts/IndexCommon.js"></script>
    <script>
        var pTemp = 1;
        $(document).ready(function () {

        })
        function Delete(a, id) {
            if (confirm('Xác nhận')) {
                data = { id: id, type: 'TBAHI' };
                $.post("/SoThu/DeletePhieuThu", data).success(function (response) {
                    if (response == "success") {
                        $(a).closest("tr").remove();
                        toastSuccess("Đã xóa thành công");
                    }
					else {
                        toastError(response);
                    }
                });
            }
        }
        var p = 1;
        function change() {
            p = 1;
        }
        $("#SearchTab").click(function () {
            var $this = $(this);
            //$this.button('loading');
            //setTimeout(function () {
            //    $this.button('reset');
            //}, 200);
            //$(this).val("Loading...");
            //$(this).prop('disabled', true);
            Search(this);
        })
        function Search(obj) {
            debugger
            var from = $("#from1").val();
            var to = $("#to1").val();
            var query = $("#query1").val();
            $("#SearchTab").prop("disabled", true);
            var typeTicketTemp = $("#TypeTicketTemp option:selected").val();
            var pageSizes = document.getElementById("pageSizeTBAHIIndexTab");
            var size = pageSizes != undefined ? pageSizes.value : '';
            $.get("/SoThu/TBAHIIndexTab?&&from=" + from + "&to=" + to + "&query=" + query + "&p=" + p + "&pageSize=" + size).success(function (response) {
                $("#tbody").html(response);
                $("#tbody").find(".number2").map(function (key, val) {
                    var val = $(this).html();
                    if (val != "") {
                        val = val.split(",").join("");
                        val = parseInt(val);
                        $(this).html(val.toLocaleString());
                    }
                })
                $("#SearchTab").prop("disabled", false);
                $(obj).val("Tìm kiếm");
                $(obj).prop('disabled', false);
            })
        }

        var temp
        $(document).on("click", "#tbody2 a", function () {
            debugger;
          
        })
        //phần của tab phiếu tạm
        $("#SearchtabTemp").click(function () {
            var $this = $(this);
            /*  $this.button('loading');*/
            //setTimeout(function () {
            //    $this.button('reset');
            //}, 200);
            SearchTabTemp(this);

        })

        function SearchTabTemp(obj) {
            debugger;
            $("#SearchtabTemp").val("Loading...");
            //$("#SearchtabTemp").prop("disabled", true);

            var from = $("#fromTemp").val();
            var to = $("#toTemp").val();
            var query = $("#queryTemp").val();
            var typeTicketTemp = $("#TypeTicketTemp option:selected").val();
            var pageSizes = document.getElementById("pageSizeTBAHIIndexTemp");
            var size = pageSizes != undefined ? pageSizes.value : '';

            $.get("/SoThu/TBAHIIndexTemp?query=" + query + "&from=" + from + "&to=" + to + "&typeTicketTemp=" + typeTicketTemp + "&p=" + pTemp + "&pageSize=" + size).success(function (response) {
                $("#tbodyTemp").html(response);
                $("#tbodyTemp").find(".number2").map(function (key, val) {
                    var val = $(this).html();
                    if (val != "") {
                        val = val.split(",").join("");
                        val = parseInt(val);
                        $(this).html(val.toLocaleString());
                    }
                })
                $("#SearchtabTemp").prop("disabled", false);
            })
        }
        var a;
        $(document).on("click", "#tbody a", function () {
            a = $(this).attr("href");
            var b = a.split("&");
            p = b[3].split("=")[1];
            console.log(p);
            Search();
            return false;
        })
        $("#FileMau").click(function () {
            debugger;
            $.fileDownload("/SoThu/ExportFile", {
                httpMethod: "POST",
                data: {},
                failMessageHtml: "Có lỗi trong khi tải file excel."
            });
            return false;
        });
        var datafile = new FormData();
        function ImportData() {
            $("#txtUploadFile").trigger('click');
        }
        $('#txtUploadFile').on('change', function (e) {
            //alert(("#txtUploadFile").val());
            if (document.getElementById("txtUploadFile").value != "") {
                var files = e.target.files;
                if (files.length > 0) {
                    if (window.FormData !== undefined) {
                        for (var x = 0; x < files.length; x++) {
                            datafile.append('file', files[x]);
                        }
                    }
                }

                $.ajax({
                    type: "POST",
                    url: "/SoThu/ImportData",
                    contentType: false,
                    processData: false,
                    data: datafile,
                    beforeSend: function () {
                        // Đang thực hiện ajax
                        //để Loading...
                    },
                    complete: function () {
                        // Hoàn tất ajax
                        document.getElementById("txtUploadFile").value = "";
                        datafile.delete('file');
                    },
                    success: function (result) {
                        if (result.IsError)
                            toastError(result.Message);
                        else {
                            toastSuccess("Import thành công");
                            //window.location.reload();
                        }
                    },
                    error: function (xhr, status, p3, p4) {
                        toastError("Lỗi: Import file excel.");
                        //window.location.reload();
                    }
                });
            }
        });
        //$("#btnExportExcel").click(function () {
        //    $.fileDownload("/SoThu/Export_Excel_TBAHI", {
        //        httpMethod: "POST",
        //        data: {
        //            FromDate: $("#FromDate").val(),
        //            ToDate: $("#ToDate").val(),
        //        },
        //        failMessageHtml: "Có lỗi trong khi tải file excel."
        //    });
        //    return false;
        //});
        //btnExportExcel
        //$("#btnExportExcel").click(function () {
        //    $.fileDownload("/SoThu/Export_Excel_TBAHI", {
        //        httpMethod: "POST",
        //        data: {
        //            FromDate: $("#FromDate").val(),
        //            ToDate: $("#ToDate").val(),
        //            Query: $("#Query").val(),
        //        }, hh
        //        failMessageHtml: "Có lỗi trong khi tải file excel."
        //    });
        //    return false;
        //});

        $("#btnExportExcel").click(function () {
            debugger;
            if ($($("#tab_data li.active")[0]).attr("data-url") != "") {
                var dt = new Date();
                var day = dt.getDate();
                var month = dt.getMonth() + 1;
                var year = dt.getFullYear();
                var hour = dt.getHours();
                var mins = dt.getMinutes();
                var postfix = day + "." + month + "." + year + "_" + hour + "." + mins;
                var idtable = "#tbodyTBAHI";
                //alert(idtable);
                var result = $(idtable).html();
                result = result.replace('class="table"', 'class="table" border="1"');
                //alert(result)
                tableToExcel(result, 'PhieuThu' + '_@ViewBag.Type' + '_' + postfix + '.xls');
            }
            else {
                window.location = `/SoChi/PhieuThu?TBAHIIndex?from=${$("#FromDate").val()}&to=${$("#ToDate").val()}&export=Excel`;
            }
            return false;
        })
        $("#exportExcel").click(function () {
            debugger;
            if ($($("#tab_data li.unactive")[0]).attr("data-url") != "") {
                var dt = new Date();
                var day = dt.getDate();
                var month = dt.getMonth() + 1;
                var year = dt.getFullYear();
                var hour = dt.getHours();
                var mins = dt.getMinutes();
                var postfix = day + "." + month + "." + year + "_" + hour + "." + mins;
                //var idtable = $($("#tab_data li.unactive")).attr("data-url").replace("/SoChi/PhieuChi/", "#");
                //alert(idtable);
                var idtable = "#tbody";
                var result = $(idtable).html();
                result = result.replace('class="table"', 'class="table" border="1"');
                //alert(result)
                tableToExcel(result, 'SoThu' + '_@ViewBag.Type' + '_' + postfix + '.xls');
            }
            else {
                window.location = `/SoThu/TBAHIIndex?from=${$("#FromDate").val()}&to=${$("#ToDate").val()}&export=Excel`;
            }
            return false;
        })

        var tableToExcel = (function () {
            debugger;
            var uri = 'data:application/vnd.ms-excel;base64,'
            , template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>{table}</table></body></html>'
            , base64 = function (s) { return window.btoa(unescape(encodeURIComponent(s))) }
            , format = function (s, c) { return s.replace(/{(\w+)}/g, function (m, p) { return c[p]; }) }
            return function (table, name) {
                //if (!table.nodeType) table = document.getElementById(table)
                var ctx = { worksheet: name || 'Worksheet', table: table }
                var link = document.createElement("A");
                link.href = uri + base64(format(template, ctx));
                link.download = name || 'Baocao.xls';
                link.target = '_blank';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            }
        })()
    </script>
}