@model List<TNK.Core.Domain.View.ViewTBHXH>
@{
    int i = 1;
}
<div class="page-title">
    <div class="title_left">
        <h3>Thu hộ khác</h3>
    </div>
</div>
<div class="clearfix"></div>
<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_panel">
            <div class="x_title">
                <ul class="nav navbar-right panel_toolbox">
                    <li>
                        <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                    </li>
                    <li>
                        <a href="/SoThu/PhieuThu?type=THKHA"><i class="fa fa-plus addNew"></i></a>
                    </li>
                </ul>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">
                <form method="get" class="row" id="formSearch">
                    <div class="col-md-2 col-sm-2 col-xs-12">
                        <div class="form-group">
                            <label>Từ ngày thu</label>
                            <input type="text" class="form-control input-sm date" value="@ViewBag.From" name="from" />
                        </div>
                    </div>
                    <div class="col-md-2 col-sm-2 col-xs-12">
                        <div class="form-group">
                            <label>Đến ngày thu</label>
                            <input type="text" class="form-control input-sm date" value="@ViewBag.To" name="to" />
                        </div>
                    </div>
                    <div class="col-md-5 col-sm-5 col-xs-12">
                        <div class="form-group">
                            <label>Từ khóa</label>
                            <input type="text" id="query" placeholder="Mã phiếu thu, Số chứng từ, Đối tác" title="Mã phiếu thu, Số chứng từ, Đối tác" class="form-control input-sm " value="@ViewBag.Query" name="query" />
                        </div>
                    </div>

                    <div class="col-md-3 col-sm-3 col-xs-12">
                        <div class="form-group">
                            <br />
                            <input type="submit" value="Tìm kiếm" class="btn btn-success" />
                            <input type="button" value="Xuất excel" class="btn btn-info" id="btnExportExcel" />
                        </div>
                    </div>

                </form>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr class="success">
                                <th>STT</th>
                                <th>Ngày thu</th>
                                <th>Mã phiếu thu</th>
                                <th>Số chứng từ</th>
                                <th>Đối tác</th>
                                <th>Thông tin khác</th>
                                <th>Nội dung</th>
                                <th>Số tiền</th>
                                <th>Đã Trả</th>
                                <th>Còn lại</th>
                                <th></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null)
                            {
                                foreach (var item in Model)
                                {
                            <tr>
                                <td>@(ViewBag.PageSize * (ViewBag.PageIndex - 1) + i)</td>
                                <td>@item.NgayThu.ToString("dd/MM/yyyy")</td>
                                <td>@item.MaPhieuThu</td>
                                <td>@item.SoChungTu</td>
                                <td>@item.DoiTac</td>
                                <td>@item.ThongTinKhac</td>
                                <td>@item.NoiDung</td>
                                <td class="number2">@item.TongCong</td>
                                <td class="number2">@(item.TongCong - item.ConLai)</td>
                                <td class="number2">@item.ConLai</td>
                                <td style="width:5%" class="center">
                                    <a href="/SoThu/PhieuThu/@item.MaPhieuThu?type=T2THK&actiontype=Update"><i title="Edit" class="fa fa-edit"></i></a>
                                </td>
                                <td style="width:5%" class="center">
                                    <a href="javascript:;" onclick="Delete(this,'@item.MaPhieuThu')"><i title="Delete" class="fa fa-close"></i></a>
                                </td>
                            </tr>
                                    i++;
                                }
                            }
                        </tbody>
                    </table>
                    <div class="right">
                        @Html.Partial("~/Views/Shared/_Paging.cshtml")
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
</div>
@section scripts
{
    <script src="~/Scripts/IndexCommon.js"></script>
    <script>
        var p = 1;
        $("#Search").click(function () {
            $(this).val("Loading...");
            $(this).prop('disabled', true);
            Search(this);
        })
        function change() {
            p = 1;
        }
        function Search(obj) {
            debugger;
            var from = $("#from").val();
            var to = $("#to").val();
            var query = $("#query").val();
            $.get("/SoChi/THDCComplete?query=" + query + "&from=" + from + "&to=" + to + "&p=" + p).success(function (response) {
                $("#tbody").html(response);
                $(obj).val("Tìm kiếm");
                $(obj).prop('disabled', false);
            })
        }

        $('.date').datepicker({
            orientation: "left",
            autoclose: true
        });
        function Delete(a, id) {
            debugger;
            if (confirm('Xác nhận')) {
                data = { id: id };
                $.post("/SoChi/DeletePhieuThu", data).success(function (response) {
                    if (response == "success") {
                        $(a).closest("tr").remove();
                        toastSuccess("Đã xóa thành công");
                    }
                    else
                        toastError(response);
                });
            }
        }
    </script>
}
