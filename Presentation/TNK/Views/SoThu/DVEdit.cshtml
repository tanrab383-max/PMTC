@section scripts
{
    <link href="~/assests/plugins/select2/select2.css" rel="stylesheet" />
    <script src="~/assests/plugins/select2/select2.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/SoThuCommon.js"></script>
    <style>
        .changeType {
            cursor: pointer;
        }
    </style>
    <script>
        //calCoc();
        Cal();

        function SetSubmitType(value) {
            debugger;
            Cal();
            $("#submitType").val(value);
        }
        function OnChecked() {
            var LBH = $("#LoaiBH").prop('checked') == true ? "XKG" : "";
            $("#LoaiBaoHiem").val(LBH);
        }
        //so tien tong cong da co VAT tu database nen khong can nhan 1.1 nua
        var tongTienPhaiThuDaCoVAT = '@ViewBag.TongThucThuSauVAT';
        var totalresult = 0;
        $("#form-data").submit(function () {
            debugger;
            Cal();
            let flag = true;
            $("#tbody").find("tr").map(function (key, val) {
                var isDeleted = $(val).find(".IsDeleted").val();
                if (isDeleted != "true") {
                    var tuitien = $(val).find(".Temp").select2('val');
                    var sotien = $(val).find(".number").val().split(",").join("");
                    tuitien = tuitien == "Chọn" ? "" : tuitien;
                    sotien = sotien == "" ? 0 : parseInt(sotien);

                    if (tuitien != "" && sotien === 0) {
                        toastWarning("Vui lòng nhập số tiền");
                        $(val).find(".number").focus();
                        flag = false;
                        return;
                    }
                    if (tuitien == "" && sotien != 0) {
                        toastWarning("Vui lòng nhập túi tiền");
                        $(val).find(".Temp").focus();
                        flag = false;
                        return;
                    }
                }
            })
            if (!flag) {
                return false;
            }
            /*
            var STTT = parseInt($(".BHTT").val().split(",").join(""));
            var MNH = $(".MaNganHang").val();
            if (MNH != "" && STTT == 0) {
                toastWarning("Vui lòng nhập số tiền bảo hiểm ");

                return false;
            }
            if (MNH == "" && STTT != 0) {
                toastWarning("Vui lòng nhập công ty bảo hiểm ");
                return false;
            }
            */
            if (CheckValidatePhieuDichVu() == false)
                return false;

            //if (totalresult > 0 && $("#NguoiBaoLanh").val() == "") {
            //    toastWarning("Vui lòng nhập thông tin Người bảo lãnh.");
            //    $("#NguoiBaoLanh").focus();
            //    return false;
            //}

            if (CheckValidateThongTinNguoiThanhToan_PhieuThu() == false)
                return false;
            var lst = $(".number");
            lst.map(function (key, val) {
                $(val).val($(val).val().split(",").join(""));
            });

        })
        i = '@khtt.Count';
        $(".addHTTT").click(function () {
            var html = tr.split("httt[0]").join("httt[" + i + "]");
            @if(Model.CTPT.Count>0)
            {
             @Html.Raw("html=html.replace('" + khtt[0].Id+"','');")
             @Html.Raw("html=html.replace('" + khtt[0].SoTienThanhToan+"','');")
             @Html.Raw("html=html.replace('selected','');")
             @Html.Raw("html=html.replace('" + khtt[0].SoThamChieu + "','');")
            }
            $("#tbody").append("<tr>" + html + "</tr>");
            i++;
            setTimeout(function () {
                $('.select2').select2({
                    placeholder: "Select an option",
                    allowClear: true
                });
                removeSelect();
            }, 200);
        })
        function Remove(a) {
            debugger;
            var tr = $(a.closest("tr"));
            tr.find(".IsDeleted").val("true");
            tr.html(tr.html().split("required").join(""));
            tr.hide();
            Cal();
        }
        function Cal() {
            setTimeout(function () {
                debugger;
                if (isNaN(tongTienPhaiThuDaCoVAT))
                    tongTienPhaiThuDaCoVAT = 0;
                var soTienNo = tongTienPhaiThuDaCoVAT;
                //phan moi chinh sua
                //tinh tien thanh toan tren luoi thanh toan
                var tienThanhToan = 0;
                $("#tbody").find("tr").map(function (key, val) {
                    if ($(val).is(":visible")) {
                        var isDeleted = $(val).find(".IsDeleted").val();
                        if (isDeleted != "true") {
                            var sotien = parseInt($(val).find(".number").val().split(",").join(""));
                            if (isNaN(sotien))
                                sotien = 0;
                            tienThanhToan += sotien;
                        }
                    }
                });
                //set gia tri tong tien thanh toan tren luoi thanh toan
                $("#ThanhToan").find(".Total").html(tienThanhToan.toLocaleString('en-us'));
                //tionh tong tien thanh toa coc, bao hiem, ngan hang
                $(".SoTienThanhToan").map(function (key, val) {
                    if ($(val).is(":visible")) {
                        let number = $(this).val();
                        if (number != "") {
                            var num = $(val).val().split(",").join("");
                            if (num != "") {
                                num = parseInt(num);
                                if (isNaN(num))
                                    num = 0;
                                soTienNo = soTienNo - num;
                            }
                        }
                    }
                });

                //if (isDeleted != "true") {
                //    let number = $(this).val();
                //    alert(number);
                //    if (number != "") {
                //        number = number.split(",").join("");
                //        number = parseInt(number);
                //        total += number;
                //        $(".Total").html(total.toLocaleString('en-us'));
                //        alert(total);
                //    }
                //}
                //});

                //gia tri hien thi con no

                $("#Total").html(soTienNo.toLocaleString('en-us'));


                //hidden con no
                $("#NPT_SoTienNo").val(soTienNo);
                //var tiennganhang = 0;
                var soTienDaTraNo = parseFloat($("#SoTienDaTra").html().split(",").join(""));
                var soTienConLai = Math.round(soTienNo - soTienDaTraNo);
                $("#SoTienConLai").html(soTienConLai.toLocaleString('en-us'));
                totalresult = soTienNo;
                //var k = 0;
                //$("#ThanhToan").find(".number").map(function (key, val) {

                //    let i = parseInt($(val).val().split(",").join(""));
                //    if (!isNaN(i))
                //        k += i;
                //});

            }, 100);

        }
        $("td.number").map(function (key, val) {
            var val = $(this).html();
            val = val.split(",").join("");
            val = parseInt(val);
            $(this).html(val.toLocaleString('en-us'));
        })
        $(document).on("change", ".number", function () {
            var val = $(this).val();
            if (val != "") {
                val = val.split(",").join("");
                val = parseInt(val);
                $(this).val(val.toLocaleString('en-us'));
            }
            else {
                $(this).val(0);
            }
            //let total = 0;
            Cal();
        });
        function calCoc(a) {
            //var num = $(a).val().split(",").join("");
            //var tot = $(a).closest("tr").find(".SoTienCoTheSuDung").val().split(",").join("");
            //$(a).closest("tr").find(".SoTienConLai").val((tot - num).toLocaleString('en-us'));
            //Cal();


            setTimeout(function () {
                var stsd = $(a).val();
                stsd = stsd.split(",").join("");
                var stctsd = $(a).closest("tr").find(".SoTienCoTheSuDung").val().split(",").join("");
                if (stctsd - stsd < 0) {
                    toastError("Số tiền sử dụng cọc không được lớn hơn số tiền có thể sử dụng.Vui lòng nhập lại.");
                    $(a).focus();
                    $(a).val(0);
                    $(a).closest("tr").find(".SoTienConLai").val(stctsd);
                }
                else
                    $(a).closest("tr").find(".SoTienConLai").val((stctsd - stsd).toLocaleString('en-us'));
            }, 100);
            Cal();
        }
        var selected = {};

        var selected = {};
        var a;
        $.contextMenu({
            selector: '.changeType',
            callback: function (key, options) {
                debugger;
                selected = $(this);
                //$(selected).find(".numberGCN").val(0);

                if (key != "SuaChua") {
                    $(selected).find(".numberGCN").hide();
                }
                else {
                    $(selected).find(".numberGCN").show();
                }
                $(selected).find(".PhanLoai").val(key);
                var html = "<tr class='changeType'>" + $(selected).html() + "</tr>";
                $("." + key).append(html);
                $(selected).remove();
                CalChange();
            },
            items: {
                "SuaChua": { name: "Sửa chữa chung" },
                "KHO_DS": { name: "Đồng sơn - sơn xe" },
                "KHO_PTT": { name: "Phụ tùng trong" },
                "KHO_PTN": { name: "Phụ tùng ngoài" },
                "KHO_PKDV": { name: "Phụ kiện dịch vụ" },
            }
        });

        //$(document).on("dblclick", ".changeType", function () {
        //    selected = $(this);
        //    $("#Modal").modal();
        //});
        $(document).on("click", "#ChangeType", function () {
            debugger;
            var result = $("#selectType").val();
            if (result != "SuaChua") {
                selected.find(".numberGCN").hide();
            }
            else {
                selected.find(".numberGCN").show();
            }
            selected.find(".PhanLoai").val(result);

            var html = "<tr class='changeType'>" + selected.html() + "</tr>";
            $("." + result).append(html);
            selected.remove();
            CalChange();
        })

        function CalThanhToanGCN() {
            debugger;
            setTimeout(function () {
                var table = $(".SuaChua").closest("table");
                result = 0;
                $(table).find(".numberGCN").map(function (key, val) {
                    result += parseInt($(val).val().split(",").join(""));
                })
                $(table).find(".TotalGCN").html(result.toLocaleString('en-us'));
            }, 300);
        }
        var arr = "SuaChua,KHO_DS,KHO_PTT,KHO_PTN,KHO_PKDV".split(",");
        function CalChange() {
            arr.map(function (val, key) {
                debugger;
                giaban = 0;
                giamgia = 0;
                thucthu = 0;
                $("." + val).find("tr").map(function (key, val) {
                    var number = $(val).find("td.number");
                    giaban += parseInt($(number[0]).html().split(",").join(""));
                    giamgia += parseInt($(number[1]).html().split(",").join(""));
                    thucthu += parseInt($(number[2]).html().split(",").join(""));
                })
                var result = $("." + val).closest("table").find("tfoot").find("td.number");
                $(result[0]).html(giaban.toLocaleString('en-us'))
                $(result[1]).html(giamgia.toLocaleString('en-us'))
                $(result[2]).html(thucthu.toLocaleString('en-us'))
            })
            CalThanhToanGCN();
        }
    </script>
}