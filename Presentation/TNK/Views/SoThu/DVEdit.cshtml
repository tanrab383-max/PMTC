        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Chuyển loại</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-9">
                        <select class="form-control input-sm" id="selectType">
                            <option value="">Chọn</option>
                            <option value="SuaChua">Sửa chữa chung</option>
                            <option value="KHO_DS">Đồng sơn - sơn xe</option>
                            <option value="KHO_PTT">Phụ tùng trong</option>
                            <option value="KHO_PTN">Phụ tùng ngoài</option>
                            <option value="KHO_PKDV">Phụ kiện dịch vụ</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="button" class="btn btn-success" id="ChangeType" data-dismiss="modal">Thay đổi</button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
<div id="context-menu2" >
    @if (readOnly == "")
    {
    <ul class="dropdown-menu pull-left" role="menu" >
        <li>
            <a onclick="ChangeType('SuaChua')" href="javascript:;">
                Sửa chữa chung
            </a>
        </li>
        <li>
            <a onclick="ChangeType('KHO_DS')" href="javascript:;">
                Đồng sơn - sơn xe
            </a>
        </li>
        <li>
            <a onclick="ChangeType('KHO_PTT')" href="javascript:;">
                Phụ tùng trong
            </a>
        </li>
        <li>
            <a onclick="ChangeType('KHO_PTN')" href="javascript:;">
                Phụ tùng ngoài
            </a>
        </li>
        <li>
            <a onclick="ChangeType('KHO_PKDV')" href="javascript:;">
                Phụ kiện dịch vụ
            </a>
        </li>
    </ul>
    }
    else
    {
        <ul>
            <li>Phiếu đã trả nợ không thể thay đổi kho</li>
        </ul>
    }
</div>
