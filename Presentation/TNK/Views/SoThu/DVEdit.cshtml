@model TNK.Model.DichVuEditModel
@{
    ViewBag.Title = "Phiếu dịch vụ";
    double TongGiaBan = 0;
    double TongGiamGia = 0;
    double TongThucThu = 0;

    double TongGiaBanVAT = 0;
    double TongGiamGiaVAT = 0;
    double TongThucThuVAT = 0;

    double TongGiaBanSauVAT = 0;
    double TongGiamGiaSauVAT = 0;
    double TongThucThuSauVAT = 0;
    if (Model.CTPDV != null)
    {
        foreach (TNK.Core.Domain.ChiTietPhieuDichVu i in Model.CTPDV)
        {
            i.COST = Math.Round(i.COST, 0);
            i.DISCOUNT = Math.Round(i.DISCOUNT, 0);

            TongGiaBan += i.COST;
            TongGiamGia += i.DISCOUNT;
            TongThucThu += i.COST - i.DISCOUNT;
        }
    }
    TongGiaBanVAT = Math.Round(0.1 *TongGiaBan);
    TongGiamGiaVAT = Math.Round(0.1 * TongGiamGia);
    TongThucThuVAT = Math.Round(0.1 * TongThucThu);

    TongGiaBanSauVAT = Math.Round( 1.1* TongGiaBan);
    TongGiamGiaSauVAT = Math.Round(1.1 *TongGiamGia);
    TongThucThuVAT = Math.Round(1.1 *TongThucThu);

    var suachuachung = Model.CTPDV.Where(x => x.PhanLoai.ToUpper() == "SUACHUA").ToList();
    var dongsonsonxe = Model.CTPDV.Where(x => x.PhanLoai.ToUpper() == "KHO_DS").ToList();
    var phutungtrong = Model.CTPDV.Where(x => x.PhanLoai.ToUpper() == "KHO_PTT").ToList();
    var phutungngoai = Model.CTPDV.Where(x => x.PhanLoai.ToUpper() == "KHO_PTN").ToList();
    var phukiendichvu = Model.CTPDV.Where(x => x.PhanLoai.ToUpper() == "KHO_PKDV" ).ToList();
    var coc = Model.CTPT.Where(x => x.HinhThucThanhToan == "DC").ToList();
    var bh = Model.CTPT.FirstOrDefault(x => x.HinhThucThanhToan == "BH");
    var maCtyBH = (bh != null ? bh.Id : Guid.Empty);
    var soTienCtyBH = (bh != null ? bh.SoTienThanhToan : 0);
    var khtt = Model.CTPT.Where(x => x.HinhThucThanhToan != "DC" && x.HinhThucThanhToan != "BH").ToList();
    if (khtt == null || khtt.Count == 0)
    {
        khtt = new List<TNK.Core.Domain.ChiTietPhieuThu>();
        khtt.Add(new TNK.Core.Domain.ChiTietPhieuThu());
    }
    var z = 0;
    //no ban xe khach le
    var nophaithu = Model.noPhaiThu.FirstOrDefault(x => x.LoaiPhieuNo == "NDIVU");
    if (nophaithu == null)
    {
        nophaithu = new TNK.Core.Domain.NoPhaiThu();
    }
    //no gia cong ngoai
    var suaGCN = Model.noGCN.Count == 0 || Model.noGCN[0].SoTienDaTra == 0;
    //no phai tra hoa hong tai xe
    var suaHHTX = Model.noPhaiTra.Count == 0 || Model.noPhaiTra[0].SoTienDaTra == 0;
    //no phai thu bao hiem dich vu

    var suaBHTT = nophaithu != null &&  nophaithu.SoTienDaTra == 0 && (Model.noBaoHiem.Count == 0 || Model.noBaoHiem[0].SoTienDaTra == 0);


    var maPhieuNoGCN = Model.noGCN.Count == 0 ? "" : Model.noGCN[0].MaPhieuNo;
    var soTienDaTraNoGCN = Model.noGCN.Count == 0 ? 0 : Model.noGCN[0].SoTienDaTra;

    var maPhieuNoHHTX = Model.noPhaiTra.Count == 0 ? "" : Model.noPhaiTra[0].MaPhieuNo;
    var soTienDaTraNoHHTX = Model.noPhaiTra.Count == 0 ? 0 : Model.noPhaiTra[0].SoTienDaTra;

    var maPhieuNoBHTT = Model.noBaoHiem.Count == 0 ? "" : Model.noBaoHiem[0].MaPhieuNo;
    var soTienDaTraNoBHTT = Model.noBaoHiem.Count == 0 ? 0 : Model.noBaoHiem[0].SoTienDaTra;

    var readOnly = nophaithu.SoTienDaTra > 0 ? "readonly":"";
    var changeTypeClass = nophaithu.SoTienDaTra > 0 ? "" : "changeType";

}
