@model List<TNK.Core.Domain.View.ViewNoPhaiThu>
@{
    string Controller = @HttpContext.Current.Request.RequestContext.RouteData.Values["action"].ToString();
    int i = 1;
    var count = Model.Count;
}
<div class="page-title">
    <div class="title_left">
        <h3>@ViewBag.Title</h3>
    </div>
</div>
<div class="clearfix"></div>
<div class="row">
    <div class="col-md-12">
        <div class="tabbable-line boxless tabbable-reversed">
            <ul class="nav nav-tabs" id="tab_data">
                <li class="active" data-url="/SoThu/PhieuThuHo/@ViewBag.Type">
                    <a href="#tab_0" data-toggle="tab" aria-expanded="true">
                        Phiếu nợ
                    </a>
                </li>
                <li class="">
                    <a id="a_1" href="#tab_1" data-toggle="tab" aria-expanded="false">
                        Chi tiết phiếu thu nợ
                    </a>
                </li>
            </ul>
            <div class="tab-content">
                <div class="tab-pane active" id="tab_0">
                    <div class="x_panel">
                        <div class="x_content">
                            <form method="get" class="row">
                                <input name="id" type="hidden" value="@ViewBag.Type" />
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <label>Từ ngày thu</label>
                                        <input type="text" class="form-control input-sm date" value="@ViewBag.From" name="from" />
                                    </div>
                                </div>
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <label>Đến ngày thu</label>
                                        <input type="text" class="form-control input-sm date" value="@ViewBag.To" name="to" />
                                    </div>
                                </div>
                                <div class="col-md-5 col-sm-5 col-xs-12">
                                    <div class="form-group">
                                        <label>Từ khóa</label>
                                        <input type="text" title="Mã phiếu" placeholder="Mã phiếu" class="form-control input-sm " value="@ViewBag.Query" name="query" />
                                    </div>
                                </div>
                                <div class="col-md-3 col-sm-3 col-xs-12">
                                    <div class="form-group">
                                        <br />
                                        <input type="submit" value="Tìm kiếm" class="btn btn-success" />
                                        <input type="button" value="Xuất excel" class="btn btn-info" id="btnExportExcel" />
                                    </div>
                                </div>
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                </div>
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                </div>
                                <div class="col-md-6 col-sm-6 col-xs-12">
                                    <div class="form-group">
                                        @Html.RadioButton("tinhtrang", "", true, new { id = "All" }) Tất Cả
                                        @Html.RadioButton("tinhtrang", "H", false, new { id = "H" }) Hoàn tất
                                        @Html.RadioButton("tinhtrang", "C", false, new { id = "C" }) Chưa hoàn tất
                                    </div>
                                </div>
                            </form>
                            <div class="table-responsive" id="@ViewBag.Type">
                                <div class="right">
                                    <i class="fa fa-plus" style="cursor:pointer" id="ThemMoi"></i>
                                </div>
                                <table class="table">
                                    <thead>
                                        <tr class="success">
                                            <th>STT</th>
                                            <th>
                                                <input type="checkbox" id="CHKALL" />
                                            </th>
                                            <th>Ngày nợ</th>
                                            <th>Mã phiếu</th>
                                            <th>Công ty</th>
                                            <th>Khách hàng</th>
                                            <th>Nội dung</th>
                                            <th>Số tiền nợ</th>
                                            <th>Đã thanh toán</th>
                                            <th>Còn nợ</th>
                                            <th style="display:@ViewBag.HienThiNguoiBaoLanh">Người bảo lãnh</th>
                                            <th>Tình trạng</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@(ViewBag.PageSize * (ViewBag.PageIndex - 1) + i++)</td>
                                                <th>    
                                                    @if (item.TinhTrang.Length == 8)
                                                    {
                                                    }
                                                    else if(item.TinhTrang.Length > 8)
                                                    {
                                                        <input type="checkbox" value="@item.MaPhieuNo" class="checkbox" />
                                                        <input type="hidden" value="@(string.IsNullOrEmpty(item.DonViNo) ? "null" : item.DonViNo)" />
                                                    }
                                                </th>
                                                <td>@item.NgayNo.ToString("dd/MM/yyyy")</td>
                                                <td>@item.MaPhieuNo</td>
                                                <td>@item.DonViNo</td>
                                                <td>@item.HoTenKH</td>
                                                <td>@item.NoiDung</td>
                                                <td class="number2">@TNK.Core.Common.ToCurrencyString(item.SoTienNo)</td>
                                                <td class="number2">@TNK.Core.Common.ToCurrencyString(item.SoTienDaTra)</td>
                                                <td class="number2">@TNK.Core.Common.ToCurrencyString(item.SoTienConLai)</td>
                                                <td style="display:@ViewBag.HienThiNguoiBaoLanh">@item.NguoiBaoLanh</td>
                                                @if (!string.IsNullOrEmpty(item.MaPhieuThu))
                                                {
                                                    <td style="width:5%" class="center">
                                                        <a href="/SoThu/ThuNoHoEdit/@item.MaPhieuThu?type=@ViewBag.Type" style="color:blue;" title="Xem chi tiết phiếu thu nợ">
                                                            @item.TinhTrang
                                                        </a>
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td>@item.TinhTrang</td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <div class="right">
                                    @Html.Partial("~/Views/Shared/_Paging_v2.cshtml")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!---===-->
                <div class="tab-pane" id="tab_1">
                    <div class="x_panel">
                        <div class="x_content">
                            <div method="get" class="row">
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <label>Từ ngày thu</label>
                                        <input type="text" id="from" class="form-control input-sm date" value="@ViewBag.From" name="from" />
                                    </div>
                                </div>
                                <div class="col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <label>Đến ngày thu</label>
                                        <input type="text" id="to" class="form-control input-sm date" value="@ViewBag.To" name="to" />
                                    </div>
                                </div>
                                <div class="col-md-5 col-sm-5 col-xs-12">
                                    <div class="form-group">
                                        <label>Từ khóa</label>
                                        <input type="text" id="query" title="Mã phiếu" placeholder="Mã phiếu" class="form-control input-sm " value="@ViewBag.Query" name="query" />
                                    </div>
                                </div>
                                <div class="col-md-3 col-sm-3 col-xs-12">
                                    <div class="form-group">
                                        <br />
                                        <input type="submit" value="Tìm kiếm" id="Search" class="btn btn-success" />
                                        <input type="button" value="Xuất excel" onclick="ExportExcel()" class="btn btn-info" id="ExportExcel1" />
                                    </div>
                                </div>
                            </div>
                            <div class="table-responsive" id="tbody">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
</div>
@section scripts
{
    <script src="~/Scripts/IndexCommon.js"></script>
    <script>
        $("#CHKALL").change(function () {
            debugger;
            $("input:checkbox").prop('checked', $(this).prop("checked"));
        });
        var chk = "";
        var flag = true;
        $(".checkbox").change(function () {
            debugger;
            chk = "";
            $(".checkbox").map(function (key, val) {
                flag = true;
                if ($(val).is(":checked")) {
                    let a = $(val).closest("th").find("input[type=hidden]").val();
                    if (chk == "") {
                        chk = a;
                    }
                    else {
                        if (a != chk) {
                            flag = false;
                            toastError("Chỉ được chọn các phiếu nợ của cùng 1 @ViewBag.KhachHangNoTitle.ToLower()");
                            $(val).attr("checked", "false");
                            $(val).click();
                        }
                    }
                }
            })

        })


        function setCookie(cname, cvalue) {
            document.cookie = cname + "=" + cvalue + ";path=/SoThu/ThuNoHoCreate/";
        }

        $("#ThemMoi").click(function () {
            debugger;
            var result = "";
            var flag = true;
            var ctbh = "";
            $(".checkbox").map(function (key, val) {
                if ($(val).is(":checked")) {
                    let a = $(val).closest("th").find("input[type=hidden]").val();
                    if (ctbh == "") {
                        ctbh = a;
                    }
                    if (a != ctbh) {
                        if (flag) {
                            toastError("Chỉ được chọn các phiếu nợ của cùng 1 " + '@ViewBag.KhachHangNoTitle.ToLower()');
                        }
                        flag = false;
                        return;
                    }
                    result += $(val).val() + ",";
                }
            })
            if (result != "") {
                result = result.substring(0, result.length - 1);
            }
            if (result != "" && flag == true)
            {
                setCookie("link", result);
                window.location = "/SoThu/ThuNoHoCreate/" + 0 + "?type=@ViewBag.Type";
            }

        })

        var type = '@ViewBag.Type';
        var p = 1;
        $("#Search").click(function () {
            $(this).val("Loading...");
            $(this).prop('disabled', true);
            Search(this);
        })
        function change() {
            p = 1;
        }
        function Search(obj) {
            debugger;
            var pageSizes = 30;
            if (!isNaN(parseInt(obj)))
                pageSizes = parseInt(obj);
            var from = $("#from").val();
            var to = $("#to").val();
            var query = $("#query").val();
            $.get("/SoThu/ThuNoComplete?id=" + type + "&query=" + query + "&from=" + from + "&to=" + to + "&p=" + p + "&pageSize=" + pageSizes).success(function (response) {
                $("#tbody").html(response);
                $("#tbody").find(".number2").map(function (key, val) {
                    var val = $(this).html();
                    if (val != "") {
                        val = val.split(",").join("");
                        val = parseInt(val);
                        $(this).html(val.toLocaleString());
                    }
                })
                $(obj).val("Tìm kiếm");
                $(obj).prop('disabled', false);
            })
        }
        var a;
        $(document).on("click", "#tbody a", function () {
            a = $(this).attr("href");
            var b = a.split("&");
            p = b[3].split("=")[1];
            Search();
            return false;
        })
        function Delete(a, id) {
            if (confirm('Xác nhận')) {
                data = { id: id, type: 'ThuNo' };
                $.post("/SoThu/DeletePhieuThu", data).success(function (response) {
                    if (response == "success") {
                        $(a).closest("tr").remove();
                        toastSuccess("Đã xóa thành công");
                    }
                    else
                        toastError(response);
                });
            }
        }
        function Save(MaPhieuNo)
        {
            debugger;
            var Sales = $("#Sales_" + MaPhieuNo).val();
            var GhiChu = $("#GhiChu_" + MaPhieuNo).val();
            $.ajax({
                url: "/SoThu/Update_SalesNote",
                type: "POST",
                data: { MaPhieuNo: MaPhieuNo, Sales: Sales, GhiChu: GhiChu },
                success: function (result) {
                    if (!result.IsError) {
                        toastSuccess(result.Message);
                    }
                    else {
                        toastWarning(result.Message);
                    }
                },
                error: function (result) {
                    toastWarning("Lỗi: Cập nhật Sales và Ghi chú.");
                }
            });
        }
           $("#btnExportExcel").click(function () {
            debugger;
            if ($($("#tab_data li.unactive")[0]).attr("data-url") != "") {
                var dt = new Date();
                var day = dt.getDate();
                var month = dt.getMonth() + 1;
                var year = dt.getFullYear();
                var hour = dt.getHours();
                var mins = dt.getMinutes();
                var postfix = day + "." + month + "." + year + "_" + hour + "." + mins;
                var idtable = "#@ViewBag.Type";
                var result = $(idtable).html();
                result = result.replace('class="table"', 'class="table" border="1"');
                //alert(result)
                tableToExcel(result, 'ThuNo' + '_@ViewBag.Type' + '_' + postfix + '.xls');
            }
            else {
                window.location = `/SoThu/ThuNo/NHHGP?from=${$("#FromDate").val()}&to=${$("#ToDate").val()}&export=Excel`;
            }
            return false;
        })
         //phan xuat excel
        $("#ExportExcel1").click(function () {
            debugger;
            if ($($("#tab_data li.unactive")[0]).attr("data-url") != "") {
                var dt = new Date();
                var day = dt.getDate();
                var month = dt.getMonth() + 1;
                var year = dt.getFullYear();
                var hour = dt.getHours();
                var mins = dt.getMinutes();
                var postfix = day + "." + month + "." + year + "_" + hour + "." + mins;
                var idtable = "#tbody";
                var result = $(idtable).html();
                result = result.replace('class="table"', 'class="table" border="1"');
                //alert(result)
                tableToExcel(result, 'ThuNo' + '_@ViewBag.Type' + 'Complete_' + postfix + '.xls');
            }
            else {
                window.location = `/SoThu/ThuNo/NHHGP?from=${$("#FromDate").val()}&to=${$("#ToDate").val()}&export=Excel`;
            }
            return false;
        })
        var tableToExcel = (function () {
            debugger;
            var uri = 'data:application/vnd.ms-excel;base64,'
                , template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>{table}</table></body></html>'
                , base64 = function (s) { return window.btoa(unescape(encodeURIComponent(s))) }
                , format = function (s, c) { return s.replace(/{(\w+)}/g, function (m, p) { return c[p]; }) }
            return function (table, name) {
                //if (!table.nodeType) table = document.getElementById(table)
                var ctx = { worksheet: name || 'Worksheet', table: table }
                var link = document.createElement("A");
                link.href = uri + base64(format(template, ctx));
                link.download = name || 'Baocao.xls';
                link.target = '_blank';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            }
        })()
    </script>
}
