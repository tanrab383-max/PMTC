@model TNK.Model.SoThuModel
@{
    var item = Model.Item;
}

<div class="">
    <div class="page-title">
        <div class="title_left">
            <h3>@ViewBag.Title</h3>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="row">
        <div class="col-md-12 col-sm-12 col-xs-12">
            <div class="x_panel">
                <div class="x_title">
                    <h2><b>Thông tin hóa đơn</b></h2>
                    <ul class="nav navbar-right panel_toolbox">
                        <li>
                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                        </li>
                    </ul>
                    <div class="clearfix"></div>
                </div>
                <div class="x_content">
                    <form id="form-data" method="post" class="form-horizontal form-label-left">
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        @Html.HiddenFor(x => x.Item.MaLoaiPhieu)
                        @Html.HiddenFor(x => x.Item.MaPhieuThu)
                        <div class="row">
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Số chứng từ (*)</label>
                                    @Html.EditorFor(x => item.SoChungTu, new { htmlAttributes = new { @class = "form-control input-sm", @required = "" } })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Ngày thu</label>
                                    <input type="text" class="form-control input-sm date " name="item.NgayThu" value="@item.NgayThu.ToString("dd/MM/yyyy")" required  />
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Người mua (*)</label>
                                    @Html.EditorFor(x => item.HoTen, new { htmlAttributes = new { @class = "form-control input-sm", @required = "" } })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Điện thoại</label>
                                    @Html.EditorFor(x => item.DienThoai, new { htmlAttributes = new { @class = "form-control input-sm" } })
                                </div>
                            </div>

                            <div class="col-md-8 col-sm-8 col-xs-12">
                                <div class="form-group">
                                    <label>Địa chỉ</label>
                                    @Html.EditorFor(x => item.DiaChi, new { htmlAttributes = new { @class = "form-control input-sm" } })
                                </div>
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label>Nội dung</label>
                                    <table id="ChiTietBanTaiSan" class="table table-striped jambo_table bulk_action">
                                        <thead>
                                            <tr>
                                                <th style="min-width:200px">Tên tài sản</th>
                                                <th>Giá mua</th>
                                                <th>Đã khấu hao</th>
                                                <th>Giá trị còn lại</th>
                                                <th>Giá bán</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody id="tbodyChiTietBanTaiSan">
                                            @for (int i = 0; i < Model.CTBTS.Count; i++)
                                            {
                                                <tr>
                                                    <td>
                                                        <input type="hidden" name="ctbts[@i].Id" value="@Model.CTBTS[i].Id" />
                                                        <input type="hidden" name="ctbts[@i].MaTaiSan" class="MaTaiSan" value="@Model.CTBTS[i].MaTaiSan" />
                                                        <input type="hidden" name="ctbts[@i].IsDeleted" class="IsDeleted" value="@Model.CTBTS[i].IsDeleted" />
                                                        <select class="selectCTBTS TenTaiSan fullwidth" onclick="changeCTBTS(this)" required></select>
                                                    </td>
                                                    <td><input class="form-control input-sm GiaMua" readonly /></td>
                                                    <td><input class="form-control input-sm DaKhauHao" readonly /></td>
                                                    <td><input class="form-control input-sm GiaTriConLai" readonly /></td>
                                                    <td><input class="form-control input-sm GiaBan number" required name="ctbts[@i].GiaBan" value="@Model.CTBTS[i].GiaBan" onchange="changeCTBTS(this)" maxlength="15" /></td>
                                                    <td><a href="#" onclick="Remove(this)"><i class="fa fa-remove"></i></a></td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td>
                                                    Tổng cộng
                                                    @Html.HiddenFor(x => item.TongCong)
                                                </td>
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                                <td class="TongCongCTBTS">
                                                    @(  item.TongCong == 0 ? "0" : item.TongCong.ToString("0,0"))
                                                </td>
                                                <td><a href="#" onclick="AddCTBTS()"><i class="fa fa-plus"></i></a></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12">
                                @Html.Partial("~/Views/Shared/_ThanhToan_1.cshtml", null, new ViewDataDictionary { { "CTPT", Model.CTPT }, { "HTTT", Model.HTTT } })
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Còn lại</label>
                                    @Html.EditorFor(x => item.ConLai, new { htmlAttributes = new { @class = "form-control input-sm number", @readonly = "" } })
                                </div>
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label>Ghi chú</label>
                                    @Html.TextAreaFor(x => item.GhiChu, new { @class = "form-control input-sm" })
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12">
                                <div class="form-group">
                                    <label>Kế toán trưởng</label>
                                    @Html.DropDownListFor(x => item.KeToanTruong, Model.Users.Select(x => new SelectListItem { Text = x.UserName, Value = x.UserId.ToString() }), "Chọn", new { @class = "select2 fullwidth" })
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12">
                                <div class="form-group">
                                    <label>Người lập phiếu</label>
                                    @Html.DropDownListFor(x => item.NguoiLapPhieu, Model.Users.Select(x => new SelectListItem { Text = x.UserName, Value = x.UserId.ToString() }), "Chọn", new { @class = "select2 fullwidth" })
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12">
                                <div class="form-group">
                                    <label>Người nộp tiền</label>
                                    @Html.DropDownListFor(x => item.NguoiNopTien, Model.Users.Select(x => new SelectListItem { Text = x.UserName, Value = x.UserId.ToString() }), "Chọn", new { @class = "select2 fullwidth" })
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12">
                                <div class="form-group">
                                    <label>Người thu tiền (*)</label>
                                    @Html.DropDownListFor(x => item.NguoiThuTien, Model.Users.Select(x => new SelectListItem { Text = x.UserName, Value = x.UserId.ToString() }), "Chọn", new { @class = "select2 fullwidth" })
                                </div>
                            </div>
                        </div>
                        <div class="ln_solid"></div>
                        @if (ViewBag.Type != "Edit")
                        {
                            <div class="form-group">
                                <div class="col-md-6 col-sm-6 col-xs-12 col-md-offset-3">
                                    <input type="submit" value="Save" class="btn btn-success" />
                                </div>
                            </div>
                        }
                        <div class="ln_solid"></div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<a href="/SoThu/TBATSIndex" class="Back">Quay lại</a>
@section scripts
{
    <link href="~/assests/plugins/select2/select2.css" rel="stylesheet" />
    <script src="~/assests/plugins/select2/select2.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/SoThuCommon.js"></script>
    <script>
        i = '@Model.CTPT.Count';
        j = '@Model.CTBTS.Count';
        $(".addHTTT").click(function () {
            var html = tr.split("httt[0]").join("httt[" + i + "]");
            @if(Model.CTPT.Count>0)
            {
             @Html.Raw("html=html.replace('" + Model.CTPT[0].Id+"','');")
             @Html.Raw("html=html.replace('" + Model.CTPT[0].SoTienThanhToan+"','');")
             @Html.Raw("html=html.replace('selected','');")
             @Html.Raw("html=html.replace('" + Model.CTPT[0].SoThamChieu + "','');")
            }
            $("#tbody").append("<tr>" + html + "</tr>");
            i++;
            setTimeout(function () {
                $('.select2').select2({
                    placeholder: "Select an option",
                    allowClear: true
                });
                removeSelect();
            }, 200);
        })
        $(document).on("change", ".number", function () {
            var val = $(this).val();
            if (val != "") {
                val = val.split(",").join("");
                val = parseInt(val);
                //val = val * 1000;
                $(this).val(val.toLocaleString('en-us'));
            }
            else {
                $(this).val(0);
            }
            setTimeout(CalConLai, 200);
        });
        $("form").submit(function () {
            let flag = true;
            $("#tbody").find("tr").map(function (key, val) {
                if ($(val).is(":visible")) {
                    var tuitien = $(val).find(".Temp").select2('val');
                    var sotien = $(val).find(".number").val().split(",").join("");
                    tuitien = tuitien == "Chọn" ? "" : tuitien;
                    sotien = sotien == "" ? 0 : parseInt(sotien);
                    if (tuitien != "" && sotien === 0) {
                        toastWarning("Vui lòng nhập số tiền");
                        $(val).find(".number").focus();
                        flag = false;
                        return;
                    }
                    if (tuitien == "" && sotien != 0) {
                        toastWarning("Vui lòng nhập túi tiền");
                        $(val).find(".Temp").focus();
                        flag = false;
                        return;
                    }
                }
            })
            if (!flag) {
                return false;
            }
            var total = parseInt($("#item_ConLai").val().split(",").join(""));
            if (total < 0)
            {
                toastError("Số tiền thanh toán không được lớn hơn số tiền còn nợ");
                return false;
            }
            var lst = $(".number");
            lst.map(function (key, val) {
                $(val).val($(val).val().split(",").join(""));
            });
        })
        var KTS = [];
        var htmlCTBTS = "";
        var Type = '@ViewBag.Type';
        $(document).ready(function () {
            debugger;
            var API = "";
            if (Type == "Create")
            {
                API = "GetKhoTaiSan";
            }
            else if (Type == "Edit")
            {
                API = "GetKhoTaiSan_Edit";
            }
            $.post("/SoThu/"+API).success(function (response) {
                KTS = response;
                $(".selectCTBTS").html("");
                var opt = document.createElement("option");
                opt.text = "Chọn";
                opt.value = "";
                $(".selectCTBTS").append(opt);
                response.map(function (val, key) {
                    var option = document.createElement("option");
                    option.value = val.KId;
                    option.text = val.TenTaiSan;
                    $(".selectCTBTS").append(option);
                });
                $(".selectCTBTS").map(function (key, val) {
                    var tr = $(val).closest("tr");
                    var id = tr.find(".MaTaiSan").val();
                    var obj = searchKTS(id);
                    if (obj != undefined) {
                        setValue(tr, obj);
                        tr.find(".TenTaiSan").val(id);
                    }
                });
                if (j > 0) {
                    htmlCTBTS = $($("#tbodyChiTietBanTaiSan").find("tr")[0]).html();
                }
                $(".selectCTBTS").select2();
            });
        })

        function searchKTS(id) {
            var obj;
            KTS.map(function (val, key) {
                if (val.KId == id) {
                    obj = val;
                }
            });
            return obj;
        }
        $(document).on("change", ".selectCTBTS", function () {
            var id = $(this).val();
            var obj = searchKTS(id);
            var tr = $(this).closest("tr");
            if (obj != undefined)
                setValue(tr, obj);
        });
        function Remove(a) {
            var tr = $(a.closest("tr"));
            tr.hide("fadeOut");
            tr.find(".IsDeleted").val("true");
            tr.find(".number").remove();
            tr.html(tr.html().split("required").join(""));
            changeCTBTS();
            CalThanhToan(a);
            setTimeout(CalConLai, 300);
        }
        function setValue(tr, obj) {
            tr.find(".MaTaiSan").val(obj.KId);
            tr.find(".GiaMua").val(obj.GiaMua.toLocaleString('en-us'));
            tr.find(".DaKhauHao").val((obj.GiaTriConLai - obj.GiaMua).toLocaleString('en-us'));
            tr.find(".GiaTriConLai").val(obj.GiaTriConLai.toLocaleString('en-us'));
        }

        function RemoveCTBTS(obj) {
            $(obj).closest("tr").find(".IsDeleted").val(true);
            $(obj).closest("tr").hide("fadeOut");
        }
        function AddCTBTS() {
            var html = htmlCTBTS.split("ctbts[0]").join("ctbts[" + j + "]");
            var tr = document.createElement("tr");
            tr.innerHTML = html;
            $("#tbodyChiTietBanTaiSan").append(tr);
            j++;
            $(tr).find(".selectCTBTS").select2();
        }

        function changeCTBTS() {
            setTimeout(function () {
                var total = 0;
                $(".GiaBan").map(function (key, val) {
                    if ($(val).val() === "") {
                    }
                    else
                        total += parseInt($(val).val().split(',').join(""));
                });
                $(".TongCongCTBTS").html(total.toLocaleString('en-us')); ``
                $("#item_TongCong").val(total);
            }, 100);
        }


        var CalConLai = () => {
            var total = parseInt($("#item_TongCong").val().split(',').join("")) - parseInt($(".Total").html().split(',').join(""));
            $("#item_ConLai").val(total.toLocaleString('en-us'));
        }
    </script>
}






