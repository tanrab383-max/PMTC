@model List<TNK.Core.Domain.View.ViewTKHAC>


<div class="page-title">
    <div class="title_left">
        <h3>@ViewBag.Title</h3>
    </div>
</div>
<div class="clearfix"></div>
<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_panel">
            <div class="x_title">
                <h2><b></b></h2>
                <ul class="nav navbar-right panel_toolbox">
                    <li>
                        <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                    </li>
                    <li>
                        <a href="/SoThu/THHHBCreate"><i class="fa fa-plus"></i></a>
                    </li>
                </ul>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr class="success">
                                <th>Ngày thu</th>
                                <th>Chứng từ thu</th>
                                <th>Đối tác</th>
                                <th>Số tiền</th>
                                <th>Tình trạng</th>
                                <th></th>
                                <th></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>@item.NgayThu.ToString("dd/MM/yyyy")</td>
                                    <td>@item.SoChungTu</td>
                                    <td>@item.ThongTinKhac</td>
                                    <td>@item.TongCong.ToString("0,0")</td>
                                    <td>@item.TinhTrangPhieu</td>
                                    <td style="width:5%" class="center">
                                        <a href="/SoThu/THHHBEdit/@item.MaPhieuThu"><i title="Edit" class="fa fa-edit"></i></a>
                                    </td>
                                    <td style="width:5%" class="center">
                                        <a href="javascript:;" onclick="Delete(this,'@item.MaPhieuThu')"><i title="Delete" class="fa fa-close"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
    <div class="clearfix"></div>
</div>
@section scripts
{
    <script>
        function Delete(a,id) {
            if(confirm('Xác nhận'))
            {
                data = {id:id,type:'TKHAC'};
                $.post("/SoThu/DeletePhieuThu", data).success(function (response) {
                    if(response=="success")
                    {
                        $(a).closest("tr").remove();
                    }
                });
            }
        }
    </script>
}
