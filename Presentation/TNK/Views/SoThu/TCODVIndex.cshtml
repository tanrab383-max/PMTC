@model List<TNK.Core.Domain.View.ViewTCODV>
@{
    int i = 1;
}
    <div class="page-title">
        <div class="title_left">
            <h3>@ViewBag.Title</h3>
        </div>
        <div class="title_right" style="margin-left:88%">
            <a href="#" download><span style="font-style:italic;color:blue;font-size:15px" id="FileMau">Lấy file mẫu(*.xlxs)</span></a>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="row">
        <div class="col-md-12 col-sm-12 col-xs-12">
            <div class="x_panel">
                <div class="x_title">
                    <h2><b></b></h2>
                    <ul class="nav navbar-right panel_toolbox">
                        <li>
                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                        </li>
                        <li>
                            <a href="/SoThu/PhieuThu?type=TCODV"><i class="fa fa-plus addNew"></i></a>
                        </li>
                    </ul>
                    <div class="clearfix"></div>
                </div>
                <div class="x_content">
                    <form id="formSearch" method="get" class="row">
                        <div class="col-md-2 col-sm-2 col-xs-12">
                            <div class="form-group">
                                <label>Từ ngày thu</label>
                                <input type="text" class="form-control input-sm date" value="@ViewBag.From" name="from" />
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-2 col-xs-12">
                            <div class="form-group">
                                <label>Đến ngày thu</label>
                                <input type="text" class="form-control input-sm date" value="@ViewBag.To" name="to" />
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Từ khóa</label>
                                <input type="text" title="Mã phiếu thu, Khách hàng, Số chứng từ, Biển số, Điện thoại" placeholder="Mã phiếu thu, Khách hàng, Số chứng từ, Biển số, Điện thoại" class="form-control input-sm " value="@ViewBag.Query" name="query" />
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <br />
                                <input type="submit" style="width:30%" value="Tìm kiếm" class="btn btn-success" />
                                <input type="button" name="exportExcel" id="exportExcel" value="Excel" class="btn btn-success" />
                                <input style="width:40%" onclick="ImportData()" title="Import dữ liệu" value="Import Excel" class="btn btn-primary" />
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-2 col-xs-12">
                        </div>
                        <div class="col-md-2 col-sm-2 col-xs-12">
                        </div>
                        <div class="col-md-6 col-sm-6 col-xs-12">
                            <div class="form-group">
                                @Html.RadioButton("tinhtrang", "", true, new { id = "All" }) Tất Cả
                                @Html.RadioButton("tinhtrang", "D", false, new { id = "D" }) Đang sử dụng
                                @Html.RadioButton("tinhtrang", "H", false, new { id = "H" }) Hoàn tất
                                @Html.RadioButton("tinhtrang", "C", false, new { id = "C" }) Chưa sử dụng
                            </div>
                        </div>
                    </form>
                    <div class="table-responsive">
                        <table class="table" id="tbody">
                            <thead>
                                <tr class="success">
                                    <th>STT</th>
                                    <th>Bỏ cọc</th>
                                    <th>Ngày thu</th>
                                    <th>Mã phiếu thu</th>
                                    <th>Chứng từ</th>
                                    <th>Biển số</th>
                                    <th>Khách hàng</th>
                                    <th>Địa chỉ</th>
                                    <th>Số tiền</th>
                                    <th>Đã dùng</th>
                                    <th>Trả cọc</th>
                                    <th>Còn lại</th>
                                    <th>Tình trạng</th>
                                    <th></th>
                                    <th></th>
                                    <th></th>

                                    <th>Ghi chú</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                <tr>
                                    @if (item.TinhTrangPhieu == "H" || string.IsNullOrEmpty(item.MaPhieuThu))
                                    {
                                        <td>@(ViewBag.PageSize * (ViewBag.PageIndex - 1) + i)</td>
                                        <td>
                                            <input type="checkbox" class="chkActive" ptId="@item.MaPhieuThu" @(item.TTPCode == "B" ? "checked" : "") />
                                        </td>
                                        <td>@item.NgayThu.ToString("dd/MM/yyyy")</td>
                                        <td>@item.MaPhieuThu</td>
                                        <td>@item.SoChungTu</td>
                                        <td>@item.BienSo</td>
                                        <td>@item.HoTen</td>
                                        <td>@item.DiaChi</td>
                                        <td class="number2">@item.TongCong</td>
                                        <td class="number2">@item.SoTienDaSuDung</td>
                                        <td class="number2">@item.SoTienChiTra</td>
                                        <td class="number2">@item.ConLai</td>
                                        <td><a href="" style="color:blue" onclick="window.open('/SoThu/ChiTietCocMuaXe?MaPhieuThu=@item.MaPhieuThu', 'newwindow', 'width=900, height=900,left=200'); return false;" target="_blank" title="LỊCH SỬ DÙNG CỌC">Hoàn tất</a></td>
                                        <td style="width:5%" class="center">
                                            @if (item.TongCong != item.ConLai)
                                            {
                                                <a href="/SoThu/PhieuThu/@item.MaPhieuThu?type=TCODV&actiontype=Update"><i title="View" class="fa fa-eye"></i></a>
                                            }
                                            else
                                            {
                                                <a href="/SoThu/PhieuThu/@item.MaPhieuThu?type=TCODV&actiontype=Update"><i title="Edit" class="fa fa-edit"></i></a>
                                            }
                                        </td>
                                        <td style="width:5%" class="center">
                                            <a href="javascript:;" onclick="Delete(this,'@item.MaPhieuThu')"><i title="Delete" class="fa fa-close"></i></a>
                                        </td>
                                        <td></td>
                                        <td></td>
                                    }
                                    @if (item.TinhTrangPhieu == "D" || string.IsNullOrEmpty(item.MaPhieuThu))
                                    {
                                        <td>@(ViewBag.PageSize * (ViewBag.PageIndex - 1) + i)</td>
                                        <td>
                                            <input type="checkbox" class="chkActive" ptId="@item.MaPhieuThu" @(item.TTPCode == "B" ? "checked" : "") />
                                        </td>
                                        <td>@item.NgayThu.ToString("dd/MM/yyyy")</td>
                                        <td>@item.MaPhieuThu</td>
                                        <td>@item.SoChungTu</td>
                                        <td>@item.BienSo</td>
                                        <td>@item.HoTen</td>
                                        <td>@item.DiaChi</td>
                                        <td class="number2">@item.TongCong</td>
                                        <td class="number2">@item.SoTienDaSuDung</td>
                                        <td class="number2">@item.SoTienChiTra</td>
                                        <td class="number2">@item.ConLai</td>
                                        <td><a href="" style="color:blue" onclick="window.open('/SoThu/ChiTietCocMuaXe?MaPhieuThu=@item.MaPhieuThu', 'newwindow', 'width=900, height=900,left=200'); return false;" target="_blank" title="LỊCH SỬ DÙNG CỌC">Đang sử dụng</a></td>
                                        <td style="width:5%" class="center">
                                            @if (item.TongCong != item.ConLai)
                                            {
                                                <a href="/SoThu/PhieuThu/@item.MaPhieuThu?type=TCODV&actiontype=Update"><i title="View" class="fa fa-eye"></i></a>
                                            }
                                            else
                                            {
                                                <a href="/SoThu/PhieuThu/@item.MaPhieuThu?type=TCODV&actiontype=Update"><i title="Edit" class="fa fa-edit"></i></a>
                                            }
                                        </td>
                                        <td style="width:5%" class="center">
                                            <a href="javascript:;" onclick="Delete(this,'@item.MaPhieuThu')"><i title="Delete" class="fa fa-close"></i></a>
                                        </td>
                                        <td style="width:150px">
                                            <input type="text" id="GhiChu_@item.MaPhieuThu.ToUpper().Trim()" onmousemove="ShowTitle(this);" class="form-control input-sm textGhiChu" value="@item.GhiChu" title="ghi chú" style="width:150px" />
                                        </td>
                                        <td>
                                            <i class="fa fa-save" title="Lưu ghi chú @item.MaPhieuThu" style="cursor:pointer" onclick="SaveGhiChu('@item.MaPhieuThu')"></i>
                                        </td>
                                    }
                                    @if (item.TinhTrangPhieu == "C" || string.IsNullOrEmpty(item.MaPhieuThu))
                                    {
                                        <td>@(ViewBag.PageSize * (ViewBag.PageIndex - 1) + i)</td>
                                        <td>
                                            <input type="checkbox" class="chkActive" ptId="@item.MaPhieuThu" @(item.TTPCode == "B" ? "checked" : "") />
                                        </td>
                                        <td>@item.NgayThu.ToString("dd/MM/yyyy")</td>
                                        <td>@item.MaPhieuThu</td>
                                        <td>@item.SoChungTu</td>
                                        <td>@item.BienSo</td>
                                        <td>@item.HoTen</td>
                                        <td>@item.DiaChi</td>
                                        <td class="number2">@item.TongCong</td>
                                        <td class="number2">@item.SoTienDaSuDung</td>
                                        <td class="number2">@item.SoTienChiTra</td>
                                        <td class="number2">@item.ConLai</td>
                                        <td>Chưa sử dụng</td>
                                        <td style="width:5%" class="center">
                                            @if (item.TongCong != item.ConLai)
                                            {
                                                <a href="/SoThu/PhieuThu/@item.MaPhieuThu?type=TCODV&actiontype=Update"><i title="View" class="fa fa-eye"></i></a>
                                            }
                                            else
                                            {
                                                <a href="/SoThu/PhieuThu/@item.MaPhieuThu?type=TCODV&actiontype=Update"><i title="Edit" class="fa fa-edit"></i></a>
                                            }
                                        </td>
                                        <td style="width:5%" class="center">
                                            <a href="javascript:;" onclick="Delete(this,'@item.MaPhieuThu')"><i title="Delete" class="fa fa-close"></i></a>
                                        </td>
                                        <td style="width:150px">
                                            <input type="text" id="GhiChu_@item.MaPhieuThu.ToUpper().Trim()" onmousemove="ShowTitle(this);" class="form-control input-sm textGhiChu" value="@item.GhiChu" title="ghi chú" style="width:150px" />
                                        </td>
                                        <td>
                                            <i class="fa fa-save" title="Lưu ghi chú @item.MaPhieuThu" style="cursor:pointer" onclick="SaveGhiChu('@item.MaPhieuThu')"></i>
                                        </td>
                                    }
                                </tr>
                                    i++;
                                        }
                            </tbody>
                        </table>
                        <div class="right">
                            @Html.Partial("~/Views/Shared/_Paging_v2.cshtml")
                        </div>
                        <div class="center">
                            Tìm thấy : @ViewBag.Total data
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <div style="display:none"><input type="file" id="txtUploadFile" /></div>
    </div>
@section scripts
{
<script src="~/Scripts/IndexCommon.js"></script>
<script src="~/Scripts/jquery.fileDownload.js"></script>
<script>
        function Delete(a,id) {
            if(confirm('Xác nhận'))
            {
                data = {id:id,type:'TCODV'};
                $.post("/SoThu/DeletePhieuThu", data).success(function (response) {
                    if (response == "success") {
                        $(a).closest("tr").remove();
                        toastSuccess("Đã xóa thành công");
                    }
                    else
                        toastError(response);
                });
            }
        }

        $(".chkActive").change(function () {
            if (confirm("Xác nhận bỏ cọc")) {
                var type = $(this).is(":checked");
                var id = $(this).attr("ptId");
                $.post("/SoThu/ChangeTypeTCOBX", { id: id, type: type }).success(function (response) {
                    if (response === "success") {
                        toastSuccess("Cập nhật bỏ cọc thành công");
                    }
                    else {
                        toastError("Cập nhật không thành công");
                    }
                });
            }
        })
        function ExportFileMau() {
            debugger;

            $.fileDownload("/SoThu/ExportFile_TCDV", {
                httpMethod: "POST",
                data: {},
                failMessageHtml: "Có lỗi trong khi tải file excel."
            });
            return false;
        }
        $("#FileMau").click(function () {
            debugger;

            $.fileDownload("/SoThu/ExportFile_TCDV", {
                httpMethod: "POST",
                data: {},
                failMessageHtml: "Có lỗi trong khi tải file excel."
            });
            return false;
        });
        var datafile = new FormData();
        function ImportData() {
            $("#txtUploadFile").trigger('click');
        }
        $('#txtUploadFile').on('change', function (e) {
            if (document.getElementById("txtUploadFile").value != "") {
                var files = e.target.files;
                if (files.length > 0) {
                    if (window.FormData !== undefined) {
                        for (var x = 0; x < files.length; x++) {
                            datafile.append('file', files[x]);
                        }
                    }
                }

                $.ajax({
                    type: "POST",
                    url: "/SoThu/ImportData_TCDV",
                    contentType: false,
                    processData: false,
                    data: datafile,
                    beforeSend: function () {
                        // Đang thực hiện ajax
                        //để Loading...
                    },
                    complete: function () {
                        // Hoàn tất ajax
                        document.getElementById("txtUploadFile").value = "";
                        datafile.delete('file');
                    },
                    success: function (result) {
                        if (result.IsError)
                            toastError(result.Message);
                        else {
                            toastSuccess("Import thành công");
                            //window.location.reload();
                        }
                    },
                    error: function (xhr, status, p3, p4) {
                        toastError("Lỗi: Import file excel.");
                        //window.location.reload();
                    }
                });
            }
        });


        function SaveGhiChu(MaPhieuThu) {
            debugger;
            var GhiChu = $("#GhiChu_" + MaPhieuThu).val();
            $.ajax({
                url: "/SoThu/Update_GhiChuPhieuThu",
                type: "POST",
                data: { MaPhieuThu: MaPhieuThu, GhiChu: GhiChu},
                success: function (result) {
                    if (!result.IsError) {
                        toastSuccess(result.Message);
                    }
                    else {
                        toastWarning(result.Message);
                    }
                },
                error: function (result) {
                    toastWarning("Lỗi cập nhật ghi chú.");
                }
            });
        }
        function ShowTitle(obj) {
            $(obj).attr('title', $(obj).val());
        }

        $("#exportExcel").click(function () {
            debugger;
            if ($($("#tab_data li.unactive")[0]).attr("data-url") != "") {
                var dt = new Date();
                var day = dt.getDate();
                var month = dt.getMonth() + 1;
                var year = dt.getFullYear();
                var hour = dt.getHours();
                var mins = dt.getMinutes();
                var postfix = day + "." + month + "." + year + "_" + hour + "." + mins;
                //var idtable = $($("#tab_data li.unactive")).attr("data-url").replace("/SoChi/PhieuChi/", "#");
                //alert(idtable);
                var idtable = "#tbody";
                var result = $(idtable).html();
                result = result.replace('class="table"', 'class="table" border="1"');
                //alert(result)
                tableToExcel(result, 'SoThu' + '_@ViewBag.Type' + '_' + postfix + '.xls');
            }
            else {
                window.location = `/SoThu/TCODVIndex?from=${$("#FromDate").val()}&to=${$("#ToDate").val()}&export=Excel`;
            }
            return false;
        })

        var tableToExcel = (function () {
            debugger;
            var uri = 'data:application/vnd.ms-excel;base64,'
            , template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>{table}</table></body></html>'
            , base64 = function (s) { return window.btoa(unescape(encodeURIComponent(s))) }
            , format = function (s, c) { return s.replace(/{(\w+)}/g, function (m, p) { return c[p]; }) }
            return function (table, name) {
                //if (!table.nodeType) table = document.getElementById(table)
                var ctx = { worksheet: name || 'Worksheet', table: table }
                var link = document.createElement("A");
                link.href = uri + base64(format(template, ctx));
                link.download = name || 'Baocao.xls';
                link.target = '_blank';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            }
        })()
</script>
    }