        $(document).on("change", ".TienTraBH, .HoaHong,#item_TongCong", function () {
            debugger;
            let TienTraBH = 0;
            let HoaHong = 0;
            let Thucban = 0;
            let GiaVon = 0,GiamGia = 0;
            TienTraBH = parseInt($("#item_TienTraBH").val().split(",").join(""));
            HoaHong = parseInt($("#item_HoaHong").val().split(",").join(""));
            Thucban = parseInt($("#item_TongCong").val().split(",").join(""));
            $("#item_GiaVon").val((TienTraBH + HoaHong).toLocaleString('en-us'));
            GiaVon = parseInt($("#item_GiaVon").val().split(",").join(""));
            $("#item_GiamGia").val((GiaVon - Thucban).toLocaleString('en-us'));
        });
        function TinhConLai()
        {
            debugger;
            var TongThucThu = 0,TongCoc = 0,TongThanhToan = 0,TongHang=0;
            var a = $("#TongThucThu").val();
            if($("#TongThucThu").val() != 0 && $("#TongThucThu").val() !=  undefined)
            {
                TongThucThu = parseInt($("#TongThucThu").val().split(",").join(""));
            }
            if($("#TongCongThanhToanCoc").val() != 0 && $("#TongCongThanhToanCoc").val() != undefined)
            {
                TongCoc = parseInt($("#TongCongThanhToanCoc").val().split(",").join(""));
            }
            if($("#TongCongThanhToan").val() != 0 && $("#TongCongThanhToan").val() !=  undefined)
            {
                TongThanhToan = parseInt($("#TongCongThanhToan").val().split(",").join(""));
            }
            if("@type" == "TPHKI" || "@type" == "TPHKITemp" )
            {
                if ($("#TongCongThanhToan").val() == "" || $("#TongCongThanhToan").val()==0)
                {
                    TongThanhToan = parseInt("@ViewBag.TongCong");
                }
                else if ($("#TongCongThanhToan").text() != "")//TH load lại phiếu giảm cọc tăng thanh toán
                {
                    TongThanhToan = parseInt($("#TongCongThanhToan").text().split(",").join(""));
                }
            }
            if ($("#TongCongThanhToanHang").val() != 0 && $("#TongCongThanhToanHang").val() != undefined) {
                TongHang = parseInt($("#TongCongThanhToanHang").val().split(",").join(""));
            }
            var SoTien = TongThucThu - TongCoc - TongThanhToan - TongHang;
            $("#item_ConLai").val(SoTien.toLocaleString('en-us'));
            $("#item_ConLai").html(SoTien.toLocaleString('en-us'));
        }
        function TinhConLai_TKHAC() {
            debugger;
            var total = parseInt($("#TongCongThanhToan").text().split(",").join(""));
            var price = $("#TCTKHAC").val() == "" ? 0 : parseInt($("#TCTKHAC").val().split(",").join(""));
            var rest = price - total;
            $("#TCTKHAC").val(price.toLocaleString('en-us'));
            $("#Item_ConLai").val(rest.toLocaleString('en-us'));
            $("#Item_ConLai").html(rest.toLocaleString('en-us'));
    }
    var o = '@HANG_TT.Count';
        $(".addLHTT").click(function () {
            debugger
            // Lấy nội dung HTML từ #tr_Hang và chuyển thành chuỗi
            var html = $('#tr_Hang').prop('outerHTML');
            html = html.replace(/id="[^"]*"/g, '');
            // Thay thế lhtt[0] bằng lhtt[i]
            html = html.split("lhtt[-1]").join("lhtt[" + o + "]");

            @if(HANG_TT.Count>0)
            {
             @Html.Raw("html=html.replace('" + HANG_TT[0].Id+"','');");
             @Html.Raw("html=html.replace('" + HANG_TT[0].SoTienThanhToan+"','');")
             @Html.Raw("html=html.replace('selected','');")
             @Html.Raw("html=html.replace('hidden','');")
             @Html.Raw("html=html.replace('fullwidth','select2 fullwidth');")

            }
            $("#tbody_lhtt").append(html);
            o++;
            setTimeout(function () {
                $('.select2').select2({
                    placeholder: "Select an option",
                    allowClear: true
                });
                removeSelect();
            }, 200);
        })
