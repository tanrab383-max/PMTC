            function TinhTongGiaBan(heso) {
                var sogoi = $("#tbody_bdtk").find("tr:visible select option:selected[value!='']").length
                var sogoicyber = $('#tbody_bdtk').find('input.tengoibdtk').length;
                if (sogoi == 0) {
                    sogoi = sogoicyber;
                }
                sogoi = isNaN(sogoi) ? 0 : sogoi;

                debugger
                var s = $('#ngaythu').val();
                var arr = $('#ngaythu').val().split('/');

                var ngay = arr[0];
                var thang = arr[1];
                var nam = parseInt(arr[2]);
                var hansudung = '';


                if (sogoi != undefined) {
                    var n = parseInt(arr[0]); // ngày
                    var t = parseInt(arr[1]); // tháng (0-11 trong Date)
                    var nn = parseInt(arr[2]); // năm

                    // Tính toán lại tháng
                    var date = new Date(nn, t - 1, n); // Trừ 1 để đưa về 0-11
                    date.setMonth(date.getMonth() + (sogoi * 6 + 1));
                    // Lấy ngày với 2 chữ số
                    var ngay = date.getDate() < 10 ? '0' + date.getDate() : date.getDate().toString();

                    // Lấy tháng với 2 chữ số (cộng 1 do getMonth() trả về 0-11)
                    var thang = (date.getMonth() + 1) < 10 ? '0' + (date.getMonth() + 1) : (date.getMonth() + 1).toString();

                    // Lấy năm
                    var nam = date.getFullYear().toString();

                    // Chuỗi ngày/tháng/năm
                    var hansudung = ngay + '/' + thang + '/' + nam;

                    console.log(hansudung);
                    $(".hansudung").val(hansudung);
                    $('.hansudung').attr("disabled", 'disabled');
                }
                else {
                    $(".hansudung").val("");
                    $('.hansudung').removeAttr('disabled');
                }
                //var count = $("#tbody_bdtk").find("tr").length;
                tonggiaban = 0; tonggiamgia = 0; tongthucthu = 0; tonggianiemyet = 0;
                total = 0;
                $("#tbody_bdtk").find("tr").map(function (key, val) {
                    if ($(val).is(":visible")) {
                        var isDeleted = $(val).find(".IsDeleted").val();
                        if (isDeleted != "true") {
                            //Giá niêm yết
