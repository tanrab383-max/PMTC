@model TNK.Model.SoThuModel
@{
    var item = Model.Item;
    string type = ViewBag.Type;
    string action = ViewBag.Action;
    string typeoftemp = ViewBag.TypeOfTemp;
    double totalCoc = 0;
    double ThucThu = 0;
    double TienCong = 0;
    double SoLuong = 0;
    double GiaVon = 0;
    int SoDong = 0;
    item.LoaiBaoHiem = item.LoaiBaoHiem == "" ? "KHAC" : item.LoaiBaoHiem;
    if (type == "TPHKI" || type == "TPHKITemp" || type == "TKMPHKI" || type == "NKMPK")
    {
        SoDong = ViewBag.ListPhuTung.Rows.Count;
    }
    List<TNK.Core.Domain.ChiTietBanPhuKien> LPT = new List<TNK.Core.Domain.ChiTietBanPhuKien>();
    if (type == "T2THK")
    {
        ViewBag.Title = "Thu hộ khác";
    }
    else if (type == "TBHXH")
    {
        ViewBag.Title = "Thu BHXH";
    }
    var HANG_TT = Model.CTPT.Where(s => s.HinhThucThanhToan == "HA").ToList();
}

<div class="page-title">
    <div class="title_left">
        <h3>@(action == "Create" ? "Tạo mới" : "Cập nhật") @ViewBag.Title</h3>
    </div>
</div>
<div class="clearfix"></div>
<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_panel">
            <div class="x_title">
                <h2>Chi tiết phiếu thu</h2>
                <ul class="nav navbar-right panel_toolbox">
                    <li>
                        <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                    </li>
                </ul>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">
                <form id="form-data" method="post" class="form-horizontal form-label-left">
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    @Html.HiddenFor(x => item.MaPhieuThu)
                    @Html.HiddenFor(x => item.MaLoaiPhieu)
                    @Html.HiddenFor(x => item.MaPhieuLienQuan)
                    @Html.HiddenFor(x => item.UpdatedDate)
                    <input type="hidden" name="actiontype" id="actiontype" value="@action" />
                    <input type="hidden" name="type" id="type" value="@type" />

                    <div class="row">
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Số chứng từ (*)</label>
                                @if (type == "TBAHITemp" || type == "TPHKITemp")
                                {
                                    @Html.EditorFor(x => item.SoChungTu, new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "20", id = "SoChungTu", autofocus = "autofocus" } })
                                }
                                else if (typeoftemp == "TPHKITemp" || ((type == "TPHKI" || type == "TKMPHKI") && item.CyberId != null && item.CyberId != ""))
                                {
                                    @Html.EditorFor(x => item.SoChungTu, new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "20", id = "SoChungTu", @readonly = "" } })
                                }
                                else
                                {
                                    @Html.EditorFor(x => item.SoChungTu, new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "20", id = "SoChungTu" } })
                                }
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Ngày thu</label>
                                <input type="text" class="form-control input-sm date " id="ngaythu" name="item.NgayThu" value="@item.NgayThu.ToString("dd/MM/yyyy")" />
                            </div>
                        </div>
                        @if (type == "TBDTKKM")
                        {
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Số hợp đồng (*)</label>
                                    @Html.EditorFor(x => item.SoHopDong, new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "100", @id = "sohopdong" } })
                                </div>
                            </div>
                        }
                        @if (type == "TBHXH" || type == "T2GTX" || type == "T2THK")
                        {
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Thông tin khác</label>
                                    @Html.EditorFor(x => item.ThongTinKhac, new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "1000" } })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Đối tác (*)</label>
                                    @Html.DropDownListFor(x => item.DoiTac, Model.DoiTac.Select(x => new SelectListItem { Text = x.TenDoiTac, Value = x.MaDoiTac }), "Chọn", new { @class = "select2 fullwidth", @id = "DoiTac" })
                                </div>
                            </div>
                        }
                        @if (type == "T2THK")
                        {
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Biển số xe (*)</label>
                                    @Html.EditorFor(x => item.BienSo, new { htmlAttributes = new { @class = "form-control input-sm BienSo", @id = "BienSoTBAHI" } })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Số hợp đồng</label>
                                    @if (ViewBag.FlagT2THK == false)
                                    {
                                        @Html.EditorFor(x => item.SoHopDong, new { htmlAttributes = new { @class = "form-control input-sm SoHopDong", @maxlength = "1000", @disabled = "disabled" } })
                                    }
                                    else
                                    {
                                        @Html.EditorFor(x => item.SoHopDong, new { htmlAttributes = new { @class = "form-control input-sm SoHopDong", @maxlength = "1000" } })
                                    }
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Lý do thu(*)</label>
                                    @Html.DropDownListFor(x => Model.Item.LyDoThu, Model.LyDoThu.Select(x => new SelectListItem { Text = x.Name, Value = x.Code }), "Chọn", new { @class = "select2 fullwidth", @id = "LDC", @onchange = "DanhSachCoc(this)" })
                                </div>
                            </div>
                        }
                        @*Lộc update: Bán lẻ/Khuyến mãi phụ kiện*@
                        @if (type == "TCOBX" || type == "TCOBXTemp" || type == "TPHKI" || type == "TPHKITemp" || type == "TKMPHKI")
                        {
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    @*Lộc: Xét ràng buộc TPHKI*@
                                    @if (type == "TPHKI")
                                    {
                                        <label>Số hợp đồng</label>
                                    }
                                    else
                                    {
                                        <label>Số hợp đồng (*)</label>
                                    }
                                    @if (action == "Update" && type == "TPHKI")
                                    {
                                        @Html.EditorFor(x => item.SoHopDong, new { htmlAttributes = new { @class = "form-control input-sm SoHopDong" } })
                                    }
                                    else
                                    {
                                        @Html.EditorFor(x => item.SoHopDong, new { htmlAttributes = new { @class = "form-control input-sm SoHopDong", @id = "SoHopDong" } })
                                    }
                                </div>
                            </div>
                        }
                        @if (type == "NKMPK")
                        {
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Số hợp đồng</label>
                                    @Html.EditorFor(x => item.SoHopDong, new { htmlAttributes = new { @class = "form-control input-sm SoHopDong", @id = "SoHopDong", @readonly = 1 } })
                                </div>
                            </div>
                        }
                        @if (type == "TKHAC")
                        {
                            <input hidden name="item.MaPhieuLienQuan" value="@item.MaPhieuLienQuan" />
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Thông tin khác </label>
                                    @Html.EditorFor(x => item.ThongTinKhac, new { htmlAttributes = new { @class = "form-control input-sm " } })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Đối tác (*)</label>
                                    @Html.DropDownListFor(x => item.DoiTac, Model.DoiTac.Select(x => new SelectListItem { Text = x.TenDoiTac, Value = x.MaDoiTac }), "Chọn", new { @class = "select2 fullwidth", @id = "DoiTac" })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12" style="padding:0px">
                                <div class="col-md-5 col-sm-5 col-xs-12">
                                    <div class="form-group">
                                        <label>Số tiền</label>
                                        @*@Html.DropDownListFor(x => item.DoiTacTraLai, Model.DoiTac.Select(x => new SelectListItem { Text = x.TenDoiTac, Value = x.MaDoiTac }), "Chọn", new { @class = "select2 fullwidth" })*@
                                        @Html.EditorFor(x => Model.Item.TongCong, new { htmlAttributes = new { @class = "number form-control input-sm", @id = "TCTKHAC", @onchange = "TinhConLai_TKHAC()" } })
                                    </div>
                                </div>
                                @*//Trương Hoài Lộc: 24/08/2020
                //Thêm loại bảo hiểm: Thu Khác*@
                                <div class="col-md-7 col-sm-7 col-xs-12">
                                    <div class="form-group">
                                        <label>Số khung</label>
                                        @*@Html.DropDownListFor(x => item.DoiTacTraLai, Model.DoiTac.Select(x => new SelectListItem { Text = x.TenDoiTac, Value = x.MaDoiTac }), "Chọn", new { @class = "select2 fullwidth" })*@
                                        @Html.EditorFor(x => Model.Item.SoKhung, new { htmlAttributes = new { @class = "form-control input-sm", @id = "SOKHUNG" } })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Lý do thu(*)</label>
                                    @*@Html.DropDownListFor(x => item.DoiTacTraLai, Model.DoiTac.Select(x => new SelectListItem { Text = x.TenDoiTac, Value = x.MaDoiTac }), "Chọn", new { @class = "select2 fullwidth" })*@
                                    @Html.DropDownListFor(x => item.LoaiBaoHiem, Model.LoaiBH.Select(x => new SelectListItem { Text = x.Text, Value = x.Value }), "Chọn", new { @class = "select2 fullwidth", @id = "LoaiBH", @Value = "KHAC" })
                                </div>
                            </div>
                        }
                        @if (type == "TLADT")
                        {
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Đối tác trả lãi (*)</label>
                                    @Html.DropDownListFor(x => item.DoiTacTraLai, Model.DoiTac.Select(x => new SelectListItem { Text = x.TenDoiTac, Value = x.MaDoiTac }), "Chọn", new { @class = "select2 fullwidth" })
                                </div>
                            </div>
                        }
                        @if (type == "TVAMU")
                        {
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Hình thức vay(*)</label>
                                    @*@Html.DropDownListFor(x => item.DoiTacTraLai, Model.DoiTac.Select(x => new SelectListItem { Text = x.TenDoiTac, Value = x.MaDoiTac }), "Chọn", new { @class = "select2 fullwidth" })*@
                                    @Html.DropDownListFor(x => item.LoaiBaoHiem, Model.ListItem.Select(x => new SelectListItem { Text = x.Text, Value = x.Value }), "Chọn", new { @class = "select2 fullwidth", @id = "LoaiBH", @Value = "KHAC" })
                                </div>
                            </div>
                        }
                        @if (type == "TVAMU")
                        {
                            <div class="col-md-6 col-sm-6 col-xs-12">
                                <div class="form-group">
                                    <label>Đơn vị cho vay (*)</label>
                                    @Html.DropDownListFor(x => item.DoiTac, Model.DoiTac.Select(x => new SelectListItem { Text = x.TenDoiTac, Value = x.MaDoiTac }), "Chọn", new { @class = "select2 fullwidth" })
                                </div>
                            </div>
                        }
                        @if (type == "TBAHI")
                        {
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Họ tên khách hàng(*)</label>
                                    @Html.EditorFor(x => item.HoTen, new { htmlAttributes = new { @class = "form-control input-sm HoTen" } })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Công ty bảo hiểm</label>
                                    @Html.DropDownListFor(x => item.CTBH, Model.DoiTac.Select(x => new SelectListItem { Text = x.TenDoiTac, Value = x.MaDoiTac }), "Chọn", new { @class = "select2 fullwidth" })
                                </div>
                            </div>

                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Số hợp đồng (*)</label>
                                    @Html.EditorFor(x => item.SoHopDong, new { htmlAttributes = new { @class = "form-control input-sm SoHopDong", @id = "SoHopDongTBAHI" } })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Số khung</label>
                                    @Html.EditorFor(x => item.SoKhung, new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "17", @id = "SoKhungTBAHI" } })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Biển số xe (*)</label>
                                    @Html.EditorFor(x => item.BienSo, new { htmlAttributes = new { @class = "form-control input-sm BienSo", @id = "BienSoTBAHI" } })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Thực bán (*) </label>
                                    @Html.EditorFor(x => item.TongCong, new { htmlAttributes = new { @class = "form-control input-sm number ThanhTienBH", @maxlength = "15" } })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Tiền trả BH </label>
                                    @Html.EditorFor(x => item.TienTraBH, new { htmlAttributes = new { @class = "form-control input-sm number TienTraBH", @maxlength = "15" } })
                                    @*<input name="item.TienTraBH" class="form-control input-sm number TienTraBH" maxlength="15" value="@item.TienTraBH" />*@
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Hoa hồng</label>
                                    @Html.EditorFor(x => item.HoaHong, new { htmlAttributes = new { @class = "form-control input-sm number HoaHong", @maxlength = "15" } })
                                    @*<input name="item.HoaHong" class="form-control input-sm number HoaHong" maxlength="15" value="@item.HoaHong" />*@
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12" hidden>
                                <div class="form-group">
                                    <label>Thu hoa hồng ngay</label>
                                    @if (item.ThuHoaHongNgay != null && action == "Update")
                                    {
                                        <div class="form-inline">
                                            <input type="checkbox" onchange="Checked(this)" id="check" checked />
                                            <select id="hoahongngay" name="@item.ThuHoaHongNgay" class="form-control input-sm" style="height:29px;width:94%">
                                                @foreach (var THH in ViewBag.ThuHoaHong)
                                                {
                                                    <option value="@THH.GiaTri" @(item.ThuHoaHongNgay == THH.GiaTri ? "selected" : "")>@THH.HienThi</option>
                                                }
                                            </select>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="form-inline">
                                            <input type="checkbox" onchange="Checked(this)" id="check" />
                                            <select id="hoahongngay" name="@item.ThuHoaHongNgay" class="form-control input-sm" style="height:29px;width:94%"></select>
                                        </div>
                                    }

                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Giá bán</label>
                                    @Html.EditorFor(x => item.GiaVon, new { htmlAttributes = new { @class = "form-control input-sm number GiaBanBH", @readonly = "" } })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Giảm giá</label>
                                    @Html.EditorFor(x => item.GiamGia, new { htmlAttributes = new { @class = "form-control input-sm number GiamGiaBH", @readonly = "" } })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Tái tục</label>
                                    @Html.DropDownListFor(x => item.LoaiBaoHiem, Model.ListItem.Select(x => new SelectListItem { Text = x.Text, Value = x.Value }), "Chọn", new { @class = "select2 fullwidth LoaiBaoHiem" })
                                </div>
                            </div>
                        }
                        @if (type == "THHHB")
                        {
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Đối tác</label>
                                    @Html.DropDownListFor(x => item.DoiTac, Model.DoiTac.Select(x => new SelectListItem { Text = x.TenDoiTac, Value = x.MaDoiTac }), "Chọn", new { @class = "select2 fullwidth" })
                                </div>
                            </div>
                        }
                        @if (type == "TCODV" || type == "TBDTK")
                        {
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Biển số (*)</label>
                                    @Html.EditorFor(x => item.BienSo, new { htmlAttributes = new { @class = "form-control input-sm BienSo", @id = "BSX" } })
                                </div>
                            </div>
                        }

                        @if (type == "TBDTK")
                        {
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Số hợp đồng (*)</label>
                                    @Html.EditorFor(x => item.SoHopDong, new { htmlAttributes = new { @class = "form-control input-sm SoHopDong", @id = "SoHopDong" } })

                                </div>
                            </div>
                        }

                        @if (type == "T2GTX")
                        {
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Biển số (*)</label>
                                    @Html.EditorFor(x => item.BienSo, new { htmlAttributes = new { @class = "form-control input-sm BienSo", @id = "BSX" } })
                                </div>
                            </div>

                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Số hợp đồng (*)</label>
                                    @Html.EditorFor(x => item.SoHopDong, new { htmlAttributes = new { @class = "form-control input-sm SoHopDong", @id = "SoHopDong" } })

                                </div>
                            </div>
                        }


                        @if (type == "TCOBX" || type == "TCODV")
                        {
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group" id="DT">
                                    <label>Điện thoại</label>
                                    @Html.EditorFor(x => item.DienThoai, new { htmlAttributes = new { @class = "form-control input-sm", @id = "dienthoai" } })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group" id="DC">
                                    <label>Địa chỉ</label>
                                    @Html.EditorFor(x => item.DiaChi, new { htmlAttributes = new { @class = "form-control input-sm", @id = "diachi" } })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group" id="HTKH">
                                    <label>Họ tên khách hàng(*)</label>
                                    @Html.EditorFor(x => item.HoTen, new { htmlAttributes = new { @class = "form-control input-sm", @id = "hoten" } })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group" id="GiaBan">
                                    <label>Giá bán</label>
                                    @Html.EditorFor(x => item.GiaBan, new { htmlAttributes = new { @class = "form-control input-sm number", @maxlength = "15" } })
                                </div>
                            </div>
                        }
                        @if (type == "TPHKI" || type == "TKMPHKI")
                        {
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group" id="DT">
                                    <label>Điện thoại</label>
                                    @Html.EditorFor(x => item.DienThoai, new { htmlAttributes = new { @class = "form-control input-sm", @id = "dienthoai" } })
                                </div>
                            </div>
                            <div class="col-md-8 col-sm-8 col-xs-12">
                                <div class="form-group" id="DC">
                                    <label>Địa chỉ</label>
                                    @Html.EditorFor(x => item.DiaChi, new { htmlAttributes = new { @class = "form-control input-sm", @id = "diachi" } })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group" id="HTKH">
                                    <label>Họ tên khách hàng (*)</label>
                                    @if (typeoftemp == "TPHKITemp" || ((type == "TPHKI" || type == "TKMPHKI") && item.CyberId != null && item.CyberId != ""))
                                    {
                                        @Html.EditorFor(x => item.HoTen, new
                                        {
                                            htmlAttributes = new
                                            {
                                                @class = "form-control input-sm HoTen",
                                                @id = "hoten"@*, @readonly = ""*@}
})
                                    }
                                    else
                                    {
                                        @Html.EditorFor(x => item.HoTen, new { htmlAttributes = new { @class = "form-control input-sm HoTen", @id = "hoten" } })

                                    }
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>Biển Số</label>
                                    @if (action == "Update" && (type == "TPHKI" || type == "TKMPHKI"))
                                    {
                                        @Html.EditorFor(x => item.BienSo, new { htmlAttributes = new { @class = "form-control input-sm BienSo" } })
                                    }
