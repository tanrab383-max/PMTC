    function GetPhieuCoc(maPhieuThu,hoten,thamso) {
        debugger;
        if ('@type' != "TPHKITemp") {
            var strHoTen = hoten; //$(".BienSo").val().trim();
            var strTicket = thamso;
            var $tbody = $('#DanhSachCoc'); //ID table anh cần add dữ liệu vào
            var tienThanhToanCoc = 0;
            $tbody.html('');
            $.ajax({
                url: "/SoThu/GetPhieuCoc",
                type: "POST",
                data: { "maPhieuThu": maPhieuThu, "strHoTen": strHoTen, "strTicket": strTicket },
                success: function (result) {
                    if (!result.IsError) {
                        if (result.ListObj.length > 0) {
                            let j = 0;

                            $.each(result.ListObj, function (i, obj) {

                                var $tr = $('<tr></tr>');
                                var $td1 = $('<td></td>');
                                var $input = $('<input type="hidden" name="coc[' + i + '].SoThamChieu" value="' + obj.MaPhieuThu + '" /><label class="control-label">' + obj.HoTen + " " + formatDateToString(convertJsonDateTimeToJs(obj.NgayThu), "dd/MM/yyyy") + '</label>');
                                $td1.append($input);
                                var $td2 = $('<td><input type="text" class="form-control input-sm SoTienCoTheSuDung number" value="' + obj.TongCong.toLocaleString('en-us') + '" readonly /></td> ');
                                var $td3 = $(' <td><input type="text" name="coc[' + i + '].SoTienThanhToan" class="form-control input-sm SoTienThanhToan number dungCoc" id="coc[' + i + ']" onchange="change(this)" value="' + obj.SoTienDaSuDung.toLocaleString('en-us') + '" /></td> ');
                                var $td4 = $(' <td><input type="text" class="form-control input-sm SoTienConLai number" value="' + obj.ConLai.toLocaleString('en-us') + '" readonly /></td>');

                                tienThanhToanCoc += obj.SoTienDaSuDung;
                                $tr.append($td1);
                                $tr.append($td2);
                                $tr.append($td3);
                                $tr.append($td4);
                                $tbody.append($tr);// add thẻ tr vào tbody table
                            });

                        }
                        else {
                            //toastWarning(result.Message);
                        }
                        $("#TongCongThanhToanCoc").html(tienThanhToanCoc.toLocaleString('en-us'));
                        $("#TongCongThanhToanCoc").val(tienThanhToanCoc.toLocaleString('en-us'));
                    }
                },
                error: function (result) {
                }
            });
        }
                //
    }
    function GetPhieuCoc_V2(maPhieuThu, hoten, bienso, sohopdong) {
        debugger;
        var strHoTen = hoten; //$(".BienSo").val().trim();
        //var strTicket = thamso;
        var $tbody = $('#DanhSachCoc'); //ID table anh c?n add d? li?u vào
        var tienThanhToanCoc = 0;
        var maLoaiPhieu = $('#type').val();
        var changeAction = "change(this)";
        if (maLoaiPhieu == "TBAHI" || maLoaiPhieu == "TBDTK" || maLoaiPhieu == "T2GTX" || maLoaiPhieu == "T1GHB" || maLoaiPhieu == "T2THK")
            changeAction = "changeTBAHI(this)";
        //  alert(maLoaiPhieu);
        $tbody.html('');
        $.ajax({
            url: "/SoThu/GetPhieuCoc_V2",
            type: "POST",
            data: { "maPhieuThu": maPhieuThu, "strHoTen": strHoTen, "strBienSo": bienso, "strSoHopDong": sohopdong },
            success: function (result) {
                if (!result.IsError) {
                    if (result.ListObj.length > 0) {
                        let j = 0;

                        $.each(result.ListObj, function (i, obj) {

                            var $tr = $('<tr title ="Ngay thu:(' + formatDateToString(convertJsonDateTimeToJs(obj.NgayThu), "dd/MM/yyyy")  + ') Ma so coc: (' + obj.MaPhieuThu + ') + Ho ten: (' + obj.HoTen + ') + Bien so: (' + obj.BienSo + ') + So hop dong: (' + obj.SoHopDong + ')"></tr>');
                            var $td1 = $('<td></td>');
                            var $input = $('<input type="hidden" name="coc[' + i + '].SoThamChieu" value="' + obj.MaPhieuThu + '" /><label class="control-label">' + obj.MaPhieuThu + '+' + obj.HoTen + "+" + formatDateToString(convertJsonDateTimeToJs(obj.NgayThu), "dd/MM/yyyy") + '</label>');
                            $td1.append($input);
                            var $td2 = $('<td><input type="text" class="form-control input-sm SoTienCoTheSuDung number" value="' + obj.TongCong.toLocaleString('en-us') + '" readonly /></td> ');
                            var $td3 = $(' <td><input type="text" name="coc[' + i + '].SoTienThanhToan" class="form-control input-sm SoTienThanhToan number dungCoc" id="coc[' + i + ']" onchange="' + changeAction + '" value="' + obj.SoTienDaSuDung.toLocaleString('en-us') + '" /></td> ');
                            var $td4 = $(' <td><input type="text" class="form-control input-sm SoTienConLai number" value="' + obj.ConLai.toLocaleString('en-us') + '" readonly /></td>');

                            tienThanhToanCoc += obj.SoTienDaSuDung;
                            $tr.append($td1);
                            $tr.append($td2);
                            $tr.append($td3);
                            $tr.append($td4);
                            $tbody.append($tr);// add th? tr vào tbody table
                        });

                    }
                    else {
                        //toastWarning(result.Message);
                    }
                    $("#TongCongThanhToanCoc").html(tienThanhToanCoc.toLocaleString('en-us'));
                    $("#TongCongThanhToanCoc").val(tienThanhToanCoc.toLocaleString('en-us'));
                }
            },
            error: function (result) {
            }
        });
        //
    }
</script>
