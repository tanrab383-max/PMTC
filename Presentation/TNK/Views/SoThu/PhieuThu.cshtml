                                gianiemyet = 0;
                            tonggianiemyet += gianiemyet;
                            //Giảm giá
                            $(val).find(".giamgia").val(Math.round(gianiemyet * (heso)).toLocaleString('en-us'));
                            //giá bán
                            $(val).find(".giaban").val(Math.round(gianiemyet * (1 - heso)).toLocaleString('en-us'));

                            var giaban = parseInt($(val).find(".giaban").val().split(",").join(""));
                            if (isNaN(giaban))
                                giaban = 0;
                            tonggiaban += giaban;
                        }
                    }
                });
