  <appSettings>
    <add key="webpages:Version" value="3.0.0.0"/>
    <add key="webpages:Enabled" value="false"/>
    <add key="ClientValidationEnabled" value="true"/>
    <add key="UnobtrusiveJavaScriptEnabled" value="true"/>
    
    <add key="Host" value="mail.phattien.com"/>
    <add key="Port" value="25"/>
    <add key="AuthenUser" value="baocaodongbo@phattien.com"/>
    <add key="AuthenPassWord" value="Ph@tT13n2019"/>
    <add key="EnableSendMail" value="true"/>
    <add key="EnableSSL" value="false"/>
    <add key="EnableNotification" value="true"/>
  </appSettings>
  <!-- Cau hinh log4net-->
  <log4net debug="true">
    <appender name="DailyLog" type="log4net.Appender.RollingFileAppender">
      <file value="log/"/>
      <appendToFile value="true"/>
      <rollingStyle value="Date"/>
      <staticLogFileName value="false"/>
      <datePattern value="yyyy-MM-dd.lo\g"/>
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date %-5level %logger - %message%newline"/>
      </layout>
    </appender>
    <root>
      <level value="ALL"/>
      <appender-ref ref="DailyLog"/>
    </root>
  </log4net>
  <system.web>
    <globalization fileEncoding="UTF-8" requestEncoding="UTF-8" responseEncoding="UTF-8" culture="vi-VN" uiCulture="vi-VN"/>
    <authentication mode="Forms">
      <forms name="TNK.AUTH" loginUrl="/User/Login" protection="All" timeout="43200" requireSSL="false" slidingExpiration="true"/>
    </authentication>
    <compilation debug="true" targetFramework="4.5"/>
    <httpRuntime targetFramework="4.5"/>
    <!--<sessionState mode="SQLServer" stateConnectionString="tcpip=127.0.0.1:42424" sqlConnectionString="data source=192.168.55.230;Initial Catalog=TNK_Beta2;User ID=sa_tnk;Password=Sv@2015#" cookieless="false" timeout="10" />-->
